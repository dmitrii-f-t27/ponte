pub const PE_FX_LENGTHS : [35]u32 = [140, 26, 145, 28, 26, 22, 32, 35, 10, 10, 11, 4, 9, 0, 23, 8, 10, 30, 28, 19, 20, 11, 14, 12, 14, 14, 18, 12, 14, 13, 15, 14, 14, 15, 12];
; <<< generated

; --- Link -----------------------------------------------------------------------------------------------------------
; Off when the link is off; linked when connected with peers; waiting when connected and alone; failed when
; not connected after PE_FAILED_AFTER failures in a row; else connecting.
pub fn pe_status(link_on: bool, connected: bool, peers: i64, failures: i64) -> i64 {
    if (link_on == false) { return PE_STATUS_OFF; }
    if (connected and peers > 0) { return PE_STATUS_LINKED; }
    if (connected and peers == 0) { return PE_STATUS_WAITING; }
    if (connected == false and failures >= PE_FAILED_AFTER) { return PE_STATUS_FAILED; }
    return PE_STATUS_CONNECTING;
}

; The wait before reconnect attempt `attempt` (0 is the first): doubles from PE_RECONNECT_FIRST_MS up to
; PE_RECONNECT_MAX_MS. A negative attempt waits PE_RECONNECT_FIRST_MS.
pub fn pe_reconnect_delay_ms(attempt: i64) -> i64 {
    var delay: i64 = PE_RECONNECT_FIRST_MS;
    var k: i64 = 0;
    while (k < attempt and delay < PE_RECONNECT_MAX_MS) {
        delay = delay * 2;
        k = k + 1;
    }
    if (delay > PE_RECONNECT_MAX_MS) { return PE_RECONNECT_MAX_MS; }
    return delay;
}

; A peer is alive when its last HELLO came less than PE_PEER_TIMEOUT_MS ago (a time in the future is not alive).
pub fn pe_peer_alive(ms_since_hello: i64) -> bool {
    return ms_since_hello >= 0 and ms_since_hello < PE_PEER_TIMEOUT_MS;
}

; A connection in the room never announced itself (someone may listen): the relay counts more connections than the
; peers this Ponte knows plus itself, and has for at least PE_UNKNOWN_LISTENER_MS (ms_since_mismatch). A Ponte that
; joins says HELLO at once and the others answer at once, so the short difference while someone joins or leaves is
; not one. Negative counts are never one.
pub const PE_UNKNOWN_LISTENER_MS : i64 = 6000;
pub fn pe_unknown_listener(members: i64, peers: i64, ms_since_mismatch: i64) -> bool {
    return pe_members_mismatch(members, peers) and ms_since_mismatch >= PE_UNKNOWN_LISTENER_MS;
}

; The relay counts more connections than the peers this Ponte knows plus itself (negative counts never).
pub fn pe_members_mismatch(members: i64, peers: i64) -> bool {
    if (members < 0 or peers < 0) { return false; }
    return members - peers > 1;
}

; A new peer is accepted while this Ponte knows 0 to PE_MAX_PEERS - 2 peers (fewer than PE_MAX_PEERS - 1).
pub fn pe_accepts_new_peer(known_peers: i64) -> bool {
    return known_peers >= 0 and known_peers < PE_MAX_PEERS - 1;
}

; The relay closed the socket with `close_code` because the room was full.
pub fn pe_room_full(close_code: i64) -> bool {
    return close_code == PE_CLOSE_ROOM_FULL;
}

; The wait before the next connection after the relay closed the socket with `close_code` at failure `attempt`
; (0 is the first): PE_ROOM_FULL_RETRY_MS after a full room, else pe_reconnect_delay_ms.
pub fn pe_retry_delay_ms(close_code: i64, attempt: i64) -> i64 {
    if (pe_room_full(close_code)) { return PE_ROOM_FULL_RETRY_MS; }
    return pe_reconnect_delay_ms(attempt);
}

; --- The microphone to the peers ----------------------------------------------------------------------------------
; The microphone goes to the peers while the link is up and the owner did not mute it: always with headphones
; (nothing from the speakers reaches it), else only while the push-to-talk key is held.
pub fn pe_sends_mic(link_up: bool, muted: bool, headphones_like: bool, key_held: bool) -> bool {
    return link_up and muted == false and (headphones_like or key_held);
}

; A frame goes out when it has signal, or within PE_VAD_HANGOVER_MS after the last frame that had.
pub fn pe_vad_sends(has_signal: bool, ms_since_signal: i64) -> bool {
    return has_signal or (ms_since_signal >= 0 and ms_since_signal < PE_VAD_HANGOVER_MS);
}

; audioSends: one more audio frame may go to the socket now.
pub fn pe_audio_sends(in_flight: i64) -> bool {
    return in_flight >= 0 and in_flight < PE_MAX_AUDIO_IN_FLIGHT;
}

; --- Jitter buffer --------------------------------------------------------------------------------------------------
; au_relay_action with the PE_JITTER_* constants. `filling` until the jitter buffer was first sent (and again
; after TRIM or REFILL); `pending_ms` is what the jitter buffer holds with the new frame; `queued_ms` is what
; the output still has to play (read only when `output_running`); `low_ms` is the lowest queued_ms of the
; current window (this one included) and `low_count` how many frames it has seen.
pub fn pe_jitter_action(filling: bool, pending_ms: f64, queued_ms: f64, output_running: bool, low_ms: f64, low_count: i64) -> i64 {
    if (output_running == false) {
        if (pending_ms > PE_JITTER_TARGET_MS) { return PE_JIT_TRIM; }
        return PE_JIT_KEEP;
    }
    if (filling) {
        if (pending_ms >= PE_JITTER_TARGET_MS) { return PE_JIT_SEND; }
        return PE_JIT_KEEP;
    }
    if (queued_ms <= 0.0) { return PE_JIT_REFILL; }
    if (queued_ms + pending_ms > PE_JITTER_MAX_MS) { return PE_JIT_DROP; }
    if (pe_jitter_window_ends(low_count) and low_ms > PE_JITTER_TARGET_MS + PE_JITTER_SLACK_MS) { return PE_JIT_DROP; }
    return PE_JIT_SEND;
}

; A window of PE_JITTER_WINDOW frames is complete (the buffer then starts a new one).
pub fn pe_jitter_window_ends(low_count: i64) -> bool {
    return low_count >= PE_JITTER_WINDOW;
}

; While trimming, the oldest frame goes as long as PE_JITTER_TARGET_MS stay without it.
pub fn pe_jitter_trims(pending_ms: f64, oldest_ms: f64) -> bool {
    return pending_ms - oldest_ms >= PE_JITTER_TARGET_MS;
}

; --- Bytes and words ------------------------------------------------------------------------------------------------
; A text length as read here: below 0 is 0, above PE_TEXT_MAX is PE_TEXT_MAX.
pub fn pe_text_len(len: i64) -> i64 {
    if (len < 0) { return 0; }
    if (len > PE_TEXT_MAX) { return PE_TEXT_MAX; }
    return len;
}

; ASCII A-Z to a-z; every other byte unchanged.
pub fn pe_fold(c: u8) -> u8 {
    if (c >= PE_UPPER_A and c <= PE_UPPER_Z) { return c + PE_CASE_STEP; }
    return c;
}

; A word byte: ASCII a-z or 0-9 after folding, or any byte from 0x80 (UTF-8 letters of every script).
pub fn pe_is_word_byte(c: u8) -> bool {
    var f: u8 = pe_fold(c);
    return (f >= PE_LOWER_A and f <= PE_LOWER_Z) or (f >= PE_DIGIT_0 and f <= PE_DIGIT_9) or c >= PE_FIRST_NON_ASCII;
}

; The words of a text (maximal runs of word bytes), the first PE_WORDS_MAX of them: their starts and lengths
; are written to starts and lens; returns how many.
pub fn pe_words(text: [4096]u8, len: i64, starts: [512]i64, lens: [512]i64) -> i64 {
    var n: i64 = pe_text_len(len);
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < n and count < PE_WORDS_MAX) {
        if (pe_is_word_byte(text[i])) {
            var s: i64 = i;
            while (i < n and pe_is_word_byte(text[i])) { i = i + 1; }
            starts[count] = s;
            lens[count] = i - s;
            count = count + 1;
        } else {
            i = i + 1;
        }
    }
    return count;
}

; How many words a text has, exactly as pe_containment_milli reads them: the first PE_TEXT_MAX bytes, at most
; PE_WORDS_MAX words, a word a maximal run of word bytes (pe_is_word_byte).
pub fn pe_word_count(text: [4096]u8, len: i64) -> i64 {
    var starts: [512]i64 = [0; 512];
    var lens: [512]i64 = [0; 512];
    return pe_words(text, len, starts, lens);
}

; Two words are the same when their folded bytes are.
pub fn pe_same_word(a: [4096]u8, a_start: i64, a_len: i64, b: [4096]u8, b_start: i64, b_len: i64) -> bool {
    if (a_len != b_len) { return false; }
    var k: i64 = 0;
    while (k < a_len) {
        if (pe_fold(a[a_start + k]) != pe_fold(b[b_start + k])) { return false; }
        k = k + 1;
    }
    return true;
}

; --- Secret code ------------------------------------------------------------------------------------------------------
; A byte of the secret code's alphabet.
pub fn pe_in_secret_alphabet(c: u8) -> bool {
    var k: i64 = 0;
    while (k < PE_SECRET_ALPHABET_LEN) {
        if (PE_SECRET_ALPHABET[k] == c) { return true; }
        k = k + 1;
    }
    return false;
}

; The secret code's alphabet, written to out: returns PE_SECRET_ALPHABET_LEN.
pub fn pe_secret_alphabet(out: [64]u8) -> i64 {
    var k: i64 = 0;
    while (k < PE_SECRET_ALPHABET_LEN) {
        out[k] = PE_SECRET_ALPHABET[k];
        k = k + 1;
    }
    return PE_SECRET_ALPHABET_LEN;
}

; A typed or pasted secret code, normalized: the first PE_TEXT_MAX bytes are read; ASCII A-Z is folded to a-z;
; every PE_SPACE, PE_HYPHEN and PE_UNDERSCORE is dropped; what stays must be exactly PE_SECRET_LENGTH bytes, every one
; in PE_SECRET_ALPHABET. Writes them to out and returns PE_SECRET_LENGTH; returns 0 when the text is no code (any
; other byte, a tab or a non-ASCII letter among them; too few or too many code bytes).
pub fn pe_secret_normalized(text: [4096]u8, len: i64, out: [12]u8) -> i64 {
    var n: i64 = pe_text_len(len);
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = pe_fold(text[i]);
        if (c != PE_SPACE and c != PE_HYPHEN and c != PE_UNDERSCORE) {
            if (count >= PE_SECRET_LENGTH) { return 0; }
            if (pe_in_secret_alphabet(c) == false) { return 0; }
            out[count] = c;
            count = count + 1;
        }
        i = i + 1;
    }
    if (count != PE_SECRET_LENGTH) { return 0; }
    return count;
}

; A normalized secret code as shown: groups of PE_SECRET_GROUP bytes joined by PE_HYPHEN, written to out; returns
; PE_SECRET_DISPLAY_LEN. A text that is not exactly PE_SECRET_LENGTH alphabet bytes is shown unchanged: returns 0.
pub fn pe_secret_display(text: [4096]u8, len: i64, out: [16]u8) -> i64 {
    if (len != PE_SECRET_LENGTH) { return 0; }
    var k: i64 = 0;
    while (k < PE_SECRET_LENGTH) {
        if (pe_in_secret_alphabet(text[k]) == false) { return 0; }
        k = k + 1;
    }
    var at: i64 = 0;
    k = 0;
    while (k < PE_SECRET_LENGTH) {
        if (k > 0 and k % PE_SECRET_GROUP == 0) {
            out[at] = PE_HYPHEN;
            at = at + 1;
        }
        out[at] = text[k];
        at = at + 1;
        k = k + 1;
    }
    return at;
}

; --- Frame freshness and replay ---------------------------------------------------------------------------------------
; hi - lo > limit, exactly, for every i64 hi and lo and 0 <= limit <= 2^62 (no overflow): with hi and lo of one sign
; the difference fits; with lo < 0 <= hi it is hi + |lo|, larger than limit when either part is.
pub fn pe_gap_over(hi: i64, lo: i64, limit: i64) -> bool {
    if (hi <= lo) { return false; }
    if (lo >= 0 or hi < 0) { return hi - lo > limit; }
    if (hi > limit) { return true; }
    if (lo < 0 - limit) { return true; }
    return hi - lo > limit;
}

; A frame sent at sent_ms is fresh at now_ms when |now_ms - sent_ms| <= PE_MAX_SKEW_MS (any i64 times).
pub fn pe_frame_fresh(sent_ms: i64, now_ms: i64) -> bool {
    return pe_gap_over(now_ms, sent_ms, PE_MAX_SKEW_MS) == false and pe_gap_over(sent_ms, now_ms, PE_MAX_SKEW_MS) == false;
}

; The first admission check of a decrypted frame (PeerLink.open, before the sequence number, the peer limit and the
; frame's kind): a frame is taken only from another Ponte (`is_self`: its sender ID is this link's own; the relay
; never echoes, but a frame of this link coming back is never this link's peer) and only when it is fresh
; (pe_frame_fresh). PeerLink wrote `peer != sender, frameFresh(...)` itself before 2026-10-15.
pub fn pe_frame_accepted(is_self: bool, sent_ms: i64, now_ms: i64) -> bool {
    return is_self == false and pe_frame_fresh(sent_ms, now_ms);
}

; When a voice started or ended (at_ms, sender's clock), on this Mac's clock: the sender stamps the event and the frame
; (sent_ms) on the same clock, so the gap between them needs no agreement between the two Macs' clocks; the event
; happened that long before the frame arrived (now_ms; the relay's delay is not subtracted). A gap below 0 or above
; PE_MAX_SKEW_MS, or a negative now_ms, is not trusted: the arrival.
pub fn pe_voice_local_ms(at_ms: i64, sent_ms: i64, now_ms: i64) -> i64 {
    if (now_ms < 0 or at_ms > sent_ms) { return now_ms; }
    if (pe_gap_over(sent_ms, at_ms, PE_MAX_SKEW_MS)) { return now_ms; }
    return now_ms - (sent_ms - at_ms);
}

; A frame's sequence number is new when no frame of that peer was taken yet, or it is above the last one taken.
pub fn pe_seq_newer(seq: u32, last_seq: u32, has_last: bool) -> bool {
    return has_last == false or seq > last_seq;
}

; --- Voice windows ----------------------------------------------------------------------------------------------------
; Where a voice window ends, as pe_is_peer_voice reads it: its announced end when it has one (end_ms >= 0); else, for a
; window that is `refreshed` (another Ponte's: its sender re-sends START every PE_VOICE_REFRESH_MS), last_seen_ms (its
; last START) when that is more than PE_VOICE_STALE_MS before now_ms; else -1 (still open). A window that is never
; refreshed (this Ponte's own voice, recorded here: no keepalive, and its END cannot get lost) ends only by its END,
; however long it plays. Any i64 times (no overflow).
pub fn pe_window_end_ms(end_ms: i64, last_seen_ms: i64, now_ms: i64, refreshed: bool) -> i64 {
    if (end_ms >= 0) { return end_ms; }
    if (refreshed == false) { return -1; }
    if (pe_gap_over(now_ms, last_seen_ms, PE_VOICE_STALE_MS)) { return last_seen_ms; }
    return -1;
}

; --- Containment ------------------------------------------------------------------------------------------------------
; How much of `phrase` is in `said`, 0...1000: the words as pe_words reads them (the first PE_TEXT_MAX bytes and
; PE_WORDS_MAX words of each; ASCII case folded; a word is a run of ASCII letters and digits or of bytes from 0x80);
; L is the length of the longest common subsequence of the two word sequences (equal words: equal folded bytes); the
; result is PE_PERMILLE * L / (words of phrase), rounded down; 0 when the phrase has no word. It asks how much of the
; recognized phrase, in order, is in what the Ponte said: "Sim, podemos comecar agora" in "Podemos comecar agora?" is
; 750 (3 of 4 words), however alike the two texts look.
pub fn pe_containment_milli(phrase: [4096]u8, phrase_len: i64, said: [4096]u8, said_len: i64) -> i64 {
    var p_starts: [512]i64 = [0; 512];
    var p_lens: [512]i64 = [0; 512];
    var s_starts: [512]i64 = [0; 512];
    var s_lens: [512]i64 = [0; 512];
    var np: i64 = pe_words(phrase, phrase_len, p_starts, p_lens);
    var ns: i64 = pe_words(said, said_len, s_starts, s_lens);
    if (np == 0) { return 0; }
    var prev: [513]i64 = [0; 513];
    var row: [513]i64 = [0; 513];
    var i: i64 = 0;
    while (i < np) {
        row[0] = 0;
        var j: i64 = 0;
        while (j < ns) {
            if (pe_same_word(phrase, p_starts[i], p_lens[i], said, s_starts[j], s_lens[j])) {
                row[j + 1] = prev[j] + 1;
            } else {
                if (prev[j + 1] >= row[j]) {
                    row[j + 1] = prev[j + 1];
                } else {
                    row[j + 1] = row[j];
                }
            }
            j = j + 1;
        }
        j = 0;
        while (j <= ns) {
            prev[j] = row[j];
            j = j + 1;
        }
        i = i + 1;
    }
    return (PE_PERMILLE * prev[ns]) / np;
}

; --- Is a recognized phrase a Ponte's voice? --------------------------------------------------------------------------
; part * PE_PERMILLE >= permille * whole, exactly, for 0 <= part, 1 <= whole and 0 <= permille <= PE_PERMILLE (no
; overflow): with whole = PE_PERMILLE * q + r, it is (part - permille * q) * PE_PERMILLE >= permille * r.
pub fn pe_permille_at_least(part: i64, whole: i64, permille: i64) -> bool {
    var q: i64 = whole / PE_PERMILLE;
    var r: i64 = whole % PE_PERMILLE;
    var rest: i64 = part - permille * q;
    return rest >= (permille * r + PE_PERMILLE - 1) / PE_PERMILLE;
}

; At least PE_OWN_OVERLAP_PERMILLE of the phrase [p_start, p_start + duration) (duration >= 1) lies in [w_from, w_until]
; (open: no end). |p_start|, |w_from| and |w_until| below 2^62 + 2^15, duration below 2^63 (no overflow): the overlap
; is at most the duration.
pub fn pe_mostly_in(p_start: i64, duration: i64, w_from: i64, open: bool, w_until: i64) -> bool {
    var lo: i64 = p_start;
    if (w_from > lo) { lo = w_from; }
    var hi: i64 = p_start + duration;
    if (open == false and w_until < hi) { hi = w_until; }
    var overlap: i64 = 0;
    if (hi > lo) { overlap = hi - lo; }
    return pe_permille_at_least(overlap, duration, PE_OWN_OVERLAP_PERMILLE);
}

; The phrase [p_start, p_end] meets [w_from, w_until] (open: no end): it ends at or after w_from and starts at or before
; w_until.
pub fn pe_meets(p_start: i64, p_end: i64, w_from: i64, open: bool, w_until: i64) -> bool {
    return p_end >= w_from and (open or p_start <= w_until);
}

; Whether the recognized phrase [phrase_start_ms, phrase_end_ms] (either order) is a Ponte's voice announced as `kind`
; in the window [window_start_ms, window_end_ms] (window_end_ms < 0: still open, pe_window_end_ms). `is_self`: the
; window is this Ponte's own (its voice echoed back by the far side), not another Ponte's; `phrase_words`: the words of
; the phrase (pe_word_count); `containment_milli`: how much of the phrase is in what the Ponte said
; (pe_containment_milli).
; The phrase starts at the earlier time and lasts duration = max(1, |phrase_end_ms - phrase_start_ms|); it ends at
; start + duration. The window starts PE_WINDOW_BEFORE_MS early (the recognizer's phrase start is early); "lies in"
; means at least PE_OWN_OVERLAP_PERMILLE of the phrase's duration does (pe_mostly_in); an open window has no end.
; - The owner's own voice (PE_VOICE_OWN), this Ponte's or another's: when the phrase lies in the window ending
;   PE_OWN_AFTER_MS after window_end_ms (the end is stamped at his last voice; a laptop next to the owner can send his
;   own voice back through the call, review 2026-10-14), so the Brazilian's quick reply right after it is translated.
; - TTS (PE_VOICE_TTS), with at least PE_CONTAIN_MIN_MILLI containment:
;   (1) while it plays: the phrase lies in the window ending PE_ECHO_LAG_MS after window_end_ms (any length);
;   (2) just after: a phrase of at least PE_MIN_WORDS words that meets the window ending PE_WINDOW_AFTER_MS after
;       window_end_ms (pe_meets);
;   (3) another Ponte's TTS only, with at least PE_CONTAIN_SURE_MILLI: a phrase of at least PE_MIN_WORDS words that
;       meets the window ending PE_TEXT_WINDOW_MS after window_end_ms (the recognizer lags behind a voice from the
;       call; this Ponte's own TTS comes back at once or not at all).
;   A short reply of the Brazilian ("Dez mil?", "Sim") that repeats words of a TTS is his own after the TTS ended.
; - Any other kind: never.
; Times t with |t| < 2^62 (no overflow); kind, phrase_words and containment_milli are only compared.
pub fn pe_is_peer_voice(kind: i64, is_self: bool, phrase_words: i64, containment_milli: i64, phrase_start_ms: i64, phrase_end_ms: i64, window_start_ms: i64, window_end_ms: i64) -> bool {
    var p_start: i64 = phrase_start_ms;
    var p_last: i64 = phrase_end_ms;
    if (phrase_end_ms < phrase_start_ms) {
        p_start = phrase_end_ms;
        p_last = phrase_start_ms;
    }
    var duration: i64 = p_last - p_start;
    if (duration < 1) { duration = 1; }
    var p_end: i64 = p_start + duration;
    var open: bool = window_end_ms < 0;
    var w_from: i64 = window_start_ms - PE_WINDOW_BEFORE_MS;
    if (kind == PE_VOICE_OWN) {
        return pe_mostly_in(p_start, duration, w_from, open, window_end_ms + PE_OWN_AFTER_MS);
    }
    if (kind == PE_VOICE_TTS) {
        if (containment_milli < PE_CONTAIN_MIN_MILLI) { return false; }
        if (pe_mostly_in(p_start, duration, w_from, open, window_end_ms + PE_ECHO_LAG_MS)) { return true; }
        if (phrase_words < PE_MIN_WORDS) { return false; }
        if (pe_meets(p_start, p_end, w_from, open, window_end_ms + PE_WINDOW_AFTER_MS)) { return true; }
        if (is_self) { return false; }
        return containment_milli >= PE_CONTAIN_SURE_MILLI and pe_meets(p_start, p_end, w_from, open, window_end_ms + PE_TEXT_WINDOW_MS);
    }
    return false;
}

; --- The wire and the link's housekeeping (moved out of Swift 2026-10-15) --------------------------------------
; A frame after decryption: kind (1 byte), sender (8, little-endian), sequence number (4), the sender's clock in ms
; (8, signed), then the payload. A VOICE payload: kind (1), state (1), when it started or ended in ms (8, signed),
; then the text. An AUDIO payload: 16-bit little-endian samples (an odd last byte is ignored).
pub const PE_HDR_KIND : i64 = 0;
pub const PE_HDR_SENDER : i64 = 1;
pub const PE_HDR_SEQ : i64 = 9;
pub const PE_HDR_SENT : i64 = 13;
pub const PE_HDR_BYTES : i64 = 21;
pub const PE_VP_KIND : i64 = 0;
pub const PE_VP_STATE : i64 = 1;
pub const PE_VP_AT : i64 = 2;
pub const PE_VP_TEXT : i64 = 10;
; The samples of one PE_FRAME_MS frame at PE_SAMPLE_RATE.
pub const PE_FRAME_SAMPLES : i64 = 640;
; A voice text goes out with at most this many bytes.
pub const PE_VOICE_TEXT_MAX : i64 = 4000;
; PBKDF2 gives this many bytes for the room id and for the key.
pub const PE_KEY_BYTES : i64 = 32;
; The relay's own note {"members":n}: at most PE_NOTE_MAX bytes, n in 0...PE_MEMBERS_MAX.
pub const PE_NOTE_MAX : i64 = 64;
pub const PE_MEMBERS_MAX : i64 = 64;
; The socket closes this long after the BYE is handed to it; quitting waits a little longer for that.
pub const PE_BYE_GRACE_MS : i64 = 200;
pub const PE_QUIT_WAIT_MS : i64 = 300;
; "Another Russian is speaking" (the panel): a frame of his voice played within this long.
pub const PE_SPEAKING_MS : i64 = 500;

pub fn pe_frame_complete(len: i64) -> bool {
    return len >= PE_HDR_BYTES;
}

pub fn pe_voice_complete(payload_len: i64) -> bool {
    return payload_len >= PE_VP_TEXT;
}

pub fn pe_audio_samples(payload_len: i64) -> i64 {
    if (payload_len < 0) { return 0; }
    return payload_len / 2;
}

; A sample to the wire: held to -1...1 (NaN to 0), times 32767, rounded half away from zero (-32767...32767).
pub fn pe_sample_to_int16(x: f32) -> i64 {
    var one: f32 = 1.0;
    var zero: f32 = 0.0;
    var scale: f32 = 32767.0;
    var v: f32 = zero;
    if (x > zero) {
        v = x;
        if (v > one) { v = one; }
    }
    if (x < zero) {
        v = x;
        if (v < zero - one) { v = zero - one; }
    }
    return cast_i64(round(v * scale));
}

; How many bytes of a voice text go out (text holds len bytes; a negative length reads as 0): all of it up to
; PE_VOICE_TEXT_MAX, else that many cut before the character the limit falls in, so no UTF-8 character is split.
pub fn pe_voice_text_bytes(text: [4096]u8, len: i64) -> i64 {
    if (len <= 0) { return 0; }
    if (len <= PE_VOICE_TEXT_MAX) { return len; }
    var n: i64 = PE_VOICE_TEXT_MAX;
    while (n > 0 and (text[n] & 192) == 128) {
        n = n - 1;
    }
    return n;
}

; A row of the link's texts, copied to out: its length (0 for an unknown row).
pub fn pe_row(row: i64, out: [64]u8) -> i64 {
    if (row < 0 or row >= PE_ROW_COUNT) { return 0; }
    var off: i64 = PE_ROW_OFFSETS[row];
    var len: i64 = PE_ROW_LENGTHS[row];
    var k: i64 = 0;
    while (k < len) {
        out[k] = PE_ROW_TEXT[off + k];
        k = k + 1;
    }
    return len;
}

pub fn pe_note_fits(len: i64) -> bool {
    return len >= 0 and len <= PE_NOTE_MAX;
}

pub fn pe_members_valid(n: i64) -> bool {
    return n >= 0 and n <= PE_MEMBERS_MAX;
}

; The failure count after the relay closed the socket: one more (it stops growing at 2^62); a full room counts as
; failed at once (PE_FAILED_AFTER).
pub fn pe_failures_after_close(failures: i64, room_full: bool) -> i64 {
    var next: i64 = failures;
    if (next < 0) { next = 0; }
    if (next < 4611686018427387904) { next = next + 1; }
    if (room_full and next < PE_FAILED_AFTER) { next = PE_FAILED_AFTER; }
    return next;
}

; A frame from a sender this Ponte does not know is taken while it may accept a new peer; a BYE always (it only
; removes); a known sender's always.
pub fn pe_frame_admitted(known: bool, kind: i64, known_peers: i64) -> bool {
    return known or kind == PE_MSG_BYE or pe_accepts_new_peer(known_peers);
}

; A Ponte answers a new peer's first frame with its own HELLO, so the newcomer knows it at once.
pub fn pe_answers_hello(new_peer: bool, kind: i64) -> bool {
    return new_peer and kind != PE_MSG_BYE;
}

; The link's timer: HELLO and the re-announcement of voices on one tick, at the shorter of the two periods.
pub fn pe_tick_ms() -> i64 {
    if (PE_HELLO_EVERY_MS < PE_VOICE_REFRESH_MS) { return PE_HELLO_EVERY_MS; }
    return PE_VOICE_REFRESH_MS;
}

; The microphone goes to the peers only while the link is linked.
pub fn pe_link_up(status: i64) -> bool {
    return status == PE_STATUS_LINKED;
}

pub fn pe_peer_speaking(ms_since_frame: i64) -> bool {
    return ms_since_frame >= 0 and ms_since_frame < PE_SPEAKING_MS;
}

; PeerWindows.record (REC_*): a START with the text of the open window of that sender and kind refreshes it; a START
; with another text ends it and opens a new one; a START without one opens one; an END ends the open window; an END
; without one, or another state, does nothing.
pub const PE_REC_NONE : i64 = 0;
pub const PE_REC_REFRESH : i64 = 1;
pub const PE_REC_REPLACE : i64 = 2;
pub const PE_REC_OPEN : i64 = 3;
pub const PE_REC_END : i64 = 4;
pub fn pe_window_record(state: i64, has_open: bool, same_text: bool) -> i64 {
    if (state == PE_VOICE_START) {
        if (has_open == false) { return PE_REC_OPEN; }
        if (same_text) { return PE_REC_REFRESH; }
        return PE_REC_REPLACE;
    }
    if (state == PE_VOICE_END and has_open) { return PE_REC_END; }
    return PE_REC_NONE;
}

; A window is forgotten PE_WINDOW_KEEP_MS after it ended (window_end_ms from pe_window_end_ms; below 0: open).
pub fn pe_window_forgotten(window_end_ms: i64, now_ms: i64) -> bool {
    return window_end_ms >= 0 and pe_gap_over(now_ms, window_end_ms, PE_WINDOW_KEEP_MS);
}

; Only a TTS window has a text to compare a phrase with; an own-voice window is time only.
pub fn pe_window_compares_text(kind: i64) -> bool {
    return kind == PE_VOICE_TTS;
}

; PeerMicGate (GATE_*): a buffer the gate lets through is sent; the first one it holds back after sending flushes the
; half frame waiting, so that is not sent later; otherwise nothing.
pub const PE_GATE_NONE : i64 = 0;
pub const PE_GATE_SEND : i64 = 1;
pub const PE_GATE_FLUSH : i64 = 2;
pub fn pe_mic_gate_step(sends: bool, was_sending: bool) -> i64 {
    if (sends) { return PE_GATE_SEND; }
    if (was_sending) { return PE_GATE_FLUSH; }
    return PE_GATE_NONE;
}

; PeerMicGate: a microphone buffer goes to the other Russians when the gate is open (pe_sends_mic: link up, not
; muted, headphones or the talk key) and the voice detector sends (pe_vad_sends: voice now, or within the hangover).
; `ms_since_signal` < 0: no voice yet. The `sends` of pe_mic_gate_step; PeerMicGate joined the two itself before
; 2026-10-15.
pub fn pe_mic_sends(link_up: bool, muted: bool, headphones_like: bool, key_held: bool, has_signal: bool, ms_since_signal: i64) -> bool {
    return pe_sends_mic(link_up, muted, headphones_like, key_held) and pe_vad_sends(has_signal, ms_since_signal);
}

; --- Texts for the tests ------------------------------------------------------------------------------------------
; Copies text fixture `index` to out and returns its length (0 for an unknown index).
pub fn pe_fixture(index: i64, out: [4096]u8) -> i64 {
    if (index < 0 or index >= PE_FX_COUNT) { return 0; }
    var off: i64 = PE_FX_OFFSETS[index];
    var len: i64 = PE_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and k < PE_TEXT_MAX) {
        out[k] = PE_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; The words of fixture `index`.
pub fn pe_fixture_words(index: i64) -> i64 {
    var t: [4096]u8 = [0; 4096];
    var n: i64 = pe_fixture(index, t);
    return pe_word_count(t, n);
}

; How much of fixture `phrase` is in fixture `said`.
pub fn pe_fixture_containment(phrase: i64, said: i64) -> i64 {
    var tp: [4096]u8 = [0; 4096];
    var ts: [4096]u8 = [0; 4096];
    var np: i64 = pe_fixture(phrase, tp);
    var ns: i64 = pe_fixture(said, ts);
    return pe_containment_milli(tp, np, ts, ns);
}

; Fixture `text` normalizes to fixture `expected` (expected < 0: to no code).
pub fn pe_fixture_secret_is(text: i64, expected: i64) -> bool {
    var t: [4096]u8 = [0; 4096];
    var e: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var n: i64 = pe_fixture(text, t);
    var got: i64 = pe_secret_normalized(t, n, out);
    if (expected < 0) { return got == 0; }
    var m: i64 = pe_fixture(expected, e);
    if (got != m) { return false; }
    var k: i64 = 0;
    while (k < m) {
        if (out[k] != e[k]) { return false; }
        k = k + 1;
    }
    return true;
}

; Fixture `text` is shown as fixture `expected` (expected < 0: unchanged).
pub fn pe_fixture_display_is(text: i64, expected: i64) -> bool {
    var t: [4096]u8 = [0; 4096];
    var e: [4096]u8 = [0; 4096];
    var out: [16]u8 = [0; 16];
    var n: i64 = pe_fixture(text, t);
    var got: i64 = pe_secret_display(t, n, out);
    if (expected < 0) { return got == 0; }
    var m: i64 = pe_fixture(expected, e);
    if (got != m) { return false; }
    var k: i64 = 0;
    while (k < m) {
        if (out[k] != e[k]) { return false; }
        k = k + 1;
    }
    return true;
}

test pe_link_rules {
    assert pe_audio_sends(0) == true;
    assert pe_audio_sends(5) == true;
    assert pe_audio_sends(6) == false;
    assert pe_audio_sends(-1) == false;
    // Status: off, linked, waiting, failed, connecting.
    assert pe_status(false, true, 2, 0) == PE_STATUS_OFF;
    assert pe_status(false, false, 0, 9) == PE_STATUS_OFF;
    assert pe_status(true, true, 1, 0) == PE_STATUS_LINKED;
    assert pe_status(true, true, 6, 5) == PE_STATUS_LINKED;
    assert pe_status(true, true, 0, 0) == PE_STATUS_WAITING;
    assert pe_status(true, true, 0, 7) == PE_STATUS_WAITING;
    assert pe_status(true, false, 0, 0) == PE_STATUS_CONNECTING;
    assert pe_status(true, false, 3, 2) == PE_STATUS_CONNECTING;
    assert pe_status(true, false, 0, 3) == PE_STATUS_FAILED;
    assert pe_status(true, false, 2, 10) == PE_STATUS_FAILED;
    // Reconnect delays.
    assert pe_reconnect_delay_ms(-7) == 500;
    assert pe_reconnect_delay_ms(-1) == 500;
    assert pe_reconnect_delay_ms(0) == 500;
    assert pe_reconnect_delay_ms(1) == 1000;
    assert pe_reconnect_delay_ms(2) == 2000;
    assert pe_reconnect_delay_ms(3) == 4000;
    assert pe_reconnect_delay_ms(4) == 8000;
    assert pe_reconnect_delay_ms(5) == 8000;
    assert pe_reconnect_delay_ms(1000000) == 8000;
    // Peers time out after three missed HELLOs.
    assert PE_PEER_TIMEOUT_MS == 3 * PE_HELLO_EVERY_MS;
    assert pe_peer_alive(0) == true;
    assert pe_peer_alive(14999) == true;
    assert pe_peer_alive(15000) == false;
    assert pe_peer_alive(-1) == false;
    // The microphone: headphones open it, the speakers only with the key held; muted or no link never.
    var bad: u32 = 0;
    var bits: i32 = 0;
    while (bits < 16) {
        var up: bool = (bits & 1) != 0;
        var muted: bool = (bits & 2) != 0;
        var phones: bool = (bits & 4) != 0;
        var key: bool = (bits & 8) != 0;
        var expected: bool = false;
        if (up and muted == false) {
            if (phones) { expected = true; }
            if (key) { expected = true; }
        }
        if (pe_sends_mic(up, muted, phones, key) != expected) { bad = bad + 1; }
        bits = bits + 1;
    }
    assert bad == 0;
    assert pe_sends_mic(true, false, false, true) == true;
    assert pe_sends_mic(true, false, false, false) == false;
    // The voice gate and its hangover.
    assert pe_vad_sends(true, -5) == true;
    assert pe_vad_sends(false, 0) == true;
    assert pe_vad_sends(false, 599) == true;
    assert pe_vad_sends(false, 600) == false;
    assert pe_vad_sends(false, -1) == false;
    // Frames: 40 ms of 16 kHz are 640 samples.
    assert PE_SAMPLE_RATE * 40.0 / 1000.0 == 640.0;
}

test pe_jitter_rules {
    // The codes are the own-voice relay's (AU_RLA_KEEP..AU_RLA_REFILL are 0..4).
    assert PE_JIT_KEEP == 0;
    assert PE_JIT_SEND == 1;
    assert PE_JIT_DROP == 2;
    assert PE_JIT_TRIM == 3;
    assert PE_JIT_REFILL == 4;
    assert pe_jitter_action(true, 80.0, 0.0, true, 0.0, 0) == PE_JIT_KEEP;
    assert pe_jitter_action(true, 120.0, 0.0, true, 0.0, 0) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 120.0, true, 120.0, 1) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 360.0, true, 100.0, 10) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 361.0, true, 100.0, 10) == PE_JIT_DROP;
    assert pe_jitter_action(false, 40.0, 0.0, true, 0.0, 3) == PE_JIT_REFILL;
    assert pe_jitter_action(false, 40.0, -5.0, true, -5.0, 3) == PE_JIT_REFILL;
    assert pe_jitter_action(false, 120.0, 0.0, false, 0.0, 0) == PE_JIT_KEEP;
    assert pe_jitter_action(true, 160.0, 0.0, false, 0.0, 0) == PE_JIT_TRIM;
    assert pe_jitter_action(false, 40.0, 200.0, true, 160.1, 50) == PE_JIT_DROP;
    assert pe_jitter_action(false, 40.0, 200.0, true, 160.0, 50) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 200.0, true, 170.0, 49) == PE_JIT_SEND;
    assert pe_jitter_window_ends(49) == false;
    assert pe_jitter_window_ends(50) == true;
    assert pe_jitter_trims(160.0, 40.0) == true;
    assert pe_jitter_trims(159.0, 40.0) == false;
    // A steady 40 ms stream into an output that plays 40 ms per frame: one fill, then only sends, and the
    // output never holds more than the maximum.
    var filling: bool = true;
    var pending: f64 = 0.0;
    var queued: f64 = 0.0;
    var sends: i64 = 0;
    var other: i64 = 0;
    var low: f64 = 1000000.0;
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < 1000) {
        pending = pending + 40.0;
        if (filling == false) {
            if (queued < low) { low = queued; }
            count = count + 1;
        }
        var a: i64 = pe_jitter_action(filling, pending, queued, true, low, count);
        if (pe_jitter_window_ends(count)) {
            low = 1000000.0;
            count = 0;
        }
        if (a == PE_JIT_SEND) {
            queued = queued + pending;
            pending = 0.0;
            filling = false;
            sends = sends + 1;
        } else {
            if (a != PE_JIT_KEEP) { other = other + 1; }
        }
        if (queued > PE_JITTER_MAX_MS) { other = other + 1; }
        if (filling == false) { queued = queued - 40.0; }
        i = i + 1;
    }
    assert other == 0;
    assert sends == 998;
    // After a burst left 300 ms in the output: one frame per window goes until the queue is near the target.
    queued = 300.0;
    low = 1000000.0;
    count = 0;
    var drops: i64 = 0;
    i = 0;
    while (i < 1000) {
        pending = 40.0;
        if (queued < low) { low = queued; }
        count = count + 1;
        var b: i64 = pe_jitter_action(false, pending, queued, true, low, count);
        if (pe_jitter_window_ends(count)) {
            low = 1000000.0;
            count = 0;
        }
        if (b == PE_JIT_SEND) { queued = queued + pending; }
        if (b == PE_JIT_DROP) { drops = drops + 1; }
        queued = queued - 40.0;
        i = i + 1;
    }
    assert drops == 4;
    assert queued == 140.0;
}

test pe_word_rules {
    // Words as containment reads them: punctuation and spaces split, a hyphen and an apostrophe too; an accented or a
    // Cyrillic letter is part of its word; digits are word bytes.
    assert pe_fixture_words(PE_FX_TTS_CONTRACT) == 25;
    assert pe_fixture_words(PE_FX_TTS_CONTRACT_PT) == 25;
    assert pe_fixture_words(PE_FX_HEARD_TAIL) == 5;
    assert pe_fixture_words(PE_FX_REPLY) == 4;
    assert pe_fixture_words(PE_FX_TTS_PRICE) == 6;
    assert pe_fixture_words(PE_FX_REPLY_PRICE) == 2;
    assert pe_fixture_words(PE_FX_REPLY_SURE) == 2;
    assert pe_fixture_words(PE_FX_SIM_ONE) == 1;
    assert pe_fixture_words(PE_FX_SIM_THREE) == 3;
    assert pe_fixture_words(PE_FX_RU_PRIVET) == 3;
    assert pe_fixture_words(PE_FX_DIGITS) == 4;
    assert pe_fixture_words(PE_FX_HYPHENS) == 4;
    assert pe_fixture_words(PE_FX_ACCENTS) == 2;
    assert pe_fixture_words(PE_FX_NO_WORDS) == 0;
    assert pe_fixture_words(PE_FX_EMPTY) == 0;
    assert pe_fixture_words(-1) == 0;
    assert pe_fixture_words(PE_FX_COUNT) == 0;
    // Every fixture: a phrase with words is wholly in itself; the count is the containment's denominator.
    var bad: u32 = 0;
    var x: i64 = 0;
    while (x < PE_FX_COUNT) {
        var w: i64 = pe_fixture_words(x);
        if (w < 0 or w > PE_WORDS_MAX) { bad = bad + 1; }
        var self_c: i64 = pe_fixture_containment(x, x);
        if (w == 0 and self_c != 0) { bad = bad + 1; }
        if (w > 0 and self_c != PE_PERMILLE) { bad = bad + 1; }
        x = x + 1;
    }
    assert bad == 0;
    // Words: case folded, every byte from 0x80 is a word byte, the first 512 words count, 4096 bytes are read.
    var t: [4096]u8 = [0; 4096];
    var starts: [512]i64 = [0; 512];
    var lens: [512]i64 = [0; 512];
    var k: i64 = 0;
    while (k < 4096) {
        if (k % 2 == 0) { t[k] = 65; } else { t[k] = 32; }
        k = k + 1;
    }
    assert pe_words(t, 4096, starts, lens) == 512;
    assert starts[511] == 1022;
    assert lens[511] == 1;
    assert pe_word_count(t, 4096) == 512;
    assert pe_word_count(t, 9999) == 512;
    assert pe_word_count(t, -3) == 0;
    assert pe_word_count(t, 0) == 0;
    assert pe_word_count(t, 5) == 3;
    assert pe_word_count(t, 1023) == 512;
    assert pe_word_count(t, 1022) == 511;
    t[0] = 195;
    t[1] = 169;
    t[2] = 32;
    assert pe_words(t, 3, starts, lens) == 1;
    assert lens[0] == 2;
    assert pe_word_count(t, 3) == 1;
    assert pe_is_word_byte(128) == true;
    assert pe_is_word_byte(255) == true;
    assert pe_is_word_byte(45) == false;
    assert pe_is_word_byte(95) == false;
    assert pe_is_word_byte(39) == false;
    var b: u32 = 0;
    var word_bytes: u32 = 0;
    while (b < 256) {
        if (pe_is_word_byte(cast_u8(b))) { word_bytes = word_bytes + 1; }
        b = b + 1;
    }
    assert word_bytes == 128 + 26 + 26 + 10;
}

test pe_secret_rules {
    assert PE_SECRET_ALPHABET_LEN == 31;
    assert PE_SECRET_DISPLAY_LEN == PE_SECRET_LENGTH + (PE_SECRET_LENGTH - 1) / PE_SECRET_GROUP;
    assert PE_KDF_ITERATIONS == 200000;
    // The alphabet: 31 of the 256 bytes, ascending, without 0 1 i l o; uppercase only after folding.
    var in_alphabet: u32 = 0;
    var bad: u32 = 0;
    var b: u32 = 0;
    while (b < 256) {
        if (pe_in_secret_alphabet(cast_u8(b))) { in_alphabet = in_alphabet + 1; }
        b = b + 1;
    }
    assert in_alphabet == 31;
    var k: i64 = 1;
    while (k < PE_SECRET_ALPHABET_LEN) {
        if (PE_SECRET_ALPHABET[k - 1] >= PE_SECRET_ALPHABET[k]) { bad = bad + 1; }
        k = k + 1;
    }
    assert bad == 0;
    assert pe_in_secret_alphabet(48) == false;
    assert pe_in_secret_alphabet(49) == false;
    assert pe_in_secret_alphabet(105) == false;
    assert pe_in_secret_alphabet(108) == false;
    assert pe_in_secret_alphabet(111) == false;
    assert pe_in_secret_alphabet(50) == true;
    assert pe_in_secret_alphabet(57) == true;
    assert pe_in_secret_alphabet(97) == true;
    assert pe_in_secret_alphabet(122) == true;
    assert pe_in_secret_alphabet(65) == false;
    var alphabet: [64]u8 = [0; 64];
    assert pe_secret_alphabet(alphabet) == 31;
    assert alphabet[0] == 50;
    assert alphabet[30] == 122;
    // Typed and pasted codes.
    assert pe_fixture_secret_is(PE_FX_SECRET_TYPED, PE_FX_SECRET) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_DISPLAY, PE_FX_SECRET) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET, PE_FX_SECRET) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_UPPER, PE_FX_SECRET) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_UNDERSCORES, PE_FX_SECRET_UNDERSCORES_NORMALIZED) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_ZERO, -1) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_SHORT, -1) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_LONG, -1) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_WITH_I, -1) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_TABS, -1) == true;
    assert pe_fixture_secret_is(PE_FX_SECRET_ACCENT, -1) == true;
    assert pe_fixture_secret_is(PE_FX_EMPTY, -1) == true;
    // Shown in groups; anything but a normalized code is shown unchanged.
    assert pe_fixture_display_is(PE_FX_SECRET, PE_FX_SECRET_DISPLAY) == true;
    assert pe_fixture_display_is(PE_FX_SECRET_UNDERSCORES_NORMALIZED, PE_FX_SECRET_UNDERSCORES_DISPLAY) == true;
    assert pe_fixture_display_is(PE_FX_SECRET_UPPER, -1) == true;
    assert pe_fixture_display_is(PE_FX_SECRET_DISPLAY, -1) == true;
    assert pe_fixture_display_is(PE_FX_SECRET_TYPED, -1) == true;
    assert pe_fixture_display_is(PE_FX_EMPTY, -1) == true;
    // Only the first 4096 bytes are read: a code that ends past them is cut; a longer length reads 4096.
    var t: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var shown: [16]u8 = [0; 16];
    k = 0;
    while (k < 4096) {
        t[k] = PE_SPACE;
        k = k + 1;
    }
    k = 0;
    while (k < 12) {
        t[4084 + k] = PE_SECRET_ALPHABET[k];
        k = k + 1;
    }
    assert pe_secret_normalized(t, 4096, out) == 12;
    assert out[0] == 50;
    assert out[11] == 100;
    assert pe_secret_normalized(t, 9999, out) == 12;
    assert pe_secret_normalized(t, 4095, out) == 0;
    assert pe_secret_normalized(t, -1, out) == 0;
    t[4083] = 66;
    assert pe_secret_normalized(t, 4096, out) == 0;
    t[4083] = 95;
    t[0] = 45;
    assert pe_secret_normalized(t, 4096, out) == 12;
    assert pe_secret_display(t, 4096, shown) == 0;
}

test pe_freshness_rules {
    var i64_max: i64 = 9223372036854775807;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    assert pe_frame_fresh(0, 0) == true;
    assert pe_frame_fresh(0, 30000) == true;
    assert pe_frame_fresh(0, 30001) == false;
    assert pe_frame_fresh(0, -30000) == true;
    assert pe_frame_fresh(0, -30001) == false;
    assert pe_frame_fresh(30000, 0) == true;
    assert pe_frame_fresh(-30001, 0) == false;
    assert pe_frame_fresh(-15000, 15000) == true;
    assert pe_frame_fresh(-15000, 15001) == false;
    assert pe_frame_fresh(15001, -15000) == false;
    assert pe_frame_fresh(1760000000000, 1760000029999) == true;
    assert pe_frame_fresh(1760000000000, 1759999969999) == false;
    // Every i64, no overflow.
    assert pe_frame_fresh(i64_min, i64_max) == false;
    assert pe_frame_fresh(i64_max, i64_min) == false;
    assert pe_frame_fresh(i64_max, i64_max) == true;
    assert pe_frame_fresh(i64_min, i64_min) == true;
    assert pe_frame_fresh(i64_max - 30000, i64_max) == true;
    assert pe_frame_fresh(i64_max - 30001, i64_max) == false;
    assert pe_frame_fresh(i64_min, i64_min + 30000) == true;
    assert pe_frame_fresh(i64_min + 30001, i64_min) == false;
    assert pe_frame_fresh(-1, i64_max) == false;
    assert pe_frame_fresh(0, i64_min) == false;
    assert pe_frame_fresh(i64_min, 0) == false;
    assert pe_frame_fresh(-30000, 0) == true;
    // The gap rule against plain arithmetic on small times.
    var bad: u32 = 0;
    var d: i64 = -40000;
    while (d <= 40000) {
        var expect: bool = d <= 30000 and d >= -30000;
        if (pe_frame_fresh(0, d) != expect) { bad = bad + 1; }
        if (pe_frame_fresh(d, 0) != expect) { bad = bad + 1; }
        if (pe_frame_fresh(d - 20000, -20000) != expect) { bad = bad + 1; }
        var over: bool = d > 12000;
        if (pe_gap_over(d, 0, 12000) != over) { bad = bad + 1; }
        var under: bool = 0 - d > 12000;
        if (pe_gap_over(0, d, 12000) != under) { bad = bad + 1; }
        d = d + 7;
    }
    assert bad == 0;
    assert pe_gap_over(i64_max, i64_min, 0) == true;
    assert pe_gap_over(i64_min, i64_max, 0) == false;
    assert pe_gap_over(5, -7, 12) == false;
    assert pe_gap_over(5, -8, 12) == true;
    // Sequence numbers.
    var top: u32 = 4294967295;
    var zero: u32 = 0;
    assert pe_seq_newer(5, 4, true) == true;
    assert pe_seq_newer(4, 4, true) == false;
    assert pe_seq_newer(3, 4, true) == false;
    assert pe_seq_newer(zero, top, false) == true;
    assert pe_seq_newer(zero, zero, false) == true;
    assert pe_seq_newer(zero, zero, true) == false;
    assert pe_seq_newer(top, top - 1, true) == true;
    assert pe_seq_newer(top, top, true) == false;
    assert pe_seq_newer(zero, top, true) == false;
    assert pe_voice_local_ms(1000, 1600, 50000) == 49400;
    assert pe_voice_local_ms(1600, 1600, 50000) == 50000;
    assert pe_voice_local_ms(1601, 1600, 50000) == 50000;
    assert pe_voice_local_ms(0, 30000, 50000) == 20000;
    assert pe_voice_local_ms(-1, 30000, 50000) == 50000;
    assert pe_voice_local_ms(1000, 1600, -5) == -5;
    assert pe_voice_local_ms(0 - 9223372036854775807, 9223372036854775807, 50000) == 50000;
    assert pe_voice_local_ms(9223372036854775807, 0 - 9223372036854775807, 50000) == 50000;
    assert pe_voice_local_ms(9223372036854745807, 9223372036854775807, 30000) == 0;
}

test pe_room_rules {
    assert pe_accepts_new_peer(-1) == false;
    assert pe_unknown_listener(3, 1, 6000) == true;
    assert pe_unknown_listener(3, 1, 5999) == false;
    assert pe_unknown_listener(2, 1, 60000) == false;
    assert pe_unknown_listener(2, 0, 6000) == true;
    assert pe_unknown_listener(-1, 0, 60000) == false;
    assert pe_unknown_listener(5, -1, 60000) == false;
    assert pe_unknown_listener(9223372036854775807, 0, 9223372036854775807) == true;
    assert pe_accepts_new_peer(0) == true;
    assert pe_accepts_new_peer(4) == true;
    assert pe_accepts_new_peer(5) == false;
    assert pe_accepts_new_peer(6) == false;
    assert pe_accepts_new_peer(9223372036854775807) == false;
    var accepted: i64 = 0;
    var n: i64 = -10;
    while (n < 100) {
        if (pe_accepts_new_peer(n)) { accepted = accepted + 1; }
        n = n + 1;
    }
    assert accepted == PE_MAX_PEERS - 1;
    assert pe_room_full(PE_CLOSE_ROOM_FULL) == true;
    assert pe_room_full(4001) == true;
    assert pe_room_full(1000) == false;
    assert pe_room_full(1006) == false;
    assert pe_room_full(4000) == false;
    assert pe_room_full(4002) == false;
    assert pe_room_full(-4001) == false;
    assert pe_retry_delay_ms(4001, 0) == 15000;
    assert pe_retry_delay_ms(4001, 9) == 15000;
    assert pe_retry_delay_ms(1006, 0) == 500;
    assert pe_retry_delay_ms(4002, 2) == 2000;
    assert pe_retry_delay_ms(1000, 50) == 8000;
    // Stable after 3 s: longer than the first reconnect wait, shorter than a HELLO period.
    assert PE_STABLE_MS == 3000;
    assert PE_STABLE_MS > PE_RECONNECT_FIRST_MS;
    assert PE_STABLE_MS < PE_HELLO_EVERY_MS;
}

test pe_voice_window_rules {
    var i64_max: i64 = 9223372036854775807;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    // Two refreshes may be lost before a window goes stale.
    assert PE_VOICE_STALE_MS > 2 * PE_VOICE_REFRESH_MS;
    assert PE_VOICE_STALE_MS < PE_WINDOW_KEEP_MS;
    // An announced end is the end, refreshed or not.
    assert pe_window_end_ms(15000, 10000, 99999, true) == 15000;
    assert pe_window_end_ms(15000, 10000, 99999, false) == 15000;
    assert pe_window_end_ms(0, 5, 99999, true) == 0;
    assert pe_window_end_ms(0, 5, 99999, false) == 0;
    assert pe_window_end_ms(15000, 10000, 0, true) == 15000;
    // Another Ponte's window: open while refreshed; stale more than 12 s after the last START, it ends there.
    assert pe_window_end_ms(-1, 10000, 10000, true) == -1;
    assert pe_window_end_ms(-1, 10000, 22000, true) == -1;
    assert pe_window_end_ms(-1, 10000, 22001, true) == 10000;
    assert pe_window_end_ms(-7, 10000, 900000, true) == 10000;
    assert pe_window_end_ms(-1, 10000, 9000, true) == -1;
    // This Ponte's own window is never refreshed: open until its END, a minute on or for ever.
    assert pe_window_end_ms(-1, 10000, 22001, false) == -1;
    assert pe_window_end_ms(-1, 10000, 70000, false) == -1;
    assert pe_window_end_ms(-7, 10000, 900000, false) == -1;
    assert pe_window_end_ms(-1, i64_min, i64_max, false) == -1;
    // Every i64, no overflow.
    assert pe_window_end_ms(-1, i64_min, i64_max, true) == i64_min;
    assert pe_window_end_ms(-1, i64_max, i64_min, true) == -1;
    assert pe_window_end_ms(i64_min, 0, i64_max, true) == 0;
    assert pe_window_end_ms(i64_max, i64_min, i64_max, true) == i64_max;
    assert pe_window_end_ms(i64_max, i64_min, i64_max, false) == i64_max;
    assert pe_window_end_ms(-1, i64_max - 12000, i64_max, true) == -1;
    assert pe_window_end_ms(-1, i64_max - 12001, i64_max, true) == i64_max - 12001;
    // A stale window read by pe_is_peer_voice: another Ponte's own voice 20 s after its last START is no longer his.
    var closed_at: i64 = pe_window_end_ms(-1, 10000, 40000, true);
    assert closed_at == 10000;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 2, 0, 30000, 31000, 10000, closed_at) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 2, 0, 30000, 31000, 10000, -1) == true;
    // This Ponte's long TTS still playing 60 s on: its echo is still dropped.
    var own_end: i64 = pe_window_end_ms(-1, 10000, 70000, false);
    assert own_end == -1;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 2, 1000, 69000, 70000, 10000, own_end) == true;
}

test pe_containment_rules {
    // The recognizer heard the tail of a 25-word TTS: all of it is in what the peer said.
    assert pe_fixture_containment(PE_FX_HEARD_TAIL, PE_FX_TTS_CONTRACT) == 1000;
    assert pe_fixture_containment(PE_FX_TTS_CONTRACT, PE_FX_HEARD_TAIL) == 200;
    assert pe_fixture_containment(PE_FX_HEARD_TAIL_PT, PE_FX_TTS_CONTRACT_PT) == 1000;
    // Accents matter: "amanha" is not "amanha" with a tilde (o contrato de: 3 of 5).
    assert pe_fixture_containment(PE_FX_HEARD_TAIL, PE_FX_TTS_CONTRACT_PT) == 600;
    // The Brazilian's quick reply repeats the TTS question: 3 of 4 words.
    assert pe_fixture_containment(PE_FX_REPLY, PE_FX_TTS_QUESTION) == 750;
    assert pe_fixture_containment(PE_FX_TTS_QUESTION, PE_FX_REPLY) == 1000;
    // A two-word reply that repeats a price is wholly in the TTS.
    assert pe_fixture_containment(PE_FX_REPLY_PRICE, PE_FX_TTS_PRICE) == 1000;
    assert pe_fixture_containment(PE_FX_REPLY_SURE, PE_FX_TTS_QUESTION) == 0;
    // "Podemos" is not "podem": enviar o contrato, 3 of 5.
    assert pe_fixture_containment(PE_FX_PHRASE_SEND, PE_FX_TTS_SEND) == 600;
    // Order matters (a subsequence); a repeated word counts as often as both texts have it in order.
    assert pe_fixture_containment(PE_FX_ORDER_SWAPPED, PE_FX_ORDER) == 500;
    assert pe_fixture_containment(PE_FX_ORDER, PE_FX_ORDER) == 1000;
    assert pe_fixture_containment(PE_FX_SIM_THREE, PE_FX_SIM_ONE) == 333;
    assert pe_fixture_containment(PE_FX_SIM_ONE, PE_FX_SIM_THREE) == 1000;
    // Cyrillic capitals are not folded (ASCII only): kak dela, 2 of 3.
    assert pe_fixture_containment(PE_FX_RU_PRIVET_LOWER, PE_FX_RU_PRIVET) == 666;
    // No words in the phrase: 0; no words in what was said: 0.
    assert pe_fixture_containment(PE_FX_NO_WORDS, PE_FX_TTS_CONTRACT) == 0;
    assert pe_fixture_containment(PE_FX_EMPTY, PE_FX_EMPTY) == 0;
    assert pe_fixture_containment(PE_FX_HEARD_TAIL, PE_FX_NO_WORDS) == 0;
    assert pe_fixture_containment(PE_FX_HEARD_TAIL, PE_FX_EMPTY) == 0;
    // Every pair of fixtures: within 0..1000.
    var bad: u32 = 0;
    var x: i64 = 0;
    while (x < PE_FX_COUNT) {
        var y: i64 = 0;
        while (y < PE_FX_COUNT) {
            var c: i64 = pe_fixture_containment(x, y);
            if (c < 0 or c > PE_PERMILLE) { bad = bad + 1; }
            y = y + 1;
        }
        x = x + 1;
    }
    assert bad == 0;
    // 512 words are read: "A A A ..." (4096 bytes, 2048 words) against "a,a,..." (200 bytes, 100 words).
    var a: [4096]u8 = [0; 4096];
    var u: [4096]u8 = [0; 4096];
    var k: i64 = 0;
    while (k < 4096) {
        if (k % 2 == 0) { a[k] = 65; } else { a[k] = 32; }
        if (k % 2 == 0) { u[k] = 97; } else { u[k] = 44; }
        k = k + 1;
    }
    assert pe_containment_milli(a, 4096, u, 200) == 195;
    assert pe_containment_milli(u, 200, a, 4096) == 1000;
    assert pe_containment_milli(a, 9999, u, 9999) == 1000;
    assert pe_containment_milli(a, -5, u, 200) == 0;
    // Permille without overflow.
    var i64_max: i64 = 9223372036854775807;
    assert pe_permille_at_least(600, 1000, 600) == true;
    assert pe_permille_at_least(599, 1000, 600) == false;
    assert pe_permille_at_least(1, 1, 600) == true;
    assert pe_permille_at_least(0, 1, 600) == false;
    assert pe_permille_at_least(0, 1, 0) == true;
    assert pe_permille_at_least(1000, 1667, 600) == false;
    assert pe_permille_at_least(1000, 1666, 600) == true;
    assert pe_permille_at_least(i64_max, i64_max, 1000) == true;
    assert pe_permille_at_least(i64_max - 1, i64_max, 1000) == false;
    assert pe_permille_at_least(5534023222112865485, i64_max, 600) == true;
    assert pe_permille_at_least(5534023222112865484, i64_max, 600) == false;
    var bad_permille: u32 = 0;
    var w: i64 = 1;
    while (w < 2600) {
        var p: i64 = 0;
        while (p <= w) {
            var exact: bool = p * 1000 >= 600 * w;
            if (pe_permille_at_least(p, w, 600) != exact) { bad_permille = bad_permille + 1; }
            p = p + 13;
        }
        w = w + 1;
    }
    assert bad_permille == 0;
}

test pe_peer_voice_rules {
    // Another Ponte's own voice: window [10000, 12000] from 9700 to 12300; 60% of the phrase must lie in it.
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 10200, 12300, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 12300, 10200, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 12000, 13000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 11500, 12800, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 11000, 13166, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 11000, 13167, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 9, 1000, 9000, 10000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 9500, 10000, 10000, 12000) == true;
    // A phrase of no duration lasts 1 ms.
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 12299, 12299, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 12300, 12300, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 9699, 9699, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 9700, 9700, 10000, 12000) == true;
    // Open: no end.
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 9000, 9600, 10000, -1) == false;
    // This Ponte's own voice, sent back by a laptop next to the owner: the same window.
    assert pe_is_peer_voice(PE_VOICE_OWN, true, 0, 0, 10200, 12300, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, true, 0, 0, 10200, 12400, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, true, 9, 1000, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, true, 0, 0, 12100, 13000, 10000, 12000) == false;
    // TTS while it plays (the window and an 800 ms echo lag, from 9700 to 12800): any length, 800 contained.
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 1, 800, 12000, 13000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 800, 12000, 13000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 799, 12000, 13000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 0, 1000, 12000, 13000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 1000, 12500, 13500, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 1000, 12000, 13333, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 1000, 12000, 13334, 10000, 12000) == false;
    // Just after it (1500 ms past its end): three words or more, 800 contained.
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 3, 800, 12500, 13500, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 2, 1000, 12500, 13500, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 800, 13500, 14000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 899, 13501, 14000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 3, 799, 12500, 13500, 10000, 12000) == false;
    // Another Ponte's TTS up to 15 s after it: three words or more, 900 contained; never this Ponte's own.
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 900, 13501, 14000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 3, 1000, 13501, 14000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 900, 20000, 21000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 899, 20000, 21000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 2, 1000, 20000, 21000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 9, 1000, 20000, 21000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 1000, 27000, 28000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 3, 1000, 27001, 28000, 10000, 12000) == false;
    // Before the window.
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 1000, 5000, 9699, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 1000, 9699, 9699, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 1000, 9699, 9699, 10000, 12000) == false;
    // Open TTS windows.
    assert pe_is_peer_voice(PE_VOICE_TTS, true, 1, 800, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 799, 50000, 51000, 10000, -1) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 900, 5000, 9699, 10000, -1) == false;
    // Unknown kinds never.
    assert pe_is_peer_voice(0, false, 9, 1000, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice(3, false, 9, 1000, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice(-1, true, 9, 1000, 11000, 11500, 10000, -1) == false;
    // The edges of the domain (|t| < 2^62).
    var big: i64 = 4611686018427387903;
    var neg: i64 = 0 - 4611686018427387903;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, neg, big, neg, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, big, neg, neg, big) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, neg, big, big - 1000, -1) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, neg, big, neg, i64_min) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 800, neg, big, big, big) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 800, neg, big, big, big) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 1, 800, neg, big, neg, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 900, big, big, 0, 0) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, 9, 900, neg, neg, big, -1) == false;
    // Window end 0 is a closed window that ended at 0.
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 100, 200, 0, 0) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, 0, 0, 300, 400, 0, 0) == false;
}

test pe_phrase_drop_rules {
    // The review's cases (2026-10-14). This Ponte said "O preco e dez mil reais" into the call [10000, 12000]; the
    // Brazilian asked back "Dez mil?" 2 s later: all of it is in the TTS, but two words after the TTS are his own.
    var price: i64 = pe_fixture_containment(PE_FX_REPLY_PRICE, PE_FX_TTS_PRICE);
    var price_words: i64 = pe_fixture_words(PE_FX_REPLY_PRICE);
    assert price == 1000;
    assert price_words == 2;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, price_words, price, 14000, 14800, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, price_words, price, 14000, 14800, 10000, 12000) == false;
    // The same two words while the TTS plays are its echo.
    assert pe_is_peer_voice(PE_VOICE_TTS, true, price_words, price, 10500, 11500, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, price_words, price, 10500, 11500, 10000, 12000) == true;
    // "Sim, claro" right after the owner's own voice [10000, 11500] (its window already holds the 600 ms hangover).
    var sure_words: i64 = pe_fixture_words(PE_FX_REPLY_SURE);
    assert sure_words == 2;
    assert pe_is_peer_voice(PE_VOICE_OWN, false, sure_words, 0, 11900, 13200, 10000, 11500) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, true, sure_words, 0, 11900, 13200, 10000, 11500) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, true, sure_words, 0, 10200, 11400, 10000, 11500) == true;
    // Another Ponte's owner still speaking (open window): what is heard meanwhile is his.
    assert pe_is_peer_voice(PE_VOICE_OWN, false, sure_words, 0, 12000, 14000, 10000, -1) == true;
    // The quick reply that repeats the TTS question (750) is translated at any time.
    var reply: i64 = pe_fixture_containment(PE_FX_REPLY, PE_FX_TTS_QUESTION);
    var reply_words: i64 = pe_fixture_words(PE_FX_REPLY);
    assert reply == 750;
    assert reply_words == 4;
    var bad: u32 = 0;
    var at: i64 = 9000;
    while (at <= 30000) {
        if (pe_is_peer_voice(PE_VOICE_TTS, true, reply_words, reply, at, at + 1300, 10000, 11500)) { bad = bad + 1; }
        if (pe_is_peer_voice(PE_VOICE_TTS, false, reply_words, reply, at, at + 1300, 10000, 11500)) { bad = bad + 1; }
        if (pe_is_peer_voice(PE_VOICE_TTS, false, reply_words, reply, at, at + 1300, 10000, -1)) { bad = bad + 1; }
        at = at + 100;
    }
    assert bad == 0;
    // A five-word tail of a long TTS [10000, 17500], fully contained, right after it: the TTS.
    var tail: i64 = pe_fixture_containment(PE_FX_HEARD_TAIL, PE_FX_TTS_CONTRACT);
    var tail_words: i64 = pe_fixture_words(PE_FX_HEARD_TAIL);
    assert tail == 1000;
    assert tail_words == 5;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, tail_words, tail, 17800, 19000, 10000, 17500) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, false, tail_words, tail, 17800, 19000, 10000, 17500) == true;
    // Recognized 8 s later: another Ponte's TTS (the recognizer lags behind the call), not this Ponte's own echo.
    assert pe_is_peer_voice(PE_VOICE_TTS, false, tail_words, tail, 25000, 26500, 10000, 17500) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, true, tail_words, tail, 25000, 26500, 10000, 17500) == false;
    // This Ponte's own window is never refreshed: a minute on it is still open, and its echo still dropped.
    assert pe_window_end_ms(-1, 10000, 70000, false) == -1;
    assert pe_window_end_ms(-1, 10000, 70000, true) == 10000;
}

test pe_wire_rules {
    assert PE_FRAME_SAMPLES * 1000 == 16000 * PE_FRAME_MS;
    assert pe_frame_complete(21) == true;
    assert pe_frame_complete(20) == false;
    assert pe_voice_complete(10) == true;
    assert pe_voice_complete(9) == false;
    assert pe_audio_samples(1280) == 640;
    assert pe_audio_samples(1281) == 640;
    assert pe_audio_samples(0 - 2) == 0;
    assert pe_sample_to_int16(1.0) == 32767;
    assert pe_sample_to_int16(2.0) == 32767;
    assert pe_sample_to_int16(0.0 - 1.0) == 0 - 32767;
    assert pe_sample_to_int16(0.0 - 5.0) == 0 - 32767;
    assert pe_sample_to_int16(0.0) == 0;
    assert pe_sample_to_int16(0.5) == 16384;
    var t: [4096]u8 = [0; 4096];
    var k: i64 = 0;
    while (k < 4096) {
        t[k] = 97;
        k = k + 1;
    }
    assert pe_voice_text_bytes(t, 0 - 1) == 0;
    assert pe_voice_text_bytes(t, 12) == 12;
    assert pe_voice_text_bytes(t, 4000) == 4000;
    assert pe_voice_text_bytes(t, 4096) == 4000;
    // A two-byte character at 3999...4000: the cut falls inside it and moves before it.
    t[3999] = 208;
    t[4000] = 159;
    assert pe_voice_text_bytes(t, 4096) == 3999;
    // A three-byte character at 3998...4000.
    t[3998] = 226;
    t[3999] = 128;
    t[4000] = 148;
    assert pe_voice_text_bytes(t, 4096) == 3998;
    var row: [64]u8 = [0; 64];
    assert pe_row(PE_ROW_ROOM_SALT, row) == 13;
    assert pe_row(PE_ROW_KEY_SALT, row) == 12;
    assert pe_row(PE_ROW_COUNT, row) == 0;
    assert pe_note_fits(64) == true;
    assert pe_note_fits(65) == false;
    assert pe_members_valid(64) == true;
    assert pe_members_valid(0 - 1) == false;
    assert pe_failures_after_close(0, false) == 1;
    assert pe_failures_after_close(0, true) == PE_FAILED_AFTER;
    assert pe_failures_after_close(5, true) == 6;
    assert pe_failures_after_close(0 - 9, false) == 1;
    assert pe_failures_after_close(9223372036854775807, false) == 9223372036854775807;
    assert pe_frame_admitted(true, PE_MSG_AUDIO, 99) == true;
    assert pe_frame_admitted(false, PE_MSG_BYE, 99) == true;
    assert pe_frame_admitted(false, PE_MSG_HELLO, 0) == true;
    assert pe_frame_admitted(false, PE_MSG_HELLO, PE_MAX_PEERS - 1) == false;
    assert pe_answers_hello(true, PE_MSG_HELLO) == true;
    assert pe_answers_hello(true, PE_MSG_BYE) == false;
    assert pe_answers_hello(false, PE_MSG_AUDIO) == false;
    assert pe_tick_ms() == 5000;
    assert pe_link_up(PE_STATUS_LINKED) == true;
    assert pe_link_up(PE_STATUS_LINKED - 1) == false;
    assert pe_peer_speaking(0) == true;
    assert pe_peer_speaking(499) == true;
    assert pe_peer_speaking(500) == false;
    assert pe_peer_speaking(0 - 1) == false;
    assert pe_members_mismatch(3, 1) == true;
    assert pe_members_mismatch(2, 1) == false;
    assert pe_members_mismatch(0 - 1, 0) == false;
}

test pe_window_book_rules {
    assert pe_window_record(PE_VOICE_START, false, false) == PE_REC_OPEN;
    assert pe_window_record(PE_VOICE_START, true, true) == PE_REC_REFRESH;
    assert pe_window_record(PE_VOICE_START, true, false) == PE_REC_REPLACE;
    assert pe_window_record(PE_VOICE_END, true, false) == PE_REC_END;
    assert pe_window_record(PE_VOICE_END, false, true) == PE_REC_NONE;
    assert pe_window_record(7, true, true) == PE_REC_NONE;
    assert pe_window_forgotten(0 - 1, 999999) == false;
    assert pe_window_forgotten(1000, 21000) == false;
    assert pe_window_forgotten(1000, 21001) == true;
    assert pe_window_forgotten(0, 9223372036854775807) == true;
    assert pe_window_compares_text(PE_VOICE_TTS) == true;
    assert pe_window_compares_text(PE_VOICE_OWN) == false;
    assert pe_mic_gate_step(true, false) == PE_GATE_SEND;
    assert pe_mic_gate_step(true, true) == PE_GATE_SEND;
    assert pe_mic_gate_step(false, true) == PE_GATE_FLUSH;
    assert pe_mic_gate_step(false, false) == PE_GATE_NONE;
}

test pe_completion_rules {
    // With headphones a voice frame goes out, and the hangover keeps the end of a word.
    assert pe_mic_sends(true, false, true, false, true, 0) == true;
    assert pe_mic_sends(true, false, true, false, false, PE_VAD_HANGOVER_MS - 1) == true;
    assert pe_mic_sends(true, false, true, false, false, PE_VAD_HANGOVER_MS) == false;
    // Silence before any voice, room noise: nothing.
    assert pe_mic_sends(true, false, true, false, false, 0 - 1) == false;
    // Without headphones only with the talk key; muted or the link down: never, voice or not.
    assert pe_mic_sends(true, false, false, false, true, 0) == false;
    assert pe_mic_sends(true, false, false, true, true, 0) == true;
    assert pe_mic_sends(true, true, true, true, true, 0) == false;
    assert pe_mic_sends(false, false, true, true, true, 0) == false;
    // Every combination is the gate and the detector together.
    var bits: i64 = 0;
    var bad: u32 = 0;
    while (bits < 32) {
        var up: bool = (bits & 1) == 1;
        var mute: bool = (bits & 2) == 2;
        var phones: bool = (bits & 4) == 4;
        var key: bool = (bits & 8) == 8;
        var voice: bool = (bits & 16) == 16;
        var ms: i64 = 0 - 1;
        while (ms <= PE_VAD_HANGOVER_MS + 1) {
            var want: bool = pe_sends_mic(up, mute, phones, key) and pe_vad_sends(voice, ms);
            if (pe_mic_sends(up, mute, phones, key, voice, ms) != want) { bad = bad + 1; }
            ms = ms + 50;
        }
        bits = bits + 1;
    }
    assert bad == 0;
    // Admission: a frame of this link itself is never taken, fresh or not; another Ponte's only within the skew.
    var i64_max: i64 = 9223372036854775807;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    assert pe_frame_accepted(false, 1000, 1000) == true;
    assert pe_frame_accepted(true, 1000, 1000) == false;
    assert pe_frame_accepted(false, 0, PE_MAX_SKEW_MS) == true;
    assert pe_frame_accepted(false, 0, PE_MAX_SKEW_MS + 1) == false;
    assert pe_frame_accepted(false, PE_MAX_SKEW_MS, 0) == true;
    assert pe_frame_accepted(false, PE_MAX_SKEW_MS + 1, 0) == false;
    assert pe_frame_accepted(true, 0, PE_MAX_SKEW_MS) == false;
    assert pe_frame_accepted(true, 0, PE_MAX_SKEW_MS + 1) == false;
    assert pe_frame_accepted(false, i64_min, i64_max) == false;
    assert pe_frame_accepted(false, i64_max, i64_min) == false;
    assert pe_frame_accepted(false, i64_max, i64_max) == true;
    var sent: i64 = 0 - 40000;
    var wrong: u32 = 0;
    while (sent <= 40000) {
        if (pe_frame_accepted(false, sent, 0) != pe_frame_fresh(sent, 0)) { wrong = wrong + 1; }
        if (pe_frame_accepted(true, sent, 0)) { wrong = wrong + 1; }
        sent = sent + 250;
    }
    assert wrong == 0;
}
