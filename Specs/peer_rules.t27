; --- Link -----------------------------------------------------------------------------------------------------------
; Off when the link is off; linked when connected with peers; waiting when connected and alone; failed when
; not connected after PE_FAILED_AFTER failures in a row; else connecting.
pub fn pe_status(link_on: bool, connected: bool, peers: i64, failures: i64) -> i64 {
    if (link_on == false) { return PE_STATUS_OFF; }
    if (connected and peers > 0) { return PE_STATUS_LINKED; }
    if (connected and peers == 0) { return PE_STATUS_WAITING; }
    if (connected == false and failures >= PE_FAILED_AFTER) { return PE_STATUS_FAILED; }
    return PE_STATUS_CONNECTING;
}

; The wait before reconnect attempt `attempt` (0 is the first): doubles from PE_RECONNECT_FIRST_MS up to
; PE_RECONNECT_MAX_MS. A negative attempt waits PE_RECONNECT_FIRST_MS.
pub fn pe_reconnect_delay_ms(attempt: i64) -> i64 {
    var delay: i64 = PE_RECONNECT_FIRST_MS;
    var k: i64 = 0;
    while (k < attempt and delay < PE_RECONNECT_MAX_MS) {
        delay = delay * 2;
        k = k + 1;
    }
    if (delay > PE_RECONNECT_MAX_MS) { return PE_RECONNECT_MAX_MS; }
    return delay;
}

; A peer is alive when its last HELLO came less than PE_PEER_TIMEOUT_MS ago (a time in the future is not alive).
pub fn pe_peer_alive(ms_since_hello: i64) -> bool {
    return ms_since_hello >= 0 and ms_since_hello < PE_PEER_TIMEOUT_MS;
}

; --- The microphone to the peers ----------------------------------------------------------------------------------
; The microphone goes to the peers while the link is up and the owner did not mute it: always with headphones
; (nothing from the speakers reaches it), else only while the push-to-talk key is held.
pub fn pe_sends_mic(link_up: bool, muted: bool, headphones_like: bool, key_held: bool) -> bool {
    return link_up and muted == false and (headphones_like or key_held);
}

; A frame goes out when it has signal, or within PE_VAD_HANGOVER_MS after the last frame that had.
pub fn pe_vad_sends(has_signal: bool, ms_since_signal: i64) -> bool {
    return has_signal or (ms_since_signal >= 0 and ms_since_signal < PE_VAD_HANGOVER_MS);
}

; --- Jitter buffer --------------------------------------------------------------------------------------------------
; au_relay_action with the PE_JITTER_* constants. `filling` until the jitter buffer was first sent (and again
; after TRIM or REFILL); `pending_ms` is what the jitter buffer holds with the new frame; `queued_ms` is what
; the output still has to play (read only when `output_running`); `low_ms` is the lowest queued_ms of the
; current window (this one included) and `low_count` how many frames it has seen.
pub fn pe_jitter_action(filling: bool, pending_ms: f64, queued_ms: f64, output_running: bool, low_ms: f64, low_count: i64) -> i64 {
    if (output_running == false) {
        if (pending_ms > PE_JITTER_TARGET_MS) { return PE_JIT_TRIM; }
        return PE_JIT_KEEP;
    }
    if (filling) {
        if (pending_ms >= PE_JITTER_TARGET_MS) { return PE_JIT_SEND; }
        return PE_JIT_KEEP;
    }
    if (queued_ms <= 0.0) { return PE_JIT_REFILL; }
    if (queued_ms + pending_ms > PE_JITTER_MAX_MS) { return PE_JIT_DROP; }
    if (pe_jitter_window_ends(low_count) and low_ms > PE_JITTER_TARGET_MS + PE_JITTER_SLACK_MS) { return PE_JIT_DROP; }
    return PE_JIT_SEND;
}

; A window of PE_JITTER_WINDOW frames is complete (the buffer then starts a new one).
pub fn pe_jitter_window_ends(low_count: i64) -> bool {
    return low_count >= PE_JITTER_WINDOW;
}

; While trimming, the oldest frame goes as long as PE_JITTER_TARGET_MS stay without it.
pub fn pe_jitter_trims(pending_ms: f64, oldest_ms: f64) -> bool {
    return pending_ms - oldest_ms >= PE_JITTER_TARGET_MS;
}

; --- Words ------------------------------------------------------------------------------------------------------------
; A text length as read here: below 0 is 0, above PE_TEXT_MAX is PE_TEXT_MAX.
pub fn pe_text_len(len: i64) -> i64 {
    if (len < 0) { return 0; }
    if (len > PE_TEXT_MAX) { return PE_TEXT_MAX; }
    return len;
}

; ASCII A-Z to a-z; every other byte unchanged.
pub fn pe_fold(c: u8) -> u8 {
    if (c >= PE_UPPER_A and c <= PE_UPPER_Z) { return c + PE_CASE_STEP; }
    return c;
}

; A word byte: ASCII a-z or 0-9 after folding, or any byte from 0x80 (UTF-8 letters of every script).
pub fn pe_is_word_byte(c: u8) -> bool {
    var f: u8 = pe_fold(c);
    return (f >= PE_LOWER_A and f <= PE_LOWER_Z) or (f >= PE_DIGIT_0 and f <= PE_DIGIT_9) or c >= PE_FIRST_NON_ASCII;
}

; The words of a text (maximal runs of word bytes), the first PE_WORDS_MAX of them: their starts and lengths
; are written to starts and lens; returns how many.
pub fn pe_words(text: [4096]u8, len: i64, starts: [512]i64, lens: [512]i64) -> i64 {
    var n: i64 = pe_text_len(len);
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < n and count < PE_WORDS_MAX) {
        if (pe_is_word_byte(text[i])) {
            var s: i64 = i;
            while (i < n and pe_is_word_byte(text[i])) { i = i + 1; }
            starts[count] = s;
            lens[count] = i - s;
            count = count + 1;
        } else {
            i = i + 1;
        }
    }
    return count;
}

; Two words are the same when their folded bytes are.
pub fn pe_same_word(a: [4096]u8, a_start: i64, a_len: i64, b: [4096]u8, b_start: i64, b_len: i64) -> bool {
    if (a_len != b_len) { return false; }
    var k: i64 = 0;
    while (k < a_len) {
        if (pe_fold(a[a_start + k]) != pe_fold(b[b_start + k])) { return false; }
        k = k + 1;
    }
    return true;
}

; How alike two texts are: the Dice coefficient of their word multisets in thousandths,
; 2 * PE_SIMILARITY_SCALE * common / (words of a + words of b), rounded down. `common` counts each word as
; often as both texts have it (every word of a takes the first unused equal word of b). 0 when neither text
; has a word.
pub fn pe_word_similarity_milli(a: [4096]u8, a_len: i64, b: [4096]u8, b_len: i64) -> i64 {
    var a_starts: [512]i64 = [0; 512];
    var a_lens: [512]i64 = [0; 512];
    var b_starts: [512]i64 = [0; 512];
    var b_lens: [512]i64 = [0; 512];
    var used: [512]u8 = [0; 512];
    var na: i64 = pe_words(a, a_len, a_starts, a_lens);
    var nb: i64 = pe_words(b, b_len, b_starts, b_lens);
    if (na + nb == 0) { return 0; }
    var common: i64 = 0;
    var i: i64 = 0;
    while (i < na) {
        var j: i64 = 0;
        var found: bool = false;
        while (j < nb and found == false) {
            if (used[j] == 0 and pe_same_word(a, a_starts[i], a_lens[i], b, b_starts[j], b_lens[j])) {
                used[j] = 1;
                found = true;
                common = common + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return (2 * PE_SIMILARITY_SCALE * common) / (na + nb);
}

; --- Is a recognized phrase a peer's voice? ---------------------------------------------------------------------------
; A peer announced a voice window [window_start_ms, window_end_ms] (window_end_ms < 0: still playing, the end is
; open). The window widened by PE_WINDOW_BEFORE_MS before and PE_WINDOW_AFTER_MS after (open: no end) overlaps
; the phrase [phrase_start_ms, phrase_end_ms] when the phrase ends at or after its start and starts at or before
; its end.
; - The owner's own voice (PE_VOICE_OWN): a phrase that overlaps is the peer's.
; - TTS (PE_VOICE_TTS): a phrase that overlaps and is at least PE_SIMILARITY_MIN_MILLI alike to the TTS text;
;   or, at least PE_SIMILARITY_SURE_MILLI alike, a phrase that ends at or after the widened start and starts at
;   most PE_TEXT_WINDOW_MS after the window end (open: no end).
; - Any other kind: never.
pub fn pe_is_peer_voice(kind: i64, similarity_milli: i64, phrase_start_ms: i64, phrase_end_ms: i64, window_start_ms: i64, window_end_ms: i64) -> bool {
    var open: bool = window_end_ms < 0;
    var after_start: bool = phrase_end_ms >= window_start_ms - PE_WINDOW_BEFORE_MS;
    var overlap: bool = after_start and (open or phrase_start_ms <= window_end_ms + PE_WINDOW_AFTER_MS);
    if (kind == PE_VOICE_OWN) { return overlap; }
    if (kind == PE_VOICE_TTS) {
        if (overlap and similarity_milli >= PE_SIMILARITY_MIN_MILLI) { return true; }
        var in_text_window: bool = after_start and (open or phrase_start_ms <= window_end_ms + PE_TEXT_WINDOW_MS);
        return similarity_milli >= PE_SIMILARITY_SURE_MILLI and in_text_window;
    }
    return false;
}

; --- Google Meet code -------------------------------------------------------------------------------------------------
pub fn pe_is_letter(c: u8) -> bool {
    return (c >= PE_UPPER_A and c <= PE_UPPER_Z) or (c >= PE_LOWER_A and c <= PE_LOWER_Z);
}

; A Meet code starts at `at` of the first n bytes: three ASCII letters, a hyphen, four letters, a hyphen, three
; letters (either case), with no ASCII letter right before or right after.
pub fn pe_meet_code_matches(text: [4096]u8, n: i64, at: i64) -> bool {
    if (at < 0 or at + PE_MEET_CODE_LEN > n) { return false; }
    if (at > 0 and pe_is_letter(text[at - 1])) { return false; }
    if (at + PE_MEET_CODE_LEN < n and pe_is_letter(text[at + PE_MEET_CODE_LEN])) { return false; }
    var k: i64 = 0;
    while (k < PE_MEET_CODE_LEN) {
        var c: u8 = text[at + k];
        if (k == 3 or k == 8) {
            if (c != PE_HYPHEN) { return false; }
        } else {
            if (pe_is_letter(c) == false) { return false; }
        }
        k = k + 1;
    }
    return true;
}

; Where the first Meet code of a text starts; -1 when there is none.
pub fn pe_meet_code_at(text: [4096]u8, len: i64) -> i64 {
    var n: i64 = pe_text_len(len);
    var at: i64 = 0;
    while (at + PE_MEET_CODE_LEN <= n) {
        if (pe_meet_code_matches(text, n, at)) { return at; }
        at = at + 1;
    }
    return -1;
}

; The first Meet code of a text, lowercase, written to out: returns PE_MEET_CODE_LEN, or 0 when there is none.
pub fn pe_meet_code(text: [4096]u8, len: i64, out: [12]u8) -> i64 {
    var at: i64 = pe_meet_code_at(text, len);
    if (at < 0) { return 0; }
    var k: i64 = 0;
    while (k < PE_MEET_CODE_LEN) {
        out[k] = pe_fold(text[at + k]);
        k = k + 1;
    }
    return PE_MEET_CODE_LEN;
}

; --- Texts for the tests ------------------------------------------------------------------------------------------
; Copies text fixture `index` to out and returns its length (0 for an unknown index).
pub fn pe_fixture(index: i64, out: [4096]u8) -> i64 {
    if (index < 0 or index >= PE_FX_COUNT) { return 0; }
    var off: i64 = PE_FX_OFFSETS[index];
    var len: i64 = PE_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and k < PE_TEXT_MAX) {
        out[k] = PE_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; The similarity of fixtures `a` and `b`.
pub fn pe_fixture_similarity(a: i64, b: i64) -> i64 {
    var ta: [4096]u8 = [0; 4096];
    var tb: [4096]u8 = [0; 4096];
    var na: i64 = pe_fixture(a, ta);
    var nb: i64 = pe_fixture(b, tb);
    return pe_word_similarity_milli(ta, na, tb, nb);
}

; The Meet code of fixture `text` equals fixture `code`.
pub fn pe_fixture_meet_code_is(text: i64, code: i64) -> bool {
    var t: [4096]u8 = [0; 4096];
    var c: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var n: i64 = pe_fixture(text, t);
    var m: i64 = pe_fixture(code, c);
    if (pe_meet_code(t, n, out) != PE_MEET_CODE_LEN or m != PE_MEET_CODE_LEN) { return false; }
    var k: i64 = 0;
    while (k < PE_MEET_CODE_LEN) {
        if (out[k] != c[k]) { return false; }
        k = k + 1;
    }
    return true;
}

test pe_link_rules {
    // Status: off, linked, waiting, failed, connecting.
    assert pe_status(false, true, 2, 0) == PE_STATUS_OFF;
    assert pe_status(false, false, 0, 9) == PE_STATUS_OFF;
    assert pe_status(true, true, 1, 0) == PE_STATUS_LINKED;
    assert pe_status(true, true, 6, 5) == PE_STATUS_LINKED;
    assert pe_status(true, true, 0, 0) == PE_STATUS_WAITING;
    assert pe_status(true, true, 0, 7) == PE_STATUS_WAITING;
    assert pe_status(true, false, 0, 0) == PE_STATUS_CONNECTING;
    assert pe_status(true, false, 3, 2) == PE_STATUS_CONNECTING;
    assert pe_status(true, false, 0, 3) == PE_STATUS_FAILED;
    assert pe_status(true, false, 2, 10) == PE_STATUS_FAILED;
    // Reconnect delays.
    assert pe_reconnect_delay_ms(-7) == 500;
    assert pe_reconnect_delay_ms(-1) == 500;
    assert pe_reconnect_delay_ms(0) == 500;
    assert pe_reconnect_delay_ms(1) == 1000;
    assert pe_reconnect_delay_ms(2) == 2000;
    assert pe_reconnect_delay_ms(3) == 4000;
    assert pe_reconnect_delay_ms(4) == 8000;
    assert pe_reconnect_delay_ms(5) == 8000;
    assert pe_reconnect_delay_ms(1000000) == 8000;
    // Peers time out after three missed HELLOs.
    assert PE_PEER_TIMEOUT_MS == 3 * PE_HELLO_EVERY_MS;
    assert pe_peer_alive(0) == true;
    assert pe_peer_alive(14999) == true;
    assert pe_peer_alive(15000) == false;
    assert pe_peer_alive(-1) == false;
    // The microphone: headphones open it, the speakers only with the key held; muted or no link never.
    var bad: u32 = 0;
    var bits: i32 = 0;
    while (bits < 16) {
        var up: bool = (bits & 1) != 0;
        var muted: bool = (bits & 2) != 0;
        var phones: bool = (bits & 4) != 0;
        var key: bool = (bits & 8) != 0;
        var expected: bool = false;
        if (up and muted == false) {
            if (phones) { expected = true; }
            if (key) { expected = true; }
        }
        if (pe_sends_mic(up, muted, phones, key) != expected) { bad = bad + 1; }
        bits = bits + 1;
    }
    assert bad == 0;
    assert pe_sends_mic(true, false, false, true) == true;
    assert pe_sends_mic(true, false, false, false) == false;
    // The voice gate and its hangover.
    assert pe_vad_sends(true, -5) == true;
    assert pe_vad_sends(false, 0) == true;
    assert pe_vad_sends(false, 599) == true;
    assert pe_vad_sends(false, 600) == false;
    assert pe_vad_sends(false, -1) == false;
    // Frames: 40 ms of 16 kHz are 640 samples.
    assert PE_SAMPLE_RATE * 40.0 / 1000.0 == 640.0;
}

test pe_jitter_rules {
    // The codes are the own-voice relay's (AU_RLA_KEEP..AU_RLA_REFILL are 0..4).
    assert PE_JIT_KEEP == 0;
    assert PE_JIT_SEND == 1;
    assert PE_JIT_DROP == 2;
    assert PE_JIT_TRIM == 3;
    assert PE_JIT_REFILL == 4;
    assert pe_jitter_action(true, 80.0, 0.0, true, 0.0, 0) == PE_JIT_KEEP;
    assert pe_jitter_action(true, 120.0, 0.0, true, 0.0, 0) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 120.0, true, 120.0, 1) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 360.0, true, 100.0, 10) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 361.0, true, 100.0, 10) == PE_JIT_DROP;
    assert pe_jitter_action(false, 40.0, 0.0, true, 0.0, 3) == PE_JIT_REFILL;
    assert pe_jitter_action(false, 40.0, -5.0, true, -5.0, 3) == PE_JIT_REFILL;
    assert pe_jitter_action(false, 120.0, 0.0, false, 0.0, 0) == PE_JIT_KEEP;
    assert pe_jitter_action(true, 160.0, 0.0, false, 0.0, 0) == PE_JIT_TRIM;
    assert pe_jitter_action(false, 40.0, 200.0, true, 160.1, 50) == PE_JIT_DROP;
    assert pe_jitter_action(false, 40.0, 200.0, true, 160.0, 50) == PE_JIT_SEND;
    assert pe_jitter_action(false, 40.0, 200.0, true, 170.0, 49) == PE_JIT_SEND;
    assert pe_jitter_window_ends(49) == false;
    assert pe_jitter_window_ends(50) == true;
    assert pe_jitter_trims(160.0, 40.0) == true;
    assert pe_jitter_trims(159.0, 40.0) == false;
    // A steady 40 ms stream into an output that plays 40 ms per frame: one fill, then only sends, and the
    // output never holds more than the maximum.
    var filling: bool = true;
    var pending: f64 = 0.0;
    var queued: f64 = 0.0;
    var sends: i64 = 0;
    var other: i64 = 0;
    var low: f64 = 1000000.0;
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < 1000) {
        pending = pending + 40.0;
        if (filling == false) {
            if (queued < low) { low = queued; }
            count = count + 1;
        }
        var a: i64 = pe_jitter_action(filling, pending, queued, true, low, count);
        if (pe_jitter_window_ends(count)) {
            low = 1000000.0;
            count = 0;
        }
        if (a == PE_JIT_SEND) {
            queued = queued + pending;
            pending = 0.0;
            filling = false;
            sends = sends + 1;
        } else {
            if (a != PE_JIT_KEEP) { other = other + 1; }
        }
        if (queued > PE_JITTER_MAX_MS) { other = other + 1; }
        if (filling == false) { queued = queued - 40.0; }
        i = i + 1;
    }
    assert other == 0;
    assert sends == 998;
    // After a burst left 300 ms in the output: one frame per window goes until the queue is near the target.
    queued = 300.0;
    low = 1000000.0;
    count = 0;
    var drops: i64 = 0;
    i = 0;
    while (i < 1000) {
        pending = 40.0;
        if (queued < low) { low = queued; }
        count = count + 1;
        var b: i64 = pe_jitter_action(false, pending, queued, true, low, count);
        if (pe_jitter_window_ends(count)) {
            low = 1000000.0;
            count = 0;
        }
        if (b == PE_JIT_SEND) { queued = queued + pending; }
        if (b == PE_JIT_DROP) { drops = drops + 1; }
        queued = queued - 40.0;
        i = i + 1;
    }
    assert drops == 4;
    assert queued == 140.0;
}

test pe_similarity_rules {
    // The TTS text against what the recognizer heard: punctuation and case do not matter.
    assert pe_fixture_similarity(PE_FX_TTS_OI, PE_FX_HEARD_OI) == 1000;
    assert pe_fixture_similarity(PE_FX_TTS_OI_PT, PE_FX_HEARD_OI_PT) == 1000;
    // Accents do: "voce" is not "voce" with a circumflex (2 common of 4 + 4 words).
    assert pe_fixture_similarity(PE_FX_TTS_OI, PE_FX_HEARD_OI_PT) == 500;
    // 4 common of 6 + 4 words.
    assert pe_fixture_similarity(PE_FX_TTS_BOM_DIA, PE_FX_HEARD_BOM_DIA) == 800;
    assert pe_fixture_similarity(PE_FX_HEARD_BOM_DIA, PE_FX_TTS_BOM_DIA) == 800;
    assert pe_fixture_similarity(PE_FX_TTS_THANKS, PE_FX_HEARD_PRICE) == 0;
    // Cyrillic capitals are not folded: 2 of 3 + 3 words.
    assert pe_fixture_similarity(PE_FX_RU_PRIVET, PE_FX_RU_PRIVET_LOWER) == 666;
    // Multisets: sim x3, nao and sim, nao x2 share sim once and nao once.
    assert pe_fixture_similarity(PE_FX_SIM_THREE, PE_FX_NAO_TWO) == 571;
    assert pe_fixture_similarity(PE_FX_DIGITS, PE_FX_DIGITS_HEARD) == 750;
    // No words.
    assert pe_fixture_similarity(PE_FX_PUNCTUATION, PE_FX_EMPTY) == 0;
    assert pe_fixture_similarity(PE_FX_EMPTY, PE_FX_EMPTY) == 0;
    assert pe_fixture_similarity(PE_FX_PUNCTUATION, PE_FX_TTS_OI) == 0;
    // Every pair of fixtures: symmetric, within 0..1000, 1000 against itself when it has words.
    var bad: u32 = 0;
    var x: i64 = 0;
    while (x < PE_FX_COUNT) {
        var y: i64 = 0;
        while (y < PE_FX_COUNT) {
            var s: i64 = pe_fixture_similarity(x, y);
            if (s != pe_fixture_similarity(y, x)) { bad = bad + 1; }
            if (s < 0 or s > PE_SIMILARITY_SCALE) { bad = bad + 1; }
            y = y + 1;
        }
        var self_s: i64 = pe_fixture_similarity(x, x);
        if (self_s != 0 and self_s != PE_SIMILARITY_SCALE) { bad = bad + 1; }
        x = x + 1;
    }
    assert bad == 0;
    // Words: case folded, every byte from 0x80 is a word byte, the first 512 words count, 4096 bytes are read.
    var t: [4096]u8 = [0; 4096];
    var u: [4096]u8 = [0; 4096];
    var starts: [512]i64 = [0; 512];
    var lens: [512]i64 = [0; 512];
    var k: i64 = 0;
    while (k < 4096) {
        if (k % 2 == 0) { t[k] = 65; } else { t[k] = 32; }
        if (k % 2 == 0) { u[k] = 97; } else { u[k] = 44; }
        k = k + 1;
    }
    assert pe_words(t, 4096, starts, lens) == 512;
    assert starts[511] == 1022;
    assert lens[511] == 1;
    assert pe_words(t, 9999, starts, lens) == 512;
    assert pe_words(t, -3, starts, lens) == 0;
    assert pe_words(t, 5, starts, lens) == 3;
    assert pe_word_similarity_milli(t, 4096, u, 4096) == 1000;
    // 512 words of "a" against 100: 100 common of 612.
    assert pe_word_similarity_milli(t, 4096, u, 200) == 326;
    t[0] = 195;
    t[1] = 169;
    t[2] = 32;
    assert pe_words(t, 3, starts, lens) == 1;
    assert lens[0] == 2;
    assert pe_is_word_byte(128) == true;
    assert pe_is_word_byte(255) == true;
    assert pe_is_word_byte(45) == false;
    assert pe_is_word_byte(95) == false;
    var b: u32 = 0;
    var word_bytes: u32 = 0;
    while (b < 256) {
        if (pe_is_word_byte(cast_u8(b))) { word_bytes = word_bytes + 1; }
        b = b + 1;
    }
    assert word_bytes == 128 + 26 + 26 + 10;
}

test pe_peer_voice_rules {
    // Own voice: the window widened by 300 ms before and 1500 ms after.
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 11000, 11500, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 9500, 9700, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 9000, 9699, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 13500, 14000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 13501, 14000, 10000, 12000) == false;
    // Still playing: no end.
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, 400, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, 349, 50000, 51000, 10000, -1) == false;
    // TTS inside the window needs some likeness; a sure match counts up to 15 s after the window.
    assert pe_is_peer_voice(PE_VOICE_TTS, 350, 11000, 11500, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, 349, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, 1000, 20000, 21000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, 700, 27000, 28000, 10000, 12000) == true;
    assert pe_is_peer_voice(PE_VOICE_TTS, 699, 20000, 21000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, 1000, 27001, 28000, 10000, 12000) == false;
    assert pe_is_peer_voice(PE_VOICE_TTS, 1000, 5000, 9699, 10000, 12000) == false;
    // The TTS sentence and what the recognizer heard, inside the window.
    var s: i64 = pe_fixture_similarity(PE_FX_TTS_OI, PE_FX_HEARD_OI);
    assert pe_is_peer_voice(PE_VOICE_TTS, s, 10200, 11800, 10000, 11500) == true;
    // Unknown kinds never.
    assert pe_is_peer_voice(0, 1000, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice(3, 1000, 11000, 11500, 10000, 12000) == false;
    // Window end 0 is a closed window that ended at 0.
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 1500, 1600, 0, 0) == true;
    assert pe_is_peer_voice(PE_VOICE_OWN, 0, 1501, 1600, 0, 0) == false;
}

test pe_meet_code_rules {
    var t: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var n: i64 = pe_fixture(PE_FX_MEET_TITLE, t);
    assert pe_meet_code_at(t, n) == 7;
    assert pe_fixture_meet_code_is(PE_FX_MEET_TITLE, PE_FX_MEET_CODE) == true;
    n = pe_fixture(PE_FX_MEET_TITLE_BROWSEROS, t);
    assert pe_meet_code_at(t, n) == 9;
    assert pe_fixture_meet_code_is(PE_FX_MEET_TITLE_BROWSEROS, PE_FX_MEET_CODE) == true;
    n = pe_fixture(PE_FX_MEET_URL, t);
    assert pe_meet_code_at(t, n) == 24;
    assert pe_fixture_meet_code_is(PE_FX_MEET_URL, PE_FX_MEET_URL_CODE) == true;
    // A letter right before or after is not a code; a digit is fine.
    n = pe_fixture(PE_FX_MEET_LETTER_BEFORE, t);
    assert pe_meet_code_at(t, n) == -1;
    assert pe_meet_code(t, n, out) == 0;
    n = pe_fixture(PE_FX_MEET_LETTER_AFTER, t);
    assert pe_meet_code_at(t, n) == -1;
    n = pe_fixture(PE_FX_MEET_DIGIT_AFTER, t);
    assert pe_meet_code_at(t, n) == 0;
    assert pe_fixture_meet_code_is(PE_FX_MEET_DIGIT_AFTER, PE_FX_MEET_URL_CODE) == true;
    n = pe_fixture(PE_FX_MEET_SHORT, t);
    assert pe_meet_code_at(t, n) == -1;
    // The first of two, lowercased.
    assert pe_fixture_meet_code_is(PE_FX_MEET_TWO, PE_FX_MEET_TWO_CODE) == true;
    // Cyrillic neighbours are not ASCII letters; an accented letter inside is not a code letter.
    n = pe_fixture(PE_FX_MEET_CYRILLIC, t);
    assert pe_meet_code_at(t, n) == 2;
    assert pe_fixture_meet_code_is(PE_FX_MEET_CYRILLIC, PE_FX_MEET_URL_CODE) == true;
    n = pe_fixture(PE_FX_MEET_ACCENT, t);
    assert pe_meet_code_at(t, n) == -1;
    // Only the first 4096 bytes are read; the end of the read text is no neighbour.
    var k: i64 = 0;
    while (k < 4096) {
        t[k] = 32;
        k = k + 1;
    }
    k = 0;
    while (k < 12) {
        t[4084 + k] = 97;
        k = k + 1;
    }
    t[4087] = PE_HYPHEN;
    t[4092] = PE_HYPHEN;
    assert pe_meet_code_at(t, 4096) == 4084;
    assert pe_meet_code_at(t, 9000) == 4084;
    assert pe_meet_code_at(t, 4095) == -1;
    assert pe_meet_code_at(t, 0) == -1;
    assert pe_meet_code_at(t, -1) == -1;
    assert pe_meet_code_matches(t, 4096, -1) == false;
    assert pe_is_letter(64) == false;
    assert pe_is_letter(91) == false;
    assert pe_is_letter(96) == false;
    assert pe_is_letter(123) == false;
    assert pe_is_letter(65) == true;
    assert pe_is_letter(122) == true;
}
