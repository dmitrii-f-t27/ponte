// SPDX-License-Identifier: MIT
; Specs/peer_rules.t27 -- Ponte: two Russians in one call hear each other without translation
; Owner's request 2026-10-13: two Russians and a Portuguese speaker are in one Google Meet call, and each Russian runs
; Ponte. The two Pontes connect through an end-to-end encrypted WebSocket relay and send each other the owner's live
; Russian voice (16 kHz mono Int16 frames of PE_FRAME_MS), so the Russians hear each other directly. The room and the
; key of the link come from a secret code only the Russians share (PBKDF2 of PE_KDF_ITERATIONS on the Swift side),
; never from the Meet code: the Portuguese speaker has that one too. Each Ponte announces when its Portuguese speech
; (the TTS of a translated phrase, or the owner's own voice "Svoi golos") plays into the call, so the OTHER Ponte does
; not translate that Portuguese voice back into Russian; and each Ponte keeps the same windows of its own voice, so it
; does not translate its own TTS when the far side echoes it back.
; This spec decides: the secret code (its alphabet, the normalized code, how it is shown); the link status, the
; reconnect delays and when a connection counts as stable; a full room and when to try it again; when a peer is alive;
; when a frame is fresh and new; when a peer's voice event happened on this Mac's clock; when the microphone goes to
; the peers (open with headphones, else only while the push-to-talk key is held, so the speakers never echo back)
; and the voice gate with its hangover; the jitter buffer of a peer's voice (the same algorithm and codes as the
; own-voice relay au_relay_action in audio_rules.t27, with deeper constants for the network); voice windows kept alive
; and when they end; the words of a recognized phrase and how much of it is in what a Ponte said (containment); and
; whether a recognized Portuguese phrase is a Ponte's voice.
; Version 3 (owner 2026-10-14): the rules the app no longer calls are gone (word similarity, the first peer-voice rule,
; the Meet code, the browser tab list); short Brazilian replies that repeat a word of a TTS are kept, a phrase after
; the owner's own voice is matched only 300 ms past its end, and this Ponte's own windows end only by their END.
; Text is UTF-8 bytes in a buffer of PE_TEXT_MAX bytes with its length (a longer length is read as PE_TEXT_MAX).
; Times are milliseconds on one clock, within +-2^62 (no overflow) where a rule does not take any i64. ASCII only.
; Facade: PontePeer/PeerRules.swift. Oracle: Tests/PonteTests/Oracles/PeerRulesLegacy.swift.
; Generated C: Sources/PonteSpecs/peer_rules.h (Specs/generate.sh).

module PontePeerRules;

; --- Audio between Pontes -----------------------------------------------------------------------------------------
; 16 kHz mono Int16: enough for speech, about 256 kbit/s per peer before compression.
pub const PE_SAMPLE_RATE : f64 = 16000.0;
; One frame on the wire: 40 ms (640 samples).
pub const PE_FRAME_MS : i64 = 40;
; The most Pontes in one room besides this one.
pub const PE_MAX_PEERS : i64 = 6;

; --- Messages (MSG_*, the first byte of a relay message) ----------------------------------------------------------
; I am here (sent every PE_HELLO_EVERY_MS); a voice frame; a voice window starts or ends; I am leaving.
pub const PE_MSG_HELLO : u8 = 1;
pub const PE_MSG_AUDIO : u8 = 2;
pub const PE_MSG_VOICE : u8 = 3;
pub const PE_MSG_BYE : u8 = 4;
; A voice window is the Portuguese TTS of a translated phrase or the owner's own voice; it starts or ends.
pub const PE_VOICE_TTS : i64 = 1;
pub const PE_VOICE_OWN : i64 = 2;
pub const PE_VOICE_START : i64 = 1;
pub const PE_VOICE_END : i64 = 2;

; --- Link status (STATUS_*) ---------------------------------------------------------------------------------------
pub const PE_STATUS_OFF : i64 = 0;
pub const PE_STATUS_CONNECTING : i64 = 1;
; Connected to the relay, nobody else in the room yet.
pub const PE_STATUS_WAITING : i64 = 2;
pub const PE_STATUS_LINKED : i64 = 3;
; Not connected after this many failed attempts in a row.
pub const PE_STATUS_FAILED : i64 = 4;
pub const PE_FAILED_AFTER : i64 = 3;
; Reconnect delays: 500, 1000, 2000, 4000 ms, then 8000 ms.
pub const PE_RECONNECT_FIRST_MS : i64 = 500;
pub const PE_RECONNECT_MAX_MS : i64 = 8000;
; A HELLO every 5 s; a peer silent for 15 s (three HELLOs missed) is gone.
pub const PE_HELLO_EVERY_MS : i64 = 5000;
pub const PE_PEER_TIMEOUT_MS : i64 = 15000;
; The failure count (pe_status, pe_reconnect_delay_ms) goes back to 0 only after the socket stayed open this long or
; a frame arrived, so a relay that accepts and drops at once still backs off.
pub const PE_STABLE_MS : i64 = 3000;
; The relay closes the socket with this code when the room is full.
pub const PE_CLOSE_ROOM_FULL : i64 = 4001;
; A full room may still count a member whose Mac slept or changed network: the relay drops such a socket within two
; of its pings (20 s). So after a full room the link tries again this much later, and shows the room as full meanwhile.
pub const PE_ROOM_FULL_RETRY_MS : i64 = 15000;

; --- The microphone to the peers ----------------------------------------------------------------------------------
; Frames keep going this long after the last frame with signal (word ends and short pauses are not cut).
pub const PE_VAD_HANGOVER_MS : i64 = 600;
; Backpressure on a slow uplink (review 2026-10-14): at most this many audio frames handed to the socket and not yet
; sent; a newer frame is dropped instead of letting the voice fall behind (6 frames = 240 ms).
pub const PE_MAX_AUDIO_IN_FLIGHT : i64 = 6;

; --- Jitter buffer of a peer's voice (as au_relay_action, deeper for the network) ----------------------------------
pub const PE_JITTER_TARGET_MS : f64 = 120.0;
pub const PE_JITTER_MAX_MS : f64 = 400.0;
pub const PE_JITTER_SLACK_MS : f64 = 40.0;
pub const PE_JITTER_WINDOW : i64 = 50;
; Jitter actions (JIT_*), equal to AU_RLA_* (audio_rules.t27): keep the frame; schedule everything kept; drop
; this frame; keep only the newest PE_JITTER_TARGET_MS; fill the jitter buffer again (the output ran dry).
pub const PE_JIT_KEEP : i64 = 0;
pub const PE_JIT_SEND : i64 = 1;
pub const PE_JIT_DROP : i64 = 2;
pub const PE_JIT_TRIM : i64 = 3;
pub const PE_JIT_REFILL : i64 = 4;

; --- Secret code shared only among the Russians ---------------------------------------------------------------------
; The Meet code is no link secret: the Portuguese speaker sees it too. One Russian makes a secret code and tells it to
; the others outside the call; the Pontes derive the room and the link key from it. A code is PE_SECRET_LENGTH bytes of
; PE_SECRET_ALPHABET (the digits 2-9 and the lowercase ASCII letters without i, l and o: no 0 1 i l o, which are
; misread for one another), shown in groups of PE_SECRET_GROUP joined by '-': abcd-efgh-jkmn.
pub const PE_SECRET_LENGTH : i64 = 12;
pub const PE_SECRET_GROUP : i64 = 4;
; abcd-efgh-jkmn: 12 bytes and 2 hyphens.
pub const PE_SECRET_DISPLAY_LEN : i64 = 14;
; The Swift side derives the room and the link key from the normalized code with PBKDF2-HMAC-SHA256 of this many
; iterations.
pub const PE_KDF_ITERATIONS : i64 = 200000;

; --- Frame freshness and replay ---------------------------------------------------------------------------------------
; Every frame carries the sender's clock (ms) and a sequence number. A frame more than PE_MAX_SKEW_MS away from this
; Ponte's clock is stale (a replay, or a clock far off); a sequence number not above the last one taken is a replay.
pub const PE_MAX_SKEW_MS : i64 = 30000;

; --- Voice windows ----------------------------------------------------------------------------------------------------
; Another Ponte speaking into the call announces a voice window (START, then END). A lost END would leave the window
; open for ever, so a sender re-sends START every PE_VOICE_REFRESH_MS for every voice still playing, and a window not
; refreshed for more than PE_VOICE_STALE_MS (two refreshes lost and a margin) ends where it was last seen.
pub const PE_VOICE_REFRESH_MS : i64 = 5000;
pub const PE_VOICE_STALE_MS : i64 = 12000;
; Ended windows are kept this long, then forgotten.
pub const PE_WINDOW_KEEP_MS : i64 = 20000;

; --- A Ponte's voice in the call --------------------------------------------------------------------------------------
pub const PE_TEXT_MAX : i64 = 4096;
; At most this many words of a text are counted.
pub const PE_WORDS_MAX : i64 = 512;
; Thousandths: a share of 1000.
pub const PE_PERMILLE : i64 = 1000;
; A recognized phrase is matched against a voice window widened by 300 ms before (the recognizer's phrase start is
; early). After a TTS window, a phrase of at least PE_MIN_WORDS words that starts up to 1500 ms after its end (the
; recognizer's phrase end is late) is the TTS with PE_CONTAIN_MIN_MILLI; another Ponte's, up to 15 s after it (the
; recognizer can lag), with PE_CONTAIN_SURE_MILLI.
pub const PE_WINDOW_BEFORE_MS : i64 = 300;
pub const PE_WINDOW_AFTER_MS : i64 = 1500;
pub const PE_TEXT_WINDOW_MS : i64 = 15000;
; How much of a recognized phrase must be in what a Ponte said (pe_containment_milli) for a TTS match; the sure one
; for a match long after the window.
pub const PE_CONTAIN_MIN_MILLI : i64 = 800;
pub const PE_CONTAIN_SURE_MILLI : i64 = 900;
; A phrase lies in a window when at least this share (thousandths) of its time does: the owner's own voice, and a TTS
; while it plays.
pub const PE_OWN_OVERLAP_PERMILLE : i64 = 600;
; Only a phrase of at least this many words is matched to a TTS by its words alone after the TTS ended: a short reply
; ("Sim", "Dez mil?") repeats a word of the TTS by nature.
pub const PE_MIN_WORDS : i64 = 3;
; The owner's own voice window already ends PE_VAD_HANGOVER_MS after his last word; a phrase is matched to it only
; this much past its end, so the Brazilian's quick reply right after it is translated.
pub const PE_OWN_AFTER_MS : i64 = 300;
; A TTS reaches this Ponte's recognizer through the call at most this late: a phrase that mostly lies in the TTS window
; widened by it is the TTS still playing, whatever its length.
pub const PE_ECHO_LAG_MS : i64 = 800;

; --- Bytes ----------------------------------------------------------------------------------------------------------
pub const PE_HYPHEN : u8 = 45;
pub const PE_DIGIT_0 : u8 = 48;
pub const PE_DIGIT_9 : u8 = 57;
pub const PE_UPPER_A : u8 = 65;
pub const PE_UPPER_Z : u8 = 90;
pub const PE_LOWER_A : u8 = 97;
pub const PE_LOWER_Z : u8 = 122;
pub const PE_CASE_STEP : u8 = 32;
pub const PE_FIRST_NON_ASCII : u8 = 128;
; Typed or pasted between the groups of a secret code and dropped: the ASCII space, '-' (PE_HYPHEN) and '_'.
pub const PE_SPACE : u8 = 32;
pub const PE_UNDERSCORE : u8 = 95;

; >>> generated by Specs/tables/peer_tables.py -- edit the lists there, not here
