pub const PE_FX2_OFFSETS : [27]u32 = [0, 140, 166, 311, 339, 365, 387, 419, 454, 464, 474, 485, 489, 498, 498, 512, 524, 538, 552, 570, 582, 596, 609, 624, 638, 652, 667];
pub const PE_FX2_LENGTHS : [27]u32 = [140, 26, 145, 28, 26, 22, 32, 35, 10, 10, 11, 4, 9, 0, 14, 12, 14, 14, 18, 12, 14, 13, 15, 14, 14, 15, 12];
; <<< generated

; A byte of the secret code's alphabet.
pub fn pe_in_secret_alphabet(c: u8) -> bool {
    var k: i64 = 0;
    while (k < PE_SECRET_ALPHABET_LEN) {
        if (PE_SECRET_ALPHABET[k] == c) { return true; }
        k = k + 1;
    }
    return false;
}

; The secret code's alphabet, written to out: returns PE_SECRET_ALPHABET_LEN.
pub fn pe_secret_alphabet(out: [64]u8) -> i64 {
    var k: i64 = 0;
    while (k < PE_SECRET_ALPHABET_LEN) {
        out[k] = PE_SECRET_ALPHABET[k];
        k = k + 1;
    }
    return PE_SECRET_ALPHABET_LEN;
}

; A typed or pasted secret code, normalized: the first PE_TEXT_MAX bytes are read; ASCII A-Z is folded to a-z;
; every PE_SPACE, PE_HYPHEN and PE_UNDERSCORE is dropped; what stays must be exactly PE_SECRET_LENGTH bytes, every one
; in PE_SECRET_ALPHABET. Writes them to out and returns PE_SECRET_LENGTH; returns 0 when the text is no code (any
; other byte, a tab or a non-ASCII letter among them; too few or too many code bytes).
pub fn pe_secret_normalized(text: [4096]u8, len: i64, out: [12]u8) -> i64 {
    var n: i64 = pe_text_len(len);
    var count: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var c: u8 = pe_fold(text[i]);
        if (c != PE_SPACE and c != PE_HYPHEN and c != PE_UNDERSCORE) {
            if (count >= PE_SECRET_LENGTH) { return 0; }
            if (pe_in_secret_alphabet(c) == false) { return 0; }
            out[count] = c;
            count = count + 1;
        }
        i = i + 1;
    }
    if (count != PE_SECRET_LENGTH) { return 0; }
    return count;
}

; A normalized secret code as shown: groups of PE_SECRET_GROUP bytes joined by PE_HYPHEN, written to out; returns
; PE_SECRET_DISPLAY_LEN. A text that is not exactly PE_SECRET_LENGTH alphabet bytes is shown unchanged: returns 0.
pub fn pe_secret_display(text: [4096]u8, len: i64, out: [16]u8) -> i64 {
    if (len != PE_SECRET_LENGTH) { return 0; }
    var k: i64 = 0;
    while (k < PE_SECRET_LENGTH) {
        if (pe_in_secret_alphabet(text[k]) == false) { return 0; }
        k = k + 1;
    }
    var at: i64 = 0;
    k = 0;
    while (k < PE_SECRET_LENGTH) {
        if (k > 0 and k % PE_SECRET_GROUP == 0) {
            out[at] = PE_HYPHEN;
            at = at + 1;
        }
        out[at] = text[k];
        at = at + 1;
        k = k + 1;
    }
    return at;
}

; --- Frame freshness and replay ---------------------------------------------------------------------------------------
; Every frame carries the sender's clock (ms) and a sequence number. A frame more than PE_MAX_SKEW_MS away from this
; Ponte's clock is stale (a replay, or a clock far off); a sequence number not above the last one taken is a replay.
pub const PE_MAX_SKEW_MS : i64 = 30000;

; hi - lo > limit, exactly, for every i64 hi and lo and 0 <= limit <= 2^62 (no overflow): with hi and lo of one sign
; the difference fits; with lo < 0 <= hi it is hi + |lo|, larger than limit when either part is.
pub fn pe_gap_over(hi: i64, lo: i64, limit: i64) -> bool {
    if (hi <= lo) { return false; }
    if (lo >= 0 or hi < 0) { return hi - lo > limit; }
    if (hi > limit) { return true; }
    if (lo < 0 - limit) { return true; }
    return hi - lo > limit;
}

; A frame sent at sent_ms is fresh at now_ms when |now_ms - sent_ms| <= PE_MAX_SKEW_MS (any i64 times).
pub fn pe_frame_fresh(sent_ms: i64, now_ms: i64) -> bool {
    return pe_gap_over(now_ms, sent_ms, PE_MAX_SKEW_MS) == false and pe_gap_over(sent_ms, now_ms, PE_MAX_SKEW_MS) == false;
}

; A frame's sequence number is new when no frame of that peer was taken yet, or it is above the last one taken.
pub fn pe_seq_newer(seq: u32, last_seq: u32, has_last: bool) -> bool {
    return has_last == false or seq > last_seq;
}

; --- Peers and connection -------------------------------------------------------------------------------------------
; A new peer is accepted while this Ponte knows 0 to PE_MAX_PEERS - 2 peers (fewer than PE_MAX_PEERS - 1).
pub fn pe_accepts_new_peer(known_peers: i64) -> bool {
    return known_peers >= 0 and known_peers < PE_MAX_PEERS - 1;
}

; The relay closes the socket with this code when the room is full: reconnecting would only fill it again.
pub const PE_CLOSE_ROOM_FULL : i64 = 4001;

; After the relay closed the socket with `close_code`, the link reconnects unless the room was full.
pub fn pe_reconnects(close_code: i64) -> bool {
    return close_code != PE_CLOSE_ROOM_FULL;
}

; The failure count (pe_status, pe_reconnect_delay_ms) goes back to 0 only after the socket stayed open this long or
; a frame arrived, so a relay that accepts and drops at once still backs off.
pub const PE_STABLE_MS : i64 = 3000;

; --- Voice windows with keepalive -----------------------------------------------------------------------------------
; Another Ponte speaking into the call announces a voice window (START, then END). A lost END would leave the window
; open for ever, so a sender re-sends START every PE_VOICE_REFRESH_MS for every voice still playing, and a window not
; refreshed for more than PE_VOICE_STALE_MS (two refreshes lost and a margin) ends where it was last seen.
pub const PE_VOICE_REFRESH_MS : i64 = 5000;
pub const PE_VOICE_STALE_MS : i64 = 12000;

; Where a voice window ends, as pe_is_peer_voice_v2 reads it: its announced end when it has one (end_ms >= 0); else
; last_seen_ms (its last START) when that is more than PE_VOICE_STALE_MS before now_ms; else -1 (still open).
; Any i64 times (no overflow).
pub fn pe_window_end_ms(end_ms: i64, last_seen_ms: i64, now_ms: i64) -> i64 {
    if (end_ms >= 0) { return end_ms; }
    if (pe_gap_over(now_ms, last_seen_ms, PE_VOICE_STALE_MS)) { return last_seen_ms; }
    return -1;
}

; --- Containment instead of symmetric similarity ----------------------------------------------------------------------
; The Dice coefficient (pe_word_similarity_milli) also calls a short reply of the Brazilian a peer's voice when it
; repeats the TTS's words: "Sim, podemos comecar agora" against "Podemos comecar agora?" is 857 alike. Containment
; asks the other way round: how much of the recognized phrase, in order, is in what the peer said.
; Thousandths: a share of 1000.
pub const PE_PERMILLE : i64 = 1000;
; A phrase overlapping a TTS window counts as the peer's with at least this containment; up to PE_TEXT_WINDOW_MS after
; the window, with the sure one.
pub const PE_CONTAIN_MIN_MILLI : i64 = 800;
pub const PE_CONTAIN_SURE_MILLI : i64 = 900;
; A phrase is the peer's own voice when at least this share (thousandths) of its time lies in the widened window.
pub const PE_OWN_OVERLAP_PERMILLE : i64 = 600;

; How much of `phrase` is in `said`, 0...1000: the words as in pe_word_similarity_milli (the first PE_TEXT_MAX bytes
; and PE_WORDS_MAX words of each; ASCII case folded; a word is a run of ASCII letters and digits or of bytes from
; 0x80); L is the length of the longest common subsequence of the two word sequences (equal words: equal folded
; bytes); the result is PE_PERMILLE * L / (words of phrase), rounded down; 0 when the phrase has no word.
pub fn pe_containment_milli(phrase: [4096]u8, phrase_len: i64, said: [4096]u8, said_len: i64) -> i64 {
    var p_starts: [512]i64 = [0; 512];
    var p_lens: [512]i64 = [0; 512];
    var s_starts: [512]i64 = [0; 512];
    var s_lens: [512]i64 = [0; 512];
    var np: i64 = pe_words(phrase, phrase_len, p_starts, p_lens);
    var ns: i64 = pe_words(said, said_len, s_starts, s_lens);
    if (np == 0) { return 0; }
    var prev: [513]i64 = [0; 513];
    var row: [513]i64 = [0; 513];
    var i: i64 = 0;
    while (i < np) {
        row[0] = 0;
        var j: i64 = 0;
        while (j < ns) {
            if (pe_same_word(phrase, p_starts[i], p_lens[i], said, s_starts[j], s_lens[j])) {
                row[j + 1] = prev[j] + 1;
            } else {
                if (prev[j + 1] >= row[j]) {
                    row[j + 1] = prev[j + 1];
                } else {
                    row[j + 1] = row[j];
                }
            }
            j = j + 1;
        }
        j = 0;
        while (j <= ns) {
            prev[j] = row[j];
            j = j + 1;
        }
        i = i + 1;
    }
    return (PE_PERMILLE * prev[ns]) / np;
}

; part * PE_PERMILLE >= permille * whole, exactly, for 0 <= part, 1 <= whole and 0 <= permille <= PE_PERMILLE (no
; overflow): with whole = PE_PERMILLE * q + r, it is (part - permille * q) * PE_PERMILLE >= permille * r.
pub fn pe_permille_at_least(part: i64, whole: i64, permille: i64) -> bool {
    var q: i64 = whole / PE_PERMILLE;
    var r: i64 = whole % PE_PERMILLE;
    var rest: i64 = part - permille * q;
    return rest >= (permille * r + PE_PERMILLE - 1) / PE_PERMILLE;
}

; Whether the recognized phrase [phrase_start_ms, phrase_end_ms] (either order) is a peer's voice announced as `kind`
; in the window [window_start_ms, window_end_ms] (window_end_ms < 0: still open), `containment_milli` being how much
; of the phrase is in what the peer said (pe_containment_milli).
; The phrase starts at the earlier time and lasts duration = max(1, |phrase_end_ms - phrase_start_ms|); it ends at
; start + duration. The window widened is [window_start_ms - PE_WINDOW_BEFORE_MS, window_end_ms + PE_WINDOW_AFTER_MS]
; (open: no end).
; - The owner's own voice (PE_VOICE_OWN): at least PE_OWN_OVERLAP_PERMILLE of the phrase's duration lies in the
;   widened window.
; - TTS (PE_VOICE_TTS): the phrase meets the widened window (ends at or after its start, starts at or before its end)
;   with at least PE_CONTAIN_MIN_MILLI; or, with at least PE_CONTAIN_SURE_MILLI, it ends at or after the widened start
;   and starts at most PE_TEXT_WINDOW_MS after window_end_ms (open: no end).
; - Any other kind: never.
; Times t with |t| < 2^62 (no overflow); containment_milli and kind are only compared.
pub fn pe_is_peer_voice_v2(kind: i64, containment_milli: i64, phrase_start_ms: i64, phrase_end_ms: i64, window_start_ms: i64, window_end_ms: i64) -> bool {
    var p_start: i64 = phrase_start_ms;
    var p_last: i64 = phrase_end_ms;
    if (phrase_end_ms < phrase_start_ms) {
        p_start = phrase_end_ms;
        p_last = phrase_start_ms;
    }
    var duration: i64 = p_last - p_start;
    if (duration < 1) { duration = 1; }
    var p_end: i64 = p_start + duration;
    var open: bool = window_end_ms < 0;
    var w_from: i64 = window_start_ms - PE_WINDOW_BEFORE_MS;
    var w_until: i64 = p_end;
    if (open == false) { w_until = window_end_ms + PE_WINDOW_AFTER_MS; }
    if (kind == PE_VOICE_OWN) {
        var lo: i64 = p_start;
        if (w_from > lo) { lo = w_from; }
        var hi: i64 = p_end;
        if (w_until < hi) { hi = w_until; }
        var overlap: i64 = 0;
        if (hi > lo) { overlap = hi - lo; }
        return pe_permille_at_least(overlap, duration, PE_OWN_OVERLAP_PERMILLE);
    }
    if (kind == PE_VOICE_TTS) {
        var meets: bool = p_end >= w_from and (open or p_start <= w_until);
        if (meets and containment_milli >= PE_CONTAIN_MIN_MILLI) { return true; }
        var in_text_window: bool = p_end >= w_from and (open or p_start <= window_end_ms + PE_TEXT_WINDOW_MS);
        return containment_milli >= PE_CONTAIN_SURE_MILLI and in_text_window;
    }
    return false;
}

; --- Texts for the tests of version 2 -------------------------------------------------------------------------------
; Copies version 2 text fixture `index` to out and returns its length (0 for an unknown index).
pub fn pe_fixture2(index: i64, out: [4096]u8) -> i64 {
    if (index < 0 or index >= PE_FX2_COUNT) { return 0; }
    var off: i64 = PE_FX2_OFFSETS[index];
    var len: i64 = PE_FX2_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and k < PE_TEXT_MAX) {
        out[k] = PE_FX2_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; How much of fixture `phrase` is in fixture `said`.
pub fn pe_fixture2_containment(phrase: i64, said: i64) -> i64 {
    var tp: [4096]u8 = [0; 4096];
    var ts: [4096]u8 = [0; 4096];
    var np: i64 = pe_fixture2(phrase, tp);
    var ns: i64 = pe_fixture2(said, ts);
    return pe_containment_milli(tp, np, ts, ns);
}

; The word similarity of fixtures `a` and `b` (the rule containment replaces, for comparison).
pub fn pe_fixture2_similarity(a: i64, b: i64) -> i64 {
    var ta: [4096]u8 = [0; 4096];
    var tb: [4096]u8 = [0; 4096];
    var na: i64 = pe_fixture2(a, ta);
    var nb: i64 = pe_fixture2(b, tb);
    return pe_word_similarity_milli(ta, na, tb, nb);
}

; Fixture `text` normalizes to fixture `expected` (expected < 0: to no code).
pub fn pe_fixture2_secret_is(text: i64, expected: i64) -> bool {
    var t: [4096]u8 = [0; 4096];
    var e: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var n: i64 = pe_fixture2(text, t);
    var got: i64 = pe_secret_normalized(t, n, out);
    if (expected < 0) { return got == 0; }
    var m: i64 = pe_fixture2(expected, e);
    if (got != m) { return false; }
    var k: i64 = 0;
    while (k < m) {
        if (out[k] != e[k]) { return false; }
        k = k + 1;
    }
    return true;
}

; Fixture `text` is shown as fixture `expected` (expected < 0: unchanged).
pub fn pe_fixture2_display_is(text: i64, expected: i64) -> bool {
    var t: [4096]u8 = [0; 4096];
    var e: [4096]u8 = [0; 4096];
    var out: [16]u8 = [0; 16];
    var n: i64 = pe_fixture2(text, t);
    var got: i64 = pe_secret_display(t, n, out);
    if (expected < 0) { return got == 0; }
    var m: i64 = pe_fixture2(expected, e);
    if (got != m) { return false; }
    var k: i64 = 0;
    while (k < m) {
        if (out[k] != e[k]) { return false; }
        k = k + 1;
    }
    return true;
}

test pe_secret_rules {
    assert PE_SECRET_ALPHABET_LEN == 31;
    assert PE_SECRET_DISPLAY_LEN == PE_SECRET_LENGTH + (PE_SECRET_LENGTH - 1) / PE_SECRET_GROUP;
    assert PE_KDF_ITERATIONS == 200000;
    // The alphabet: 31 of the 256 bytes, ascending, without 0 1 i l o; uppercase only after folding.
    var in_alphabet: u32 = 0;
    var bad: u32 = 0;
    var b: u32 = 0;
    while (b < 256) {
        if (pe_in_secret_alphabet(cast_u8(b))) { in_alphabet = in_alphabet + 1; }
        b = b + 1;
    }
    assert in_alphabet == 31;
    var k: i64 = 1;
    while (k < PE_SECRET_ALPHABET_LEN) {
        if (PE_SECRET_ALPHABET[k - 1] >= PE_SECRET_ALPHABET[k]) { bad = bad + 1; }
        k = k + 1;
    }
    assert bad == 0;
    assert pe_in_secret_alphabet(48) == false;
    assert pe_in_secret_alphabet(49) == false;
    assert pe_in_secret_alphabet(105) == false;
    assert pe_in_secret_alphabet(108) == false;
    assert pe_in_secret_alphabet(111) == false;
    assert pe_in_secret_alphabet(50) == true;
    assert pe_in_secret_alphabet(57) == true;
    assert pe_in_secret_alphabet(97) == true;
    assert pe_in_secret_alphabet(122) == true;
    assert pe_in_secret_alphabet(65) == false;
    var alphabet: [64]u8 = [0; 64];
    assert pe_secret_alphabet(alphabet) == 31;
    assert alphabet[0] == 50;
    assert alphabet[30] == 122;
    // Typed and pasted codes.
    assert pe_fixture2_secret_is(PE_FX2_SECRET_TYPED, PE_FX2_SECRET) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_DISPLAY, PE_FX2_SECRET) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET, PE_FX2_SECRET) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_UPPER, PE_FX2_SECRET) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_UNDERSCORES, PE_FX2_SECRET_UNDERSCORES_NORMALIZED) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_ZERO, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_SHORT, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_LONG, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_WITH_I, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_TABS, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_SECRET_ACCENT, -1) == true;
    assert pe_fixture2_secret_is(PE_FX2_EMPTY, -1) == true;
    // Shown in groups; anything but a normalized code is shown unchanged.
    assert pe_fixture2_display_is(PE_FX2_SECRET, PE_FX2_SECRET_DISPLAY) == true;
    assert pe_fixture2_display_is(PE_FX2_SECRET_UNDERSCORES_NORMALIZED, PE_FX2_SECRET_UNDERSCORES_DISPLAY) == true;
    assert pe_fixture2_display_is(PE_FX2_SECRET_UPPER, -1) == true;
    assert pe_fixture2_display_is(PE_FX2_SECRET_DISPLAY, -1) == true;
    assert pe_fixture2_display_is(PE_FX2_SECRET_TYPED, -1) == true;
    assert pe_fixture2_display_is(PE_FX2_EMPTY, -1) == true;
    // Only the first 4096 bytes are read: a code that ends past them is cut; a longer length reads 4096.
    var t: [4096]u8 = [0; 4096];
    var out: [12]u8 = [0; 12];
    var shown: [16]u8 = [0; 16];
    k = 0;
    while (k < 4096) {
        t[k] = PE_SPACE;
        k = k + 1;
    }
    k = 0;
    while (k < 12) {
        t[4084 + k] = PE_SECRET_ALPHABET[k];
        k = k + 1;
    }
    assert pe_secret_normalized(t, 4096, out) == 12;
    assert out[0] == 50;
    assert out[11] == 100;
    assert pe_secret_normalized(t, 9999, out) == 12;
    assert pe_secret_normalized(t, 4095, out) == 0;
    assert pe_secret_normalized(t, -1, out) == 0;
    t[4083] = 66;
    assert pe_secret_normalized(t, 4096, out) == 0;
    t[4083] = 95;
    t[0] = 45;
    assert pe_secret_normalized(t, 4096, out) == 12;
    assert pe_secret_display(t, 4096, shown) == 0;
}

test pe_freshness_rules {
    var i64_max: i64 = 9223372036854775807;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    assert pe_frame_fresh(0, 0) == true;
    assert pe_frame_fresh(0, 30000) == true;
    assert pe_frame_fresh(0, 30001) == false;
    assert pe_frame_fresh(0, -30000) == true;
    assert pe_frame_fresh(0, -30001) == false;
    assert pe_frame_fresh(30000, 0) == true;
    assert pe_frame_fresh(-30001, 0) == false;
    assert pe_frame_fresh(-15000, 15000) == true;
    assert pe_frame_fresh(-15000, 15001) == false;
    assert pe_frame_fresh(15001, -15000) == false;
    assert pe_frame_fresh(1760000000000, 1760000029999) == true;
    assert pe_frame_fresh(1760000000000, 1759999969999) == false;
    // Every i64, no overflow.
    assert pe_frame_fresh(i64_min, i64_max) == false;
    assert pe_frame_fresh(i64_max, i64_min) == false;
    assert pe_frame_fresh(i64_max, i64_max) == true;
    assert pe_frame_fresh(i64_min, i64_min) == true;
    assert pe_frame_fresh(i64_max - 30000, i64_max) == true;
    assert pe_frame_fresh(i64_max - 30001, i64_max) == false;
    assert pe_frame_fresh(i64_min, i64_min + 30000) == true;
    assert pe_frame_fresh(i64_min + 30001, i64_min) == false;
    assert pe_frame_fresh(-1, i64_max) == false;
    assert pe_frame_fresh(0, i64_min) == false;
    assert pe_frame_fresh(i64_min, 0) == false;
    assert pe_frame_fresh(-30000, 0) == true;
    // The gap rule against plain arithmetic on small times.
    var bad: u32 = 0;
    var d: i64 = -40000;
    while (d <= 40000) {
        var expect: bool = d <= 30000 and d >= -30000;
        if (pe_frame_fresh(0, d) != expect) { bad = bad + 1; }
        if (pe_frame_fresh(d, 0) != expect) { bad = bad + 1; }
        if (pe_frame_fresh(d - 20000, -20000) != expect) { bad = bad + 1; }
        var over: bool = d > 12000;
        if (pe_gap_over(d, 0, 12000) != over) { bad = bad + 1; }
        var under: bool = 0 - d > 12000;
        if (pe_gap_over(0, d, 12000) != under) { bad = bad + 1; }
        d = d + 7;
    }
    assert bad == 0;
    assert pe_gap_over(i64_max, i64_min, 0) == true;
    assert pe_gap_over(i64_min, i64_max, 0) == false;
    assert pe_gap_over(5, -7, 12) == false;
    assert pe_gap_over(5, -8, 12) == true;
    // Sequence numbers.
    var top: u32 = 4294967295;
    var zero: u32 = 0;
    assert pe_seq_newer(5, 4, true) == true;
    assert pe_seq_newer(4, 4, true) == false;
    assert pe_seq_newer(3, 4, true) == false;
    assert pe_seq_newer(zero, top, false) == true;
    assert pe_seq_newer(zero, zero, false) == true;
    assert pe_seq_newer(zero, zero, true) == false;
    assert pe_seq_newer(top, top - 1, true) == true;
    assert pe_seq_newer(top, top, true) == false;
    assert pe_seq_newer(zero, top, true) == false;
}

test pe_room_rules {
    assert pe_accepts_new_peer(-1) == false;
    assert pe_accepts_new_peer(0) == true;
    assert pe_accepts_new_peer(4) == true;
    assert pe_accepts_new_peer(5) == false;
    assert pe_accepts_new_peer(6) == false;
    assert pe_accepts_new_peer(9223372036854775807) == false;
    var accepted: i64 = 0;
    var n: i64 = -10;
    while (n < 100) {
        if (pe_accepts_new_peer(n)) { accepted = accepted + 1; }
        n = n + 1;
    }
    assert accepted == PE_MAX_PEERS - 1;
    assert pe_reconnects(PE_CLOSE_ROOM_FULL) == false;
    assert pe_reconnects(4001) == false;
    assert pe_reconnects(1000) == true;
    assert pe_reconnects(1006) == true;
    assert pe_reconnects(4000) == true;
    assert pe_reconnects(4002) == true;
    assert pe_reconnects(-4001) == true;
    // Stable after 3 s: longer than the first reconnect wait, shorter than a HELLO period.
    assert PE_STABLE_MS == 3000;
    assert PE_STABLE_MS > PE_RECONNECT_FIRST_MS;
    assert PE_STABLE_MS < PE_HELLO_EVERY_MS;
}

test pe_voice_window_rules {
    var i64_max: i64 = 9223372036854775807;
    var i64_min: i64 = 0 - 9223372036854775807 - 1;
    // Two refreshes may be lost before a window goes stale.
    assert PE_VOICE_STALE_MS > 2 * PE_VOICE_REFRESH_MS;
    assert PE_VOICE_STALE_MS < PE_WINDOW_KEEP_MS;
    // An announced end is the end.
    assert pe_window_end_ms(15000, 10000, 99999) == 15000;
    assert pe_window_end_ms(0, 5, 99999) == 0;
    assert pe_window_end_ms(15000, 10000, 0) == 15000;
    // Open while refreshed; stale more than 12 s after the last START: it ends there.
    assert pe_window_end_ms(-1, 10000, 10000) == -1;
    assert pe_window_end_ms(-1, 10000, 22000) == -1;
    assert pe_window_end_ms(-1, 10000, 22001) == 10000;
    assert pe_window_end_ms(-7, 10000, 900000) == 10000;
    assert pe_window_end_ms(-1, 10000, 9000) == -1;
    // Every i64, no overflow.
    assert pe_window_end_ms(-1, i64_min, i64_max) == i64_min;
    assert pe_window_end_ms(-1, i64_max, i64_min) == -1;
    assert pe_window_end_ms(i64_min, 0, i64_max) == 0;
    assert pe_window_end_ms(i64_max, i64_min, i64_max) == i64_max;
    assert pe_window_end_ms(-1, i64_max - 12000, i64_max) == -1;
    assert pe_window_end_ms(-1, i64_max - 12001, i64_max) == i64_max - 12001;
    // A stale window read by pe_is_peer_voice_v2: own voice 20 s after its last START is no longer the peer's.
    var closed_at: i64 = pe_window_end_ms(-1, 10000, 40000);
    assert closed_at == 10000;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 30000, 31000, 10000, closed_at) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 30000, 31000, 10000, -1) == true;
}

test pe_containment_rules {
    // The recognizer heard the tail of a 25-word TTS: all of it is in what the peer said.
    assert pe_fixture2_containment(PE_FX2_HEARD_TAIL, PE_FX2_TTS_CONTRACT) == 1000;
    assert pe_fixture2_containment(PE_FX2_TTS_CONTRACT, PE_FX2_HEARD_TAIL) == 200;
    assert pe_fixture2_containment(PE_FX2_HEARD_TAIL_PT, PE_FX2_TTS_CONTRACT_PT) == 1000;
    // Accents matter: "amanha" is not "amanha" with a tilde (o contrato de: 3 of 5).
    assert pe_fixture2_containment(PE_FX2_HEARD_TAIL, PE_FX2_TTS_CONTRACT_PT) == 600;
    // The Brazilian's quick reply repeats the TTS question: 3 of 4 words, where the Dice coefficient says 857.
    assert pe_fixture2_containment(PE_FX2_REPLY, PE_FX2_TTS_QUESTION) == 750;
    assert pe_fixture2_similarity(PE_FX2_REPLY, PE_FX2_TTS_QUESTION) == 857;
    assert pe_fixture2_containment(PE_FX2_TTS_QUESTION, PE_FX2_REPLY) == 1000;
    // "Podemos" is not "podem": enviar o contrato, 3 of 5.
    assert pe_fixture2_containment(PE_FX2_PHRASE_SEND, PE_FX2_TTS_SEND) == 600;
    // Order matters (a subsequence); a repeated word counts as often as both texts have it in order.
    assert pe_fixture2_containment(PE_FX2_ORDER_SWAPPED, PE_FX2_ORDER) == 500;
    assert pe_fixture2_containment(PE_FX2_ORDER, PE_FX2_ORDER) == 1000;
    assert pe_fixture2_containment(PE_FX2_SIM_THREE, PE_FX2_SIM_ONE) == 333;
    assert pe_fixture2_containment(PE_FX2_SIM_ONE, PE_FX2_SIM_THREE) == 1000;
    // No words in the phrase: 0; no words in what was said: 0.
    assert pe_fixture2_containment(PE_FX2_NO_WORDS, PE_FX2_TTS_CONTRACT) == 0;
    assert pe_fixture2_containment(PE_FX2_EMPTY, PE_FX2_EMPTY) == 0;
    assert pe_fixture2_containment(PE_FX2_HEARD_TAIL, PE_FX2_NO_WORDS) == 0;
    assert pe_fixture2_containment(PE_FX2_HEARD_TAIL, PE_FX2_EMPTY) == 0;
    // Every pair of fixtures: within 0..1000, 1000 against itself when it has words.
    var bad: u32 = 0;
    var x: i64 = 0;
    while (x < PE_FX2_COUNT) {
        var y: i64 = 0;
        while (y < PE_FX2_COUNT) {
            var c: i64 = pe_fixture2_containment(x, y);
            if (c < 0 or c > PE_PERMILLE) { bad = bad + 1; }
            y = y + 1;
        }
        var self_c: i64 = pe_fixture2_containment(x, x);
        var t: [4096]u8 = [0; 4096];
        var starts: [512]i64 = [0; 512];
        var lens: [512]i64 = [0; 512];
        var n: i64 = pe_fixture2(x, t);
        var word_count: i64 = pe_words(t, n, starts, lens);
        if (word_count == 0 and self_c != 0) { bad = bad + 1; }
        if (word_count > 0 and self_c != PE_PERMILLE) { bad = bad + 1; }
        x = x + 1;
    }
    assert bad == 0;
    // 512 words are read: "A A A ..." (4096 bytes, 2048 words) against "a,a,..." (200 bytes, 100 words).
    var a: [4096]u8 = [0; 4096];
    var u: [4096]u8 = [0; 4096];
    var k: i64 = 0;
    while (k < 4096) {
        if (k % 2 == 0) { a[k] = 65; } else { a[k] = 32; }
        if (k % 2 == 0) { u[k] = 97; } else { u[k] = 44; }
        k = k + 1;
    }
    assert pe_containment_milli(a, 4096, u, 200) == 195;
    assert pe_containment_milli(u, 200, a, 4096) == 1000;
    assert pe_containment_milli(a, 9999, u, 9999) == 1000;
    assert pe_containment_milli(a, -5, u, 200) == 0;
    // Permille without overflow.
    var i64_max: i64 = 9223372036854775807;
    assert pe_permille_at_least(600, 1000, 600) == true;
    assert pe_permille_at_least(599, 1000, 600) == false;
    assert pe_permille_at_least(1, 1, 600) == true;
    assert pe_permille_at_least(0, 1, 600) == false;
    assert pe_permille_at_least(0, 1, 0) == true;
    assert pe_permille_at_least(1000, 1667, 600) == false;
    assert pe_permille_at_least(1000, 1666, 600) == true;
    assert pe_permille_at_least(i64_max, i64_max, 1000) == true;
    assert pe_permille_at_least(i64_max - 1, i64_max, 1000) == false;
    assert pe_permille_at_least(5534023222112865485, i64_max, 600) == true;
    assert pe_permille_at_least(5534023222112865484, i64_max, 600) == false;
    var bad_permille: u32 = 0;
    var w: i64 = 1;
    while (w < 2600) {
        var p: i64 = 0;
        while (p <= w) {
            var exact: bool = p * 1000 >= 600 * w;
            if (pe_permille_at_least(p, w, 600) != exact) { bad_permille = bad_permille + 1; }
            p = p + 13;
        }
        w = w + 1;
    }
    assert bad_permille == 0;
}

test pe_peer_voice_v2_rules {
    // Own voice: window [10000, 12000], widened to [9700, 13500]; 60% of the phrase must lie in it.
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 10200, 12400, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 12400, 10200, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 12500, 16000, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 12500, 14000, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 12500, 14166, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 12500, 14167, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 1000, 9000, 10000, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 9500, 10000, 10000, 12000) == true;
    // A phrase of no duration lasts 1 ms.
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 13499, 13499, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 13500, 13500, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 9699, 9699, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 9700, 9700, 10000, 12000) == true;
    // Open: no end.
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 9000, 9600, 10000, -1) == false;
    // TTS: the Brazilian's reply (750) 500 ms after the window is kept; 800 inside counts; 900 counts 15 s on.
    var reply: i64 = pe_fixture2_containment(PE_FX2_REPLY, PE_FX2_TTS_QUESTION);
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, reply, 12500, 13800, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 800, 12500, 13800, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 799, 12500, 13800, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 800, 13500, 14000, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 800, 13501, 14000, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 900, 20000, 21000, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 899, 20000, 21000, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 1000, 27000, 28000, 10000, 12000) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 1000, 27001, 28000, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 1000, 5000, 9699, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 1000, 9699, 9699, 10000, 12000) == true;
    // The recognized tail of a TTS, while it still plays and after.
    var tail: i64 = pe_fixture2_containment(PE_FX2_HEARD_TAIL, PE_FX2_TTS_CONTRACT);
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, tail, 16000, 18000, 10000, -1) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, tail, 16000, 18000, 10000, 17500) == true;
    var send: i64 = pe_fixture2_containment(PE_FX2_PHRASE_SEND, PE_FX2_TTS_SEND);
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, send, 11000, 12000, 10000, -1) == false;
    // Open TTS windows.
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 800, 50000, 51000, 10000, -1) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 799, 50000, 51000, 10000, -1) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 900, 5000, 9699, 10000, -1) == false;
    // Unknown kinds never.
    assert pe_is_peer_voice_v2(0, 1000, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(3, 1000, 11000, 11500, 10000, 12000) == false;
    assert pe_is_peer_voice_v2(-1, 1000, 11000, 11500, 10000, -1) == false;
    // The edges of the domain (|t| < 2^62).
    var big: i64 = 4611686018427387903;
    var neg: i64 = 0 - 4611686018427387903;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, neg, big, neg, -1) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, big, neg, neg, big) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, neg, big, big - 1000, -1) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 800, neg, big, big, big) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 900, big, big, 0, 0) == false;
    assert pe_is_peer_voice_v2(PE_VOICE_TTS, 900, neg, neg, big, -1) == false;
    // Window end 0 is a closed window that ended at 0.
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 1000, 1500, 0, 0) == true;
    assert pe_is_peer_voice_v2(PE_VOICE_OWN, 0, 1500, 1600, 0, 0) == false;
}
