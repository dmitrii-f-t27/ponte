; Specs/transcript_rules.t27 -- Ponte: the call transcript file name and Markdown escaping, by bytes
; Mirrors the transcript parts of PonteApp/AppRules.swift one to one: transcriptFileName (with
; appendDigits), markdownEscape and isMarkdownSpecial (same constants and order of checks). Byte
; buffers hold TR_BUFFER bytes. Callers cut a phrase to TR_MD_ESCAPE_MAX_INPUT bytes at a character
; boundary before escaping, so the escaped text always fits; a longer length is read as that limit.
; Swift keeps the Markdown layout and its Russian texts. ASCII only.
; Generated C: Sources/PonteSpecs/transcript_rules.h (Specs/generate.sh).

module PonteTranscriptRules;

pub const TR_BUFFER : i64 = 4096;
; MD_ESCAPE_MAX_INPUT: escaping at most doubles the bytes, so 2048 in fits 4096 out.
pub const TR_MD_ESCAPE_MAX_INPUT : i64 = 2048;
; A file name for attempt 2 and later gets "-N" so an existing file is never overwritten.
pub const TR_FIRST_NUMBERED_ATTEMPT : i32 = 2;

; --- Bytes -----------------------------------------------------------------------------------------------
pub const TR_DIGIT_0 : u8 = 48;
pub const TR_DIGIT_9 : u8 = 57;
pub const TR_DASH : u8 = 45;
pub const TR_PLUS : u8 = 43;
pub const TR_EQUALS : u8 = 61;
pub const TR_DOT : u8 = 46;
pub const TR_PAREN_CLOSE : u8 = 41;
pub const TR_SPACE : u8 = 32;
pub const TR_LF : u8 = 10;
pub const TR_CR : u8 = 13;
pub const TR_BACKSLASH : u8 = 92;
pub const TR_LETTER_M : u8 = 109;
pub const TR_LETTER_D : u8 = 100;
; Escaped anywhere: \ ` * _ [ ] < > # | ~ &
pub const TR_SPECIALS : [12]u8 = [92, 96, 42, 95, 91, 93, 60, 62, 35, 124, 126, 38];

; --- States of markdownEscape ------------------------------------------------------------------------------
pub const TR_LINE_START : i32 = 0;
pub const TR_DIGITS : i32 = 1;
pub const TR_TEXT : i32 = 2;

