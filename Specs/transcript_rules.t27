; --- File name ------------------------------------------------------------------------------------------------
; appendDigits: max(0, value) in decimal, padded with zeros to `width`, written at `at`; returns the
; position after it.
pub fn tr_append_digits(out: [4096]u8, at: i64, value: i32, width: i64) -> i64 {
    var v: i64 = value;
    if (v < 0) { v = 0; }
    var count: i64 = 1;
    var rest: i64 = v / 10;
    while (rest > 0) {
        count = count + 1;
        rest = rest / 10;
    }
    var pos: i64 = at;
    var pad: i64 = count;
    while (pad < width) {
        out[pos] = TR_DIGIT_0;
        pos = pos + 1;
        pad = pad + 1;
    }
    var k: i64 = count;
    var w: i64 = v;
    while (k > 0) {
        out[pos + k - 1] = cast_u8(TR_DIGIT_0 + w % 10);
        w = w / 10;
        k = k - 1;
    }
    return pos + count;
}

; transcriptFileName: "YYYY-MM-DD-HHMM.md", with "-N" before ".md" for attempt N >= 2. Writes to out
; and returns the length.
pub fn tr_transcript_file_name(year: i32, month: i32, day: i32, hour: i32, minute: i32, attempt: i32, out: [4096]u8) -> i64 {
    var pos: i64 = tr_append_digits(out, 0, year, 4);
    out[pos] = TR_DASH;
    pos = tr_append_digits(out, pos + 1, month, 2);
    out[pos] = TR_DASH;
    pos = tr_append_digits(out, pos + 1, day, 2);
    out[pos] = TR_DASH;
    pos = tr_append_digits(out, pos + 1, hour, 2);
    pos = tr_append_digits(out, pos, minute, 2);
    if (attempt >= TR_FIRST_NUMBERED_ATTEMPT) {
        out[pos] = TR_DASH;
        pos = tr_append_digits(out, pos + 1, attempt, 1);
    }
    out[pos] = TR_DOT;
    out[pos + 1] = TR_LETTER_M;
    out[pos + 2] = TR_LETTER_D;
    return pos + 3;
}

; --- Markdown escaping -------------------------------------------------------------------------------------------
; isMarkdownSpecial
pub fn tr_is_markdown_special(byte: u8) -> bool {
    var i: u32 = 0;
    while (i < 12) {
        if (TR_SPECIALS[i] == byte) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn tr_is_digit(byte: u8) -> bool {
    return byte >= TR_DIGIT_0 and byte <= TR_DIGIT_9;
}

; markdownEscape: anywhere \ ` * _ [ ] < > # | ~ & get a backslash; at the start of a line (after spaces)
; - + = get one, and after a leading digit run so do . and ) ("1." would start a list); CR is dropped,
; LF is kept and starts a new line; other bytes (UTF-8 too) pass through. Returns the length written.
pub fn tr_markdown_escape(input: [4096]u8, len: i64, out: [4096]u8) -> i64 {
    var n: i64 = len;
    if (n < 0) { n = 0; }
    if (n > TR_MD_ESCAPE_MAX_INPUT) { n = TR_MD_ESCAPE_MAX_INPUT; }
    var o: i64 = 0;
    var state: i32 = TR_LINE_START;
    var i: i64 = 0;
    while (i < n) {
        var byte: u8 = input[i];
        var done: bool = false;
        if (byte == TR_CR) {
            done = true;
        } else if (byte == TR_LF) {
            out[o] = byte;
            o = o + 1;
            state = TR_LINE_START;
            done = true;
        } else if (state == TR_LINE_START) {
            if (byte == TR_SPACE) {
                out[o] = byte;
                o = o + 1;
                done = true;
            } else if (byte == TR_DASH or byte == TR_PLUS or byte == TR_EQUALS) {
                out[o] = TR_BACKSLASH;
                out[o + 1] = byte;
                o = o + 2;
                state = TR_TEXT;
                done = true;
            } else if (tr_is_digit(byte)) {
                out[o] = byte;
                o = o + 1;
                state = TR_DIGITS;
                done = true;
            }
        } else if (state == TR_DIGITS) {
            if (tr_is_digit(byte)) {
                out[o] = byte;
                o = o + 1;
                done = true;
            } else if (byte == TR_DOT or byte == TR_PAREN_CLOSE) {
                out[o] = TR_BACKSLASH;
                out[o + 1] = byte;
                o = o + 2;
                state = TR_TEXT;
                done = true;
            }
        }
        if (done == false) {
            state = TR_TEXT;
            if (tr_is_markdown_special(byte)) {
                out[o] = TR_BACKSLASH;
                o = o + 1;
            }
            out[o] = byte;
            o = o + 1;
        }
        i = i + 1;
    }
    return o;
}

; --- Texts for the tests ------------------------------------------------------------------------------------------
; Copies text fixture `index` to out and returns its length (0 for an unknown index).
pub fn tr_fixture(index: i64, out: [4096]u8) -> i64 {
    if (index < 0 or index >= TR_FX_COUNT) { return 0; }
    var off: i64 = TR_FX_OFFSETS[index];
    var len: i64 = TR_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and k < TR_BUFFER) {
        out[k] = TR_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; Do the first len bytes of buf equal fixture `index`?
pub fn tr_fixture_matches(index: i64, buf: [4096]u8, len: i64) -> bool {
    if (index < 0 or index >= TR_FX_COUNT) { return false; }
    var off: i64 = TR_FX_OFFSETS[index];
    var n: i64 = TR_FX_LENGTHS[index];
    if (n != len) { return false; }
    var k: i64 = 0;
    while (k < n) {
        if (buf[k] != TR_FX_TEXT[off + k]) { return false; }
        k = k + 1;
    }
    return true;
}

test tr_file_names {
    var out: [4096]u8 = [0; 4096];
    // rulesTranscriptBytes (file names)
    assert tr_fixture_matches(TR_FX_NAME_0905, out, tr_transcript_file_name(2026, 10, 11, 9, 5, 1, out)) == true;
    assert tr_fixture_matches(TR_FX_NAME_2359, out, tr_transcript_file_name(2026, 1, 2, 23, 59, 0, out)) == true;
    assert tr_fixture_matches(TR_FX_NAME_1400_2, out, tr_transcript_file_name(2026, 10, 11, 14, 0, 2, out)) == true;
    assert tr_fixture_matches(TR_FX_NAME_1400_12, out, tr_transcript_file_name(2026, 10, 11, 14, 0, 12, out)) == true;
    // Negative values read as 0; wide values are not cut.
    assert tr_transcript_file_name(-5, 1, 2, 3, 4, 1, out) == 18;
    assert out[0] == 48;
    assert out[3] == 48;
    assert tr_transcript_file_name(12345, 1, 2, 3, 4, 1, out) == 19;
    assert tr_append_digits(out, 0, 2147483647, 1) == 10;
    assert out[0] == 50;
    assert out[9] == 55;
}

test tr_escape_rules {
    var inb: [4096]u8 = [0; 4096];
    var out: [4096]u8 = [0; 4096];
    var n: i64 = tr_fixture(TR_FX_PLAIN, inb);
    assert tr_fixture_matches(TR_FX_PLAIN, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_SPECIALS, inb);
    assert tr_fixture_matches(TR_FX_SPECIALS_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_ITEM, inb);
    assert tr_fixture_matches(TR_FX_ITEM_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_PLUS, inb);
    assert tr_fixture_matches(TR_FX_PLUS_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_TITLE, inb);
    assert tr_fixture_matches(TR_FX_TITLE_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_FIRST, inb);
    assert tr_fixture_matches(TR_FX_FIRST_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_YEAR, inb);
    assert tr_fixture_matches(TR_FX_YEAR_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_DECIMAL, inb);
    assert tr_fixture_matches(TR_FX_DECIMAL_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_INNER_DECIMAL, inb);
    assert tr_fixture_matches(TR_FX_INNER_DECIMAL, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_INNER_DASH, inb);
    assert tr_fixture_matches(TR_FX_INNER_DASH, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_LINES, inb);
    assert tr_fixture_matches(TR_FX_LINES_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    assert tr_markdown_escape(inb, 0, out) == 0;
    n = tr_fixture(TR_FX_TRICKY, inb);
    assert tr_fixture_matches(TR_FX_TRICKY_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    n = tr_fixture(TR_FX_TRICKY_TR, inb);
    assert tr_fixture_matches(TR_FX_TRICKY_TR_ESC, out, tr_markdown_escape(inb, n, out)) == true;
    // Exactly the twelve specials are special.
    var c: u32 = 0;
    var specials: u32 = 0;
    while (c < 256) {
        if (tr_is_markdown_special(cast_u8(c))) { specials = specials + 1; }
        c = c + 1;
    }
    assert specials == 12;
    // The worst case fits: 2048 specials become 4096 bytes; longer input is read as 2048 bytes.
    var i: i64 = 0;
    while (i < 4096) {
        inb[i] = 42;
        i = i + 1;
    }
    assert tr_markdown_escape(inb, 2048, out) == 4096;
    assert tr_markdown_escape(inb, 4096, out) == 4096;
    assert out[4094] == 92;
    assert out[4095] == 42;
    // Every byte alone: CR vanishes, specials and line-start marks double, the rest pass through.
    var b: u32 = 0;
    var bad: u32 = 0;
    while (b < 256) {
        var byte: u8 = cast_u8(b);
        inb[0] = byte;
        var m: i64 = tr_markdown_escape(inb, 1, out);
        var expected: i64 = 1;
        if (byte == 13) { expected = 0; }
        if (tr_is_markdown_special(byte) or byte == 45 or byte == 43 or byte == 61) { expected = 2; }
        if (m != expected) { bad = bad + 1; }
        b = b + 1;
    }
    assert bad == 0;
}
