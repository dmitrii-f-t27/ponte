// SPDX-License-Identifier: MIT
; Specs/camera_rules.t27 -- Ponte: the owner's camera picture in Google Meet (owner's request 2026-10-15)
; The built-in camera gives programs no exposure, focus or white balance, and macOS video effects (Portrait,
; Studio Light) belong to each program separately, so Ponte cannot change what Meet gets from the camera. The
; Ponte Camera extension for BrowserOS (camera/extension) wraps the camera track Meet asks for and draws every
; frame through a small shader; Ponte's panel "Kamera" sets the picture over a local WebSocket. This spec
; decides: the settings, their ranges, defaults and presets; the colour transform as a 3x4 affine matrix plus
; a shadow lift, and the same transform for one pixel (the oracle the shader is tested against); the part of
; the frame shown (zoom, pan, mirror) in texture coordinates; when a frame is processed at all; and the link
; (its port, the only origin it accepts, keepalive, message limit, the panel's status).
; The extension runs this same C, built to WebAssembly by camera/build-wasm.sh, so the numbers the shader gets
; are the numbers the tests check. Settings are integers (sliders), the transform is f32. ASCII only.
; Facade: PonteApp/CameraRules.swift. Oracle: Tests/PonteTests/Oracles/CameraRulesLegacy.swift.
; Generated C: Sources/PonteSpecs/camera_rules.h (Specs/generate.sh).

module PonteCameraRules;

; --- Settings (SET_*) ---------------------------------------------------------------------------------------------
; Light: brightness and contrast -100...100, shadows 0...100. Colour: warmth and saturation -100...100.
; Frame: zoom 100...300 (percent), pan x and y -100...100 (share of the room the zoom leaves), mirror 0 or 1.
pub const CM_SET_BRIGHTNESS : i64 = 0;
pub const CM_SET_CONTRAST : i64 = 1;
pub const CM_SET_SHADOWS : i64 = 2;
pub const CM_SET_WARMTH : i64 = 3;
pub const CM_SET_SATURATION : i64 = 4;
pub const CM_SET_ZOOM : i64 = 5;
pub const CM_SET_PAN_X : i64 = 6;
pub const CM_SET_PAN_Y : i64 = 7;
pub const CM_SET_MIRROR : i64 = 8;
pub const CM_SET_COUNT : i64 = 9;

pub const CM_ZOOM_MIN : i64 = 100;
pub const CM_ZOOM_MAX : i64 = 300;

; --- Presets (PRESET_*): they set light and colour and keep the frame ------------------------------------------
pub const CM_PRESET_NORMAL : i64 = 0;
; A warmer, slightly brighter face under cold office light.
pub const CM_PRESET_WARM : i64 = 1;
; A dark room or a window behind: brighter, shadows lifted, a little less contrast.
pub const CM_PRESET_DARK_ROOM : i64 = 2;
; A flat, grey picture: more contrast and colour.
pub const CM_PRESET_VIVID : i64 = 3;
pub const CM_PRESET_COUNT : i64 = 4;

; --- The colour transform -----------------------------------------------------------------------------------------
; Applied in this order to RGB in 0...1: warmth gains (red up and blue down by CM_WARMTH_GAIN_MAX at +100),
; saturation around Rec. 709 luma (factor 1 + saturation/100), contrast around mid grey (factor 1 + contrast/100 *
; CM_CONTRAST_SPAN), brightness (+ brightness/100 * CM_BRIGHTNESS_SHIFT_MAX); clamp to 0...1; the shadow lift
; v + k * v * (1 - v)^2 with k = shadows/100 * CM_SHADOW_LIFT_MAX (keeps black and white, lifts the dark and middle
; tones most near v = 1/3, and stays rising for k < 3); clamp to 0...1.
pub const CM_WARMTH_GAIN_MAX : f32 = 0.12;
pub const CM_CONTRAST_SPAN : f32 = 0.5;
pub const CM_BRIGHTNESS_SHIFT_MAX : f32 = 0.2;
pub const CM_SHADOW_LIFT_MAX : f32 = 1.2;
pub const CM_LUMA_R : f32 = 0.2126;
pub const CM_LUMA_G : f32 = 0.7152;
pub const CM_LUMA_B : f32 = 0.0722;
; cm_color_params writes the 3x3 matrix row by row (0...8), the offsets (9...11) and k (12).
pub const CM_PARAMS_COUNT : i64 = 13;

; --- The link: Ponte (server) <-> the extension's service worker --------------------------------------------------
; ws://127.0.0.1:CM_LINK_PORT, only from the extension's own origin (CM_ROW_EXTENSION_ORIGIN).
pub const CM_LINK_PORT : i64 = 47839;
pub const CM_LINK_VERSION : i64 = 1;
; Ponte sends the settings again this often: Chromium lets an extension's service worker sleep after 30 s without
; an event, and a message keeps it and its socket alive.
pub const CM_LINK_PING_MS : i64 = 20000;
; A larger message, or a handshake longer than this, closes the connection.
pub const CM_LINK_MESSAGE_MAX : i64 = 4096;
; Connections at once: the extension opens one; a second extension window opens another.
pub const CM_LINK_CLIENTS_MAX : i64 = 4;
; The panel's status (LINK_*).
pub const CM_LINK_OFF : i64 = 0;
; The port is taken (another Ponte?) or the listener failed.
pub const CM_LINK_FAILED : i64 = 1;
; Ponte listens; the extension has not connected (not installed, or BrowserOS is closed).
pub const CM_LINK_NO_EXTENSION : i64 = 2;
; The extension is connected; no Meet page uses the camera.
pub const CM_LINK_WAITING : i64 = 3;
; A Meet page sends the processed picture.
pub const CM_LINK_ACTIVE : i64 = 4;

