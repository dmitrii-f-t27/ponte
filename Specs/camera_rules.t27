// SPDX-License-Identifier: MIT
; Specs/camera_rules.t27 -- Ponte: the owner's camera picture in Google Meet (owner's request 2026-10-15)
; The built-in camera gives programs no exposure, focus or white balance, and macOS video effects (Portrait,
; Studio Light) belong to each program separately, so Ponte cannot change what Meet gets from the camera. The
; Ponte Camera extension for BrowserOS (camera/extension) wraps the camera track Meet asks for and draws every
; frame through a small shader; Ponte's panel "Kamera" sets the picture over a local WebSocket. This spec
; decides: the settings, their ranges, defaults and presets; the colour transform as a 3x4 affine matrix plus
; a shadow lift, and the same transform for one pixel (the oracle the shader is tested against); the part of
; the frame shown (zoom, pan, mirror) in texture coordinates; when a frame is processed at all; and the link
; (its port, the only origin it accepts, keepalive, message limit, the panel's status).
; Version 2 (2026-10-15, after the extension's errors "passing frames unchanged [object DOMException]" and
; ERR_CONNECTION_REFUSED on the owner's Mac): the frame pipeline in a Meet page (what each frame does, which renderer
; draws it, what a failure of a renderer or of Meet's side of the track does, how long until the next try, what the
; page reports), when the extension dials Ponte again, the WebSocket decisions of Ponte's side of the link (handshake
; status, frame header checks, opcodes), the cleaned error text a page reports, and the panel's status with frames
; that pass unprocessed.
; The extension runs this same C, built to WebAssembly by camera/build-wasm.sh, so the numbers the shader gets
; are the numbers the tests check. Settings are integers (sliders), the transform is f32. ASCII only.
; Facade: PonteApp/CameraRules.swift. Oracle: Tests/PonteTests/Oracles/CameraRulesLegacy.swift.
; Generated C: Sources/PonteSpecs/camera_rules.h (Specs/generate.sh).

module PonteCameraRules;

; --- Settings (SET_*) ---------------------------------------------------------------------------------------------
; Light: brightness and contrast -100...100, shadows 0...100. Colour: warmth and saturation -100...100.
; Frame: zoom 100...300 (percent), pan x and y -100...100 (share of the room the zoom leaves), mirror 0 or 1.
pub const CM_SET_BRIGHTNESS : i64 = 0;
pub const CM_SET_CONTRAST : i64 = 1;
pub const CM_SET_SHADOWS : i64 = 2;
pub const CM_SET_WARMTH : i64 = 3;
pub const CM_SET_SATURATION : i64 = 4;
pub const CM_SET_ZOOM : i64 = 5;
pub const CM_SET_PAN_X : i64 = 6;
pub const CM_SET_PAN_Y : i64 = 7;
pub const CM_SET_MIRROR : i64 = 8;
pub const CM_SET_COUNT : i64 = 9;

pub const CM_ZOOM_MIN : i64 = 100;
pub const CM_ZOOM_MAX : i64 = 300;

; --- Presets (PRESET_*): they set light and colour and keep the frame ------------------------------------------
pub const CM_PRESET_NORMAL : i64 = 0;
; A warmer, slightly brighter face under cold office light.
pub const CM_PRESET_WARM : i64 = 1;
; A dark room or a window behind: brighter, shadows lifted, a little less contrast.
pub const CM_PRESET_DARK_ROOM : i64 = 2;
; A flat, grey picture: more contrast and colour.
pub const CM_PRESET_VIVID : i64 = 3;
pub const CM_PRESET_COUNT : i64 = 4;

; --- The colour transform -----------------------------------------------------------------------------------------
; Applied in this order to RGB in 0...1: warmth gains (red up and blue down by CM_WARMTH_GAIN_MAX at +100),
; saturation around Rec. 709 luma (factor 1 + saturation/100), contrast around mid grey (factor 1 + contrast/100 *
; CM_CONTRAST_SPAN), brightness (+ brightness/100 * CM_BRIGHTNESS_SHIFT_MAX); clamp to 0...1; the shadow lift
; v + k * v * (1 - v)^2 with k = shadows/100 * CM_SHADOW_LIFT_MAX (keeps black and white, lifts the dark and middle
; tones most near v = 1/3, and stays rising for k < 3); clamp to 0...1.
pub const CM_WARMTH_GAIN_MAX : f32 = 0.12;
pub const CM_CONTRAST_SPAN : f32 = 0.5;
pub const CM_BRIGHTNESS_SHIFT_MAX : f32 = 0.2;
pub const CM_SHADOW_LIFT_MAX : f32 = 1.2;
pub const CM_LUMA_R : f32 = 0.2126;
pub const CM_LUMA_G : f32 = 0.7152;
pub const CM_LUMA_B : f32 = 0.0722;
; cm_color_params writes the 3x3 matrix row by row (0...8), the offsets (9...11) and k (12).
pub const CM_PARAMS_COUNT : i64 = 13;

; --- The link: Ponte (server) <-> the extension's service worker --------------------------------------------------
; ws://127.0.0.1:CM_LINK_PORT, only from the extension's own origin (CM_ROW_EXTENSION_ORIGIN).
pub const CM_LINK_PORT : i64 = 47839;
pub const CM_LINK_VERSION : i64 = 1;
; Ponte sends the settings again this often: Chromium lets an extension's service worker sleep after 30 s without
; an event, and a message keeps it and its socket alive.
pub const CM_LINK_PING_MS : i64 = 20000;
; A larger message, or a handshake longer than this, closes the connection.
pub const CM_LINK_MESSAGE_MAX : i64 = 4096;
; Connections at once: the extension opens one; a second extension window opens another.
pub const CM_LINK_CLIENTS_MAX : i64 = 4;
; TCP connections at once, handshakes included: any more are closed at once, so connections that never finish their
; handshake cannot pile up; and a handshake not finished within CM_LINK_HANDSHAKE_MS closes its connection.
pub const CM_LINK_CONNECTIONS_MAX : i64 = 8;
pub const CM_LINK_HANDSHAKE_MS : i64 = 5000;
; A report of more processed cameras than this is read as this many.
pub const CM_LINK_CAMERAS_MAX : i64 = 16;
; The panel's status (LINK_*).
pub const CM_LINK_OFF : i64 = 0;
; The port is taken (another Ponte?) or the listener failed.
pub const CM_LINK_FAILED : i64 = 1;
; Ponte listens; the extension has not connected (not installed, or BrowserOS is closed).
pub const CM_LINK_NO_EXTENSION : i64 = 2;
; The extension is connected; no Meet page uses the camera.
pub const CM_LINK_WAITING : i64 = 3;
; A Meet page sends the processed picture.
pub const CM_LINK_ACTIVE : i64 = 4;
; A Meet page has the camera open and its frames pass as they came, because the settings change nothing (or
; "Obrabatyvat' kameru" is off): the picture is the right one, but no frame is drawn.
pub const CM_LINK_PASSING : i64 = 5;
; A Meet page should process its camera but cannot draw right now (a renderer failed): its frames pass as they
; came, unprocessed, while the extension tries again by itself. Shown with the page's last error.
pub const CM_LINK_TROUBLE : i64 = 6;
; Ponte reads a socket in pieces of at most this many bytes.
pub const CM_LINK_READ_MAX : i64 = 16384;

; --- The extension dials Ponte (camera/extension/sw.js) -------------------------------------------------------------
; Ponte may be closed or start after the browser: a refused connection is normal then, and the browser logs each
; refused attempt in chrome://extensions by itself (no script can stop that), so the attempts are spaced. Why the
; service worker dials (DIAL_*): it started (browser start, a wake-up), the extension was installed or updated,
; its timer or alarm fired, a Meet page reported, the socket closed.
pub const CM_DIAL_START : i64 = 0;
pub const CM_DIAL_INSTALL : i64 = 1;
pub const CM_DIAL_TIMER : i64 = 2;
pub const CM_DIAL_PAGE : i64 = 3;
pub const CM_DIAL_CLOSED : i64 = 4;
; After failures in a row the wait doubles from CM_DIAL_FIRST_MS: up to CM_DIAL_MEET_MAX_MS while a Meet page is
; open (Ponte started late connects within that), else up to CM_DIAL_IDLE_MAX_MS. The service worker's alarm
; (every 30 s, Chromium's shortest) wakes it to look again.
pub const CM_DIAL_FIRST_MS : i64 = 1000;
pub const CM_DIAL_MEET_MAX_MS : i64 = 30000;
pub const CM_DIAL_IDLE_MAX_MS : i64 = 300000;
pub const CM_DIAL_FAILURES_CAP : i64 = 32;

; --- Ponte's side of the WebSocket (PonteCamera/CameraLink.swift) ------------------------------------------------
; HTTP answers to a handshake.
pub const CM_HTTP_SWITCHING : i64 = 101;
pub const CM_HTTP_BAD_REQUEST : i64 = 400;
pub const CM_HTTP_FORBIDDEN : i64 = 403;
pub const CM_HTTP_TOO_LARGE : i64 = 431;
pub const CM_HTTP_BUSY : i64 = 503;
; Close codes (RFC 6455).
pub const CM_WS_CLOSE_NORMAL : i64 = 1000;
pub const CM_WS_CLOSE_PROTOCOL : i64 = 1002;
pub const CM_WS_CLOSE_UNSUPPORTED : i64 = 1003;
pub const CM_WS_CLOSE_TOO_BIG : i64 = 1009;
; What a received frame does (WSA_*): a text message, the peer closes, a ping to answer, a pong, anything else.
pub const CM_WSA_MESSAGE : i64 = 0;
pub const CM_WSA_CLOSE : i64 = 1;
pub const CM_WSA_PONG : i64 = 2;
pub const CM_WSA_IGNORE : i64 = 3;
pub const CM_WSA_UNSUPPORTED : i64 = 4;
; Ponte's own messages are sent with a 7-bit or a 16-bit length.
pub const CM_WS_SEND_MAX : i64 = 65535;

; --- The frame pipeline in a Meet page (camera/extension/page.js) -------------------------------------------------
; page.js runs in Meet's own world, where the extension's WebAssembly is not at hand and Meet's content security
; policy decides what may be compiled; so the service worker evaluates the functions of this section over their whole
; (small) domains and hands the page the tables (camera/extension/policy.js); the page only looks the answers up.
; A camera track Meet asks for is wrapped. Each frame either passes as it came (the original frame goes to Meet) or
; is drawn by a renderer into a new frame that goes to Meet instead (the original is released once the new one
; exists). A renderer that fails is released and tried again later, or replaced by the next one; frames meanwhile pass
; as they came, so the picture never goes black, and the status says that they are not processed.
; Track states (TRK_*): wrapped with no frame yet; frames pass because nothing changes the picture; the last frame
; was drawn and went to Meet; a renderer failed and frames pass until the next try; every renderer failed and frames
; pass until CM_RENDER_FAILED_RETRY_MS or new settings; the track ended.
pub const CM_TRK_STARTING : i64 = 0;
pub const CM_TRK_PASSING : i64 = 1;
pub const CM_TRK_PROCESSED : i64 = 2;
pub const CM_TRK_RECOVERING : i64 = 3;
pub const CM_TRK_FAILED : i64 = 4;
pub const CM_TRK_ENDED : i64 = 5;
pub const CM_TRK_COUNT : i64 = 6;
; Events (TEV_*): a frame passed because nothing needs processing; a frame passed while a try is not due (or the
; frame had no size); a drawn frame went to Meet; Meet's side refused a frame while the track was not being stopped
; (the generator's stream is broken: nothing more can be written); the track was stopped or ended; new settings.
pub const CM_TEV_PASSED : i64 = 0;
pub const CM_TEV_HELD : i64 = 1;
pub const CM_TEV_DRAWN : i64 = 2;
pub const CM_TEV_WRITE_FAILED : i64 = 3;
pub const CM_TEV_STOPPED : i64 = 4;
pub const CM_TEV_SETTINGS : i64 = 5;
pub const CM_TEV_COUNT : i64 = 6;
; What the page does after an event (TACT_*): nothing; the failure count back to 0; release the renderer and start
; again from the first renderer with no failures, at once; release the renderer, the reader and the writer and stop
; both tracks (the camera is released; Meet sees its track end and may ask for the camera again).
pub const CM_TACT_NONE : i64 = 0;
pub const CM_TACT_CLEAR : i64 = 1;
pub const CM_TACT_RESET : i64 = 2;
pub const CM_TACT_CLOSE : i64 = 3;
; Where a frame goes (ROUTE_*): to Meet as it came, through the renderer, nowhere (the track ended: released).
pub const CM_ROUTE_PASS : i64 = 0;
pub const CM_ROUTE_DRAW : i64 = 1;
pub const CM_ROUTE_STOP : i64 = 2;
; Renderers (RV_*; the codes are stable, the order they are tried is cm_render_at). WebGL2 draws the colour and the
; frame; its new frame is taken straight from the canvas with a preserved drawing buffer (tried first), or as an
; ImageBitmap of the drawing buffer (tried second). The 2D canvas draws only the part of the frame shown (zoom, pan,
; mirror), so it is used only while the colour settings change nothing (tried last).
; The order, by the checks of 2026-10-15: on the owner's Apple M4 (ANGLE Metal, BrowserOS neo, real camera NV12
; 640x480) the final diagnose run made a VideoFrame from the WebGL2 canvas (BGRX) and drew 30 frames/s processed,
; while VideoFrame(ImageBitmap) threw "OperationError: Failed to construct 'VideoFrame': Failed to create video
; frame"; headless Chrome with SwiftShader (the fake-camera tests) behaves the same. (An earlier diagnose run with the
; first patch reported the ImageBitmap renderer as drawing; the final run, with a probe of each path on its own,
; did not confirm it.) A path that does not work costs one frame: an unproven renderer is left at its first failure,
; and later tracks start with the one that drew (see CM_RENDER_TRIES).
pub const CM_RV_WEBGL_BITMAP : i64 = 0;
pub const CM_RV_WEBGL_CANVAS : i64 = 1;
pub const CM_RV_CANVAS2D : i64 = 2;
pub const CM_RV_COUNT : i64 = 3;
pub const CM_RV_FIRST : i64 = 1;
; Where a failure happened (STAGE_*): none known; making the context, shaders or program; taking the camera frame
; in (texImage2D, drawImage); drawing; making the new frame (ImageBitmap, VideoFrame); the context was lost; Meet's
; side refused a frame; reading the camera failed.
pub const CM_STAGE_NONE : i64 = 0;
pub const CM_STAGE_CREATE : i64 = 1;
pub const CM_STAGE_UPLOAD : i64 = 2;
pub const CM_STAGE_DRAW : i64 = 3;
pub const CM_STAGE_OUTPUT : i64 = 4;
pub const CM_STAGE_LOST : i64 = 5;
pub const CM_STAGE_WRITE : i64 = 6;
pub const CM_STAGE_READ : i64 = 7;
pub const CM_STAGE_COUNT : i64 = 8;
; A renderer is tried this many times in a row before the next one; the waits between are CM_RENDER_RETRY_FIRST_MS,
; doubling; after a lost context CM_RENDER_LOST_RETRY_MS (the GPU process may be restarting); after every renderer
; failed, CM_RENDER_FAILED_RETRY_MS. Only a proven renderer gets the tries: one that has drawn a frame on this page.
; One that has not is left at its first failure (except a lost context, which says nothing about the renderer): a way
; of making frames this browser and GPU do not support costs one frame, not a second of retries. A new track starts
; with the renderer that last drew on the page (cm_render_first).
pub const CM_RENDER_TRIES : i64 = 3;
pub const CM_RENDER_RETRY_FIRST_MS : i64 = 250;
pub const CM_RENDER_LOST_RETRY_MS : i64 = 1000;
pub const CM_RENDER_FAILED_RETRY_MS : i64 = 30000;
; What a track counts as in the page's report (BUCKET_*): nothing (ended); a camera whose frames pass as they came;
; a processed camera; a camera that should be processed and is not.
pub const CM_BUCKET_NONE : i64 = 0;
pub const CM_BUCKET_PASSING : i64 = 1;
pub const CM_BUCKET_PROCESSED : i64 = 2;
pub const CM_BUCKET_TROUBLE : i64 = 3;
; The error a page reports: the DOMException's name and its message, printable ASCII only, at most this many bytes
; (no frames, no page content).
pub const CM_REPORT_NAME : i64 = 0;
pub const CM_REPORT_TEXT : i64 = 1;
pub const CM_REPORT_NAME_MAX : i64 = 64;
pub const CM_REPORT_TEXT_MAX : i64 = 200;
; How much a reported error counts when the panel shows one of several (cm_report_error_rank).
pub const CM_ERROR_RANK_NONE : i64 = 0;
pub const CM_ERROR_RANK_PAST : i64 = 1;
pub const CM_ERROR_RANK_TROUBLE : i64 = 2;
; The tables the service worker hands the page change shape (or the meaning of their codes) with this number.
; 2 (0.1.14): the failure tables by proven renderer, the first renderer by the last one that drew, the error ranks.
pub const CM_POLICY_REV : i64 = 2;

