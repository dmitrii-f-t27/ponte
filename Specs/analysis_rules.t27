// SPDX-License-Identifier: MIT
; Specs/analysis_rules.t27 -- Ponte: the call analysis agent (running notes during a call, the report after it)
; The owner pastes the API key of an OpenAI-compatible chat service (Z.ai GLM, DeepSeek or his own). During a
; call an agent keeps running notes from the transcript (both directions, original and translation, who
; spoke); after the call it writes a report of the important data, saved as plain text. This spec decides:
; the providers and their defaults (byte tables), the request endpoint and limits, whether a base URL can be
; used (http:// only for this Mac), whether the saved key may go to the configured address (a key is bound to
; the address it was saved for), whether a model name can be used, what a Keychain write did, when the analysis
; is on, when the notes are updated, which lines are ready, how many lines go into one request, whether a reply
; is complete (finish_reason) and what to do with a cut one, how an error is classified, retried and backed
; off, when the report is built or shown, what happens on quit, and the report file name. Swift (PonteSpeech/AnalysisRules.swift) only marshals; the prompts, the JSON, the
; Keychain, URLSession and the views stay in Swift. The test oracle is AnalysisRulesLegacy
; (Tests/PonteTests/Oracles), a separate plain-Swift implementation of the same rules.
; Times are integer milliseconds, sizes UTF-8 bytes. ASCII only.
; Generated C: Sources/PonteSpecs/analysis_rules.h (Specs/generate.sh).

module PonteAnalysisRules;

; --- Providers (rows of the AN_ROW table, in this order) -------------------------------------------------
pub const AN_PROVIDER_ZAI : i64 = 0;
pub const AN_PROVIDER_DEEPSEEK : i64 = 1;
; An OpenAI-compatible service the owner names (base URL and model typed in the settings).
pub const AN_PROVIDER_CUSTOM : i64 = 2;
pub const AN_PROVIDER_COUNT : i64 = 3;
pub const AN_DEFAULT_PROVIDER : i64 = 0;
; The analysis is on by default once a key is saved (1 = on).
pub const AN_DEFAULT_ON : i64 = 1;

; --- When the notes are updated ---------------------------------------------------------------------------
; At most one notes update per interval, and only with at least this many new lines...
pub const AN_INTERVAL_MS : i64 = 120000;
pub const AN_MIN_NEW_LINES : i64 = 4;
; ...unless this many lines have piled up (a fast talk), which keeps each request small.
pub const AN_FORCE_NEW_LINES : i64 = 60;
; How often the agent looks at the transcript.
pub const AN_TICK_MS : i64 = 5000;
; A line without a translation (and without a translation error) is ready after this long.
pub const AN_LINE_SETTLE_MS : i64 = 20000;

; --- Request limits ------------------------------------------------------------------------------------------
; One request (system prompt + notes + transcript lines) is at most this many bytes; a longer transcript is
; summarized chunk by chunk into the notes first.
pub const AN_MAX_REQUEST_BYTES : i64 = 40000;
; One transcript line (original + translation) is cut to this many bytes.
pub const AN_MAX_LINE_BYTES : i64 = 4000;
; The notes the service returns are cut to this many bytes; the prompt asks for at most AN_NOTES_CHARS characters.
pub const AN_MAX_NOTES_BYTES : i64 = 24000;
pub const AN_NOTES_CHARS : i64 = 6000;
; The chunk planner reads at most this many line sizes at once.
pub const AN_LIST_MAX : i64 = 256;
; The URLRequest timeout: slow free models (GLM flash) take about a minute on a long request.
pub const AN_REQUEST_TIMEOUT_MS : i64 = 90000;
; The check button of the settings sends a tiny request with a shorter timeout.
pub const AN_PROBE_TIMEOUT_MS : i64 = 30000;
pub const AN_MAX_TOKENS : i64 = 4096;
; deepseek-flash (DeepSeek-V4.1-Flash; deepseek-chat is gone from the docs, 2026-10-14) answers at most 8192 tokens.
pub const AN_REPORT_MAX_TOKENS : i64 = 8000;
pub const AN_PROBE_MAX_TOKENS : i64 = 16;
; Temperature x 1000: low, the task is extraction.
pub const AN_TEMPERATURE_MILLI : i64 = 200;
; Out-buffers: table rows, IDs, Keychain services and file names; URLs.
pub const AN_TEXT_OUT_MAX : i64 = 256;
pub const AN_URL_MAX : i64 = 2048;

; --- Errors -----------------------------------------------------------------------------------------------------
; What failed (Swift reads the URLSession error or the reply into these).
pub const AN_KIND_HTTP : i64 = 0;
pub const AN_KIND_TIMEOUT : i64 = 1;
pub const AN_KIND_NETWORK : i64 = 2;
; A 2xx reply without text in choices[0].message.content.
pub const AN_KIND_EMPTY : i64 = 3;
; A 2xx reply that is not chat-completions JSON.
pub const AN_KIND_BAD_REPLY : i64 = 4;
pub const AN_KIND_NO_KEY : i64 = 5;
pub const AN_KIND_BAD_URL : i64 = 6;
; A 2xx reply the service cut before its end (an_reply_complete is false).
pub const AN_KIND_CUT : i64 = 7;
; The saved key belongs to another base URL (an_bind_check): nothing is sent.
pub const AN_KIND_KEY_ELSEWHERE : i64 = 8;
; Error classes.
pub const AN_ERR_NONE : i64 = 0;
pub const AN_ERR_NETWORK : i64 = 1;
pub const AN_ERR_TIMEOUT : i64 = 2;
; 401, 403: the key.
pub const AN_ERR_AUTH : i64 = 3;
; 402: no money on the account (DeepSeek "Insufficient Balance").
pub const AN_ERR_PAYMENT : i64 = 4;
pub const AN_ERR_RATE_LIMIT : i64 = 5;
pub const AN_ERR_SERVER : i64 = 6;
; 404: a wrong base URL or model.
pub const AN_ERR_NOT_FOUND : i64 = 7;
; Other 4xx: the request.
pub const AN_ERR_REJECTED : i64 = 8;
pub const AN_ERR_EMPTY : i64 = 9;
pub const AN_ERR_BAD_REPLY : i64 = 10;
pub const AN_ERR_NO_KEY : i64 = 11;
pub const AN_ERR_BAD_URL : i64 = 12;
pub const AN_ERR_OTHER : i64 = 13;
pub const AN_ERR_CUT : i64 = 14;
pub const AN_ERR_KEY_ELSEWHERE : i64 = 15;
; HTTP statuses an_http_class tells apart (0 = no response).
pub const AN_HTTP_NO_RESPONSE : i64 = 0;
pub const AN_HTTP_OK_FIRST : i64 = 200;
pub const AN_HTTP_OK_END : i64 = 300;
pub const AN_HTTP_CLIENT_ERROR : i64 = 400;
pub const AN_HTTP_UNAUTHORIZED : i64 = 401;
pub const AN_HTTP_PAYMENT_REQUIRED : i64 = 402;
pub const AN_HTTP_FORBIDDEN : i64 = 403;
pub const AN_HTTP_NOT_FOUND : i64 = 404;
pub const AN_HTTP_REQUEST_TIMEOUT : i64 = 408;
pub const AN_HTTP_TOO_MANY_REQUESTS : i64 = 429;
pub const AN_HTTP_SERVER_ERROR : i64 = 500;
pub const AN_HTTP_STATUS_END : i64 = 600;

; --- Retries and backoff ------------------------------------------------------------------------------------------
; Attempts per request of the report (the first and two retries).
pub const AN_MAX_ATTEMPTS : i64 = 3;
pub const AN_RETRY_GIVE_UP : i64 = 0;
pub const AN_RETRY_AGAIN : i64 = 1;
; The wait after the n-th failure in a row: base, doubled each time, at most the maximum.
pub const AN_RETRY_BASE_MS : i64 = 15000;
pub const AN_RETRY_MAX_MS : i64 = 300000;
; The background notes stop after this many failures in a row (the report still tries).
pub const AN_MAX_BACKGROUND_FAILURES : i64 = 6;
pub const AN_BG_RETRY : i64 = 0;
pub const AN_BG_STOP : i64 = 1;

; --- Base URL check and configuration --------------------------------------------------------------------------------
pub const AN_URL_OK : i64 = 0;
pub const AN_URL_EMPTY : i64 = 1;
pub const AN_URL_NO_SCHEME : i64 = 2;
pub const AN_URL_NO_HOST : i64 = 3;
pub const AN_URL_SPACE : i64 = 4;
pub const AN_URL_TOO_LONG : i64 = 5;
; http:// to a host that is not this Mac (localhost, 127.0.0.1, [::1]): the key would cross the network in clear.
pub const AN_URL_HTTP_REMOTE : i64 = 6;
pub const AN_CFG_OK : i64 = 0;
pub const AN_CFG_NO_KEY : i64 = 1;
pub const AN_CFG_BAD_URL : i64 = 2;
pub const AN_CFG_NO_MODEL : i64 = 3;
; The key was saved for another base URL (or before keys were bound to one): save it again for this address.
pub const AN_CFG_KEY_ELSEWHERE : i64 = 4;
; Whether the saved key may go to the configured base URL (an_bind_check).
pub const AN_BIND_OK : i64 = 0;
; Saved for another address.
pub const AN_BIND_OTHER : i64 = 1;
; Saved without an address (by Ponte before the binding) and no default stands in for it.
pub const AN_BIND_UNBOUND : i64 = 2;
; A model name (trimmed by Swift) goes into the request JSON: at most AN_MODEL_MAX bytes, no space or control byte.
pub const AN_MODEL_MAX : i64 = 256;
pub const AN_MODEL_OK : i64 = 0;
pub const AN_MODEL_EMPTY : i64 = 1;
pub const AN_MODEL_TOO_LONG : i64 = 2;
pub const AN_MODEL_BAD_CHAR : i64 = 3;
; What a Keychain call returned (Swift reads OSStatus into these).
pub const AN_KC_OK : i64 = 0;
pub const AN_KC_NOT_FOUND : i64 = 1;
pub const AN_KC_DUPLICATE : i64 = 2;
pub const AN_KC_OTHER : i64 = 3;
; What saving a key did: saved; refused because an item of the same name that Ponte could not delete (another
; app's) is there; failed.
pub const AN_SAVE_OK : i64 = 0;
pub const AN_SAVE_FOREIGN : i64 = 1;
pub const AN_SAVE_FAILED : i64 = 2;
; A pasted API key (trimmed by Swift) goes into an HTTP header: printable ASCII only, at most AN_KEY_MAX bytes.
pub const AN_KEY_MAX : i64 = 1024;
pub const AN_KEY_OK : i64 = 0;
pub const AN_KEY_EMPTY : i64 = 1;
pub const AN_KEY_BAD_CHAR : i64 = 2;
pub const AN_KEY_TOO_LONG : i64 = 3;
pub const AN_TILDE : u8 = 126;
pub const AN_COLON : u8 = 58;
pub const AN_QUESTION : u8 = 63;
pub const AN_HASH : u8 = 35;
pub const AN_DIGIT_9 : u8 = 57;

; --- Replies --------------------------------------------------------------------------------------------------------
; choices[0].finish_reason: absent; "stop"; "length" (cut at max_tokens); a cut by the service (AN_ROW_FINISH_CUT_*);
; anything else (tool_calls, unknown words).
pub const AN_FINISH_NONE : i64 = 0;
pub const AN_FINISH_STOP : i64 = 1;
pub const AN_FINISH_LENGTH : i64 = 2;
pub const AN_FINISH_CUT : i64 = 3;
pub const AN_FINISH_OTHER : i64 = 4;
; After a cut notes reply: try again at once with fewer lines, ask for shorter notes first, or fail.
pub const AN_CUT_SMALLER : i64 = 0;
pub const AN_CUT_COMPRESS : i64 = 1;
pub const AN_CUT_FAIL : i64 = 2;
; Cut replies in a row (the last one included) after which a notes update fails.
pub const AN_MAX_CUTS : i64 = 6;
; Notes of at least this many bytes (about 3000 Cyrillic characters) are shortened first when a reply is cut.
pub const AN_COMPRESS_FROM_BYTES : i64 = 6000;
; The shortening request asks for notes of at most this many characters.
pub const AN_COMPRESS_CHARS : i64 = 3000;

; --- The report ------------------------------------------------------------------------------------------------------
; What the report button of the toolbar does: show what there is, build (or rebuild) the report, or explain why not.
pub const AN_OPEN_SHOW : i64 = 0;
pub const AN_OPEN_BUILD : i64 = 1;
pub const AN_OPEN_EXPLAIN : i64 = 2;
; Whether the refresh button of the report can build it now, and why not.
pub const AN_CHECK_OK : i64 = 0;
pub const AN_CHECK_BUSY : i64 = 1;
pub const AN_CHECK_NOT_SET : i64 = 2;
pub const AN_CHECK_NO_LINES : i64 = 3;
; The toggle "analyse the call" is off: nothing is sent.
pub const AN_CHECK_OFF : i64 = 4;
; On quit, a report still being written gets at most this long to arrive (it is then written to a file); after it
; the request is abandoned.
pub const AN_QUIT_WAIT_MS : i64 = 10000;

; --- Lines ---------------------------------------------------------------------------------------------------------
; Direction codes (incoming: the other side in pt-BR; outgoing: the owner in ru) and who spoke.
pub const AN_DIR_INCOMING : i64 = 0;
pub const AN_DIR_OUTGOING : i64 = 1;
; The other side (Swift writes it as "Sobesednik" in Russian).
pub const AN_SPEAKER_THEM : i64 = 0;
; The owner ("Ya").
pub const AN_SPEAKER_ME : i64 = 1;
pub const AN_MS_PER_MINUTE : i64 = 60000;

; --- Report file name ------------------------------------------------------------------------------------------------
