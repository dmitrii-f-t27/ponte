; --- Lines ---------------------------------------------------------------------------------------------------------
; Direction codes (incoming: the other side in pt-BR; outgoing: the owner in ru) and who spoke.
pub const AN_DIR_INCOMING : i64 = 0;
pub const AN_DIR_OUTGOING : i64 = 1;
; The other side (Swift writes it as "Sobesednik" in Russian).
pub const AN_SPEAKER_THEM : i64 = 0;
; The owner ("Ya").
pub const AN_SPEAKER_ME : i64 = 1;
pub const AN_MS_PER_MINUTE : i64 = 60000;

; --- Report file name ------------------------------------------------------------------------------------------------
pub const AN_FIRST_ATTEMPT : i32 = 1;
; Attempt 2 and later add "-N", so an existing file is never overwritten.
pub const AN_FIRST_NUMBERED_ATTEMPT : i32 = 2;
