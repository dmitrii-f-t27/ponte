; --- The report ------------------------------------------------------------------------------------------------------
; What the report button of the toolbar does: show what there is, build (or rebuild) the report, or explain why not.
pub const AN_OPEN_SHOW : i64 = 0;
pub const AN_OPEN_BUILD : i64 = 1;
pub const AN_OPEN_EXPLAIN : i64 = 2;
; Whether the refresh button of the report can build it now, and why not.
pub const AN_CHECK_OK : i64 = 0;
