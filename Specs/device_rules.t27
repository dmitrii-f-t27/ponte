pub const DV_FX_OFFSETS : [73]u32 = [0, 20, 40, 59, 87, 109, 132, 135, 136, 149, 165, 174, 190, 194, 202, 209, 210, 219, 221, 235, 237, 249, 264, 281, 290, 291, 305, 317, 327, 338, 354, 360, 360, 362, 365, 371, 377, 391, 395, 405, 412, 421, 438, 448, 464, 489, 521, 545, 578, 596, 616, 783, 814, 839, 885, 914, 929, 951, 960, 1087, 1098, 1116, 1139, 1157, 1185, 1200, 1205, 1209, 1214, 1219, 1239, 1250, 1269];
pub const DV_FX_LENGTHS : [73]u32 = [20, 20, 19, 28, 22, 23, 3, 1, 13, 16, 9, 16, 4, 8, 7, 1, 9, 2, 14, 2, 12, 15, 17, 9, 1, 14, 12, 10, 11, 16, 6, 0, 2, 3, 6, 6, 14, 4, 10, 7, 9, 17, 10, 16, 25, 32, 24, 33, 18, 20, 167, 31, 25, 46, 29, 15, 22, 9, 127, 11, 18, 23, 18, 28, 15, 5, 4, 5, 5, 20, 11, 19, 12];
