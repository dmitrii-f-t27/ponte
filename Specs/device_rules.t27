; --- Echo risk (echoNone, echoSpeaker, echoMaybe) ----------------------------------------------------------
; None: headphones, virtual devices, mics. Speaker: a loudspeaker, show "use headphones".
; Maybe: cannot tell (Bluetooth, USB, other wired, unknown).
pub const DV_ECHO_NONE : i64 = 0;
pub const DV_ECHO_SPEAKER : i64 = 1;
pub const DV_ECHO_MAYBE : i64 = 2;

