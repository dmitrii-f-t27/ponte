// SPDX-License-Identifier: MIT
; Specs/device_rules.t27 -- Ponte: audio devices, the apps that can be captured, and their names
; Mirrors the device, app-catalog and text-helper parts of PonteAudio/AudioRules.swift one to one (same
; functions, codes, constants and order of checks; each function names the Swift function it mirrors).
; Every text argument lives in one buffer `text` of DV_TEXT_MAX bytes as an offset and a length; a list
; of texts is parallel offset and length arrays with a count (at most DV_LIST_MAX). A slice outside the
; buffer reads as empty. Text matching is ASCII case folding on UTF-8 bytes; equality is byte equality
; (Swift's String == also equates canonically equivalent forms; device names, UIDs and bundle IDs
; arrive in one form). ASCII only.
; Generated C: Sources/PonteSpecs/device_rules.h (Specs/generate.sh).

module PonteDeviceRules;

pub const DV_TEXT_MAX : i64 = 8192;
pub const DV_LIST_MAX : i64 = 256;

; parentChainMaxDepth: how many parent processes to walk up when looking for a process's owning app.
pub const DV_PARENT_CHAIN_MAX_DEPTH : i64 = 8;

; --- Device kinds (kind*) ---------------------------------------------------------------------------------
pub const DV_KIND_UNKNOWN : i64 = 0;
pub const DV_KIND_BUILT_IN_SPEAKER : i64 = 1;
pub const DV_KIND_BUILT_IN_HEADPHONES : i64 = 2;
pub const DV_KIND_BUILT_IN_MIC : i64 = 3;
; The virtual mic for the call app.
pub const DV_KIND_BLACKHOLE : i64 = 4;
; Classic and LE.
pub const DV_KIND_BLUETOOTH : i64 = 5;
pub const DV_KIND_USB : i64 = 6;
; HDMI / DisplayPort (monitor speakers).
pub const DV_KIND_DISPLAY : i64 = 7;
pub const DV_KIND_AIRPLAY : i64 = 8;
; A user aggregate or multi-output device.
pub const DV_KIND_AGGREGATE : i64 = 9;
; Ponte's own private tap aggregate.
pub const DV_KIND_PONTE_AGGREGATE : i64 = 10;
; Other virtual drivers (Zoom, Teams, Loopback...).
pub const DV_KIND_VIRTUAL : i64 = 11;
; iPhone as mic (Continuity Capture).
pub const DV_KIND_CONTINUITY : i64 = 12;
; PCI, FireWire, Thunderbolt, AVB.
pub const DV_KIND_OTHER_WIRED : i64 = 13;

