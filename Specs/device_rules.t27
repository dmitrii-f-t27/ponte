; --- Slices of the text buffer ----------------------------------------------------------------------------------
; A slice is readable when it lies inside the buffer.
pub fn dv_slice_ok(off: i64, len: i64) -> bool {
    return off >= 0 and len >= 0 and off <= DV_TEXT_MAX and len <= DV_TEXT_MAX - off;
}

; The length of a slice as read: 0 outside the buffer.
pub fn dv_slice_len(off: i64, len: i64) -> i64 {
    if (dv_slice_ok(off, len)) { return len; }
    return 0;
}

; foldedBytes on one byte: A-Z to a-z, other bytes unchanged.
pub fn dv_fold(c: u8) -> u8 {
    if (c >= DV_UPPER_A and c <= DV_UPPER_Z) { return c + DV_CASE_STEP; }
    return c;
}

; foldedBytes: writes the folded slice to out and returns its length.
pub fn dv_folded_bytes(text: [8192]u8, off: i64, len: i64, out: [8192]u8) -> i64 {
    var n: i64 = dv_slice_len(off, len);
    var i: i64 = 0;
    while (i < n) {
        out[i] = dv_fold(text[off + i]);
        i = i + 1;
    }
    return n;
}

; containsCI: the haystack slice contains the needle slice, ASCII case-insensitive; an empty needle matches.
pub fn dv_contains_ci(text: [8192]u8, hay_off: i64, hay_len: i64, needle_off: i64, needle_len: i64) -> bool {
    var h: i64 = dv_slice_len(hay_off, hay_len);
    var m: i64 = dv_slice_len(needle_off, needle_len);
    if (m == 0) { return true; }
    if (m > h) { return false; }
    var first: u8 = dv_fold(text[needle_off]);
    var start: i64 = 0;
    while (start <= h - m) {
        if (dv_fold(text[hay_off + start]) == first) {
            var k: i64 = 1;
            var same: bool = true;
            while (same and k < m) {
                if (dv_fold(text[hay_off + start + k]) != dv_fold(text[needle_off + k])) { same = false; }
                k = k + 1;
            }
            if (same) { return true; }
        }
        start = start + 1;
    }
    return false;
}

; containsCI with a needle from the row table.
pub fn dv_contains_row_ci(text: [8192]u8, hay_off: i64, hay_len: i64, row: i64) -> bool {
    var h: i64 = dv_slice_len(hay_off, hay_len);
    var off: i64 = DV_ROW_OFFSETS[row];
    var m: i64 = DV_ROW_LENGTHS[row];
    if (m == 0) { return true; }
    if (m > h) { return false; }
    var start: i64 = 0;
    while (start <= h - m) {
        var k: i64 = 0;
        var same: bool = true;
        while (same and k < m) {
            if (dv_fold(text[hay_off + start + k]) != dv_fold(DV_ROW_TEXT[off + k])) { same = false; }
            k = k + 1;
        }
        if (same) { return true; }
        start = start + 1;
    }
    return false;
}

; Byte equality of two slices.
pub fn dv_equal(text: [8192]u8, a_off: i64, a_len: i64, b_off: i64, b_len: i64) -> bool {
    var a: i64 = dv_slice_len(a_off, a_len);
    var b: i64 = dv_slice_len(b_off, b_len);
    if (a != b) { return false; }
    var i: i64 = 0;
    while (i < a) {
        if (text[a_off + i] != text[b_off + i]) { return false; }
        i = i + 1;
    }
    return true;
}

; Byte equality of a slice and a row.
pub fn dv_equal_row(text: [8192]u8, off: i64, len: i64, row: i64) -> bool {
    var n: i64 = dv_slice_len(off, len);
    var r_off: i64 = DV_ROW_OFFSETS[row];
    var m: i64 = DV_ROW_LENGTHS[row];
    if (n != m) { return false; }
    var i: i64 = 0;
    while (i < n) {
        if (text[off + i] != DV_ROW_TEXT[r_off + i]) { return false; }
        i = i + 1;
    }
    return true;
}

; Copies row `row` to out and returns its length.
pub fn dv_row_bytes(row: i64, out: [8192]u8) -> i64 {
    if (row < 0 or row >= DV_ROW_COUNT) { return 0; }
    var off: i64 = DV_ROW_OFFSETS[row];
    var n: i64 = DV_ROW_LENGTHS[row];
    var i: i64 = 0;
    while (i < n) {
        out[i] = DV_ROW_TEXT[off + i];
        i = i + 1;
    }
    return n;
}

; --- Devices -------------------------------------------------------------------------------------------------------
; isBlackHole: the name contains "blackhole" (ASCII case-insensitive).
pub fn dv_is_blackhole(text: [8192]u8, name_off: i64, name_len: i64) -> bool {
    return dv_contains_row_ci(text, name_off, name_len, DV_ROW_BLACKHOLE);
}

; isPonteAggregate: the UID starts with "ai.ponte.tap." (exact bytes).
pub fn dv_is_ponte_aggregate(text: [8192]u8, uid_off: i64, uid_len: i64) -> bool {
    var n: i64 = dv_slice_len(uid_off, uid_len);
    var p_off: i64 = DV_ROW_OFFSETS[DV_ROW_PONTE_PREFIX];
    var m: i64 = DV_ROW_LENGTHS[DV_ROW_PONTE_PREFIX];
    if (n < m) { return false; }
    var i: i64 = 0;
    while (i < m) {
        if (text[uid_off + i] != DV_ROW_TEXT[p_off + i]) { return false; }
        i = i + 1;
    }
    return true;
}

; deviceKind: Ponte aggregate (UID prefix), then BlackHole (name), then the transport type. Built-in:
; "headphone" in the UID or name is headphones; else output channels make a speaker, input channels a mic.
pub fn dv_device_kind(text: [8192]u8, name_off: i64, name_len: i64, uid_off: i64, uid_len: i64, transport_type: u32, input_channels: i64, output_channels: i64) -> i64 {
    if (dv_is_ponte_aggregate(text, uid_off, uid_len)) { return DV_KIND_PONTE_AGGREGATE; }
    if (dv_is_blackhole(text, name_off, name_len)) { return DV_KIND_BLACKHOLE; }
    var t: u32 = transport_type;
    if (t == DV_TRANSPORT_BUILT_IN) {
        if (dv_contains_row_ci(text, uid_off, uid_len, DV_ROW_HEADPHONE) or dv_contains_row_ci(text, name_off, name_len, DV_ROW_HEADPHONE)) {
            return DV_KIND_BUILT_IN_HEADPHONES;
        }
        if (output_channels > 0) { return DV_KIND_BUILT_IN_SPEAKER; }
        if (input_channels > 0) { return DV_KIND_BUILT_IN_MIC; }
        return DV_KIND_UNKNOWN;
    }
    if (t == DV_TRANSPORT_BLUETOOTH or t == DV_TRANSPORT_BLUETOOTH_LE) { return DV_KIND_BLUETOOTH; }
    if (t == DV_TRANSPORT_USB) { return DV_KIND_USB; }
    if (t == DV_TRANSPORT_HDMI or t == DV_TRANSPORT_DISPLAYPORT) { return DV_KIND_DISPLAY; }
    if (t == DV_TRANSPORT_AIRPLAY) { return DV_KIND_AIRPLAY; }
    if (t == DV_TRANSPORT_AGGREGATE) { return DV_KIND_AGGREGATE; }
    if (t == DV_TRANSPORT_VIRTUAL) { return DV_KIND_VIRTUAL; }
    if (t == DV_TRANSPORT_CONTINUITY_WIRED or t == DV_TRANSPORT_CONTINUITY_WIRELESS) { return DV_KIND_CONTINUITY; }
    if (t == DV_TRANSPORT_PCI or t == DV_TRANSPORT_FIREWIRE or t == DV_TRANSPORT_THUNDERBOLT or t == DV_TRANSPORT_AVB) {
        return DV_KIND_OTHER_WIRED;
    }
    return DV_KIND_UNKNOWN;
}

; echoRisk: of playing the other side's voice on an output of this kind.
pub fn dv_echo_risk(kind: i64) -> i64 {
    if (kind == DV_KIND_BUILT_IN_SPEAKER or kind == DV_KIND_DISPLAY or kind == DV_KIND_AIRPLAY) { return DV_ECHO_SPEAKER; }
    if (kind == DV_KIND_BLUETOOTH or kind == DV_KIND_USB or kind == DV_KIND_OTHER_WIRED or kind == DV_KIND_UNKNOWN) { return DV_ECHO_MAYBE; }
    return DV_ECHO_NONE;
}

; isExcludedForMonitoring: never "my microphone" or "my headphones": the call's virtual mic, Ponte's tap.
pub fn dv_is_excluded_for_monitoring(kind: i64) -> bool {
    return kind == DV_KIND_BLACKHOLE or kind == DV_KIND_PONTE_AGGREGATE;
}

; A list count as read: at most DV_LIST_MAX.
pub fn dv_list_count(count: i64) -> i64 {
    if (count < 0) { return 0; }
    if (count > DV_LIST_MAX) { return DV_LIST_MAX; }
    return count;
}

; pickBlackHoleIndex: among BlackHole devices with output channels, the first whose name contains "2ch",
; else the first. -1 if none.
pub fn dv_pick_blackhole_index(text: [8192]u8, name_offsets: [256]u32, name_lengths: [256]u32, output_channels: [256]i64, count: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var first: i64 = -1;
    var i: i64 = 0;
    while (i < n) {
        if (dv_is_blackhole(text, name_offsets[i], name_lengths[i]) and output_channels[i] > 0) {
            if (dv_contains_row_ci(text, name_offsets[i], name_lengths[i], DV_ROW_TWO_CH)) { return i; }
            if (first < 0) { first = i; }
        }
        i = i + 1;
    }
    return first;
}

; Usable as a monitoring device: has channels in that direction and is not excluded.
pub fn dv_usable(kind: i64, channels: i64) -> bool {
    return channels > 0 and dv_is_excluded_for_monitoring(kind) == false;
}

; pickMicIndex: the default input if usable; else the first usable built-in mic; else the first usable. -1 if none.
pub fn dv_pick_mic_index(kinds: [256]i64, input_channels: [256]i64, count: i64, default_index: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    if (default_index >= 0 and default_index < n) {
        if (dv_usable(kinds[default_index], input_channels[default_index])) { return default_index; }
    }
    var i: i64 = 0;
    while (i < n) {
        if (dv_usable(kinds[i], input_channels[i]) and kinds[i] == DV_KIND_BUILT_IN_MIC) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (dv_usable(kinds[i], input_channels[i])) { return i; }
        i = i + 1;
    }
    return -1;
}

; pickListenOutputIndex: the default output if usable; else by kind priority built-in headphones,
; Bluetooth, USB, built-in speaker; else the first usable. -1 if none.
pub fn dv_pick_listen_output_index(kinds: [256]i64, output_channels: [256]i64, count: i64, default_index: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    if (default_index >= 0 and default_index < n) {
        if (dv_usable(kinds[default_index], output_channels[default_index])) { return default_index; }
    }
    var p: i64 = 0;
    while (p < 4) {
        var i: i64 = 0;
        while (i < n) {
            if (dv_usable(kinds[i], output_channels[i]) and kinds[i] == DV_LISTEN_PRIORITY[p]) { return i; }
            i = i + 1;
        }
        p = p + 1;
    }
    var j: i64 = 0;
    while (j < n) {
        if (dv_usable(kinds[j], output_channels[j])) { return j; }
        j = j + 1;
    }
    return -1;
}

; matchDeviceIndex: the first exact UID, then the first exact name, then the first name containing the
; query (ASCII case-insensitive). -1 if none.
pub fn dv_match_device_index(text: [8192]u8, query_off: i64, query_len: i64, name_offsets: [256]u32, name_lengths: [256]u32, uid_offsets: [256]u32, uid_lengths: [256]u32, count: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var i: i64 = 0;
    while (i < n) {
        if (dv_equal(text, uid_offsets[i], uid_lengths[i], query_off, query_len)) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (dv_equal(text, name_offsets[i], name_lengths[i], query_off, query_len)) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (dv_contains_ci(text, name_offsets[i], name_lengths[i], query_off, query_len)) { return i; }
        i = i + 1;
    }
    return -1;
}

; --- App catalog ------------------------------------------------------------------------------------------------------
; knownCallAppIndex: the index into the known call apps (sorted by bundle ID, exact match), or -1.
pub fn dv_known_call_app_index(text: [8192]u8, id_off: i64, id_len: i64) -> i64 {
    var i: i64 = 0;
    while (i < DV_CALL_APPS) {
        if (dv_equal_row(text, id_off, id_len, DV_ROW_FIRST_APP + i)) { return i; }
        i = i + 1;
    }
    return -1;
}

; isKnownCallApp
pub fn dv_is_known_call_app(text: [8192]u8, id_off: i64, id_len: i64) -> bool {
    return dv_known_call_app_index(text, id_off, id_len) >= 0;
}

; knownCallAppBundleIDs[index] and knownCallAppLabels[index]: written to out, their length returned (0: none).
pub fn dv_call_app_bundle_id(index: i64, out: [8192]u8) -> i64 {
    if (index < 0 or index >= DV_CALL_APPS) { return 0; }
    return dv_row_bytes(DV_ROW_FIRST_APP + index, out);
}

pub fn dv_call_app_label(index: i64, out: [8192]u8) -> i64 {
    if (index < 0 or index >= DV_CALL_APPS) { return 0; }
    return dv_row_bytes(DV_ROW_FIRST_LABEL + index, out);
}

; isCompanionProcess: a process that carries a call app's audio without belonging to it (FaceTime calls
; run in avconferenced and TelephonyUtilities).
pub fn dv_is_companion_process(text: [8192]u8, process_off: i64, process_len: i64, target_off: i64, target_len: i64) -> bool {
    var i: i64 = 0;
    while (i < DV_COMPANIONS) {
        if (dv_equal_row(text, target_off, target_len, DV_ROW_FIRST_COMPANION_TARGET + i) and dv_equal_row(text, process_off, process_len, DV_ROW_FIRST_COMPANION_PROCESS + i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

; isTapTargetProcess: never Ponte itself; the owner is the target, or the process's own bundle ID (not
; empty) is the target, or it is a companion of the target.
pub fn dv_is_tap_target_process(text: [8192]u8, process_off: i64, process_len: i64, owner_off: i64, owner_len: i64, target_off: i64, target_len: i64, pid: i32, self_pid: i32) -> bool {
    if (pid == self_pid) { return false; }
    if (dv_equal(text, owner_off, owner_len, target_off, target_len)) { return true; }
    if (dv_slice_len(process_off, process_len) > 0 and dv_equal(text, process_off, process_len, target_off, target_len)) { return true; }
    return dv_is_companion_process(text, process_off, process_len, target_off, target_len);
}

; parentAppIndex: the index of the longest non-empty app ID such that the helper ID starts with it plus
; "." (com.google.Chrome.helper -> com.google.Chrome); the first of equal lengths wins. -1 if none.
pub fn dv_parent_app_index(text: [8192]u8, helper_off: i64, helper_len: i64, app_offsets: [256]u32, app_lengths: [256]u32, count: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var h: i64 = dv_slice_len(helper_off, helper_len);
    var best: i64 = -1;
    var best_length: i64 = -1;
    var i: i64 = 0;
    while (i < n) {
        var a_off: i64 = app_offsets[i];
        var a: i64 = dv_slice_len(a_off, app_lengths[i]);
        if (a > 0 and a + 1 <= h and a + 1 > best_length) {
            var same: bool = text[helper_off + a] == DV_DOT;
            var k: i64 = 0;
            while (same and k < a) {
                if (text[helper_off + k] != text[a_off + k]) { same = false; }
                k = k + 1;
            }
            if (same) {
                best = i;
                best_length = a + 1;
            }
        }
        i = i + 1;
    }
    return best;
}

; outermostAppPathLength: the byte length of the path up to and including the first component ending
; in ".app" (the component must have a name before ".app"). -1 if none.
pub fn dv_outermost_app_path_length(text: [8192]u8, path_off: i64, path_len: i64) -> i64 {
    var n: i64 = dv_slice_len(path_off, path_len);
    var s_off: i64 = DV_ROW_OFFSETS[DV_ROW_APP_SUFFIX];
    var s: i64 = DV_ROW_LENGTHS[DV_ROW_APP_SUFFIX];
    var i: i64 = 0;
    while (i + s <= n) {
        var same: bool = true;
        var k: i64 = 0;
        while (same and k < s) {
            if (text[path_off + i + k] != DV_ROW_TEXT[s_off + k]) { same = false; }
            k = k + 1;
        }
        if (same) {
            var end: i64 = i + s;
            var component_start: i64 = 0;
            var j: i64 = i - 1;
            while (j >= 0) {
                if (text[path_off + j] == DV_SLASH) {
                    component_start = j + 1;
                    j = -1;
                } else {
                    j = j - 1;
                }
            }
            if ((end == n or text[path_off + end] == DV_SLASH) and i > component_start) { return end; }
        }
        i = i + 1;
    }
    return -1;
}

; ownerSource: the first true source wins, in this order.
pub fn dv_owner_source(self_is_regular_app: bool, has_app_bundle_path: bool, has_responsible_app: bool, has_regular_parent_app: bool, has_prefix_parent: bool) -> i64 {
    if (self_is_regular_app) { return DV_OWNER_SELF; }
    if (has_app_bundle_path) { return DV_OWNER_APP_BUNDLE_PATH; }
    if (has_responsible_app) { return DV_OWNER_RESPONSIBLE; }
    if (has_regular_parent_app) { return DV_OWNER_PARENT; }
    if (has_prefix_parent) { return DV_OWNER_BUNDLE_PREFIX; }
    return DV_OWNER_FALLBACK;
}

; isSelfProcess: Ponte's own process never appears as a source.
pub fn dv_is_self_process(pid: i32, owner_pid: i32, self_pid: i32) -> bool {
    return pid == self_pid or owner_pid == self_pid;
}

; shouldListApp: a Dock app, anything playing now, or a known call app.
pub fn dv_should_list_app(is_regular_app: bool, is_playing: bool, is_known_call_app: bool) -> bool {
    return is_regular_app or is_playing or is_known_call_app;
}

; appRank: 0 playing call app, 1 other playing app, 2 idle call app, 3 the rest.
pub fn dv_app_rank(is_known_call_app: bool, is_playing: bool) -> i64 {
    if (is_known_call_app and is_playing) { return DV_RANK_PLAYING_CALL_APP; }
    if (is_playing) { return DV_RANK_PLAYING; }
    if (is_known_call_app) { return DV_RANK_IDLE_CALL_APP; }
    return DV_RANK_OTHER;
}

; Does entry a come before entry b: rank, then the case-folded name bytes (a shorter prefix first),
; then the index.
pub fn dv_app_before(ranks: [256]i64, text: [8192]u8, name_offsets: [256]u32, name_lengths: [256]u32, a: i64, b: i64) -> bool {
    if (ranks[a] != ranks[b]) { return ranks[a] < ranks[b]; }
    var a_off: i64 = name_offsets[a];
    var b_off: i64 = name_offsets[b];
    var a_len: i64 = dv_slice_len(a_off, name_lengths[a]);
    var b_len: i64 = dv_slice_len(b_off, name_lengths[b]);
    var i: i64 = 0;
    while (i < a_len and i < b_len) {
        var x: u8 = dv_fold(text[a_off + i]);
        var y: u8 = dv_fold(text[b_off + i]);
        if (x != y) { return x < y; }
        i = i + 1;
    }
    if (a_len != b_len) { return a_len < b_len; }
    return a < b;
}

; appSortOrder: writes the indices 0..<count to order, sorted by dv_app_before (a total order, so the
; result equals Swift's sort), and returns the count written.
pub fn dv_app_sort_order(ranks: [256]i64, text: [8192]u8, name_offsets: [256]u32, name_lengths: [256]u32, count: i64, order: [256]i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var i: i64 = 0;
    while (i < n) {
        order[i] = i;
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        var item: i64 = order[i];
        var j: i64 = i - 1;
        var moving: bool = true;
        while (moving and j >= 0) {
            if (dv_app_before(ranks, text, name_offsets, name_lengths, item, order[j])) {
                order[j + 1] = order[j];
                j = j - 1;
            } else {
                moving = false;
            }
        }
        order[j + 1] = item;
        i = i + 1;
    }
    return n;
}

; --- Rules moved here from AudioProcesses, RunningAudioAppCatalog and the app (2026-10-11) -------------------------
; Where a process's owner ID comes from: the HAL's bundle ID, the app's, or "pid.<n>".
pub const DV_ID_HAL : i64 = 0;
pub const DV_ID_APP : i64 = 1;
pub const DV_ID_PID : i64 = 2;
; Where its display name comes from: the app's name, the executable's file name, or the ID.
pub const DV_NAME_APP : i64 = 0;
pub const DV_NAME_PATH : i64 = 1;
pub const DV_NAME_ID : i64 = 2;
; The name of an app found by its bundle path: the running app's, CFBundleDisplayName, CFBundleName, the file.
pub const DV_BUNDLE_NAME_RUNNING : i64 = 0;
pub const DV_BUNDLE_NAME_DISPLAY : i64 = 1;
pub const DV_BUNDLE_NAME_BUNDLE : i64 = 2;
pub const DV_BUNDLE_NAME_FILE : i64 = 3;
; PID 1 is launchd: never an owner.
pub const DV_LAUNCHD_PID : i32 = 1;

; A regular (Dock) app with a bundle ID.
pub fn dv_is_regular_app(regular_policy: bool, has_bundle_id: bool) -> bool {
    return regular_policy and has_bundle_id;
}

; The HAL reports a PID; a real process has a positive one.
pub fn dv_process_pid_valid(pid: i32) -> bool {
    return pid > 0;
}

; The responsible process counts when it is another process and not launchd.
pub fn dv_responsible_usable(responsible_pid: i32, pid: i32) -> bool {
    return responsible_pid != pid and responsible_pid > DV_LAUNCHD_PID;
}

; The walk up the parents goes on while the parent is not launchd and not the process itself.
pub fn dv_parent_continues(parent_pid: i32, current: i32) -> bool {
    return parent_pid > DV_LAUNCHD_PID and parent_pid != current;
}

pub fn dv_owner_id_source(has_hal_id: bool, has_app_id: bool) -> i64 {
    if (has_hal_id) { return DV_ID_HAL; }
    if (has_app_id) { return DV_ID_APP; }
    return DV_ID_PID;
}

pub fn dv_owner_name_source(has_app_name: bool, has_path: bool) -> i64 {
    if (has_app_name) { return DV_NAME_APP; }
    if (has_path) { return DV_NAME_PATH; }
    return DV_NAME_ID;
}

pub fn dv_bundle_name_source(has_running_name: bool, has_display_name: bool, has_bundle_name: bool) -> i64 {
    if (has_running_name) { return DV_BUNDLE_NAME_RUNNING; }
    if (has_display_name) { return DV_BUNDLE_NAME_DISPLAY; }
    if (has_bundle_name) { return DV_BUNDLE_NAME_BUNDLE; }
    return DV_BUNDLE_NAME_FILE;
}

; An app found by its bundle path is regular if its running instance is, else if the process itself is.
pub fn dv_path_owner_regular(has_running: bool, running_regular: bool, has_self: bool, self_regular: bool) -> bool {
    if (has_running) { return running_regular; }
    if (has_self) { return self_regular; }
    return false;
}

; An app plays when any of its processes plays.
pub fn dv_app_playing(already_playing: bool, process_playing: bool) -> bool {
    return already_playing or process_playing;
}

; While grouping processes under an app, a regular owner record replaces one that is not.
pub fn dv_prefers_owner(candidate_regular: bool, current_regular: bool) -> bool {
    return candidate_regular and current_regular == false;
}

; Listening on a loudspeaker: ask for headphones.
pub fn dv_needs_headphones(kind: i64) -> bool {
    return dv_echo_risk(kind) == DV_ECHO_SPEAKER;
}

; --- The checklist "before the call" (owner 2026-10-13) ---------------------------------------------------------------
; Live test 2026-10-13: Meet's microphone was muted; Meet fell back from BlackHole to the MacBook microphone (the
; other side heard nothing, or the Russian voice); a browser extension replaced the microphone; without headphones
; the microphone heard the other side. Core Audio lists, per client process, the devices it uses for input
; (kAudioProcessPropertyDevices, input scope) and whether its input runs (kAudioProcessPropertyIsRunningInput).
; A reader is one (process, input device) pair; Swift resolves the process's owning app as for the taps.

; The role of a reading process: Ponte (this process, or any instance of Ponte), the call app, or another program.
pub const DV_READER_PONTE : i64 = 0;
pub const DV_READER_CALL : i64 = 1;
pub const DV_READER_OTHER : i64 = 2;
; What one pair means for the call: nothing; the call app reads BlackHole; another program reads BlackHole;
; the call app reads a real microphone.
pub const DV_USE_NONE : i64 = 0;
pub const DV_USE_CALL_BLACKHOLE : i64 = 1;
pub const DV_USE_OTHER_BLACKHOLE : i64 = 2;
pub const DV_USE_CALL_REAL_MIC : i64 = 3;
; Who listens to BlackHole. UNKNOWN: the process list could not be read. OK: a program other than Ponte reads
; BlackHole. NOBODY: no one but Ponte does. REAL_MIC: the call app reads a real microphone and not BlackHole
; (the other side hears the Russian voice). BOTH: the call app reads BlackHole and a real microphone (which one
; the call uses cannot be told). NO_BLACKHOLE: BlackHole is not installed.
pub const DV_LISTEN_UNKNOWN : i64 = 0;
pub const DV_LISTEN_OK : i64 = 1;
pub const DV_LISTEN_NOBODY : i64 = 2;
pub const DV_LISTEN_REAL_MIC : i64 = 3;
pub const DV_LISTEN_BOTH : i64 = 4;
pub const DV_LISTEN_NO_BLACKHOLE : i64 = 5;

; isPonteID: the bundle ID is Ponte's (exact bytes).
pub fn dv_is_ponte_id(text: [8192]u8, id_off: i64, id_len: i64) -> bool {
    return dv_equal_row(text, id_off, id_len, DV_ROW_PONTE_ID);
}

; readerRole: Ponte when it is this process or its owning app is Ponte; with a chosen app (has_target), the
; call app when the owner is the target or a companion of it (FaceTime's avconferenced); with all Mac audio
; chosen, the call app when the owner is a known call app; else another program.
pub fn dv_reader_role(text: [8192]u8, owner_off: i64, owner_len: i64, target_off: i64, target_len: i64, has_target: bool, pid: i32, self_pid: i32) -> i64 {
    if (pid == self_pid or dv_is_ponte_id(text, owner_off, owner_len)) { return DV_READER_PONTE; }
    if (has_target) {
        if (dv_equal(text, owner_off, owner_len, target_off, target_len) or dv_is_companion_process(text, owner_off, owner_len, target_off, target_len)) {
            return DV_READER_CALL;
        }
        return DV_READER_OTHER;
    }
    if (dv_is_known_call_app(text, owner_off, owner_len)) { return DV_READER_CALL; }
    return DV_READER_OTHER;
}

; isRealMicKind: a device a person speaks into. BlackHole, Ponte's tap, other virtual drivers and aggregates
; carry other programs' audio, so reading them is not "the other side hears your voice".
pub fn dv_is_real_mic_kind(kind: i64) -> bool {
    return kind != DV_KIND_BLACKHOLE and kind != DV_KIND_PONTE_AGGREGATE and kind != DV_KIND_VIRTUAL and kind != DV_KIND_AGGREGATE;
}

; readerUse: only a running input counts, and Ponte never does. BlackHole read by the call app or by another
; program; a real microphone matters only when the call app reads it.
pub fn dv_reader_use(role: i64, kind: i64, running_input: bool) -> i64 {
    if (running_input == false or role == DV_READER_PONTE) { return DV_USE_NONE; }
    if (kind == DV_KIND_BLACKHOLE) {
        if (role == DV_READER_CALL) { return DV_USE_CALL_BLACKHOLE; }
        return DV_USE_OTHER_BLACKHOLE;
    }
    if (role == DV_READER_CALL and dv_is_real_mic_kind(kind)) { return DV_USE_CALL_REAL_MIC; }
    return DV_USE_NONE;
}

; listenStatus: from every pair's use. No BlackHole first, then an unread process list; the call app on a real
; microphone wins over any BlackHole reader (BOTH when the call app also reads BlackHole); then any BlackHole
; reader is OK; else NOBODY.
pub fn dv_listen_status(uses: [256]i64, count: i64, listed: bool, blackhole_present: bool) -> i64 {
    if (blackhole_present == false) { return DV_LISTEN_NO_BLACKHOLE; }
    if (listed == false) { return DV_LISTEN_UNKNOWN; }
    var n: i64 = dv_list_count(count);
    var call_blackhole: bool = false;
    var other_blackhole: bool = false;
    var call_mic: bool = false;
    var i: i64 = 0;
    while (i < n) {
        if (uses[i] == DV_USE_CALL_BLACKHOLE) { call_blackhole = true; }
        if (uses[i] == DV_USE_OTHER_BLACKHOLE) { other_blackhole = true; }
        if (uses[i] == DV_USE_CALL_REAL_MIC) { call_mic = true; }
        i = i + 1;
    }
    if (call_mic) {
        if (call_blackhole) { return DV_LISTEN_BOTH; }
        return DV_LISTEN_REAL_MIC;
    }
    if (call_blackhole or other_blackhole) { return DV_LISTEN_OK; }
    return DV_LISTEN_NOBODY;
}

; The first pair with this use, or -1.
pub fn dv_first_use(uses: [256]i64, count: i64, wanted: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var i: i64 = 0;
    while (i < n) {
        if (uses[i] == wanted) { return i; }
        i = i + 1;
    }
    return -1;
}

; listenIndex: the pair the status names: the call app's real microphone; else the call app on BlackHole; else
; another program on BlackHole. -1 if none.
pub fn dv_listen_index(uses: [256]i64, count: i64) -> i64 {
    var i: i64 = dv_first_use(uses, count, DV_USE_CALL_REAL_MIC);
    if (i >= 0) { return i; }
    i = dv_first_use(uses, count, DV_USE_CALL_BLACKHOLE);
    if (i >= 0) { return i; }
    return dv_first_use(uses, count, DV_USE_OTHER_BLACKHOLE);
}

; isHeadphonesLike: the listening output is headphones or a headset: the headphone jack, Bluetooth or USB.
pub fn dv_is_headphones_like(kind: i64) -> bool {
    return kind == DV_KIND_BUILT_IN_HEADPHONES or kind == DV_KIND_BLUETOOTH or kind == DV_KIND_USB;
}

; Never Ponte's microphone: BlackHole, Ponte's tap, an iPhone (Continuity).
pub fn dv_auto_mic_allowed(kind: i64, channels: i64) -> bool {
    return channels > 0 and dv_is_excluded_for_monitoring(kind) == false and kind != DV_KIND_CONTINUITY;
}

; The headset's microphone for listening output `output`: device i is the output itself, or has the output's
; kind and its name, or both are the headphone jack.
pub fn dv_headset_mic_matches(text: [8192]u8, name_offsets: [256]u32, name_lengths: [256]u32, kinds: [256]i64, i: i64, output: i64) -> bool {
    if (i == output) { return true; }
    if (kinds[i] != kinds[output]) { return false; }
    if (kinds[i] == DV_KIND_BUILT_IN_HEADPHONES) { return true; }
    return dv_equal(text, name_offsets[i], name_lengths[i], name_offsets[output], name_lengths[output]);
}

; pickAutoMicIndex: Ponte's microphone when none is chosen in the settings (owner 2026-10-13). When the
; listening output (output_index; -1: none) is headphones-like, the first allowed microphone of that headset
; (dv_headset_mic_matches: AirPods, a USB headset, the jack's microphone). Otherwise the first built-in
; microphone. Otherwise the first allowed real microphone. Never BlackHole, Ponte's tap or an iPhone. -1 if none.
pub fn dv_pick_auto_mic_index(text: [8192]u8, name_offsets: [256]u32, name_lengths: [256]u32, kinds: [256]i64, input_channels: [256]i64, count: i64, output_index: i64) -> i64 {
    var n: i64 = dv_list_count(count);
    var i: i64 = 0;
    if (output_index >= 0 and output_index < n) {
        if (dv_is_headphones_like(kinds[output_index])) {
            while (i < n) {
                if (dv_auto_mic_allowed(kinds[i], input_channels[i]) and dv_headset_mic_matches(text, name_offsets, name_lengths, kinds, i, output_index)) {
                    return i;
                }
                i = i + 1;
            }
        }
    }
    i = 0;
    while (i < n) {
        if (dv_auto_mic_allowed(kinds[i], input_channels[i]) and kinds[i] == DV_KIND_BUILT_IN_MIC) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if (dv_auto_mic_allowed(kinds[i], input_channels[i]) and dv_is_real_mic_kind(kinds[i])) { return i; }
        i = i + 1;
    }
    return -1;
}

; --- Texts for the tests -----------------------------------------------------------------------------------------------
; Copies text fixture `index` to text at `at` and returns its length (0 for an unknown index).
pub fn dv_fixture(index: i64, text: [8192]u8, at: i64) -> i64 {
    if (index < 0 or index >= DV_FX_COUNT or at < 0) { return 0; }
    var off: i64 = DV_FX_OFFSETS[index];
    var len: i64 = DV_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and at + k < DV_TEXT_MAX) {
        text[at + k] = DV_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; Appends fixture `index` to a list: writes it at `at`, records its offset and length at `slot`, and
; returns the next free position.
pub fn dv_fixture_push(index: i64, text: [8192]u8, at: i64, offsets: [256]u32, lengths: [256]u32, slot: i64) -> i64 {
    var n: i64 = dv_fixture(index, text, at);
    offsets[slot] = cast_u32(at);
    lengths[slot] = cast_u32(n);
    return at + n;
}

test dv_text_helpers {
    var t: [8192]u8 = [0; 8192];
    var out: [8192]u8 = [0; 8192];
    // nameRules
    var a: i64 = dv_fixture(DV_FX_BH_2CH, t, 0);
    assert dv_is_blackhole(t, 0, a) == true;
    a = dv_fixture(DV_FX_BH_16CH_LOWER, t, 0);
    assert dv_is_blackhole(t, 0, a) == true;
    a = dv_fixture(DV_FX_MY_BLACKHOLE, t, 0);
    assert dv_is_blackhole(t, 0, a) == true;
    a = dv_fixture(DV_FX_BLACK_HOLE, t, 0);
    assert dv_is_blackhole(t, 0, a) == false;
    a = dv_fixture(DV_FX_MBP_SPEAKERS, t, 0);
    assert dv_is_blackhole(t, 0, a) == false;
    a = dv_fixture(DV_FX_PONTE_ABC, t, 0);
    assert dv_is_ponte_aggregate(t, 0, a) == true;
    a = dv_fixture(DV_FX_PONTE_TA, t, 0);
    assert dv_is_ponte_aggregate(t, 0, a) == false;
    a = dv_fixture(DV_FX_MBP_SPEAKERS, t, 0);
    var b: i64 = dv_fixture(DV_FX_PRO_SP, t, 100);
    assert dv_contains_ci(t, 0, a, 100, b) == true;
    a = dv_fixture(DV_FX_X, t, 0);
    assert dv_contains_ci(t, 0, a, 100, 0) == true;
    a = dv_fixture(DV_FX_AB, t, 0);
    b = dv_fixture(DV_FX_ABC, t, 100);
    assert dv_contains_ci(t, 0, a, 100, b) == false;
    a = dv_fixture(DV_FX_ABZ_C, t, 0);
    var folded: i64 = dv_folded_bytes(t, 0, a, out);
    b = dv_fixture(DV_FX_ABZ_C_FOLDED, t, 100);
    assert folded == b;
    var k: i64 = 0;
    var bad: u32 = 0;
    while (k < b) {
        if (out[k] != t[100 + k]) { bad = bad + 1; }
        k = k + 1;
    }
    assert bad == 0;
    // Folding changes exactly the 26 ASCII capitals.
    var c: u32 = 0;
    var changed: u32 = 0;
    while (c < 256) {
        var byte: u8 = cast_u8(c);
        if (dv_fold(byte) != byte) { changed = changed + 1; }
        c = c + 1;
    }
    assert changed == 26;
    // A slice outside the buffer reads as empty.
    assert dv_slice_len(8190, 5) == 0;
    assert dv_slice_len(-1, 2) == 0;
    assert dv_slice_len(8190, 2) == 2;
}

test dv_device_kinds {
    var t: [8192]u8 = [0; 8192];
    var n: i64 = dv_fixture(DV_FX_MBP_SPEAKERS, t, 0);
    var u: i64 = dv_fixture(DV_FX_UID_SPEAKER, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BUILT_IN, 0, 2) == DV_KIND_BUILT_IN_SPEAKER;
    n = dv_fixture(DV_FX_EXT_HEADPHONES, t, 0);
    u = dv_fixture(DV_FX_UID_HEADPHONE, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BUILT_IN, 0, 2) == DV_KIND_BUILT_IN_HEADPHONES;
    n = dv_fixture(DV_FX_MBP_MIC, t, 0);
    u = dv_fixture(DV_FX_UID_MIC, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BUILT_IN, 1, 0) == DV_KIND_BUILT_IN_MIC;
    n = dv_fixture(DV_FX_ODD, t, 0);
    u = dv_fixture(DV_FX_X, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BUILT_IN, 0, 0) == DV_KIND_UNKNOWN;
    n = dv_fixture(DV_FX_BH_2CH, t, 0);
    u = dv_fixture(DV_FX_UID_BH, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_VIRTUAL, 2, 2) == DV_KIND_BLACKHOLE;
    n = dv_fixture(DV_FX_PONTE_TAP, t, 0);
    u = dv_fixture(DV_FX_UID_PONTE, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_AGGREGATE, 2, 0) == DV_KIND_PONTE_AGGREGATE;
    n = dv_fixture(DV_FX_S6L, t, 0);
    u = dv_fixture(DV_FX_UID_S6L, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BLUETOOTH, 0, 2) == DV_KIND_BLUETOOTH;
    n = dv_fixture(DV_FX_AIRPODS, t, 0);
    u = dv_fixture(DV_FX_A, t, 100);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_BLUETOOTH_LE, 1, 2) == DV_KIND_BLUETOOTH;
    n = dv_fixture(DV_FX_USB_AUDIO, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_USB, 2, 2) == DV_KIND_USB;
    n = dv_fixture(DV_FX_LG, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_HDMI, 0, 2) == DV_KIND_DISPLAY;
    n = dv_fixture(DV_FX_STUDIO_DISPLAY, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_DISPLAYPORT, 0, 2) == DV_KIND_DISPLAY;
    n = dv_fixture(DV_FX_TV, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_AIRPLAY, 0, 2) == DV_KIND_AIRPLAY;
    n = dv_fixture(DV_FX_MULTI_OUTPUT, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_AGGREGATE, 0, 2) == DV_KIND_AGGREGATE;
    n = dv_fixture(DV_FX_ZOOM_DEVICE, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_VIRTUAL, 2, 2) == DV_KIND_VIRTUAL;
    n = dv_fixture(DV_FX_IPHONE_MIC, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_CONTINUITY_WIRELESS, 1, 0) == DV_KIND_CONTINUITY;
    n = dv_fixture(DV_FX_INTERFACE, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, DV_TRANSPORT_THUNDERBOLT, 2, 2) == DV_KIND_OTHER_WIRED;
    n = dv_fixture(DV_FX_QUESTION, t, 0);
    assert dv_device_kind(t, 0, n, 100, u, 0, 1, 1) == DV_KIND_UNKNOWN;
    // echoRiskByKind
    assert dv_echo_risk(DV_KIND_BUILT_IN_SPEAKER) == DV_ECHO_SPEAKER;
    assert dv_echo_risk(DV_KIND_DISPLAY) == DV_ECHO_SPEAKER;
    assert dv_echo_risk(DV_KIND_AIRPLAY) == DV_ECHO_SPEAKER;
    assert dv_echo_risk(DV_KIND_BUILT_IN_HEADPHONES) == DV_ECHO_NONE;
    assert dv_echo_risk(DV_KIND_BLACKHOLE) == DV_ECHO_NONE;
    assert dv_echo_risk(DV_KIND_VIRTUAL) == DV_ECHO_NONE;
    assert dv_echo_risk(DV_KIND_BLUETOOTH) == DV_ECHO_MAYBE;
    assert dv_echo_risk(DV_KIND_USB) == DV_ECHO_MAYBE;
    assert dv_echo_risk(DV_KIND_UNKNOWN) == DV_ECHO_MAYBE;
    // Every kind has one of the three risks; only BlackHole and Ponte's tap are excluded.
    var kind: i64 = 0;
    var bad: u32 = 0;
    var excluded: u32 = 0;
    while (kind <= DV_KIND_OTHER_WIRED) {
        var r: i64 = dv_echo_risk(kind);
        if (r < DV_ECHO_NONE or r > DV_ECHO_MAYBE) { bad = bad + 1; }
        if (dv_is_excluded_for_monitoring(kind)) { excluded = excluded + 1; }
        kind = kind + 1;
    }
    assert bad == 0;
    assert excluded == 2;
}

test dv_device_picks {
    var t: [8192]u8 = [0; 8192];
    var offs: [256]u32 = [0; 256];
    var lens: [256]u32 = [0; 256];
    var uoffs: [256]u32 = [0; 256];
    var ulens: [256]u32 = [0; 256];
    var outs: [256]i64 = [0; 256];
    var kinds: [256]i64 = [0; 256];
    var ins: [256]i64 = [0; 256];
    // pickBlackHoleIndex: prefer 2ch, must have outputs.
    var at: i64 = dv_fixture_push(DV_FX_MBP_SPEAKERS, t, 0, offs, lens, 0);
    at = dv_fixture_push(DV_FX_BH_16CH, t, at, offs, lens, 1);
    at = dv_fixture_push(DV_FX_BH_2CH, t, at, offs, lens, 2);
    outs[0] = 2;
    outs[1] = 16;
    outs[2] = 2;
    assert dv_pick_blackhole_index(t, offs, lens, outs, 3) == 2;
    at = dv_fixture_push(DV_FX_BH_16CH, t, 0, offs, lens, 0);
    outs[0] = 16;
    assert dv_pick_blackhole_index(t, offs, lens, outs, 1) == 0;
    at = dv_fixture_push(DV_FX_BH_2CH, t, 0, offs, lens, 0);
    outs[0] = 0;
    assert dv_pick_blackhole_index(t, offs, lens, outs, 1) == -1;
    assert dv_pick_blackhole_index(t, offs, lens, outs, 0) == -1;
    // pickMicIndex: default unless excluded; then the built-in mic; then any input.
    kinds[0] = DV_KIND_BLACKHOLE;
    kinds[1] = DV_KIND_USB;
    kinds[2] = DV_KIND_BUILT_IN_MIC;
    kinds[3] = DV_KIND_BUILT_IN_SPEAKER;
    ins[0] = 2;
    ins[1] = 1;
    ins[2] = 1;
    ins[3] = 0;
    assert dv_pick_mic_index(kinds, ins, 4, 1) == 1;
    assert dv_pick_mic_index(kinds, ins, 4, 0) == 2;
    ins[2] = 0;
    assert dv_pick_mic_index(kinds, ins, 4, 0) == 1;
    ins[1] = 0;
    assert dv_pick_mic_index(kinds, ins, 4, -1) == -1;
    // pickListenOutputIndex: default unless BlackHole; then headphones, Bluetooth, USB, speaker.
    kinds[0] = DV_KIND_BLACKHOLE;
    kinds[1] = DV_KIND_BUILT_IN_SPEAKER;
    kinds[2] = DV_KIND_USB;
    kinds[3] = DV_KIND_BLUETOOTH;
    kinds[4] = DV_KIND_BUILT_IN_HEADPHONES;
    var i: i64 = 0;
    while (i < 5) {
        outs[i] = 2;
        i = i + 1;
    }
    assert dv_pick_listen_output_index(kinds, outs, 5, 1) == 1;
    assert dv_pick_listen_output_index(kinds, outs, 5, 0) == 4;
    outs[4] = 0;
    assert dv_pick_listen_output_index(kinds, outs, 5, 0) == 3;
    outs[3] = 0;
    assert dv_pick_listen_output_index(kinds, outs, 5, 0) == 2;
    outs[2] = 0;
    assert dv_pick_listen_output_index(kinds, outs, 5, 9) == 1;
    kinds[0] = DV_KIND_VIRTUAL;
    outs[0] = 2;
    assert dv_pick_listen_output_index(kinds, outs, 1, -1) == 0;
    kinds[0] = DV_KIND_BLACKHOLE;
    assert dv_pick_listen_output_index(kinds, outs, 1, 0) == -1;
    // matchDeviceIndex: UID, exact name, substring.
    at = dv_fixture_push(DV_FX_MBP_SPEAKERS, t, 0, offs, lens, 0);
    at = dv_fixture_push(DV_FX_S6L, t, at, offs, lens, 1);
    at = dv_fixture_push(DV_FX_MBP_MIC, t, at, offs, lens, 2);
    at = dv_fixture_push(DV_FX_UID_SPEAKER, t, at, uoffs, ulens, 0);
    at = dv_fixture_push(DV_FX_UID_296C, t, at, uoffs, ulens, 1);
    at = dv_fixture_push(DV_FX_UID_MIC, t, at, uoffs, ulens, 2);
    var q: i64 = dv_fixture(DV_FX_UID_296C, t, at);
    assert dv_match_device_index(t, at, q, offs, lens, uoffs, ulens, 3) == 1;
    q = dv_fixture(DV_FX_S6L, t, at);
    assert dv_match_device_index(t, at, q, offs, lens, uoffs, ulens, 3) == 1;
    q = dv_fixture(DV_FX_MICROPHONE, t, at);
    assert dv_match_device_index(t, at, q, offs, lens, uoffs, ulens, 3) == 2;
    q = dv_fixture(DV_FX_MACBOOK, t, at);
    assert dv_match_device_index(t, at, q, offs, lens, uoffs, ulens, 3) == 0;
    q = dv_fixture(DV_FX_BLACKHOLE_WORD, t, at);
    assert dv_match_device_index(t, at, q, offs, lens, uoffs, ulens, 3) == -1;
}

test dv_app_catalog {
    var t: [8192]u8 = [0; 8192];
    var out: [8192]u8 = [0; 8192];
    var offs: [256]u32 = [0; 256];
    var lens: [256]u32 = [0; 256];
    // knownCallAppsMatchContracts: every row finds itself; the table is sorted by bundle ID.
    var i: i64 = 0;
    var bad: u32 = 0;
    while (i < DV_CALL_APPS) {
        var n: i64 = dv_call_app_bundle_id(i, t);
        if (dv_known_call_app_index(t, 0, n) != i) { bad = bad + 1; }
        if (dv_call_app_label(i, out) <= 0) { bad = bad + 1; }
        if (i > 0) {
            var m: i64 = dv_call_app_bundle_id(i - 1, out);
            var k: i64 = 0;
            var decided: bool = false;
            while (decided == false and k < n and k < m) {
                if (out[k] != t[k]) {
                    if (out[k] > t[k]) { bad = bad + 1; }
                    decided = true;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    assert bad == 0;
    assert DV_CALL_APPS == 9;
    assert dv_call_app_bundle_id(9, t) == 0;
    assert dv_call_app_label(9, out) == 0;
    var a: i64 = dv_fixture(DV_FX_CHROME_HELPER, t, 0);
    assert dv_known_call_app_index(t, 0, a) == -1;
    a = dv_fixture(DV_FX_ZOOM_ID, t, 0);
    assert dv_is_known_call_app(t, 0, a) == true;
    assert dv_known_call_app_index(t, 0, a) == 8;
    // BrowserOS neo (Google Meet in a Chromium browser) sorts between Safari and Chrome; its helpers are not call apps.
    a = dv_fixture(DV_FX_BROWSEROS, t, 0);
    assert dv_known_call_app_index(t, 0, a) == 2;
    a = dv_fixture(DV_FX_BROWSEROS_HELPER, t, 0);
    assert dv_known_call_app_index(t, 0, a) == -1;
    a = dv_fixture(DV_FX_MUSIC, t, 0);
    assert dv_is_known_call_app(t, 0, a) == false;
    // helperToParentByPrefix: the longest app ID wins; an app is not its own parent; empty IDs never match.
    var at: i64 = dv_fixture_push(DV_FX_CHROME, t, 0, offs, lens, 0);
    at = dv_fixture_push(DV_FX_GOOGLE, t, at, offs, lens, 1);
    at = dv_fixture_push(DV_FX_SAFARI, t, at, offs, lens, 2);
    at = dv_fixture_push(DV_FX_EMPTY, t, at, offs, lens, 3);
    var h: i64 = dv_fixture(DV_FX_CHROME_HELPER, t, at);
    assert dv_parent_app_index(t, at, h, offs, lens, 4) == 0;
    h = dv_fixture(DV_FX_CHROME_RENDERER, t, at);
    assert dv_parent_app_index(t, at, h, offs, lens, 4) == 0;
    h = dv_fixture(DV_FX_CHROME_X, t, at);
    assert dv_parent_app_index(t, at, h, offs, lens, 4) == 1;
    h = dv_fixture(DV_FX_CHROME, t, at);
    assert dv_parent_app_index(t, at, h, offs, lens, 4) == 1;
    h = dv_fixture(DV_FX_WEBKIT_GPU, t, at);
    assert dv_parent_app_index(t, at, h, offs, lens, 4) == -1;
    // appBundlePath
    var p: i64 = dv_fixture(DV_FX_PATH_CHROME_HELPER, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == dv_fixture(DV_FX_PATH_CHROME_APP, out, 0);
    p = dv_fixture(DV_FX_PATH_ZOOM, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == p;
    p = dv_fixture(DV_FX_PATH_TELEPHONE, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == dv_fixture(DV_FX_PATH_TELEPHONE_APP, out, 0);
    p = dv_fixture(DV_FX_PATH_AFPLAY, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == -1;
    p = dv_fixture(DV_FX_PATH_APPLICATION, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == -1;
    p = dv_fixture(DV_FX_PATH_DOT_APP, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == -1;
    p = dv_fixture(DV_FX_PATH_WEBKIT_GPU, t, 0);
    assert dv_outermost_app_path_length(t, 0, p) == -1;
    // ownerSourceOrder
    assert dv_owner_source(true, true, true, true, true) == DV_OWNER_SELF;
    assert dv_owner_source(false, true, true, true, true) == DV_OWNER_APP_BUNDLE_PATH;
    assert dv_owner_source(false, false, true, true, true) == DV_OWNER_RESPONSIBLE;
    assert dv_owner_source(false, false, false, true, true) == DV_OWNER_PARENT;
    assert dv_owner_source(false, false, false, false, true) == DV_OWNER_BUNDLE_PREFIX;
    assert dv_owner_source(false, false, false, false, false) == DV_OWNER_FALLBACK;
}

test dv_tap_targets_and_order {
    var t: [8192]u8 = [0; 8192];
    var offs: [256]u32 = [0; 256];
    var lens: [256]u32 = [0; 256];
    var ranks: [256]i64 = [0; 256];
    var order: [256]i64 = [0; 256];
    // tapTargets: process at 0, owner at 1000, target at 2000.
    var p: i64 = dv_fixture(DV_FX_CHROME_HELPER, t, 0);
    var o: i64 = dv_fixture(DV_FX_CHROME, t, 1000);
    var g: i64 = dv_fixture(DV_FX_CHROME, t, 2000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 5, 9) == true;
    p = dv_fixture(DV_FX_ZOOM_ID, t, 0);
    o = dv_fixture(DV_FX_TERMINAL, t, 1000);
    g = dv_fixture(DV_FX_ZOOM_ID, t, 2000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 5, 9) == true;
    p = dv_fixture(DV_FX_AVCONFERENCED, t, 0);
    o = dv_fixture(DV_FX_AVCONFERENCED, t, 1000);
    g = dv_fixture(DV_FX_FACETIME, t, 2000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 5, 9) == true;
    p = dv_fixture(DV_FX_TELEPHONY, t, 0);
    o = dv_fixture(DV_FX_X, t, 1000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 5, 9) == true;
    p = dv_fixture(DV_FX_AVCONFERENCED, t, 0);
    g = dv_fixture(DV_FX_ZOOM_ID, t, 2000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 5, 9) == false;
    p = dv_fixture(DV_FX_CHROME, t, 0);
    o = dv_fixture(DV_FX_CHROME, t, 1000);
    g = dv_fixture(DV_FX_CHROME, t, 2000);
    assert dv_is_tap_target_process(t, 0, p, 1000, o, 2000, g, 9, 9) == false;
    o = dv_fixture(DV_FX_X, t, 1000);
    assert dv_is_tap_target_process(t, 0, 0, 1000, o, 2000, 0, 5, 9) == false;
    p = dv_fixture(DV_FX_AVCONFERENCED, t, 0);
    g = dv_fixture(DV_FX_FACETIME, t, 2000);
    assert dv_is_companion_process(t, 0, p, 2000, g) == true;
    assert dv_is_companion_process(t, 2000, g, 0, p) == false;
    // listingAndOrder
    assert dv_is_self_process(9, 1, 9) == true;
    assert dv_is_self_process(5, 9, 9) == true;
    assert dv_is_self_process(5, 6, 9) == false;
    assert dv_should_list_app(true, false, false) == true;
    assert dv_should_list_app(false, true, false) == true;
    assert dv_should_list_app(false, false, true) == true;
    assert dv_should_list_app(false, false, false) == false;
    assert dv_app_rank(true, true) == 0;
    assert dv_app_rank(false, true) == 1;
    assert dv_app_rank(true, false) == 2;
    assert dv_app_rank(false, false) == 3;
    // ranks [3, 0, 3, 3, 1, 3], names [notes, Zoom, Music, Notes, x, notes] -> [1, 4, 2, 0, 3, 5]
    var at: i64 = dv_fixture_push(DV_FX_NOTES, t, 0, offs, lens, 0);
    at = dv_fixture_push(DV_FX_ZOOM_NAME, t, at, offs, lens, 1);
    at = dv_fixture_push(DV_FX_MUSIC_NAME, t, at, offs, lens, 2);
    at = dv_fixture_push(DV_FX_NOTES_CAP, t, at, offs, lens, 3);
    at = dv_fixture_push(DV_FX_X, t, at, offs, lens, 4);
    at = dv_fixture_push(DV_FX_NOTES, t, at, offs, lens, 5);
    ranks[0] = 3;
    ranks[1] = 0;
    ranks[2] = 3;
    ranks[3] = 3;
    ranks[4] = 1;
    ranks[5] = 3;
    assert dv_app_sort_order(ranks, t, offs, lens, 6, order) == 6;
    assert order[0] == 1;
    assert order[1] == 4;
    assert order[2] == 2;
    assert order[3] == 0;
    assert order[4] == 3;
    assert order[5] == 5;
    assert dv_app_sort_order(ranks, t, offs, lens, 0, order) == 0;
    // The order is a permutation and every neighbour pair is in order, for a long list.
    var i: i64 = 0;
    at = 0;
    while (i < 200) {
        at = dv_fixture_push(i % DV_FX_COUNT, t, at, offs, lens, i);
        ranks[i] = (i * 7) % 4;
        i = i + 1;
    }
    assert dv_app_sort_order(ranks, t, offs, lens, 200, order) == 200;
    var seen: [256]i64 = [0; 256];
    var bad: u32 = 0;
    i = 0;
    while (i < 200) {
        seen[order[i]] = seen[order[i]] + 1;
        if (i > 0 and dv_app_before(ranks, t, offs, lens, order[i], order[i - 1])) { bad = bad + 1; }
        i = i + 1;
    }
    i = 0;
    while (i < 200) {
        if (seen[i] != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert bad == 0;
}

test dv_moved_rules {
    assert dv_is_regular_app(true, true) == true;
    assert dv_is_regular_app(true, false) == false;
    assert dv_is_regular_app(false, true) == false;
    assert dv_process_pid_valid(1) == true;
    assert dv_process_pid_valid(0) == false;
    assert dv_process_pid_valid(-1) == false;
    assert dv_responsible_usable(500, 400) == true;
    assert dv_responsible_usable(400, 400) == false;
    assert dv_responsible_usable(1, 400) == false;
    assert dv_responsible_usable(0, 400) == false;
    assert dv_parent_continues(300, 400) == true;
    assert dv_parent_continues(1, 400) == false;
    assert dv_parent_continues(400, 400) == false;
    assert dv_owner_id_source(true, true) == DV_ID_HAL;
    assert dv_owner_id_source(false, true) == DV_ID_APP;
    assert dv_owner_id_source(false, false) == DV_ID_PID;
    assert dv_owner_name_source(true, true) == DV_NAME_APP;
    assert dv_owner_name_source(false, true) == DV_NAME_PATH;
    assert dv_owner_name_source(false, false) == DV_NAME_ID;
    assert dv_bundle_name_source(true, true, true) == DV_BUNDLE_NAME_RUNNING;
    assert dv_bundle_name_source(false, true, true) == DV_BUNDLE_NAME_DISPLAY;
    assert dv_bundle_name_source(false, false, true) == DV_BUNDLE_NAME_BUNDLE;
    assert dv_bundle_name_source(false, false, false) == DV_BUNDLE_NAME_FILE;
    assert dv_path_owner_regular(true, false, true, true) == false;
    assert dv_path_owner_regular(false, false, true, true) == true;
    assert dv_path_owner_regular(false, true, false, true) == false;
    assert dv_app_playing(false, true) == true;
    assert dv_app_playing(false, false) == false;
    assert dv_prefers_owner(true, false) == true;
    assert dv_prefers_owner(true, true) == false;
    assert dv_prefers_owner(false, false) == false;
    assert dv_needs_headphones(DV_KIND_BUILT_IN_SPEAKER) == true;
    assert dv_needs_headphones(DV_KIND_DISPLAY) == true;
    assert dv_needs_headphones(DV_KIND_BLUETOOTH) == false;
    assert dv_needs_headphones(DV_KIND_BUILT_IN_HEADPHONES) == false;
    var t: [8192]u8 = [0; 8192];
    assert dv_row_bytes(DV_ROW_PID_PREFIX, t) == 4;
    assert t[3] == 46;
}

test dv_checklist_readers {
    var t: [8192]u8 = [0; 8192];
    var uses: [256]i64 = [0; 256];
    // readerRole: owner at 0, target at 1000.
    var o: i64 = dv_fixture(DV_FX_BROWSEROS, t, 0);
    var g: i64 = dv_fixture(DV_FX_BROWSEROS, t, 1000);
    assert dv_reader_role(t, 0, o, 1000, g, true, 5, 9) == DV_READER_CALL;
    assert dv_reader_role(t, 0, o, 1000, g, true, 9, 9) == DV_READER_PONTE;
    assert dv_reader_role(t, 0, o, 1000, 0, false, 5, 9) == DV_READER_CALL;
    g = dv_fixture(DV_FX_ZOOM_ID, t, 1000);
    assert dv_reader_role(t, 0, o, 1000, g, true, 5, 9) == DV_READER_OTHER;
    // Another Ponte instance (the installed app next to a test build) never counts.
    o = dv_fixture(DV_FX_PONTE_ID, t, 0);
    assert dv_reader_role(t, 0, o, 1000, g, true, 5, 9) == DV_READER_PONTE;
    assert dv_reader_role(t, 0, o, 1000, 0, false, 5, 9) == DV_READER_PONTE;
    assert dv_is_ponte_id(t, 0, o) == true;
    assert dv_is_ponte_id(t, 0, o - 1) == false;
    // FaceTime's calls run in avconferenced; with all Mac audio a non-call app is another program.
    o = dv_fixture(DV_FX_AVCONFERENCED, t, 0);
    g = dv_fixture(DV_FX_FACETIME, t, 1000);
    assert dv_reader_role(t, 0, o, 1000, g, true, 5, 9) == DV_READER_CALL;
    assert dv_reader_role(t, 0, o, 1000, 0, false, 5, 9) == DV_READER_OTHER;
    o = dv_fixture(DV_FX_MUSIC, t, 0);
    assert dv_reader_role(t, 0, o, 1000, 0, false, 5, 9) == DV_READER_OTHER;
    // readerUse
    assert dv_reader_use(DV_READER_CALL, DV_KIND_BLACKHOLE, true) == DV_USE_CALL_BLACKHOLE;
    assert dv_reader_use(DV_READER_OTHER, DV_KIND_BLACKHOLE, true) == DV_USE_OTHER_BLACKHOLE;
    assert dv_reader_use(DV_READER_PONTE, DV_KIND_BLACKHOLE, true) == DV_USE_NONE;
    assert dv_reader_use(DV_READER_CALL, DV_KIND_BLACKHOLE, false) == DV_USE_NONE;
    assert dv_reader_use(DV_READER_CALL, DV_KIND_BUILT_IN_MIC, true) == DV_USE_CALL_REAL_MIC;
    assert dv_reader_use(DV_READER_CALL, DV_KIND_BLUETOOTH, true) == DV_USE_CALL_REAL_MIC;
    assert dv_reader_use(DV_READER_CALL, DV_KIND_CONTINUITY, true) == DV_USE_CALL_REAL_MIC;
    assert dv_reader_use(DV_READER_CALL, DV_KIND_VIRTUAL, true) == DV_USE_NONE;
    assert dv_reader_use(DV_READER_OTHER, DV_KIND_BUILT_IN_MIC, true) == DV_USE_NONE;
    // listenStatus and listenIndex. Live 2026-10-13: BrowserOS's helper reads BlackHole, Ponte reads the mic.
    uses[0] = DV_USE_NONE;
    uses[1] = DV_USE_CALL_BLACKHOLE;
    assert dv_listen_status(uses, 2, true, true) == DV_LISTEN_OK;
    assert dv_listen_index(uses, 2) == 1;
    assert dv_listen_status(uses, 2, true, false) == DV_LISTEN_NO_BLACKHOLE;
    assert dv_listen_status(uses, 2, false, true) == DV_LISTEN_UNKNOWN;
    assert dv_listen_status(uses, 1, true, true) == DV_LISTEN_NOBODY;
    assert dv_listen_index(uses, 1) == -1;
    assert dv_listen_status(uses, 0, true, true) == DV_LISTEN_NOBODY;
    uses[0] = DV_USE_CALL_REAL_MIC;
    assert dv_listen_status(uses, 2, true, true) == DV_LISTEN_BOTH;
    assert dv_listen_status(uses, 1, true, true) == DV_LISTEN_REAL_MIC;
    assert dv_listen_index(uses, 2) == 0;
    uses[0] = DV_USE_OTHER_BLACKHOLE;
    uses[1] = DV_USE_NONE;
    assert dv_listen_status(uses, 2, true, true) == DV_LISTEN_OK;
    assert dv_listen_index(uses, 2) == 0;
    uses[1] = DV_USE_CALL_BLACKHOLE;
    assert dv_listen_index(uses, 2) == 1;
    // Exhaustively over two pairs: a real microphone in the call app is never OK; OK needs a BlackHole reader.
    var a: i64 = 0;
    var bad: u32 = 0;
    while (a < 4) {
        var b: i64 = 0;
        while (b < 4) {
            uses[0] = a;
            uses[1] = b;
            var st: i64 = dv_listen_status(uses, 2, true, true);
            var mic: bool = a == DV_USE_CALL_REAL_MIC or b == DV_USE_CALL_REAL_MIC;
            var bh: bool = a == DV_USE_CALL_BLACKHOLE or b == DV_USE_CALL_BLACKHOLE or a == DV_USE_OTHER_BLACKHOLE or b == DV_USE_OTHER_BLACKHOLE;
            if (mic and (st == DV_LISTEN_OK or st == DV_LISTEN_NOBODY)) { bad = bad + 1; }
            if (st == DV_LISTEN_OK and bh == false) { bad = bad + 1; }
            if ((st == DV_LISTEN_NOBODY) != (mic == false and bh == false)) { bad = bad + 1; }
            if ((dv_listen_index(uses, 2) < 0) != (st == DV_LISTEN_NOBODY)) { bad = bad + 1; }
            b = b + 1;
        }
        a = a + 1;
    }
    assert bad == 0;
    // Headphones-like outputs.
    assert dv_is_headphones_like(DV_KIND_BUILT_IN_HEADPHONES) == true;
    assert dv_is_headphones_like(DV_KIND_BLUETOOTH) == true;
    assert dv_is_headphones_like(DV_KIND_USB) == true;
    assert dv_is_headphones_like(DV_KIND_BUILT_IN_SPEAKER) == false;
    assert dv_is_headphones_like(DV_KIND_DISPLAY) == false;
    assert dv_is_headphones_like(DV_KIND_AIRPLAY) == false;
    assert dv_is_headphones_like(DV_KIND_BLACKHOLE) == false;
}

test dv_auto_mic {
    var t: [8192]u8 = [0; 8192];
    var offs: [256]u32 = [0; 256];
    var lens: [256]u32 = [0; 256];
    var kinds: [256]i64 = [0; 256];
    var ins: [256]i64 = [0; 256];
    // This Mac on 2026-10-13: an iPhone mic, BlackHole, the MacBook mic, the MacBook speakers (the output).
    var at: i64 = dv_fixture_push(DV_FX_IPHONE_MIC, t, 0, offs, lens, 0);
    at = dv_fixture_push(DV_FX_BH_2CH, t, at, offs, lens, 1);
    at = dv_fixture_push(DV_FX_MBP_MIC, t, at, offs, lens, 2);
    at = dv_fixture_push(DV_FX_MBP_SPEAKERS, t, at, offs, lens, 3);
    kinds[0] = DV_KIND_CONTINUITY;
    kinds[1] = DV_KIND_BLACKHOLE;
    kinds[2] = DV_KIND_BUILT_IN_MIC;
    kinds[3] = DV_KIND_BUILT_IN_SPEAKER;
    ins[0] = 1;
    ins[1] = 2;
    ins[2] = 1;
    ins[3] = 0;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 4, 3) == 2;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 4, -1) == 2;
    // AirPods as the output with their own input: their microphone.
    at = dv_fixture_push(DV_FX_AIRPODS_PRO, t, at, offs, lens, 4);
    kinds[4] = DV_KIND_BLUETOOTH;
    ins[4] = 1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 5, 4) == 4;
    // AirPods listed as two devices of the same name: the input one.
    at = dv_fixture_push(DV_FX_AIRPODS_PRO, t, at, offs, lens, 5);
    kinds[5] = DV_KIND_BLUETOOTH;
    ins[4] = 0;
    ins[5] = 1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 6, 4) == 5;
    // A Bluetooth speaker without a microphone (S6-L): the MacBook mic, never another Bluetooth device.
    at = dv_fixture_push(DV_FX_S6L, t, at, offs, lens, 6);
    kinds[6] = DV_KIND_BLUETOOTH;
    ins[6] = 0;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 7, 6) == 2;
    // The headphone jack with a headset: the jack's microphone.
    at = dv_fixture_push(DV_FX_EXT_HEADPHONES, t, at, offs, lens, 7);
    at = dv_fixture_push(DV_FX_EXT_MIC, t, at, offs, lens, 8);
    kinds[7] = DV_KIND_BUILT_IN_HEADPHONES;
    kinds[8] = DV_KIND_BUILT_IN_HEADPHONES;
    ins[7] = 0;
    ins[8] = 1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 9, 7) == 8;
    // A USB headset; a USB microphone of another name is not its microphone.
    at = dv_fixture_push(DV_FX_JABRA, t, at, offs, lens, 9);
    at = dv_fixture_push(DV_FX_USB_AUDIO, t, at, offs, lens, 10);
    kinds[9] = DV_KIND_USB;
    kinds[10] = DV_KIND_USB;
    ins[9] = 0;
    ins[10] = 1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 11, 9) == 2;
    ins[9] = 1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 11, 9) == 9;
    // No built-in microphone: the first real one, never the iPhone or BlackHole.
    ins[2] = 0;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 11, 3) == 5;
    ins[5] = 0;
    ins[8] = 0;
    ins[9] = 0;
    ins[10] = 0;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 11, 3) == -1;
    assert dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 0, 3) == -1;
    // Every kind: an iPhone, BlackHole or Ponte's tap is never picked, whatever the output.
    var k: i64 = 0;
    var bad: u32 = 0;
    while (k <= DV_KIND_OTHER_WIRED) {
        kinds[0] = k;
        ins[0] = 1;
        var o: i64 = -1;
        while (o < 1) {
            var pick: i64 = dv_pick_auto_mic_index(t, offs, lens, kinds, ins, 1, o);
            var never: bool = k == DV_KIND_CONTINUITY or k == DV_KIND_BLACKHOLE or k == DV_KIND_PONTE_AGGREGATE;
            if (never and pick != -1) { bad = bad + 1; }
            o = o + 1;
        }
        k = k + 1;
    }
    assert bad == 0;
}
