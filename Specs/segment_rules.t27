// SPDX-License-Identifier: MIT
; Specs/segment_rules.t27 -- Ponte: what is voice, when a phrase is finalized, what a phrase says
; Mirrors the voice-activity, phrase-finalization, text-classification and cut-index parts of
; PonteSpeech/SpeechRules.swift one to one (same constants, codes, order of checks and integer
; arithmetic; each function names the Swift function it mirrors). Times are integer milliseconds,
; a level is RMS x 100000, a noise floor is in milli-levels (level x 1000), text is UTF-8 bytes in a
; buffer of SG_TEXT_MAX bytes with its length (a longer length is read as SG_TEXT_MAX), and whitespace
; is 0x20, 0x09, 0x0A and 0x0D. ASCII only.
; Generated C: Sources/PonteSpecs/segment_rules.h (Specs/generate.sh).

module PonteSegmentRules;

pub const SG_TEXT_MAX : i64 = 8192;

; --- Voice activity (level meter) --------------------------------------------------------------------
; meterWindowMs: the transcriber meters audio in windows of this length.
pub const SG_METER_WINDOW_MS : i64 = 20;
; voiceThresholdLevel: RMS 0.01 (about -40 dBFS) in level units.
pub const SG_VOICE_THRESHOLD_LEVEL : i64 = 1000;
; Effective threshold = max(voiceThresholdLevel, floor x 5 / 2), the floor in milli-levels.
pub const SG_NOISE_FLOOR_FACTOR_NUMERATOR : i64 = 5;
pub const SG_NOISE_FLOOR_FACTOR_DENOMINATOR : i64 = 2;
pub const SG_MILLI : i64 = 1000;
; noiseFloorRiseMs: the noise floor rises toward louder windows with this time constant.
pub const SG_NOISE_FLOOR_RISE_MS : i64 = 60000;
; minRecordedPauseMs: silences shorter than this do not split voice segments.
pub const SG_MIN_RECORDED_PAUSE_MS : i64 = 60;

; --- Phrase finalization ------------------------------------------------------------------------------
; endOfPhrasePauseMs: silence that ends a phrase.
pub const SG_END_OF_PHRASE_PAUSE_MS : i64 = 600;
; trailingMarginMs: audio kept after the voice stops, so the last word is not clipped.
pub const SG_TRAILING_MARGIN_MS : i64 = 150;
; maxPhraseMs: speech longer than this is cut at the next suitable pause.
pub const SG_MAX_PHRASE_MS : i64 = 6000;
; minPauseMs: a pause this long inside a long monologue is a cut point.
pub const SG_MIN_PAUSE_MS : i64 = 150;
; shortPauseMs: a gap this long counts after sentence-ending punctuation, or after hardLimitMs.
pub const SG_SHORT_PAUSE_MS : i64 = 80;
; hardLimitMs: after this much speech any short pause is a cut point.
pub const SG_HARD_LIMIT_MS : i64 = 9000;
; absoluteLimitMs: after this much speech the phrase is cut at once, even inside a word.
pub const SG_ABSOLUTE_LIMIT_MS : i64 = 12000;
; minCutSpacingMs: two cuts must be at least this far apart.
pub const SG_MIN_CUT_SPACING_MS : i64 = 100;
; stallTimeoutMs: no audio for this long in the middle of a phrase finalizes what was heard.
pub const SG_STALL_TIMEOUT_MS : i64 = 1000;
; watchdogPeriodMs: how often the transcriber's watchdog checks for a stalled source.
pub const SG_WATCHDOG_PERIOD_MS : i64 = 250;
; stallFlushSilenceMs: silence fed to the analyzer after a stall cut. SpeechAnalyzer finalizes only once it
; has audio past the cut (measured 2026-10-11: with nothing after it, the final waited for finish()).
pub const SG_STALL_FLUSH_SILENCE_MS : i64 = 500;

; finalizeAction results.
pub const SG_ACTION_WAIT : i64 = 0;
pub const SG_ACTION_END_OF_PHRASE : i64 = 1;
pub const SG_ACTION_MONOLOGUE_PAUSE : i64 = 2;
pub const SG_ACTION_MONOLOGUE_FORCED : i64 = 3;

; finalizeAction flags: something to finalize; the stream is closing; Ponte's own cuts are off.
pub const SG_FLAG_HAS_CONTENT : i64 = 1;
pub const SG_FLAG_FINISHING : i64 = 2;
pub const SG_FLAG_CUTS_DISABLED : i64 = 4;

; punctuationCode results.
pub const SG_PUNCTUATION_NONE : i64 = 0;
pub const SG_PUNCTUATION_CLAUSE : i64 = 1;
pub const SG_PUNCTUATION_SENTENCE : i64 = 2;

; --- Phrases -------------------------------------------------------------------------------------------
; minPhraseBytes: shorter text is never a phrase.
pub const SG_MIN_PHRASE_BYTES : i64 = 2;
; hallucinationMaxWords, hallucinationMinVoiceMs: up to this many words over less than this much
; metered voice are dropped.
pub const SG_HALLUCINATION_MAX_WORDS : i64 = 3;
pub const SG_HALLUCINATION_MIN_VOICE_MS : i64 = 100;
; phraseAction results.
pub const SG_PHRASE_KEEP : i64 = 0;
pub const SG_PHRASE_DROP_HALLUCINATION : i64 = 1;
pub const SG_PHRASE_DROP_NO_CONTENT : i64 = 2;

; --- Cutting long text -----------------------------------------------------------------------------------
; speechChunkMaxBytes, speechChunkMinBytes: pieces of long finals for synthesis.
pub const SG_SPEECH_CHUNK_MAX_BYTES : i64 = 200;
pub const SG_SPEECH_CHUNK_MIN_BYTES : i64 = 24;

; --- Bytes ------------------------------------------------------------------------------------------------
pub const SG_SPACE : u8 = 32;
pub const SG_TAB : u8 = 9;
pub const SG_LF : u8 = 10;
pub const SG_CR : u8 = 13;
pub const SG_QUOTE : u8 = 34;
pub const SG_APOSTROPHE : u8 = 39;
pub const SG_PAREN_CLOSE : u8 = 41;
pub const SG_DOT : u8 = 46;
pub const SG_EXCLAMATION : u8 = 33;
pub const SG_QUESTION : u8 = 63;
pub const SG_COMMA : u8 = 44;
pub const SG_SEMICOLON : u8 = 59;
pub const SG_COLON : u8 = 58;
; UTF-8: C2 BB is a closing guillemet; E2 80 9D a closing curly quote, E2 80 A6 an ellipsis,
; E2 80 94 an em dash, E2 80 93 an en dash; E2 80 and E2 81 open General Punctuation.
pub const SG_LEAD_C2 : u8 = 194;
pub const SG_LEAD_C3 : u8 = 195;
pub const SG_LEAD_E2 : u8 = 226;
pub const SG_SECOND_80 : u8 = 128;
pub const SG_SECOND_81 : u8 = 129;
pub const SG_GUILLEMET_CLOSE : u8 = 187;
pub const SG_CURLY_CLOSE : u8 = 157;
pub const SG_ELLIPSIS : u8 = 166;
pub const SG_EM_DASH : u8 = 148;
pub const SG_EN_DASH : u8 = 147;
pub const SG_CONTINUATION_MASK : u8 = 192;
pub const SG_CONTINUATION : u8 = 128;

; A text length as read here: below 0 is 0, above SG_TEXT_MAX is SG_TEXT_MAX.
pub fn sg_text_len(len: i64) -> i64 {
    if (len < 0) { return 0; }
    if (len > SG_TEXT_MAX) { return SG_TEXT_MAX; }
    return len;
}

; isSpace
pub fn sg_is_space(b: u8) -> bool {
    return b == SG_SPACE or b == SG_TAB or b == SG_LF or b == SG_CR;
}

; --- Voice activity ------------------------------------------------------------------------------------------
; effectiveThreshold: max(voiceThresholdLevel, floorMilli * 5 / (2 * 1000)).
pub fn sg_effective_threshold(floor_milli: i64) -> i64 {
    var scaled: i64 = floor_milli * SG_NOISE_FLOOR_FACTOR_NUMERATOR / (SG_NOISE_FLOOR_FACTOR_DENOMINATOR * SG_MILLI);
    if (scaled >= SG_VOICE_THRESHOLD_LEVEL) { return scaled; }
    return SG_VOICE_THRESHOLD_LEVEL;
}

; isVoice: a meter window of this level is voice.
pub fn sg_is_voice(level: i64, floor_milli: i64) -> bool {
    return level >= sg_effective_threshold(floor_milli);
}

; nextNoiseFloor: drops at once to a quieter window, rises slowly toward a louder one
; (by (target - floor) * d / noiseFloorRiseMs, d the window length clamped to 0...noiseFloorRiseMs).
pub fn sg_next_noise_floor(floor_milli: i64, has_floor: bool, level: i64, duration_ms: i64) -> i64 {
    var target: i64 = level * SG_MILLI;
    if (has_floor == false or target < floor_milli) { return target; }
    var d: i64 = duration_ms;
    if (d < 0) { d = 0; }
    if (d > SG_NOISE_FLOOR_RISE_MS) { d = SG_NOISE_FLOOR_RISE_MS; }
    return floor_milli + (target - floor_milli) * d / SG_NOISE_FLOOR_RISE_MS;
}

; --- Phrase finalization ---------------------------------------------------------------------------------------
; cutBackoffMs: how far before now the cut lies, max(0, pauseMs - trailingMarginMs) for the pause cuts.
pub fn sg_cut_backoff_ms(action: i64, pause_ms: i64) -> i64 {
    if (action == SG_ACTION_END_OF_PHRASE or action == SG_ACTION_MONOLOGUE_PAUSE) {
        var back: i64 = pause_ms - SG_TRAILING_MARGIN_MS;
        if (back >= 0) { return back; }
        return 0;
    }
    return 0;
}

; finalizeAction: should the transcriber ask SpeechAnalyzer to finalize now?
;   pause_ms         the current silence, 0 while someone speaks
;   speech_ms        speech in this phrase, up to the start of the current silence or now
;   punctuation      punctuationCode of the volatile text
;   last_cut_ago_ms  time since the last requested cut (INT64_MAX if none)
;   phrase_age_ms    time since the current phrase began
;   flags            SG_FLAG_* bits
; Nothing without content, while finishing or with cuts disabled. While speaking, only the absolute
; limit cuts; a 600 ms pause ends the phrase; in a long monologue a 150 ms pause cuts, and so does an
; 80 ms one after a sentence end or past the hard limit. A cut must lie inside the phrase and more than
; minCutSpacingMs after the previous one.
pub fn sg_finalize_action(pause_ms: i64, speech_ms: i64, punctuation: i64, last_cut_ago_ms: i64, phrase_age_ms: i64, flags: i64) -> i64 {
    if ((flags & SG_FLAG_HAS_CONTENT) == 0 or (flags & SG_FLAG_FINISHING) != 0 or (flags & SG_FLAG_CUTS_DISABLED) != 0) {
        return SG_ACTION_WAIT;
    }
    var action: i64 = SG_ACTION_WAIT;
    if (pause_ms <= 0) {
        if (speech_ms >= SG_ABSOLUTE_LIMIT_MS) { action = SG_ACTION_MONOLOGUE_FORCED; }
    } else if (pause_ms >= SG_END_OF_PHRASE_PAUSE_MS) {
        action = SG_ACTION_END_OF_PHRASE;
    } else if (speech_ms >= SG_MAX_PHRASE_MS) {
        if (pause_ms >= SG_MIN_PAUSE_MS) {
            action = SG_ACTION_MONOLOGUE_PAUSE;
        } else if (pause_ms >= SG_SHORT_PAUSE_MS and (punctuation == SG_PUNCTUATION_SENTENCE or speech_ms >= SG_HARD_LIMIT_MS)) {
            action = SG_ACTION_MONOLOGUE_PAUSE;
        }
    }
    if (action == SG_ACTION_WAIT) { return SG_ACTION_WAIT; }
    var backoff: i64 = sg_cut_backoff_ms(action, pause_ms);
    if (phrase_age_ms > backoff and last_cut_ago_ms - backoff > SG_MIN_CUT_SPACING_MS) { return action; }
    return SG_ACTION_WAIT;
}

; --- Text classification -----------------------------------------------------------------------------------------
; punctuationCode: the punctuation at the end of the text, ignoring trailing spaces, " ' ) and the
; closing guillemet and curly quote. Sentence: . ! ? and the ellipsis. Clause: , ; : and the dashes.
pub fn sg_punctuation_code(text: [8192]u8, len: i64) -> i64 {
    var end: i64 = sg_text_len(len);
    var trimming: bool = true;
    while (trimming and end > 0) {
        var t: u8 = text[end - 1];
        if (sg_is_space(t) or t == SG_QUOTE or t == SG_APOSTROPHE or t == SG_PAREN_CLOSE) {
            end = end - 1;
        } else if (end >= 2 and text[end - 2] == SG_LEAD_C2 and t == SG_GUILLEMET_CLOSE) {
            end = end - 2;
        } else if (end >= 3 and text[end - 3] == SG_LEAD_E2 and text[end - 2] == SG_SECOND_80 and t == SG_CURLY_CLOSE) {
            end = end - 3;
        } else {
            trimming = false;
        }
    }
    if (end <= 0) { return SG_PUNCTUATION_NONE; }
    var b: u8 = text[end - 1];
    if (b == SG_DOT or b == SG_EXCLAMATION or b == SG_QUESTION) { return SG_PUNCTUATION_SENTENCE; }
    if (b == SG_COMMA or b == SG_SEMICOLON or b == SG_COLON) { return SG_PUNCTUATION_CLAUSE; }
    if (end >= 3 and text[end - 3] == SG_LEAD_E2 and text[end - 2] == SG_SECOND_80) {
        if (b == SG_ELLIPSIS) { return SG_PUNCTUATION_SENTENCE; }
        if (b == SG_EM_DASH or b == SG_EN_DASH) { return SG_PUNCTUATION_CLAUSE; }
    }
    return SG_PUNCTUATION_NONE;
}

; wordCount: words separated by ASCII whitespace.
pub fn sg_word_count(text: [8192]u8, len: i64) -> i64 {
    var n: i64 = sg_text_len(len);
    var count: i64 = 0;
    var in_word: bool = false;
    var i: i64 = 0;
    while (i < n) {
        if (sg_is_space(text[i])) {
            in_word = false;
        } else if (in_word == false) {
            in_word = true;
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

; hasSpeechContent: at least minPhraseBytes and one letter or digit: an ASCII alphanumeric, or a
; character from U+00C0 up (lead byte C3 or higher) outside General Punctuation (E2 80, E2 81).
; C2 sequences (U+0080..U+00BF: symbols, guillemets, NBSP) are skipped.
pub fn sg_has_speech_content(text: [8192]u8, len: i64) -> bool {
    var n: i64 = sg_text_len(len);
    if (n < SG_MIN_PHRASE_BYTES) { return false; }
    var i: i64 = 0;
    while (i < n) {
        var b: u8 = text[i];
        if (b < 128) {
            if ((b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)) { return true; }
            i = i + 1;
        } else if (b == SG_LEAD_C2) {
            i = i + 2;
        } else if (b == SG_LEAD_E2 and i + 1 < n and (text[i + 1] == SG_SECOND_80 or text[i + 1] == SG_SECOND_81)) {
            i = i + 3;
        } else if (b >= SG_LEAD_C3) {
            return true;
        } else {
            i = i + 1;
        }
    }
    return false;
}

; phraseAction: drop text with no content; drop up to 3 words over less than 100 ms of voice.
pub fn sg_phrase_action(text: [8192]u8, len: i64, voice_ms: i64) -> i64 {
    if (sg_has_speech_content(text, len) == false) { return SG_PHRASE_DROP_NO_CONTENT; }
    if (voice_ms < SG_HALLUCINATION_MIN_VOICE_MS and sg_word_count(text, len) <= SG_HALLUCINATION_MAX_WORDS) {
        return SG_PHRASE_DROP_HALLUCINATION;
    }
    return SG_PHRASE_KEEP;
}

; --- Cutting long text -------------------------------------------------------------------------------------------
; followedBySpace inside cutByteIndex: the end of the text, or whitespace.
pub fn sg_followed_by_space(text: [8192]u8, n: i64, end: i64) -> bool {
    if (end == n) { return true; }
    return sg_is_space(text[end]);
}

; cutByteIndex: where to cut a long text, a byte index in minBytes...maxBytes (the head is text[0..<index]).
; Text that fits returns its length. Otherwise the last sentence end (. ! ? ellipsis followed by a space or
; the end), else the last clause end (, ; : dashes followed by a space), else the last space at or after
; minBytes, else maxBytes moved back over continuation bytes (maxBytes itself if that reaches 0).
pub fn sg_cut_byte_index(text: [8192]u8, len: i64, max_bytes: i64, min_bytes: i64) -> i64 {
    var n: i64 = sg_text_len(len);
    if (n <= max_bytes or max_bytes <= 0) { return n; }
    var sentence: i64 = 0;
    var clause: i64 = 0;
    var space: i64 = 0;
    var i: i64 = 0;
    while (i < max_bytes) {
        var b: u8 = text[i];
        var end: i64 = 0;
        var kind: i64 = 0;
        if (b == SG_DOT or b == SG_EXCLAMATION or b == SG_QUESTION) {
            end = i + 1;
            kind = 2;
        } else if (b == SG_COMMA or b == SG_SEMICOLON or b == SG_COLON) {
            end = i + 1;
            kind = 1;
        } else if (b == SG_LEAD_E2 and i + 2 < n and text[i + 1] == SG_SECOND_80) {
            var c: u8 = text[i + 2];
            if (c == SG_ELLIPSIS) {
                end = i + 3;
                kind = 2;
            } else if (c == SG_EM_DASH or c == SG_EN_DASH) {
                end = i + 3;
                kind = 1;
            }
        }
        if (kind > 0 and end <= max_bytes and end >= min_bytes and sg_followed_by_space(text, n, end)) {
            if (kind == 2) {
                sentence = end;
            } else {
                clause = end;
            }
        }
        if (sg_is_space(b) and i >= min_bytes) { space = i; }
        i = i + 1;
    }
    if (sentence > 0) { return sentence; }
    if (clause > 0) { return clause; }
    if (space > 0) { return space; }
    var j: i64 = max_bytes;
    while (j > 0 and (text[j] & SG_CONTINUATION_MASK) == SG_CONTINUATION) { j = j - 1; }
    if (j > 0) { return j; }
    return max_bytes;
}

; --- Rules moved here from AppleTranscriber, VoiceActivity and AudioConversion (2026-10-11) ------------------
; Languages and the SpeechAnalyzer module each uses: SpeechTranscriber for pt-BR, DictationTranscriber for
; ru-RU (SpeechTranscriber has no Russian).
pub const SG_LANG_PT_BR : i64 = 0;
pub const SG_LANG_RU : i64 = 1;
pub const SG_MODULE_SPEECH : i64 = 0;
pub const SG_MODULE_DICTATION : i64 = 1;
; AppleTranscriber defaults: fast results for pt-BR, and Ponte's own cuts on (1 = on).
pub const SG_FAST_RESULTS_DEFAULT : i64 = 1;
pub const SG_OWN_CUTS_DEFAULT : i64 = 1;
; Seconds and milliseconds; a level is RMS x 100000.
pub const SG_MS_PER_SECOND : f64 = 1000.0;
pub const SG_LEVEL_SCALE : f64 = 100000.0;
; "No cut yet" (Int.max) for lastCutAgoMs.
pub const SG_NO_CUT_MS : i64 = 9223372036854775807;
; Voice after this many seconds past the phrase start counts as content to finalize.
pub const SG_CONTENT_VOICE_MARGIN_SECONDS : f64 = 0.05;
; Arrival marks (audio end -> wall clock): trimmed above 2400 marks to the last 120 seconds of audio.
pub const SG_ARRIVALS_MAX : i64 = 2400;
pub const SG_ARRIVALS_KEEP_SECONDS : f64 = 120.0;
; The arrival of audio up to t is the first mark that ends at most 0.5 ms before t.
pub const SG_ARRIVAL_TOLERANCE_SECONDS : f64 = 0.0005;
; Phrase timings kept for the lane (the last 200).
pub const SG_TIMINGS_KEPT : i64 = 200;
; Closed voice segments kept by the level meter (the last 256).
pub const SG_VOICE_SEGMENTS_KEPT : i64 = 256;
; What the level meter does with one window (VoiceActivity.add).
pub const SG_ACTIVITY_KEEP : i64 = 0;
pub const SG_ACTIVITY_SILENCE_STARTS : i64 = 1;
pub const SG_ACTIVITY_VOICE_STARTS : i64 = 2;
pub const SG_ACTIVITY_SILENCE_ENDS : i64 = 3;
pub const SG_ACTIVITY_SILENCE_ENDS_VOICE_STARTS : i64 = 4;
pub const SG_ACTIVITY_SEGMENT_CLOSES : i64 = 5;
; What a final result emits: nothing, the final phrase, or an empty final that discards the shown partial.
pub const SG_EVENT_NONE : i64 = 0;
pub const SG_EVENT_FINAL : i64 = 1;
pub const SG_EVENT_DISCARD : i64 = 2;
; AudioConversion: resampler room on top of the exact length, frames drained at the end, input statuses
; (AVAudioConverterInputStatus raw values).
pub const SG_CONVERSION_SLACK_FRAMES : i64 = 256;
pub const SG_FLUSH_FRAMES : i64 = 4096;
pub const SG_INPUT_HAVE_DATA : i64 = 0;
pub const SG_INPUT_NO_DATA_NOW : i64 = 1;
pub const SG_INPUT_END_OF_STREAM : i64 = 2;
; Int16 / Int32 PCM full scale (AudioConversion.rms), and the RMS block.
pub const SG_INT16_FULL_SCALE : f32 = 32768.0;
pub const SG_INT32_FULL_SCALE : f32 = 2147483648.0;
pub const SG_RMS_BLOCK : i64 = 4096;

; Swift's max and min on Double (max(a, b) = b >= a ? b : a; min(a, b) = b < a ? b : a).
pub fn sg_max_d(a: f64, b: f64) -> f64 {
    if (b >= a) { return b; }
    return a;
}

pub fn sg_min_d(a: f64, b: f64) -> f64 {
    if (b < a) { return b; }
    return a;
}

; Finite: not NaN and not an infinity (x - x is 0 only for finite x).
pub fn sg_is_finite(x: f64) -> bool {
    return x - x == 0.0;
}

; Seconds to whole milliseconds, rounded half away from zero.
pub fn sg_millis(seconds: f64) -> i64 {
    return cast_i64(round(seconds * SG_MS_PER_SECOND));
}

; VoiceActivity.level: RMS to level units, rounded.
pub fn sg_level_from_rms(rms: f32) -> i64 {
    var r: f64 = rms;
    return cast_i64(round(r * SG_LEVEL_SCALE));
}

; Frames in one meter window: max(1, Int(rate) * meterWindowMs / 1000).
pub fn sg_meter_window_frames(sample_rate: f64) -> i64 {
    var w: i64 = cast_i64(sample_rate) * SG_METER_WINDOW_MS / 1000;
    if (w >= 1) { return w; }
    return 1;
}

; Frames of silence fed after a stall cut: max(1, Int(rate) * stallFlushSilenceMs / 1000).
pub fn sg_stall_silence_frames(sample_rate: f64) -> i64 {
    var w: i64 = cast_i64(sample_rate) * SG_STALL_FLUSH_SILENCE_MS / 1000;
    if (w >= 1) { return w; }
    return 1;
}

pub fn sg_trims_arrivals(count: i64) -> bool {
    return count > SG_ARRIVALS_MAX;
}

pub fn sg_keeps_arrival(audio_end: f64, end: f64) -> bool {
    return audio_end > end - SG_ARRIVALS_KEEP_SECONDS;
}

pub fn sg_arrival_covers(audio_end: f64, t: f64) -> bool {
    return audio_end >= t - SG_ARRIVAL_TOLERANCE_SECONDS;
}

; The phrase is measured from its first voice, never before the phrase start.
pub fn sg_measure_start(phrase_start: f64, has_voice: bool, voice_start: f64) -> f64 {
    var v: f64 = phrase_start;
    if (has_voice) { v = voice_start; }
    return sg_max_d(phrase_start, v);
}

; The current pause: since the silence started, if it started after the measure start; else none.
pub fn sg_measure_pause(now: f64, start: f64, has_silence: bool, silence: f64) -> f64 {
    if (has_silence and silence > start) { return now - silence; }
    return 0.0;
}

; Speech in the phrase: up to the silence if it started after the measure start, none if it started
; before, else up to now.
pub fn sg_measure_speech(now: f64, start: f64, has_silence: bool, silence: f64) -> f64 {
    if (has_silence) {
        if (silence > start) { return silence - start; }
        return 0.0;
    }
    return now - start;
}

; finalizeAction flags: volatile text or voice past the phrase start; the stream is closing; cuts are off.
pub fn sg_finalize_flags(has_volatile_text: bool, last_voice_end: f64, phrase_start: f64, finishing: bool, cuts_enabled: bool) -> i64 {
    var flags: i64 = 0;
    if (has_volatile_text or last_voice_end > phrase_start + SG_CONTENT_VOICE_MARGIN_SECONDS) {
        flags = flags | SG_FLAG_HAS_CONTENT;
    }
    if (finishing) { flags = flags | SG_FLAG_FINISHING; }
    if (cuts_enabled == false) { flags = flags | SG_FLAG_CUTS_DISABLED; }
    return flags;
}

pub fn sg_last_cut_ago_ms(now: f64, has_last_cut: bool, last_cut: f64) -> i64 {
    if (has_last_cut) { return sg_millis(now - last_cut); }
    return SG_NO_CUT_MS;
}

; Where the analyzer is told to finalize: now minus the cut's backoff.
pub fn sg_cut_time(now: f64, action: i64, pause_ms: i64) -> f64 {
    var back: f64 = sg_cut_backoff_ms(action, pause_ms);
    return now - back / SG_MS_PER_SECOND;
}

; A source that stopped mid-phrase is cut: not finishing, cuts on, volatile text, audio last appended more
; than stallTimeoutMs ago, and the last cut (if any) more than minCutSpacingMs of fed audio back.
pub fn sg_stall_cut(finishing: bool, cuts_enabled: bool, has_volatile_text: bool, has_append: bool, ms_since_append: i64, has_last_cut: bool, ms_fed_since_cut: i64) -> bool {
    if (finishing or cuts_enabled == false or has_volatile_text == false or has_append == false) { return false; }
    if (ms_since_append > SG_STALL_TIMEOUT_MS) {
        if (has_last_cut and ms_fed_since_cut <= SG_MIN_CUT_SPACING_MS) { return false; }
        return true;
    }
    return false;
}

; A final was forced by a cut when the last cut lies inside the phrase.
pub fn sg_cut_in_phrase(has_last_cut: bool, last_cut: f64, phrase_start: f64) -> bool {
    return has_last_cut and last_cut > phrase_start;
}

pub fn sg_final_event(keep: bool, partial_shown: bool) -> i64 {
    if (keep) { return SG_EVENT_FINAL; }
    if (partial_shown) { return SG_EVENT_DISCARD; }
    return SG_EVENT_NONE;
}

; A partial is emitted when the phrase is kept and its text changed.
pub fn sg_partial_event(keep: bool, changed: bool) -> bool {
    return keep and changed;
}

; The phrase start moves forward to a finite result time.
pub fn sg_advance_phrase_start(phrase_start: f64, t: f64) -> f64 {
    if (sg_is_finite(t)) { return sg_max_d(phrase_start, t); }
    return phrase_start;
}

pub fn sg_timing_start(has_tokens: bool, first_start: f64, phrase_start: f64) -> f64 {
    if (has_tokens) { return first_start; }
    return phrase_start;
}

; The end of a phrase's audio: its last word, else the result range; pulled back to where the level meter
; heard the voice stop when that lies inside the last word.
pub fn sg_timing_end(has_tokens: bool, last_start: f64, last_end: f64, range_end: f64, audio_start: f64, last_voice_end: f64) -> f64 {
    var audio_end: f64 = range_end;
    var last_word_start: f64 = audio_start;
    if (has_tokens) {
        audio_end = last_end;
        last_word_start = last_start;
    }
    if (audio_end > last_voice_end and last_voice_end > last_word_start) { return last_voice_end; }
    return audio_end;
}

pub fn sg_trims_timings(count: i64) -> bool {
    return count > SG_TIMINGS_KEPT;
}

pub fn sg_range_measurable(start: f64, end: f64) -> bool {
    return sg_is_finite(start) and sg_is_finite(end) and end > start;
}

; A recognized word with a finite time range and some text.
pub fn sg_timed_word(start: f64, end: f64, word_bytes: i64) -> bool {
    return sg_is_finite(start) and sg_is_finite(end) and word_bytes > 0;
}

pub fn sg_transcriber_kind(language: i64) -> i64 {
    if (language == SG_LANG_RU) { return SG_MODULE_DICTATION; }
    return SG_MODULE_SPEECH;
}

; VoiceActivity.add for one window: what changes in the meter's state.
pub fn sg_activity_step(voice: bool, has_silence: bool, silence_start: f64, has_voice: bool, start: f64) -> i64 {
    if (voice) {
        if (has_silence) {
            if (has_voice and sg_millis(start - silence_start) >= SG_MIN_RECORDED_PAUSE_MS) { return SG_ACTIVITY_SEGMENT_CLOSES; }
            if (has_voice) { return SG_ACTIVITY_SILENCE_ENDS; }
            return SG_ACTIVITY_SILENCE_ENDS_VOICE_STARTS;
        }
        if (has_voice) { return SG_ACTIVITY_KEEP; }
        return SG_ACTIVITY_VOICE_STARTS;
    }
    if (has_silence) { return SG_ACTIVITY_KEEP; }
    return SG_ACTIVITY_SILENCE_STARTS;
}

pub fn sg_segments_to_drop(count: i64) -> i64 {
    if (count > SG_VOICE_SEGMENTS_KEPT) { return count - SG_VOICE_SEGMENTS_KEPT; }
    return 0;
}

; The open voice segment ends at the silence start, else at the last window's end, never before its start.
pub fn sg_open_segment_end(voice_start: f64, has_silence: bool, silence_start: f64, last_end: f64) -> f64 {
    var e: f64 = last_end;
    if (has_silence) { e = silence_start; }
    return sg_max_d(voice_start, e);
}

; Seconds of a segment inside a range: max(0, min(upper, rangeUpper) - max(lower, rangeLower)).
pub fn sg_overlap_seconds(lower: f64, upper: f64, range_lower: f64, range_upper: f64) -> f64 {
    var d: f64 = sg_min_d(upper, range_upper) - sg_max_d(lower, range_lower);
    return sg_max_d(0.0, d);
}

; AudioConversion.convert: ceil(frames * (toRate / fromRate)) + 256.
pub fn sg_conversion_capacity(frames: i64, from_rate: f64, to_rate: f64) -> i64 {
    var ratio: f64 = to_rate / from_rate;
    var f: f64 = frames;
    var scaled: f64 = f * ratio;
    return cast_i64(ceil(scaled)) + SG_CONVERSION_SLACK_FRAMES;
}

pub fn sg_converter_input(fed: bool, final: bool) -> i64 {
    if (fed) {
        if (final) { return SG_INPUT_END_OF_STREAM; }
        return SG_INPUT_NO_DATA_NOW;
    }
    return SG_INPUT_HAVE_DATA;
}

; AudioConversion.rms window: min(count or the buffer length, length - from); 0 when that is not
; positive or from is negative.
pub fn sg_window_count(from: i64, has_count: bool, count: i64, frame_length: i64) -> i64 {
    var want: i64 = frame_length;
    if (has_count) { want = count; }
    var n: i64 = want;
    if (frame_length - from < n) { n = frame_length - from; }
    if (n > 0 and from >= 0) { return n; }
    return 0;
}

pub fn sg_int16_to_float(v: i16) -> f32 {
    var f: f32 = v;
    return f / SG_INT16_FULL_SCALE;
}

pub fn sg_int32_to_float(v: i32) -> f32 {
    var f: f32 = v;
    return f / SG_INT32_FULL_SCALE;
}

; sum + v * v over count samples, in Float, in index order.
pub fn sg_sum_squares_f32(samples: [4096]f32, count: i64, sum: f32) -> f32 {
    var n: i64 = count;
    if (n > SG_RMS_BLOCK) { n = SG_RMS_BLOCK; }
    var total: f32 = sum;
    var i: i64 = 0;
    while (i < n) {
        var v: f32 = samples[i];
        var sq: f32 = v * v;
        total = total + sq;
        i = i + 1;
    }
    return total;
}

; sqrt(sum / Float(count)) in Float.
pub fn sg_rms_f32(sum: f32, count: i64) -> f32 {
    var n: f32 = count;
    var mean: f32 = sum / n;
    return sqrt(mean);
}

