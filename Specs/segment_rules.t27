; Copies text fixture `index` to out at `at` and returns its length (0 for an unknown index).
pub fn sg_fixture(index: i64, out: [8192]u8, at: i64) -> i64 {
    if (index < 0 or index >= SG_FX_COUNT or at < 0) { return 0; }
    var off: i64 = SG_FX_OFFSETS[index];
    var len: i64 = SG_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and at + k < SG_TEXT_MAX) {
        out[at + k] = SG_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; --- Moved out of Swift 2026-10-15 --------------------------------------------------------------------------------
; A phrase's voice starts at its first voice window (and ends at the end of its last).
pub fn sg_phrase_voice_start(has_start: bool, start: f64, window_start: f64) -> f64 {
    if (has_start) { return start; }
    return window_start;
}

; A cut asked of the analyzer is a time at this many units per second.
pub const SG_CUT_TIMESCALE : i32 = 16000;

; The arrival time of audio no mark covers (ARRIVAL_*): the last mark's, or now when there is none.
pub const SG_ARRIVAL_LAST : i64 = 0;
pub const SG_ARRIVAL_NOW : i64 = 1;
pub fn sg_arrival_fallback(has_marks: bool) -> i64 {
    if (has_marks) { return SG_ARRIVAL_LAST; }
    return SG_ARRIVAL_NOW;
}

; Text still volatile when the analyzer stops becomes a final phrase.
pub fn sg_flushes_volatile(has_volatile: bool) -> bool {
    return has_volatile;
}

test sg_voice_activity {
    // thresholdsAndFloor
    assert sg_is_voice(999, 0) == false;
    assert sg_is_voice(1000, 0) == true;
    assert sg_effective_threshold(1000000) == 2500;
    assert sg_effective_threshold(0) == 1000;
    assert sg_next_noise_floor(0, false, 700, 20) == 700000;
    assert sg_next_noise_floor(500000, true, 100, 20) == 100000;
    assert sg_next_noise_floor(0, true, 1000, 20) == 333;
    assert sg_next_noise_floor(0, true, 1000, -5) == 0;
    assert sg_next_noise_floor(0, true, 1000, 90000) == 1000000;
    // The floor never passes the target and never drops below the old floor while rising.
    var f: i64 = 0;
    var bad: u32 = 0;
    while (f <= 2000000) {
        var level: i64 = 0;
        while (level <= 3000) {
            var next: i64 = sg_next_noise_floor(f, true, level, 20);
            var target: i64 = level * 1000;
            if (target >= f and (next < f or next > target)) { bad = bad + 1; }
            if (target < f and next != target) { bad = bad + 1; }
            level = level + 250;
        }
        f = f + 125000;
    }
    assert bad == 0;
}

test sg_finalize_rules {
    // waitsWhileSpeakingAShortPhrase
    assert sg_finalize_action(0, 3000, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(0, 11999, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    // endOfPhraseAfterSixHundredMilliseconds
    assert sg_finalize_action(599, 2000, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(600, 2000, 0, 9223372036854775807, 60000, 1) == SG_ACTION_END_OF_PHRASE;
    assert sg_finalize_action(600, 200, 0, 9223372036854775807, 60000, 1) == SG_ACTION_END_OF_PHRASE;
    // flagsBlockCuts
    assert sg_finalize_action(900, 2000, 0, 9223372036854775807, 60000, 0) == SG_ACTION_WAIT;
    assert sg_finalize_action(900, 2000, 0, 9223372036854775807, 60000, 3) == SG_ACTION_WAIT;
    assert sg_finalize_action(900, 2000, 0, 9223372036854775807, 60000, 5) == SG_ACTION_WAIT;
    // longMonologueCutsInAPause
    assert sg_finalize_action(300, 5999, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(149, 6500, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(150, 6500, 0, 9223372036854775807, 60000, 1) == SG_ACTION_MONOLOGUE_PAUSE;
    // shortPauseNeedsSentenceEndOrHardLimit
    assert sg_finalize_action(80, 6500, SG_PUNCTUATION_CLAUSE, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(80, 6500, SG_PUNCTUATION_SENTENCE, 9223372036854775807, 60000, 1) == SG_ACTION_MONOLOGUE_PAUSE;
    assert sg_finalize_action(79, 6500, SG_PUNCTUATION_SENTENCE, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(80, 8999, 0, 9223372036854775807, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(80, 9000, 0, 9223372036854775807, 60000, 1) == SG_ACTION_MONOLOGUE_PAUSE;
    // absoluteLimitCutsInsideSpeech
    assert sg_finalize_action(0, 12000, 0, 9223372036854775807, 60000, 1) == SG_ACTION_MONOLOGUE_FORCED;
    // cutsAreSpacedAndStayInsideThePhrase
    assert sg_finalize_action(600, 2000, 0, 550, 60000, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(600, 2000, 0, 551, 60000, 1) == SG_ACTION_END_OF_PHRASE;
    assert sg_finalize_action(600, 2000, 0, 9223372036854775807, 450, 1) == SG_ACTION_WAIT;
    assert sg_finalize_action(600, 2000, 0, 9223372036854775807, 451, 1) == SG_ACTION_END_OF_PHRASE;
    // backoffKeepsATrailingMargin
    assert sg_cut_backoff_ms(SG_ACTION_END_OF_PHRASE, 600) == 450;
    assert sg_cut_backoff_ms(SG_ACTION_MONOLOGUE_PAUSE, 100) == 0;
    assert sg_cut_backoff_ms(SG_ACTION_MONOLOGUE_FORCED, 0) == 0;
    assert sg_cut_backoff_ms(SG_ACTION_WAIT, 900) == 0;
    // Every input: an action only with content and cuts allowed; a forced cut only while speaking.
    var flags: i64 = 0;
    var bad: u32 = 0;
    while (flags < 8) {
        var pause: i64 = 0;
        while (pause <= 900) {
            var speech: i64 = 0;
            while (speech <= 13000) {
                var p: i64 = 0;
                while (p < 3) {
                    var a: i64 = sg_finalize_action(pause, speech, p, 9223372036854775807, 60000, flags);
                    if (a < SG_ACTION_WAIT or a > SG_ACTION_MONOLOGUE_FORCED) { bad = bad + 1; }
                    if (a != SG_ACTION_WAIT and flags != SG_FLAG_HAS_CONTENT) { bad = bad + 1; }
                    if (a == SG_ACTION_MONOLOGUE_FORCED and pause > 0) { bad = bad + 1; }
                    if (a == SG_ACTION_END_OF_PHRASE and pause < SG_END_OF_PHRASE_PAUSE_MS) { bad = bad + 1; }
                    p = p + 1;
                }
                speech = speech + 500;
            }
            pause = pause + 10;
        }
        flags = flags + 1;
    }
    assert bad == 0;
}

test sg_text_rules {
    var t: [8192]u8 = [0; 8192];
    // punctuation
    assert sg_punctuation_code(t, sg_fixture(SG_FX_BOM_DIA, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_OUVE, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_DOBRYI, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_ENTAO, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_QUOTE, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_GUILLEMET, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_CURLY, t, 0)) == SG_PUNCTUATION_SENTENCE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_COMMA, t, 0)) == SG_PUNCTUATION_CLAUSE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_EM_DASH, t, 0)) == SG_PUNCTUATION_CLAUSE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_EN_DASH, t, 0)) == SG_PUNCTUATION_CLAUSE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_NO_PUNCT, t, 0)) == SG_PUNCTUATION_NONE;
    assert sg_punctuation_code(t, sg_fixture(SG_FX_EMPTY, t, 0)) == SG_PUNCTUATION_NONE;
    // words
    assert sg_word_count(t, sg_fixture(SG_FX_WORDS3, t, 0)) == 3;
    assert sg_word_count(t, sg_fixture(SG_FX_EMPTY, t, 0)) == 0;
    assert sg_word_count(t, sg_fixture(SG_FX_DA, t, 0)) == 1;
    // speechContent
    assert sg_has_speech_content(t, sg_fixture(SG_FX_OK, t, 0)) == true;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_TWELVE, t, 0)) == true;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_YA, t, 0)) == true;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_E_ACUTE, t, 0)) == true;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_A, t, 0)) == false;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_DOT, t, 0)) == false;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_ELLIPSIS, t, 0)) == false;
    assert sg_has_speech_content(t, sg_fixture(SG_FX_QUOTES_DASH, t, 0)) == false;
    // phraseVerdict
    assert sg_phrase_action(t, sg_fixture(SG_FX_B_DOT, t, 0), 0) == SG_PHRASE_DROP_HALLUCINATION;
    assert sg_phrase_action(t, sg_fixture(SG_FX_DOT, t, 0), 0) == SG_PHRASE_DROP_NO_CONTENT;
    assert sg_phrase_action(t, sg_fixture(SG_FX_SIM, t, 0), 400) == SG_PHRASE_KEEP;
    assert sg_phrase_action(t, sg_fixture(SG_FX_FOUR_WORDS, t, 0), 0) == SG_PHRASE_KEEP;
    assert sg_phrase_action(t, sg_fixture(SG_FX_THREE_WORDS, t, 0), 99) == SG_PHRASE_DROP_HALLUCINATION;
    assert sg_phrase_action(t, sg_fixture(SG_FX_THREE_WORDS, t, 0), 100) == SG_PHRASE_KEEP;
    // Every single byte: never content alone (shorter than minPhraseBytes); never a word count above 1.
    var b: u32 = 0;
    var bad: u32 = 0;
    while (b < 256) {
        t[0] = cast_u8(b);
        if (sg_has_speech_content(t, 1)) { bad = bad + 1; }
        if (sg_word_count(t, 1) > 1) { bad = bad + 1; }
        b = b + 1;
    }
    assert bad == 0;
}

test sg_cut_rules {
    var t: [8192]u8 = [0; 8192];
    var head: [8192]u8 = [0; 8192];
    // shortTextIsNotCut
    var n: i64 = sg_fixture(SG_FX_BOM_DIA, t, 0);
    assert sg_cut_byte_index(t, n, 200, 24) == n;
    // prefersTheLastSentenceEnd
    n = sg_fixture(SG_FX_SENTENCES, t, 0);
    assert sg_cut_byte_index(t, n, 40, 5) == sg_fixture(SG_FX_SENTENCES_HEAD, head, 0);
    // thenTheLastClause
    n = sg_fixture(SG_FX_CLAUSES, t, 0);
    assert sg_cut_byte_index(t, n, 40, 5) == sg_fixture(SG_FX_CLAUSES_HEAD, head, 0);
    // thenTheLastSpace
    n = sg_fixture(SG_FX_SPACES, t, 0);
    var cut: i64 = sg_cut_byte_index(t, n, 30, 5);
    assert cut <= 30;
    assert t[cut] == SG_SPACE;
    // neverSplitsACharacter
    n = sg_fixture(SG_FX_ZHE40, t, 0);
    assert sg_cut_byte_index(t, n, 31, 5) == 30;
    // respectsMinBytesAndEllipsis
    n = sg_fixture(SG_FX_ELLIPSIS_TEXT, t, 0);
    assert sg_cut_byte_index(t, n, 30, 8) == sg_fixture(SG_FX_ELLIPSIS_HEAD, head, 0);
    assert sg_cut_byte_index(t, n, 0, 8) == n;
    // Every max on every fixture: the cut lies in 1...max and on a character boundary.
    var fx: i64 = 0;
    var bad: u32 = 0;
    while (fx < SG_FX_COUNT) {
        n = sg_fixture(fx, t, 0);
        var m: i64 = 1;
        while (m < n) {
            var c: i64 = sg_cut_byte_index(t, n, m, 5);
            if (c < 1 or c > m) { bad = bad + 1; }
            if (c < n and (t[c] & SG_CONTINUATION_MASK) == SG_CONTINUATION and c != m) { bad = bad + 1; }
            m = m + 1;
        }
        fx = fx + 1;
    }
    assert bad == 0;
}

test sg_moved_rules {
    assert sg_millis(1.0) == 1000;
    assert sg_millis(0.0005) == 1;
    assert sg_millis(-0.0005) == -1;
    assert sg_millis(0.0004) == 0;
    assert sg_level_from_rms(0.01) == 1000;
    assert sg_level_from_rms(0.0) == 0;
    assert sg_meter_window_frames(48000.0) == 960;
    assert sg_meter_window_frames(16000.9) == 320;
    assert sg_meter_window_frames(10.0) == 1;
    assert sg_stall_silence_frames(48000.0) == 24000;
    assert sg_stall_silence_frames(1.0) == 1;
    assert sg_trims_arrivals(2401) == true;
    assert sg_trims_arrivals(2400) == false;
    assert sg_keeps_arrival(100.5, 220.0) == true;
    assert sg_keeps_arrival(100.0, 220.0) == false;
    assert sg_arrival_covers(1.0, 1.0005) == true;
    assert sg_arrival_covers(1.0, 1.001) == false;
    assert sg_measure_start(5.0, true, 6.0) == 6.0;
    assert sg_measure_start(5.0, true, 4.0) == 5.0;
    assert sg_measure_start(5.0, false, 9.0) == 5.0;
    assert sg_measure_pause(10.0, 5.0, true, 9.0) == 1.0;
    assert sg_measure_pause(10.0, 5.0, true, 4.0) == 0.0;
    assert sg_measure_pause(10.0, 5.0, false, 9.0) == 0.0;
    assert sg_measure_speech(10.0, 5.0, true, 9.0) == 4.0;
    assert sg_measure_speech(10.0, 5.0, true, 4.0) == 0.0;
    assert sg_measure_speech(10.0, 5.0, false, 9.0) == 5.0;
    assert sg_finalize_flags(true, 0.0, 0.0, false, true) == SG_FLAG_HAS_CONTENT;
    assert sg_finalize_flags(false, 1.06, 1.0, false, true) == SG_FLAG_HAS_CONTENT;
    assert sg_finalize_flags(false, 1.05, 1.0, true, false) == SG_FLAG_FINISHING + SG_FLAG_CUTS_DISABLED;
    assert sg_last_cut_ago_ms(3.0, true, 2.5) == 500;
    assert sg_last_cut_ago_ms(3.0, false, 2.5) == SG_NO_CUT_MS;
    assert sg_cut_time(10.0, SG_ACTION_END_OF_PHRASE, 650) == 9.5;
    assert sg_cut_time(10.0, SG_ACTION_MONOLOGUE_FORCED, 0) == 10.0;
    assert sg_stall_cut(false, true, true, true, 1001, false, 0) == true;
    assert sg_stall_cut(false, true, true, true, 1000, false, 0) == false;
    assert sg_stall_cut(false, true, true, true, 1001, true, 100) == false;
    assert sg_stall_cut(false, true, true, true, 1001, true, 101) == true;
    assert sg_stall_cut(true, true, true, true, 5000, false, 0) == false;
    assert sg_stall_cut(false, false, true, true, 5000, false, 0) == false;
    assert sg_stall_cut(false, true, false, true, 5000, false, 0) == false;
    assert sg_stall_cut(false, true, true, false, 5000, false, 0) == false;
    assert sg_cut_in_phrase(true, 2.0, 1.0) == true;
    assert sg_cut_in_phrase(true, 1.0, 1.0) == false;
    assert sg_cut_in_phrase(false, 2.0, 1.0) == false;
    assert sg_final_event(true, false) == SG_EVENT_FINAL;
    assert sg_final_event(false, true) == SG_EVENT_DISCARD;
    assert sg_final_event(false, false) == SG_EVENT_NONE;
    assert sg_partial_event(true, true) == true;
    assert sg_partial_event(true, false) == false;
    assert sg_advance_phrase_start(1.0, 2.0) == 2.0;
    assert sg_advance_phrase_start(3.0, 2.0) == 3.0;
    var inf: f64 = 1.0e308 * 10.0;
    assert sg_advance_phrase_start(3.0, inf) == 3.0;
    assert sg_is_finite(inf) == false;
    assert sg_is_finite(inf - inf) == false;
    assert sg_is_finite(-2.5) == true;
    assert sg_timing_start(true, 1.5, 1.0) == 1.5;
    assert sg_timing_start(false, 1.5, 1.0) == 1.0;
    assert sg_timing_end(true, 2.0, 3.0, 4.0, 1.0, 2.5) == 2.5;
    assert sg_timing_end(true, 2.0, 3.0, 4.0, 1.0, 1.5) == 3.0;
    assert sg_timing_end(false, 2.0, 3.0, 4.0, 1.0, 1.5) == 1.5;
    assert sg_timing_end(false, 2.0, 3.0, 4.0, 1.0, 9.0) == 4.0;
    assert sg_trims_timings(201) == true;
    assert sg_trims_timings(200) == false;
    assert sg_range_measurable(1.0, 2.0) == true;
    assert sg_range_measurable(2.0, 2.0) == false;
    assert sg_range_measurable(1.0, inf) == false;
    assert sg_timed_word(1.0, 2.0, 3) == true;
    assert sg_timed_word(1.0, 2.0, 0) == false;
    assert sg_timed_word(inf, 2.0, 3) == false;
    assert sg_transcriber_kind(SG_LANG_PT_BR) == SG_MODULE_SPEECH;
    assert sg_transcriber_kind(SG_LANG_RU) == SG_MODULE_DICTATION;
    // The level meter's state machine for every presence of silence and voice.
    assert sg_activity_step(true, true, 1.0, true, 1.06) == SG_ACTIVITY_SEGMENT_CLOSES;
    assert sg_activity_step(true, true, 1.0, true, 1.04) == SG_ACTIVITY_SILENCE_ENDS;
    assert sg_activity_step(true, true, 1.0, false, 1.5) == SG_ACTIVITY_SILENCE_ENDS_VOICE_STARTS;
    assert sg_activity_step(true, false, 0.0, true, 1.5) == SG_ACTIVITY_KEEP;
    assert sg_activity_step(true, false, 0.0, false, 1.5) == SG_ACTIVITY_VOICE_STARTS;
    assert sg_activity_step(false, true, 1.0, true, 1.5) == SG_ACTIVITY_KEEP;
    assert sg_activity_step(false, false, 0.0, true, 1.5) == SG_ACTIVITY_SILENCE_STARTS;
    assert sg_segments_to_drop(257) == 1;
    assert sg_segments_to_drop(256) == 0;
    assert sg_open_segment_end(1.0, true, 2.0, 3.0) == 2.0;
    assert sg_open_segment_end(1.0, false, 2.0, 3.0) == 3.0;
    assert sg_open_segment_end(4.0, true, 2.0, 3.0) == 4.0;
    assert sg_overlap_seconds(1.0, 3.0, 2.0, 5.0) == 1.0;
    assert sg_overlap_seconds(1.0, 3.0, 4.0, 5.0) == 0.0;
    assert sg_overlap_seconds(1.0, 3.0, 0.0, 5.0) == 2.0;
    assert sg_conversion_capacity(100, 48000.0, 16000.0) == 34 + 256;
    assert sg_conversion_capacity(441, 44100.0, 48000.0) == 481 + 256;
    assert sg_converter_input(false, false) == SG_INPUT_HAVE_DATA;
    assert sg_converter_input(true, false) == SG_INPUT_NO_DATA_NOW;
    assert sg_converter_input(true, true) == SG_INPUT_END_OF_STREAM;
    assert sg_window_count(0, true, 960, 4096) == 960;
    assert sg_window_count(4000, true, 960, 4096) == 96;
    assert sg_window_count(0, false, 0, 512) == 512;
    assert sg_window_count(-1, true, 10, 100) == 0;
    assert sg_window_count(100, true, 10, 100) == 0;
    assert sg_int16_to_float(16384) == 0.5;
    assert sg_int32_to_float(-2147483648) == -1.0;
    var block: [4096]f32 = [0.0; 4096];
    block[0] = 3.0;
    block[1] = 4.0;
    assert sg_sum_squares_f32(block, 2, 0.0) == 25.0;
    assert sg_sum_squares_f32(block, 2, 1.0) == 26.0;
    assert sg_rms_f32(25.0, 4) == 2.5;
}

test sg_moved_out_of_swift {
    assert sg_phrase_voice_start(true, 1.5, 2.0) == 1.5;
    assert sg_phrase_voice_start(false, 1.5, 2.0) == 2.0;
    assert SG_CUT_TIMESCALE == 16000;
    assert sg_arrival_fallback(true) == SG_ARRIVAL_LAST;
    assert sg_arrival_fallback(false) == SG_ARRIVAL_NOW;
    assert sg_flushes_volatile(true) == true;
}
