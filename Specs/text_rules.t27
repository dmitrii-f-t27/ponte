// SPDX-License-Identifier: MIT
; Specs/text_rules.t27 -- Ponte: Russian text the owner types or pastes into the outgoing column, said into the call
; The column "Ya -> po-portugalski" has a text field and the button "Skazat'" (owner's request 2026-10-13).
; The text enters the outgoing lane's own phrase pipeline as final phrases: the same translator with the
; conversation context, the same voice, call output (BlackHole) and queue as a spoken phrase, in order, with
; no transcriber and no push-to-talk gate (typed text is said while the key is up). The pause "Pauza golosa
; v zvonok" and the speech flags are the pipeline's own (ln_speak_requested, ln_phrase_step): while paused
; the translation is shown and not said. This spec decides: when "Skazat'" is enabled and why not; the
; longest text said at once; how a long text is split into phrases (at sentence ends first, so translation
; and speech start soon and sound natural); which pieces are said; which control Command-Return presses; the
; note under the field; and the marker of a typed line. Whether a text has speech content is
; sg_has_speech_content (segment_rules.t27, through SpeechRules); trimming Unicode whitespace stays in Swift.
; Text is UTF-8 bytes in a buffer of TX_TEXT_MAX bytes with its length (a longer length is read as
; TX_TEXT_MAX); whitespace is 0x20, 0x09, 0x0A and 0x0D. ASCII only.
; Facade: PonteApp/TextRules.swift. Oracle: Tests/PonteTests/Oracles/TextRulesLegacy.swift.
; Generated C: Sources/PonteSpecs/text_rules.h (Specs/generate.sh).

module PonteTextRules;

pub const TX_TEXT_MAX : i64 = 8192;
; The longest text said at once, in bytes after trimming: about 2000 Cyrillic letters, two minutes of speech.
pub const TX_MAX_BYTES : i64 = 4000;
; The note under the field counts Russian letters: two bytes each.
pub const TX_MAX_LETTERS : i64 = 2000;
; A phrase is at least this many bytes: a shorter sentence joins the next one, a shorter tail joins the
; phrase before it...
pub const TX_PHRASE_MIN_BYTES : i64 = 24;
; ...and at most this many: a longer sentence is cut at a line break, a clause end or a space.
pub const TX_PHRASE_MAX_BYTES : i64 = 400;

; --- Can the text be said? (SUBMIT_*) ------------------------------------------------------------------------
pub const TX_SUBMIT_OK : i32 = 0;
; No call is running.
pub const TX_SUBMIT_NOT_RUNNING : i32 = 1;
; A call runs, but the outgoing lane did not start.
pub const TX_SUBMIT_NO_LANE : i32 = 2;
; Nothing to say: no letter or digit after trimming.
pub const TX_SUBMIT_EMPTY : i32 = 3;
; Longer than TX_MAX_BYTES: refused, the note says to send it in parts.
pub const TX_SUBMIT_TOO_LONG : i32 = 4;

; --- The note under the field (NOTE_*) --------------------------------------------------------------------------
pub const TX_NOTE_NONE : i32 = 0;
pub const TX_NOTE_TOO_LONG : i32 = 1;
; Text is waiting, but no call runs: press "Start".
pub const TX_NOTE_NEEDS_START : i32 = 2;
; A call runs without the outgoing lane.
pub const TX_NOTE_NO_LANE : i32 = 3;
; Voice paused: the translation appears, nothing is said.
pub const TX_NOTE_PAUSED : i32 = 4;

; --- Marker of a line in the transcript (MARK_*) ------------------------------------------------------------------
pub const TX_MARK_NONE : i32 = 0;
; Typed, not spoken: a small keyboard next to the time.
pub const TX_MARK_KEYBOARD : i32 = 1;

; --- Command-Return (CMDRET_*) ------------------------------------------------------------------------------------
; "Start" / "Stop" (the shortcut it always had).
pub const TX_CMDRET_RUN : i32 = 0;
; "Skazat'": while a call runs and the text field has the focus. Return alone types a new line.
pub const TX_CMDRET_SAY : i32 = 1;

; --- Bytes --------------------------------------------------------------------------------------------------------
pub const TX_SPACE : u8 = 32;
pub const TX_TAB : u8 = 9;
pub const TX_LF : u8 = 10;
pub const TX_CR : u8 = 13;
pub const TX_DOT : u8 = 46;
pub const TX_EXCLAMATION : u8 = 33;
pub const TX_QUESTION : u8 = 63;
pub const TX_COMMA : u8 = 44;
pub const TX_SEMICOLON : u8 = 59;
pub const TX_COLON : u8 = 58;
pub const TX_QUOTE : u8 = 34;
pub const TX_APOSTROPHE : u8 = 39;
pub const TX_PAREN_CLOSE : u8 = 41;
; UTF-8: C2 BB is a closing guillemet; E2 80 9D a closing curly quote, E2 80 A6 an ellipsis,
; E2 80 94 an em dash, E2 80 93 an en dash.
pub const TX_LEAD_C2 : u8 = 194;
pub const TX_LEAD_E2 : u8 = 226;
pub const TX_SECOND_80 : u8 = 128;
pub const TX_GUILLEMET_CLOSE : u8 = 187;
pub const TX_CURLY_CLOSE : u8 = 157;
pub const TX_ELLIPSIS : u8 = 166;
pub const TX_EM_DASH : u8 = 148;
pub const TX_EN_DASH : u8 = 147;
; Lead bytes of two-byte letters (U+00C0..U+07FF: Latin-1 letters, Cyrillic); C2 is symbols.
pub const TX_LEAD_LETTER_FIRST : u8 = 195;
pub const TX_LEAD_LETTER_LAST : u8 = 223;
pub const TX_CONTINUATION_MASK : u8 = 192;
pub const TX_CONTINUATION : u8 = 128;

