pub const TX_FX_OFFSETS : [29]u32 = [0, 126, 164, 199, 250, 286, 344, 448, 564, 642, 737, 781, 877, 921, 1020, 1061, 1157, 1212, 1319, 1374, 1453, 1543, 1606, 2236, 2309, 2796, 3576, 4076, 4083];
pub const TX_FX_LENGTHS : [29]u32 = [126, 38, 35, 51, 36, 58, 104, 116, 78, 95, 44, 96, 44, 99, 41, 96, 55, 107, 55, 79, 90, 63, 630, 73, 487, 780, 500, 7, 0];
; <<< generated

; --- Can the text be said? ------------------------------------------------------------------------------------------
; bytes: the UTF-8 length of the trimmed text; has_content: sg_has_speech_content of it.
; Not running, then no outgoing lane, then nothing to say, then too long.
pub fn tx_submit_check(running: bool, has_lane: bool, bytes: i64, has_content: bool) -> i32 {
    if (running == false) { return TX_SUBMIT_NOT_RUNNING; }
    if (has_lane == false) { return TX_SUBMIT_NO_LANE; }
    if (has_content == false) { return TX_SUBMIT_EMPTY; }
    if (bytes > TX_MAX_BYTES) { return TX_SUBMIT_TOO_LONG; }
    return TX_SUBMIT_OK;
}

; "Skazat'" is enabled only when the text can be said.
pub fn tx_say_enabled(check: i32) -> bool {
    return check == TX_SUBMIT_OK;
}

; The note under the field: too long; text waits for "Start" (only when the field is not empty); the call runs
; without the outgoing lane; the voice is paused (the translation appears, nothing is said); else none.
pub fn tx_field_note(check: i32, bytes: i64, paused: bool) -> i32 {
    if (check == TX_SUBMIT_TOO_LONG) { return TX_NOTE_TOO_LONG; }
    if (check == TX_SUBMIT_NOT_RUNNING) {
        if (bytes > 0) { return TX_NOTE_NEEDS_START; }
        return TX_NOTE_NONE;
    }
    if (check == TX_SUBMIT_NO_LANE) { return TX_NOTE_NO_LANE; }
    if (paused) { return TX_NOTE_PAUSED; }
    return TX_NOTE_NONE;
}

; Command-Return says the text while a call runs and the field has the focus; otherwise it is "Start" / "Stop".
pub fn tx_command_return(field_focused: bool, running: bool) -> i32 {
    if (field_focused and running) { return TX_CMDRET_SAY; }
    return TX_CMDRET_RUN;
}

; The marker of a transcript line.
pub fn tx_line_marker(typed: bool) -> i32 {
    if (typed) { return TX_MARK_KEYBOARD; }
    return TX_MARK_NONE;
}

; A piece of a split text is said only if it has speech content (a tail of smileys is not); bytes after trimming.
pub fn tx_piece_said(has_content: bool, bytes: i64) -> bool {
    return has_content and bytes > 0;
}

; --- Splitting a text into phrases ------------------------------------------------------------------------------------
; A text length as read here: below 0 is 0, above TX_TEXT_MAX is TX_TEXT_MAX.
pub fn tx_text_len(len: i64) -> i64 {
    if (len < 0) { return 0; }
    if (len > TX_TEXT_MAX) { return TX_TEXT_MAX; }
    return len;
}

pub fn tx_is_space(b: u8) -> bool {
    return b == TX_SPACE or b == TX_TAB or b == TX_LF or b == TX_CR;
}

pub fn tx_is_continuation(b: u8) -> bool {
    return (b & TX_CONTINUATION_MASK) == TX_CONTINUATION;
}

; The first byte at or after `at` that is not whitespace: where the next phrase starts (len when none).
pub fn tx_phrase_start(text: [8192]u8, len: i64, at: i64) -> i64 {
    var n: i64 = tx_text_len(len);
    var i: i64 = at;
    if (i < 0) { i = 0; }
    if (i >= n) { return n; }
    while (i < n and tx_is_space(text[i])) { i = i + 1; }
    return i;
}

; A dot after a one-letter word is not a sentence end: initials and abbreviations ("D. Fedorov", "t. e.",
; "i t. d."), list numbers ("2."). One letter is an ASCII letter or digit, or a two-byte letter (lead C3..DF),
; with whitespace or the start of the text before it.
pub fn tx_one_letter_before(text: [8192]u8, i: i64) -> bool {
    if (i >= 1) {
        var b: u8 = text[i - 1];
        if ((b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)) {
            return i == 1 or tx_is_space(text[i - 2]);
        }
    }
    if (i >= 2) {
        var lead: u8 = text[i - 2];
        if (lead >= TX_LEAD_LETTER_FIRST and lead <= TX_LEAD_LETTER_LAST and tx_is_continuation(text[i - 1])) {
            return i == 2 or tx_is_space(text[i - 3]);
        }
    }
    return false;
}

; A sentence ends with the mark at byte i (. ! ? or the ellipsis; not a dot after a one-letter word): the index
; after the mark and any closing " ' ) guillemet or curly quote, which must be the end of the text or whitespace.
; -1 when no sentence ends there. n is the readable length.
pub fn tx_sentence_end_at(text: [8192]u8, n: i64, i: i64) -> i64 {
    var b: u8 = text[i];
    var e: i64 = -1;
    if (b == TX_EXCLAMATION or b == TX_QUESTION) {
        e = i + 1;
    } else if (b == TX_DOT) {
        if (tx_one_letter_before(text, i) == false) { e = i + 1; }
    } else if (b == TX_LEAD_E2 and i + 2 < n and text[i + 1] == TX_SECOND_80 and text[i + 2] == TX_ELLIPSIS) {
        e = i + 3;
    }
    if (e < 0) { return -1; }
    var closing: bool = true;
    while (closing and e < n) {
        var c: u8 = text[e];
        if (c == TX_QUOTE or c == TX_APOSTROPHE or c == TX_PAREN_CLOSE) {
            e = e + 1;
        } else if (c == TX_LEAD_C2 and e + 1 < n and text[e + 1] == TX_GUILLEMET_CLOSE) {
            e = e + 2;
        } else if (c == TX_LEAD_E2 and e + 2 < n and text[e + 1] == TX_SECOND_80 and text[e + 2] == TX_CURLY_CLOSE) {
            e = e + 3;
        } else {
            closing = false;
        }
    }
    if (e == n) { return e; }
    if (tx_is_space(text[e])) { return e; }
    return -1;
}

; A paragraph ends at the line feed at byte i when only spaces, tabs and CR stand between it and the next
; line feed (an empty line): it counts as a sentence end, at i. -1 otherwise.
pub fn tx_paragraph_end_at(text: [8192]u8, n: i64, i: i64) -> i64 {
    if (text[i] != TX_LF) { return -1; }
    var j: i64 = i + 1;
    while (j < n and (text[j] == TX_SPACE or text[j] == TX_TAB or text[j] == TX_CR)) { j = j + 1; }
    if (j < n and text[j] == TX_LF) { return i; }
    return -1;
}

; A clause ends with , ; : or a dash at byte i, followed by whitespace: the index after it. -1 otherwise.
pub fn tx_clause_end_at(text: [8192]u8, n: i64, i: i64) -> i64 {
    var b: u8 = text[i];
    var e: i64 = -1;
    if (b == TX_COMMA or b == TX_SEMICOLON or b == TX_COLON) {
        e = i + 1;
    } else if (b == TX_LEAD_E2 and i + 2 < n and text[i + 1] == TX_SECOND_80 and (text[i + 2] == TX_EM_DASH or text[i + 2] == TX_EN_DASH)) {
        e = i + 3;
    }
    if (e < 0 or e >= n) { return -1; }
    if (tx_is_space(text[e])) { return e; }
    return -1;
}

; Where the phrase that starts at `start` ends (the phrase is text[start..<end], the caller trims it).
; 1. The first sentence or paragraph end that makes the phrase at least TX_PHRASE_MIN_BYTES long and at most
;    TX_PHRASE_MAX_BYTES, and leaves either nothing or at least TX_PHRASE_MIN_BYTES after the whitespace.
; 2. Else the whole rest, when it is at most TX_PHRASE_MAX_BYTES.
; 3. Else, within TX_PHRASE_MAX_BYTES and at least TX_PHRASE_MIN_BYTES in: the last line feed, else the last
;    clause end, else the last whitespace, else the limit moved back to the start of a character (the limit
;    itself if that reaches the start).
; A start at or past the end returns the readable length.
pub fn tx_phrase_end(text: [8192]u8, len: i64, start: i64) -> i64 {
    var n: i64 = tx_text_len(len);
    var s: i64 = start;
    if (s < 0) { s = 0; }
    if (s >= n) { return n; }
    var limit: i64 = n;
    if (n - s > TX_PHRASE_MAX_BYTES) { limit = s + TX_PHRASE_MAX_BYTES; }
    var line_cut: i64 = -1;
    var clause_cut: i64 = -1;
    var space_cut: i64 = -1;
    var i: i64 = s;
    while (i < limit) {
        var e: i64 = tx_sentence_end_at(text, n, i);
        if (e < 0) { e = tx_paragraph_end_at(text, n, i); }
        if (e >= 0 and e <= limit and e - s >= TX_PHRASE_MIN_BYTES) {
            var tail: i64 = tx_phrase_start(text, n, e);
            if (tail >= n or n - tail >= TX_PHRASE_MIN_BYTES) { return e; }
        }
        if (i - s >= TX_PHRASE_MIN_BYTES) {
            if (text[i] == TX_LF) { line_cut = i; }
            if (tx_is_space(text[i])) { space_cut = i; }
        }
        var c: i64 = tx_clause_end_at(text, n, i);
        if (c >= 0 and c <= limit and c - s >= TX_PHRASE_MIN_BYTES) { clause_cut = c; }
        i = i + 1;
    }
    if (limit == n) { return n; }
    if (line_cut >= 0) { return line_cut; }
    if (clause_cut >= 0) { return clause_cut; }
    if (space_cut >= 0) { return space_cut; }
    var j: i64 = limit;
    while (j > s and tx_is_continuation(text[j])) { j = j - 1; }
    if (j > s) { return j; }
    return limit;
}

; --- Texts for the tests ------------------------------------------------------------------------------------------
; Copies text fixture `index` to out at `at` and returns its length (0 for an unknown index).
pub fn tx_fixture(index: i64, out: [8192]u8, at: i64) -> i64 {
    if (index < 0 or index >= TX_FX_COUNT or at < 0) { return 0; }
    var off: i64 = TX_FX_OFFSETS[index];
    var len: i64 = TX_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and at + k < TX_TEXT_MAX) {
        out[at + k] = TX_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

; The length of fixture `index` (0 for an unknown index).
pub fn tx_fixture_len(index: i64) -> i64 {
    if (index < 0 or index >= TX_FX_COUNT) { return 0; }
    var len: i64 = TX_FX_LENGTHS[index];
    return len;
}

test tx_submit_rules {
    assert TX_MAX_LETTERS * 2 == TX_MAX_BYTES;
    // The order of the checks.
    assert tx_submit_check(false, false, 0, false) == TX_SUBMIT_NOT_RUNNING;
    assert tx_submit_check(false, true, 10, true) == TX_SUBMIT_NOT_RUNNING;
    assert tx_submit_check(true, false, 10, true) == TX_SUBMIT_NO_LANE;
    assert tx_submit_check(true, true, 0, false) == TX_SUBMIT_EMPTY;
    assert tx_submit_check(true, true, 9000, false) == TX_SUBMIT_EMPTY;
    assert tx_submit_check(true, true, 4000, true) == TX_SUBMIT_OK;
    assert tx_submit_check(true, true, 4001, true) == TX_SUBMIT_TOO_LONG;
    assert tx_submit_check(true, true, 2, true) == TX_SUBMIT_OK;
    assert tx_say_enabled(TX_SUBMIT_OK) == true;
    // Every flag set and lengths around the limit: enabled exactly when running, with the lane, content and fit.
    var bad: u32 = 0;
    var bits: i32 = 0;
    while (bits < 8) {
        var running: bool = (bits & 1) != 0;
        var lane: bool = (bits & 2) != 0;
        var content: bool = (bits & 4) != 0;
        var b: i64 = -2;
        while (b <= TX_MAX_BYTES + 2) {
            var check: i32 = tx_submit_check(running, lane, b, content);
            var fits: bool = b <= TX_MAX_BYTES;
            if (tx_say_enabled(check) != (running and lane and content and fits)) { bad = bad + 1; }
            if (check < TX_SUBMIT_OK or check > TX_SUBMIT_TOO_LONG) { bad = bad + 1; }
            b = b + 1;
        }
        bits = bits + 1;
    }
    assert bad == 0;
    assert tx_say_enabled(TX_SUBMIT_NOT_RUNNING) == false;
    assert tx_say_enabled(TX_SUBMIT_NO_LANE) == false;
    assert tx_say_enabled(TX_SUBMIT_EMPTY) == false;
    assert tx_say_enabled(TX_SUBMIT_TOO_LONG) == false;
    // Notes.
    assert tx_field_note(TX_SUBMIT_TOO_LONG, 5000, true) == TX_NOTE_TOO_LONG;
    assert tx_field_note(TX_SUBMIT_NOT_RUNNING, 3, false) == TX_NOTE_NEEDS_START;
    assert tx_field_note(TX_SUBMIT_NOT_RUNNING, 0, true) == TX_NOTE_NONE;
    assert tx_field_note(TX_SUBMIT_NO_LANE, 0, true) == TX_NOTE_NO_LANE;
    assert tx_field_note(TX_SUBMIT_OK, 10, true) == TX_NOTE_PAUSED;
    assert tx_field_note(TX_SUBMIT_EMPTY, 0, true) == TX_NOTE_PAUSED;
    assert tx_field_note(TX_SUBMIT_OK, 10, false) == TX_NOTE_NONE;
    assert tx_field_note(TX_SUBMIT_EMPTY, 0, false) == TX_NOTE_NONE;
    // Command-Return, markers, pieces.
    assert tx_command_return(true, true) == TX_CMDRET_SAY;
    assert tx_command_return(true, false) == TX_CMDRET_RUN;
    assert tx_command_return(false, true) == TX_CMDRET_RUN;
    assert tx_command_return(false, false) == TX_CMDRET_RUN;
    assert tx_line_marker(true) == TX_MARK_KEYBOARD;
    assert tx_line_marker(false) == TX_MARK_NONE;
    assert tx_piece_said(true, 5) == true;
    assert tx_piece_said(false, 5) == false;
    assert tx_piece_said(true, 0) == false;
}

test tx_phrase_rules {
    var t: [8192]u8 = [0; 8192];
    // Three sentences, each long enough: three phrases, cut after each sentence end.
    var n: i64 = tx_fixture(TX_FX_THREE, t, 0);
    var e: i64 = tx_phrase_end(t, n, 0);
    assert e == tx_fixture_len(TX_FX_THREE_1);
    var s: i64 = tx_phrase_start(t, n, e);
    assert s == e + 1;
    e = tx_phrase_end(t, n, s);
    assert e - s == tx_fixture_len(TX_FX_THREE_2);
    s = tx_phrase_start(t, n, e);
    assert tx_phrase_end(t, n, s) == n;
    assert n - s == tx_fixture_len(TX_FX_THREE_3);
    // Short sentences and a short tail stay one phrase.
    n = tx_fixture(TX_FX_SHORT, t, 0);
    assert tx_phrase_end(t, n, 0) == n;
    n = tx_fixture(TX_FX_LATIN, t, 0);
    assert tx_phrase_end(t, n, 0) == n;
    // A dot after a one-letter word does not end a sentence.
    n = tx_fixture(TX_FX_ABBREV, t, 0);
    assert tx_phrase_end(t, n, 0) == n;
    n = tx_fixture(TX_FX_INITIAL, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_INITIAL_1);
    // Closing guillemet, "?!", the ellipsis, a decimal point.
    n = tx_fixture(TX_FX_QUOTE, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_QUOTE_1);
    n = tx_fixture(TX_FX_BANG, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_BANG_1);
    n = tx_fixture(TX_FX_ELLIPSIS, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_ELLIPSIS_1);
    n = tx_fixture(TX_FX_DECIMAL, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_DECIMAL_1);
    // An empty line ends a paragraph; a single line feed does not end a phrase that fits.
    n = tx_fixture(TX_FX_PARAGRAPH, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_PARAGRAPH_1);
    n = tx_fixture(TX_FX_LINES, t, 0);
    assert tx_phrase_end(t, n, 0) == n;
    // A tail long enough to be its own phrase is cut off, even without content.
    n = tx_fixture(TX_FX_SMILES, t, 0);
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_SMILES_1);
    // Longer than a phrase without a sentence end: the line feed, else the last clause end, else the last space,
    // else a character boundary.
    n = tx_fixture(TX_FX_LIST_LONG, t, 0);
    assert n > TX_PHRASE_MAX_BYTES;
    assert tx_phrase_end(t, n, 0) == tx_fixture_len(TX_FX_LIST_LONG_1);
    n = tx_fixture(TX_FX_COMMAS_LONG, t, 0);
    assert n > TX_PHRASE_MAX_BYTES;
    e = tx_phrase_end(t, n, 0);
    assert e <= TX_PHRASE_MAX_BYTES;
    assert e > TX_PHRASE_MAX_BYTES - 40;
    assert t[e - 1] == TX_COMMA;
    assert t[e] == TX_SPACE;
    s = tx_phrase_start(t, n, e);
    assert tx_phrase_end(t, n, s) == n;
    n = tx_fixture(TX_FX_WORDS_LONG, t, 0);
    e = tx_phrase_end(t, n, 0);
    assert e <= TX_PHRASE_MAX_BYTES;
    assert e > TX_PHRASE_MAX_BYTES - 12;
    assert t[e] == TX_SPACE;
    n = tx_fixture(TX_FX_ZHE_LONG, t, 0);
    assert tx_phrase_end(t, n, 0) == TX_PHRASE_MAX_BYTES;
    assert tx_phrase_end(t, n, 1) == TX_PHRASE_MAX_BYTES;
    assert tx_phrase_end(t, n, TX_PHRASE_MAX_BYTES) == n;
    // Whitespace only, empty text, starts out of range.
    n = tx_fixture(TX_FX_SPACES, t, 0);
    assert tx_phrase_start(t, n, 0) == n;
    assert tx_phrase_start(t, 0, 0) == 0;
    assert tx_phrase_end(t, 0, 0) == 0;
    n = tx_fixture(TX_FX_THREE, t, 0);
    assert tx_phrase_start(t, n, -5) == 0;
    assert tx_phrase_start(t, n, n + 5) == n;
    assert tx_phrase_end(t, n, n + 5) == n;
    assert tx_phrase_end(t, n, -5) == tx_fixture_len(TX_FX_THREE_1);
    // Every fixture from every start: the phrase moves forward, stays within TX_PHRASE_MAX_BYTES and the text,
    // and ends on a character boundary.
    var fx: i64 = 0;
    var bad: u32 = 0;
    while (fx < TX_FX_COUNT) {
        n = tx_fixture(fx, t, 0);
        var st: i64 = 0;
        while (st < n) {
            var en: i64 = tx_phrase_end(t, n, st);
            if (en <= st or en > n or en - st > TX_PHRASE_MAX_BYTES) { bad = bad + 1; }
            if (en < n and tx_is_continuation(t[en]) and tx_is_continuation(t[st]) == false) { bad = bad + 1; }
            st = st + 1;
        }
        fx = fx + 1;
    }
    assert bad == 0;
    // Lengths beyond the buffer read as TX_TEXT_MAX.
    assert tx_text_len(-1) == 0;
    assert tx_text_len(TX_TEXT_MAX + 1) == TX_TEXT_MAX;
}

test tx_boundary_rules {
    var t: [8192]u8 = [0; 8192];
    // "a. b": one letter before the dot; "ab. c": a sentence end; "15.4": no space after the dot.
    t[0] = 97;
    t[1] = TX_DOT;
    t[2] = TX_SPACE;
    t[3] = 98;
    assert tx_one_letter_before(t, 1) == true;
    assert tx_sentence_end_at(t, 4, 1) == -1;
    t[0] = 97;
    t[1] = 98;
    t[2] = TX_DOT;
    t[3] = TX_SPACE;
    assert tx_one_letter_before(t, 2) == false;
    assert tx_sentence_end_at(t, 4, 2) == 3;
    assert tx_sentence_end_at(t, 3, 2) == 3;
    t[0] = 49;
    t[1] = 53;
    t[2] = TX_DOT;
    t[3] = 52;
    assert tx_one_letter_before(t, 2) == false;
    assert tx_sentence_end_at(t, 4, 2) == -1;
    // "x! )" closes after the bracket only when it touches the mark: "x!) y" ends at 3.
    t[0] = 120;
    t[1] = TX_EXCLAMATION;
    t[2] = TX_PAREN_CLOSE;
    t[3] = TX_SPACE;
    assert tx_sentence_end_at(t, 4, 1) == 3;
    // A paragraph: LF, spaces and CR, LF. A single LF is not one.
    t[0] = TX_LF;
    t[1] = TX_SPACE;
    t[2] = TX_CR;
    t[3] = TX_LF;
    assert tx_paragraph_end_at(t, 4, 0) == 0;
    assert tx_paragraph_end_at(t, 3, 0) == -1;
    assert tx_paragraph_end_at(t, 4, 1) == -1;
    // Clause ends need whitespace after them and something after that.
    t[0] = 97;
    t[1] = TX_COMMA;
    t[2] = TX_SPACE;
    assert tx_clause_end_at(t, 3, 1) == 2;
    assert tx_clause_end_at(t, 2, 1) == -1;
    t[2] = 98;
    assert tx_clause_end_at(t, 3, 1) == -1;
    // Every byte as the only byte: whitespace is exactly space, tab, LF and CR; continuation bytes are 80..BF.
    var b: u32 = 0;
    var spaces: u32 = 0;
    var continuations: u32 = 0;
    while (b < 256) {
        if (tx_is_space(cast_u8(b))) { spaces = spaces + 1; }
        if (tx_is_continuation(cast_u8(b))) { continuations = continuations + 1; }
        b = b + 1;
    }
    assert spaces == 4;
    assert continuations == 64;
}
