// SPDX-License-Identifier: MIT
; Specs/audio_rules.t27 -- Ponte: the audio maths and the tap and microphone decisions
; Mirrors PonteAudio/AudioRules.swift one to one (audio math, rates and chunks, pacing, conversion path,
; the process-tap lifecycle and the microphone permission); its devices, app catalog and text helpers
; are in device_rules.t27. Each function names the Swift function it mirrors. The arithmetic follows
; the Swift exactly: sums of squares accumulate in double precision in index order, everything else is
; single precision, one operation at a time; min/max keep Swift's choice on ties and NaN
; (max(a, b) = b >= a ? b : a; min(a, b) = b < a ? b : a).
; Float buffers are passed in blocks: a mono block holds AU_BLOCK_FRAMES samples, an interleaved or
; planar block AU_BLOCK_SAMPLES; Swift copies longer buffers block by block (the *_continue functions
; carry a running sum or peak across blocks). Counts beyond a block are read as a full block.
; ASCII only. Generated C: Sources/PonteSpecs/audio_rules.h (Specs/generate.sh).

module PonteAudioRules;

; --- Constants (AudioRules) -----------------------------------------------------------------------------
; chunkSeconds: chunk length for file and test sources, and the probe meter window unit.
pub const AU_CHUNK_SECONDS : f64 = 0.1;
; fallbackSampleRate: used when a device or a file reports no sample rate.
pub const AU_FALLBACK_SAMPLE_RATE : f64 = 48000.0;
; dBFSFloor: the lowest dBFS value, also the value for a level of exactly 0 (Float).
pub const AU_DBFS_FLOOR : f32 = -120.0;
; quietThresholdDBFS: below this RMS level a signal counts as quiet (Float).
pub const AU_QUIET_THRESHOLD_DBFS : f32 = -60.0;
; conversionSlackFrames: extra frames allocated on top of the exact resampled length.
pub const AU_CONVERSION_SLACK_FRAMES : i64 = 1024;
; reconcileDebounceSeconds: delay before re-reading the HAL process list after a change notification.
pub const AU_RECONCILE_DEBOUNCE_SECONDS : f64 = 0.05;
; micTapBufferFrames: frames per AVAudioEngine input-tap callback requested by MicSource (a hint).
pub const AU_MIC_TAP_BUFFER_FRAMES : i64 = 2048;
; int16FullScale, int32FullScale: PCM full scale (Float).
pub const AU_INT16_FULL_SCALE : f32 = 32768.0;
pub const AU_INT32_FULL_SCALE : f32 = 2147483648.0;
; Nanoseconds in a second (pacing).
pub const AU_NANOS_PER_SECOND : f64 = 1000000000.0;
; A usable process-tap stream has 32-bit samples.
pub const AU_TAP_BITS_PER_CHANNEL : i64 = 32;

; --- Block sizes (C only: Swift passes buffers of exactly these sizes) ---------------------------------------
pub const AU_BLOCK_FRAMES : i64 = 4096;
pub const AU_BLOCK_SAMPLES : i64 = 8192;
; au_downmix_planar and au_planar_frames take at most this many channels.
pub const AU_PLANAR_MAX_CHANNELS : i64 = 64;

; --- Level codes (levelDigitalSilence, levelQuiet, levelSignal) -----------------------------------------------
pub const AU_LEVEL_DIGITAL_SILENCE : i64 = 0;
pub const AU_LEVEL_QUIET : i64 = 1;
pub const AU_LEVEL_SIGNAL : i64 = 2;

; --- Player conversion paths (convertNone, convertDownmix, convertResample) ------------------------------------
pub const AU_CONVERT_NONE : i64 = 0;
pub const AU_CONVERT_DOWNMIX : i64 = 1;
pub const AU_CONVERT_RESAMPLE : i64 = 2;

; --- Process tap actions (tapKeep, tapWait, tapUpdate, tapRebuild) -----------------------------------------------
pub const AU_TAP_KEEP : i64 = 0;
pub const AU_TAP_WAIT : i64 = 1;
pub const AU_TAP_UPDATE : i64 = 2;
pub const AU_TAP_REBUILD : i64 = 3;

; --- Microphone permission (micStart, micRequestFirst, micDenied) ------------------------------------------------
; AVAuthorizationStatus raw values: 0 notDetermined, 1 restricted, 2 denied, 3 authorized.
pub const AU_MIC_START : i64 = 0;
pub const AU_MIC_REQUEST_FIRST : i64 = 1;
pub const AU_MIC_DENIED : i64 = 2;
pub const AU_AV_NOT_DETERMINED : i64 = 0;
pub const AU_AV_AUTHORIZED : i64 = 3;

; --- Level meter (an extra rule; AudioRules.swift has no meter smoothing) -----------------------------------------
; A rising level moves the meter half-way at once; a falling one only a tenth of the way.
pub const AU_METER_ATTACK : f32 = 0.5;
pub const AU_METER_RELEASE : f32 = 0.1;

; --- Swift's min and max on Float -----------------------------------------------------------------------------------
pub fn au_max_f(a: f32, b: f32) -> f32 {
    if (b >= a) { return b; }
    return a;
}

pub fn au_min_f(a: f32, b: f32) -> f32 {
    if (b < a) { return b; }
    return a;
}

; The part of a count that fits a block of `block` items: below 0 reads as 0, above `block` as `block`.
pub fn au_fit(count: i64, block: i64) -> i64 {
    if (count < 0) { return 0; }
    if (count > block) { return block; }
    return count;
}

; --- Blocks -----------------------------------------------------------------------------------------------------------
; How many of `frames` frames of `channels` channels one block holds: at most AU_BLOCK_FRAMES frames and
; AU_BLOCK_SAMPLES samples; 0 when channels or frames is not positive (or one frame does not fit).
pub fn au_block_frames_for(channels: i64, frames: i64) -> i64 {
    if (channels > 0 and frames > 0) {
        var n: i64 = au_fit(frames, AU_BLOCK_FRAMES);
        var room: i64 = AU_BLOCK_SAMPLES / channels;
        if (n > room) { n = room; }
        return n;
    }
    return 0;
}

; Frames in sample_count interleaved samples of `channels` channels (a remainder ignored); 0 for no channels.
pub fn au_interleaved_frames(sample_count: i64, channels: i64) -> i64 {
    if (channels > 0) { return sample_count / channels; }
    return 0;
}

; Frames of planar channels: the shortest of channel_count lengths; 0 for no channels, more than
; AU_PLANAR_MAX_CHANNELS, or a shortest length that is not positive.
pub fn au_planar_frames(lengths: [64]i64, channel_count: i64) -> i64 {
    if (channel_count <= 0 or channel_count > AU_PLANAR_MAX_CHANNELS) { return 0; }
    var frames: i64 = lengths[0];
    var c: i64 = 1;
    while (c < channel_count) {
        if (lengths[c] < frames) { frames = lengths[c]; }
        c = c + 1;
    }
    if (frames <= 0) { return 0; }
    return frames;
}

; --- Sample conversion ----------------------------------------------------------------------------------------------
; int16ToFloat, int32ToFloat: Float(v) / full scale.
pub fn au_int16_to_float(v: i16) -> f32 {
    var f: f32 = v;
    return f / AU_INT16_FULL_SCALE;
}

pub fn au_int32_to_float(v: i32) -> f32 {
    var f: f32 = v;
    return f / AU_INT32_FULL_SCALE;
}

; framesInBuffer: byteSize / (bytesPerSample * channels); 0 when channels or bytesPerSample is not positive.
pub fn au_frames_in_buffer(byte_size: i64, channels: i64, bytes_per_sample: i64) -> i64 {
    if (channels > 0 and bytes_per_sample > 0) {
        return byte_size / (bytes_per_sample * channels);
    }
    return 0;
}

; --- Downmix ----------------------------------------------------------------------------------------------------------
; accumulateFrames: dst[i] += the sum of frame i's channels, for i < frames. One channel adds the sample
; itself; more channels first sum into a Float from 0 in channel order. Returns the frames processed:
; frames, but at most AU_BLOCK_FRAMES and at most AU_BLOCK_SAMPLES / channels (0 when nothing is done).
pub fn au_accumulate_frames(src: [8192]f32, channels: i64, frames: i64, dst: [4096]f32) -> i64 {
    var n: i64 = au_block_frames_for(channels, frames);
    if (n > 0) {
        var i: i64 = 0;
        if (channels == 1) {
            while (i < n) {
                dst[i] = dst[i] + src[i];
                i = i + 1;
            }
            return n;
        }
        while (i < n) {
            var s: f32 = 0.0;
            var base: i64 = i * channels;
            var c: i64 = 0;
            while (c < channels) {
                s = s + src[base + c];
                c = c + 1;
            }
            dst[i] = dst[i] + s;
            i = i + 1;
        }
        return n;
    }
    return 0;
}

; averageFactor: 1 / Float(totalChannels) when totalChannels > 1, else 1.
pub fn au_average_factor(total_channels: i64) -> f32 {
    if (total_channels > 1) {
        var one: f32 = 1.0;
        var n: f32 = total_channels;
        return one / n;
    }
    return 1.0;
}

; scale: dst[i] *= factor for i < frames; nothing when factor is 1. Returns the samples scaled.
pub fn au_scale(dst: [4096]f32, frames: i64, factor: f32) -> i64 {
    if (factor == 1.0) { return 0; }
    var n: i64 = au_fit(frames, AU_BLOCK_FRAMES);
    var i: i64 = 0;
    while (i < n) {
        dst[i] = dst[i] * factor;
        i = i + 1;
    }
    return n;
}

; downmixInterleaved: the mono average of sample_count interleaved samples (frames = sample_count /
; channels, a remainder ignored): out is zeroed, the frames accumulated, then scaled by averageFactor.
; Returns the frame count written to out (0 when channels is not positive).
pub fn au_downmix_interleaved(samples: [8192]f32, sample_count: i64, channels: i64, out: [4096]f32) -> i64 {
    if (channels > 0) {
        var frames: i64 = au_interleaved_frames(au_fit(sample_count, AU_BLOCK_SAMPLES), channels);
        frames = au_fit(frames, AU_BLOCK_FRAMES);
        var i: i64 = 0;
        while (i < frames) {
            out[i] = 0.0;
            i = i + 1;
        }
        var done: i64 = au_accumulate_frames(samples, channels, frames, out);
        var scaled: i64 = au_scale(out, done, au_average_factor(channels));
        if (scaled > done) { return scaled; }
        return done;
    }
    return 0;
}

; downmixPlanar: planar holds the channels one after another, channel c with lengths[c] samples.
; frames = the shortest channel; nothing for no channels or no frames. Each channel is added in order,
; then the sum is scaled by averageFactor(channel_count). Returns the frame count written to out.
pub fn au_downmix_planar(planar: [8192]f32, lengths: [64]i64, channel_count: i64, out: [4096]f32) -> i64 {
    var frames: i64 = au_fit(au_planar_frames(lengths, channel_count), AU_BLOCK_FRAMES);
    if (frames <= 0) { return 0; }
    var i: i64 = 0;
    while (i < frames) {
        out[i] = 0.0;
        i = i + 1;
    }
    var offset: i64 = 0;
    var c: i64 = 0;
    while (c < channel_count) {
        if (lengths[c] < 0 or offset + frames > AU_BLOCK_SAMPLES) { return 0; }
        var j: i64 = 0;
        while (j < frames) {
            out[j] = out[j] + planar[offset + j];
            j = j + 1;
        }
        offset = offset + lengths[c];
        c = c + 1;
    }
    au_scale(out, frames, au_average_factor(channel_count));
    return frames;
}

; --- Gain ------------------------------------------------------------------------------------------------------------
; clamp: min(hi, max(lo, x)).
pub fn au_clamp(x: f32, lo: f32, hi: f32) -> f32 {
    return au_min_f(hi, au_max_f(lo, x));
}

; clampUnit: a volume or gain setting clamped to 0...1.
pub fn au_clamp_unit(x: f32) -> f32 {
    return au_clamp(x, 0.0, 1.0);
}

; gainClip: one sample times the gain, hard-clipped to [-1, 1].
pub fn au_gain_clip(sample: f32, gain: f32) -> f32 {
    var v: f32 = sample * gain;
    return au_clamp(v, -1.0, 1.0);
}

; applyGain: gainClip on each of count samples, in place. Returns the samples processed.
pub fn au_apply_gain(samples: [4096]f32, count: i64, gain: f32) -> i64 {
    var n: i64 = au_fit(count, AU_BLOCK_FRAMES);
    var i: i64 = 0;
    while (i < n) {
        samples[i] = au_gain_clip(samples[i], gain);
        i = i + 1;
    }
    return n;
}

; --- Levels ----------------------------------------------------------------------------------------------------------
; rmsFromSum: Float(sqrt(sumSquares / Double(count))); 0 when count is not positive.
pub fn au_rms_from_sum(sum_squares: f64, count: i64) -> f32 {
    if (count > 0) {
        var n: f64 = count;
        return sqrt(sum_squares / n);
    }
    return 0.0;
}

; sum + Double(s) * Double(s) over count samples, in index order (rms accumulates this from 0).
pub fn au_sum_squares_continue(samples: [4096]f32, count: i64, sum: f64) -> f64 {
    var n: i64 = au_fit(count, AU_BLOCK_FRAMES);
    var total: f64 = sum;
    var i: i64 = 0;
    while (i < n) {
        var v: f64 = samples[i];
        total = total + v * v;
        i = i + 1;
    }
    return total;
}

; rms: the root mean square of one block.
pub fn au_rms(samples: [4096]f32, count: i64) -> f32 {
    var n: i64 = au_fit(count, AU_BLOCK_FRAMES);
    return au_rms_from_sum(au_sum_squares_continue(samples, n, 0.0), n);
}

; peak = max(peak, abs(s)) over count samples, starting from `peak` (peak starts from 0).
pub fn au_peak_continue(samples: [4096]f32, count: i64, peak: f32) -> f32 {
    var n: i64 = au_fit(count, AU_BLOCK_FRAMES);
    var p: f32 = peak;
    var i: i64 = 0;
    while (i < n) {
        p = au_max_f(p, abs(samples[i]));
        i = i + 1;
    }
    return p;
}

; peak: the largest absolute sample of one block; 0 for no samples.
pub fn au_peak(samples: [4096]f32, count: i64) -> f32 {
    return au_peak_continue(samples, count, 0.0);
}

; dBFS: max(dBFSFloor, 20 * log10(level)) in Float; dBFSFloor for level <= 0 (and NaN).
pub fn au_dbfs(level: f32) -> f32 {
    if (level > 0.0) {
        var l: f32 = log10f(level);
        var db: f32 = 20.0 * l;
        return au_max_f(AU_DBFS_FLOOR, db);
    }
    return AU_DBFS_FLOOR;
}

; levelCode: digital silence when the peak is exactly 0; quiet when the RMS is below the quiet threshold.
pub fn au_level_code(peak: f32, rms: f32) -> i64 {
    if (peak == 0.0) { return AU_LEVEL_DIGITAL_SILENCE; }
    if (au_dbfs(rms) < AU_QUIET_THRESHOLD_DBFS) { return AU_LEVEL_QUIET; }
    return AU_LEVEL_SIGNAL;
}

; tapSilenceSuspect: a tap that delivered frames of exact zeros (usually a missing permission).
pub fn au_tap_silence_suspect(total_frames: i64, peak: f32) -> bool {
    return total_frames > 0 and peak == 0.0;
}

; Extra: the next level-meter value from the previous one and the new level (dBFS or linear).
pub fn au_meter_smooth(previous: f32, level: f32) -> f32 {
    var k: f32 = AU_METER_RELEASE;
    if (level > previous) { k = AU_METER_ATTACK; }
    var diff: f32 = level - previous;
    var step: f32 = k * diff;
    return previous + step;
}

; --- Rates, chunks, pacing ---------------------------------------------------------------------------------------------
; rateOrDefault: the rate if positive, else fallbackSampleRate.
pub fn au_rate_or_default(rate: f64) -> f64 {
    if (rate > 0.0) { return rate; }
    return AU_FALLBACK_SAMPLE_RATE;
}

; framesPerChunk: max(1, round(sampleRate * seconds)), halves rounded away from zero.
pub fn au_frames_per_chunk(sample_rate: f64, seconds: f64) -> i64 {
    var exact: f64 = sample_rate * seconds;
    var rounded: f64 = round(exact);
    var frames: f64 = 1.0;
    if (rounded >= 1.0) { frames = rounded; }
    return cast_i64(frames);
}

; chunkLengths: the chunks covering total frames, each `chunk` long but the last; none when total or
; chunk is not positive. au_chunk_count gives their number, au_chunk_length the length of one.
pub fn au_chunk_count(total: i64, chunk: i64) -> i64 {
    if (total > 0 and chunk > 0) {
        return (total - 1) / chunk + 1;
    }
    return 0;
}

pub fn au_chunk_length(total: i64, chunk: i64, index: i64) -> i64 {
    if (index < 0 or index >= au_chunk_count(total, chunk)) { return 0; }
    var rest: i64 = total - index * chunk;
    if (rest < chunk) { return rest; }
    return chunk;
}

; conversionCapacity: ceil(Double(frames) * toRate / fromRate) + slack; frames + slack when a rate is not positive.
pub fn au_conversion_capacity(frames: i64, from_rate: f64, to_rate: f64) -> i64 {
    if (from_rate > 0.0 and to_rate > 0.0) {
        var f: f64 = frames;
        var scaled: f64 = f * to_rate / from_rate;
        var up: f64 = ceil(scaled);
        return cast_i64(up) + AU_CONVERSION_SLACK_FRAMES;
    }
    return frames + AU_CONVERSION_SLACK_FRAMES;
}

; needsResample: the rates differ.
pub fn au_needs_resample(from_rate: f64, to_rate: f64) -> bool {
    return from_rate != to_rate;
}

; converterShouldDownmix: the resampler averages channels when it reduces their count.
pub fn au_converter_should_downmix(input_channels: i64, output_channels: i64) -> bool {
    return input_channels > output_channels;
}

; sessionRate: fixed at the first attach (fixedRate > 0) and kept afterwards.
pub fn au_session_rate(fixed_rate: f64, tap_rate: f64) -> f64 {
    if (fixed_rate > 0.0) { return fixed_rate; }
    return tap_rate;
}

; pacingSleepNanos: deadline = start + UInt64(Double(endFrame) / sampleRate * 1e9); the time left to it,
; 0 when it has passed or when the rate or the end frame is not positive.
pub fn au_pacing_sleep_nanos(start_nanos: u64, now_nanos: u64, end_frame: i64, sample_rate: f64) -> u64 {
    if (sample_rate > 0.0 and end_frame > 0) {
        var frames: f64 = end_frame;
        var seconds: f64 = frames / sample_rate;
        var delay: u64 = cast_u64(seconds * AU_NANOS_PER_SECOND);
        var deadline: u64 = start_nanos + delay;
        if (deadline > now_nanos) { return deadline - now_nanos; }
        return 0;
    }
    return 0;
}

; conversionPath: none for the identical format, downmix at the same rate, resample otherwise.
pub fn au_conversion_path(same_format: bool, same_rate: bool) -> i64 {
    if (same_format) { return AU_CONVERT_NONE; }
    if (same_rate) { return AU_CONVERT_DOWNMIX; }
    return AU_CONVERT_RESAMPLE;
}

; isUsableTapFormat: linear PCM, float, 32-bit, positive rate.
pub fn au_is_usable_tap_format(is_linear_pcm: bool, is_float: bool, bits_per_channel: i64, sample_rate: f64) -> bool {
    return is_linear_pcm and is_float and bits_per_channel == AU_TAP_BITS_PER_CHANNEL and sample_rate > 0.0;
}

; --- Process tap lifecycle --------------------------------------------------------------------------------------------
; tapAction, first matching row wins:
;   not forced, attached, same process set           -> keep
;   not forced, not attached, nothing to tap          -> keep (still waiting for the app)
;   nothing to tap (no processes and not global)      -> wait (destroy the tap, if any)
;   not forced, attached                              -> update the live tap
;   otherwise                                         -> rebuild
pub fn au_tap_action(attached: bool, desired_count: i64, same_set: bool, is_global: bool, force: bool) -> i64 {
    if (force == false and attached and same_set) { return AU_TAP_KEEP; }
    var nothing_to_tap: bool = desired_count == 0 and is_global == false;
    if (force == false and attached == false and nothing_to_tap) { return AU_TAP_KEEP; }
    if (nothing_to_tap) { return AU_TAP_WAIT; }
    if (force == false and attached) { return AU_TAP_UPDATE; }
    return AU_TAP_REBUILD;
}

; --- Microphone permission -----------------------------------------------------------------------------------------------
; micStartDecision: authorized starts, not determined asks first, anything else is denied.
pub fn au_mic_start_decision(authorization_status: i64) -> i64 {
    if (authorization_status == AU_AV_AUTHORIZED) { return AU_MIC_START; }
    if (authorization_status == AU_AV_NOT_DETERMINED) { return AU_MIC_REQUEST_FIRST; }
    return AU_MIC_DENIED;
}

; --- Rebuilding a capture after a device change (MicSource, AppAudioTapSource) ----------------------------------------
; Live crash 2026-10-13: MicSource rebuilt its engine inside the configuration-change notification and
; installed a tap with a stale format; AVAudioEngine raised an Objective-C exception and the app aborted.
; A capture is now rebuilt later, off that thread, after RESTART_DELAY_MS, doubling the wait after each
; failed rebuild up to RESTART_MAX_DELAY_MS, and it keeps trying at that pace while the source runs.
pub const AU_RESTART_DELAY_MS : i64 = 300;
pub const AU_RESTART_MAX_DELAY_MS : i64 = 5000;
; After this many failed rebuilds in a row the source reports itself failed (it still retries).
pub const AU_RESTART_ATTEMPTS : i64 = 6;

; restartDelayMs: the wait before rebuild number `attempt` (0 = the first after the change; a negative
; attempt counts as 0): RESTART_DELAY_MS, doubled per failed attempt, at most RESTART_MAX_DELAY_MS.
pub fn au_restart_delay_ms(attempt: i64) -> i64 {
    var delay: i64 = AU_RESTART_DELAY_MS;
    var n: i64 = 0;
    while (n < attempt and delay < AU_RESTART_MAX_DELAY_MS) {
        delay = delay * 2;
        n = n + 1;
    }
    if (delay > AU_RESTART_MAX_DELAY_MS) { return AU_RESTART_MAX_DELAY_MS; }
    return delay;
}

; restartFailed: after `failures` failed rebuilds in a row the source reports failed.
pub fn au_restart_failed(failures: i64) -> bool {
    return failures >= AU_RESTART_ATTEMPTS;
}

; micTapReady: a microphone tap goes in only when both sides of the input node have a format: the device
; side (input format) and the tap's bus (output format) need a positive rate and at least one channel.
; The tap takes the bus's own format; AVAudioEngine raises on a tap without one.
pub fn au_mic_tap_ready(input_rate: f64, input_channels: i64, bus_rate: f64, bus_channels: i64) -> bool {
    return input_rate > 0.0 and input_channels > 0 and bus_rate > 0.0 and bus_channels > 0;
}

; --- The call output heals itself (DeviceAudioPlayer) ------------------------------------------------------------
; Seen live 2026-10-13: Ponte runs several AVAudioEngines (the microphone, the BlackHole player, the headphones
; player). Whenever any audio device reconfigures (Meet opening BlackHole as its input, another engine starting,
; an iPhone Continuity microphone appearing, headphones connecting) the engines are stopped, in bursts of 2-4
; within 2 s. The player rebuilt its engine only on the next phrase, and a phrase that was playing during the
; stop was reported as played: it was cut, and a replay right after a burst reached nothing in Meet.
; Now the player keeps its engine running between phrases (silence), rebuilds it after a real stop with the
; capture backoff above (never inside the notification), and plays a cut phrase again from its start.

; Player states (PL_*): no engine yet; running; stopped with a rebuild scheduled (phrases wait for it);
; RESTART_ATTEMPTS rebuilds in a row failed (it still retries, but phrases are refused at once, so a lane
; never waits for a device that is gone).
pub const AU_PL_IDLE : i64 = 0;
pub const AU_PL_RUNNING : i64 = 1;
pub const AU_PL_REBUILDING : i64 = 2;
pub const AU_PL_FAILED : i64 = 3;
; Player events (PLE_*): the engine started (a first start or a rebuild); a start or a rebuild failed;
; AVAudioEngineConfigurationChange arrived (with the engine's isRunning at that moment).
pub const AU_PLE_STARTED : i64 = 0;
pub const AU_PLE_START_FAILED : i64 = 1;
pub const AU_PLE_CHANGE : i64 = 2;
; Player actions (PLA_*): nothing; schedule the phrases that wait (the engine runs again); schedule a rebuild
; after restartDelayMs(failures); the same and complete the waiting phrases unplayed (failed); the engine
; stopped under the phrases: everything scheduled is cut (it waits for the rebuild), then schedule a rebuild.
pub const AU_PLA_NONE : i64 = 0;
pub const AU_PLA_SCHEDULE_WAITING : i64 = 1;
pub const AU_PLA_RETRY : i64 = 2;
pub const AU_PLA_RETRY_RELEASE : i64 = 3;
pub const AU_PLA_CUT_RETRY : i64 = 4;
; What a new phrase does (PLQ_*): start the engine first (no engine yet), go to the player node now, wait for
; the rebuild, or complete at once unplayed.
pub const AU_PLQ_START : i64 = 0;
pub const AU_PLQ_SCHEDULE : i64 = 1;
pub const AU_PLQ_WAIT : i64 = 2;
pub const AU_PLQ_REFUSE : i64 = 3;
; What the completion of a phrase's last buffer means (PLC_*): the phrase was heard; it comes from an engine
; instance that is gone or stopped (the cut and the rebuild take care of the phrase); it comes from the
; phrase's own running engine, but the player has not rendered up to the phrase's end, so a stop flushed it
; (play it again now).
pub const AU_PLC_DONE : i64 = 0;
pub const AU_PLC_IGNORE : i64 = 1;
pub const AU_PLC_REPLAY : i64 = 2;
; A phrase cut by a stop is played again from its start at most this many times, then dropped.
pub const AU_PLAYER_MAX_REPLAYS : i64 = 3;
; A completion counts as heard when the player has rendered up to the phrase's end less this many frames
; (render cycles; the end is a lower bound taken when the phrase was scheduled). At most this much of a
; phrase's tail (85 ms at 48 kHz, usually its trailing silence) can be cut unnoticed.
pub const AU_PLAYER_END_TOLERANCE_FRAMES : i64 = 4096;
; A step packs the state and the action: state * STEP_BASE + action.
pub const AU_PL_STEP_BASE : i64 = 256;

; playerStep: the state and the action after an event. `failures` is the number of failed starts in a row
; including this one (START_FAILED only); `engine_running` is the engine's isRunning (CHANGE only).
;   STARTED                        -> running, schedule the waiting phrases
;   START_FAILED, restartFailed    -> failed, retry and complete the waiting phrases
;   START_FAILED                   -> rebuilding, retry
;   CHANGE, engine still running   -> no change (AVAudioEngine also posts it after its own start)
;   CHANGE, stopped, was running   -> rebuilding, cut and retry
;   CHANGE, stopped, otherwise     -> no change (a rebuild is already scheduled, or there is no engine yet)
pub fn au_player_step(state: i64, event: i64, engine_running: bool, failures: i64) -> i64 {
    if (event == AU_PLE_STARTED) { return AU_PL_RUNNING * AU_PL_STEP_BASE + AU_PLA_SCHEDULE_WAITING; }
    if (event == AU_PLE_START_FAILED) {
        if (au_restart_failed(failures)) { return AU_PL_FAILED * AU_PL_STEP_BASE + AU_PLA_RETRY_RELEASE; }
        return AU_PL_REBUILDING * AU_PL_STEP_BASE + AU_PLA_RETRY;
    }
    if (event == AU_PLE_CHANGE and engine_running == false and state == AU_PL_RUNNING) {
        return AU_PL_REBUILDING * AU_PL_STEP_BASE + AU_PLA_CUT_RETRY;
    }
    return au_player_keep(state);
}

; The same state with no action.
pub fn au_player_keep(state: i64) -> i64 {
    return state * AU_PL_STEP_BASE + AU_PLA_NONE;
}

pub fn au_player_step_state(step: i64) -> i64 {
    return step / AU_PL_STEP_BASE;
}

pub fn au_player_step_action(step: i64) -> i64 {
    return step % AU_PL_STEP_BASE;
}

; playerEnqueue: what a new phrase does in each state.
pub fn au_player_enqueue(state: i64) -> i64 {
    if (state == AU_PL_RUNNING) { return AU_PLQ_SCHEDULE; }
    if (state == AU_PL_REBUILDING) { return AU_PLQ_WAIT; }
    if (state == AU_PL_FAILED) { return AU_PLQ_REFUSE; }
    return AU_PLQ_START;
}

; playerCompletion: AVAudioPlayerNode also calls the completions of its buffers when it is stopped, so a
; completion means the phrase was heard only when it comes from the engine instance the phrase is scheduled
; on (`same_generation`: the player bumps its generation before every stop of its own), that engine still
; runs (a stop by the system flushes too), and the player has rendered up to the phrase's end (`position`,
; when the node reports one). From the phrase's own running engine short of its end it was flushed: replay.
pub fn au_player_completion(same_generation: bool, engine_running: bool, has_position: bool, position: i64, end_frame: i64) -> i64 {
    if (same_generation == false or engine_running == false) { return AU_PLC_IGNORE; }
    if (has_position == false) { return AU_PLC_DONE; }
    if (position >= end_frame - AU_PLAYER_END_TOLERANCE_FRAMES) { return AU_PLC_DONE; }
    return AU_PLC_REPLAY;
}

; playerReplays: a phrase cut `cuts` times (this one included) is played again from its start.
pub fn au_player_replays(cuts: i64) -> bool {
    return cuts <= AU_PLAYER_MAX_REPLAYS;
}

; --- Rules moved here from the rest of PonteAudio and the app (2026-10-11) ------------------------------------

; AVAudioCommonFormat raw values (PCM.mono, PCM.samples).
pub const AU_FORMAT_OTHER : i64 = 0;
pub const AU_FORMAT_FLOAT32 : i64 = 1;
pub const AU_FORMAT_FLOAT64 : i64 = 2;
pub const AU_FORMAT_INT16 : i64 = 3;
pub const AU_FORMAT_INT32 : i64 = 4;
; AVAudioConverterInputStatus raw values (PCM.Converter).
pub const AU_INPUT_HAVE_DATA : i64 = 0;
pub const AU_INPUT_NO_DATA_NOW : i64 = 1;
pub const AU_INPUT_END_OF_STREAM : i64 = 2;
; Bytes of one Float32 sample; "no frames yet" while combining buffers (Int.max).
pub const AU_FLOAT_BYTES : i64 = 4;
pub const AU_NO_FRAMES : i64 = 9223372036854775807;
; au_buffer_list_* take at most this many buffers of an AudioBufferList.
pub const AU_BUFFER_LIST_MAX : i64 = 64;
; The level meter (Components.LevelMeter) shows -60...0 dBFS; levels below 1e-5 read as 1e-5.
pub const AU_METER_LEVEL_FLOOR : f32 = 0.00001;
pub const AU_METER_RANGE_DB : f32 = 60.0;
; FourCC bytes shown as text: printable ASCII 32...126.
pub const AU_PRINTABLE_FIRST : u32 = 32;
pub const AU_PRINTABLE_END : u32 = 127;

; A buffer with any non-zero sample: its level code is not digital silence (lanes, the wizard meter).
pub fn au_has_signal(peak: f32, rms: f32) -> bool {
    return au_level_code(peak, rms) != AU_LEVEL_DIGITAL_SILENCE;
}

; A tap of one app lists its processes (mixdown of them); the global tap lists the processes it excludes,
; and reports no captured PIDs.
pub fn au_tap_lists_processes(is_global: bool) -> bool {
    return is_global == false;
}

; The resampler flushes at the last buffer of a play call, or before a buffer of another format.
pub fn au_flushes_converter(index: i64, count: i64, next_format_differs: bool) -> bool {
    return index == count - 1 or next_format_differs;
}

; A buffer of an AudioBufferList takes part in the downmix: it has data and channels.
pub fn au_uses_buffer(has_data: bool, channels: i64) -> bool {
    return has_data and channels > 0;
}

; Frames of the downmix of the buffers that take part: the shortest buffer, at most max_frames; 0 when
; there are no channels.
pub fn au_buffer_list_frames(byte_sizes: [64]i64, channels: [64]i64, count: i64, max_frames: i64) -> i64 {
    var n: i64 = au_fit(count, AU_BUFFER_LIST_MAX);
    var frames: i64 = AU_NO_FRAMES;
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        var f: i64 = au_frames_in_buffer(byte_sizes[i], channels[i], AU_FLOAT_BYTES);
        if (f < frames) { frames = f; }
        total = total + channels[i];
        i = i + 1;
    }
    if (total > 0 and frames != AU_NO_FRAMES) {
        if (max_frames < frames) { return max_frames; }
        return frames;
    }
    return 0;
}

; All channels of the buffers that take part (the downmix averages over them).
pub fn au_buffer_list_channels(channels: [64]i64, count: i64) -> i64 {
    var n: i64 = au_fit(count, AU_BUFFER_LIST_MAX);
    var total: i64 = 0;
    var i: i64 = 0;
    while (i < n) {
        total = total + channels[i];
        i = i + 1;
    }
    return total;
}

; PCM.mono: interleaved data is one block of all channels; planar data is one block per channel.
pub fn au_mono_blocks(interleaved: bool, channels: i64) -> i64 {
    if (interleaved) { return 1; }
    return channels;
}

pub fn au_mono_per_block(interleaved: bool, channels: i64) -> i64 {
    if (interleaved) { return channels; }
    return 1;
}

; PCM.mono reads Float32, Int16 and Int32 samples.
pub fn au_mono_supported(format: i64) -> bool {
    return format == AU_FORMAT_FLOAT32 or format == AU_FORMAT_INT16 or format == AU_FORMAT_INT32;
}

; PCM.isMonoFloat32: Float32 with one channel.
pub fn au_is_mono_float32(format: i64, channels: i64) -> bool {
    return format == AU_FORMAT_FLOAT32 and channels == 1;
}

; PCM.samples reads a deinterleaved mono Float32 buffer as it is, anything else through the downmix.
pub fn au_is_plain_mono(format: i64, channels: i64, interleaved: bool) -> bool {
    return au_is_mono_float32(format, channels) and interleaved == false;
}

; PCM.Converter input: the buffer once, then "no data now", or "end of stream" when flushing.
pub fn au_converter_input(supplied: bool, final: bool) -> i64 {
    if (supplied) {
        if (final) { return AU_INPUT_END_OF_STREAM; }
        return AU_INPUT_NO_DATA_NOW;
    }
    return AU_INPUT_HAVE_DATA;
}

; HAL.fourCC: a code is shown as four characters when every byte is printable ASCII.
pub fn au_fourcc_printable(code: u32) -> bool {
    var shift: u32 = 0;
    while (shift < 32) {
        var b: u32 = (code >> shift) & 255;
        if (b < AU_PRINTABLE_FIRST or b >= AU_PRINTABLE_END) { return false; }
        shift = shift + 8;
    }
    return true;
}

; Components.LevelMeter: the bar's fill, min(1, max(0, (20 * log10(max(level, 1e-5)) + 60) / 60)), in Float.
pub fn au_meter_fraction(level: f32) -> f32 {
    var floor_level: f32 = AU_METER_LEVEL_FLOOR;
    var range: f32 = AU_METER_RANGE_DB;
    var l: f32 = au_max_f(level, floor_level);
    var lg: f32 = log10f(l);
    var db: f32 = 20.0 * lg;
    var shifted: f32 = db + range;
    var fraction: f32 = shifted / range;
    var zero: f32 = 0.0;
    var one: f32 = 1.0;
    return au_min_f(one, au_max_f(zero, fraction));
}

test au_conversion_and_downmix {
    // sampleConversion
    assert au_int16_to_float(16384) == 0.5;
    assert au_int16_to_float(-32768) == -1.0;
    assert au_int32_to_float(-2147483648) == -1.0;
    assert au_int32_to_float(1073741824) == 0.5;
    var top: f32 = 32767.0;
    var scale16: f32 = 32768.0;
    assert au_int16_to_float(32767) == top / scale16;
    // framesInBuffer
    assert au_frames_in_buffer(4096, 2, 4) == 512;
    assert au_frames_in_buffer(4095, 2, 4) == 511;
    assert au_frames_in_buffer(4096, 0, 4) == 0;
    assert au_frames_in_buffer(4096, 1, 0) == 0;
    // downmixInterleaved [1, 0, 0.5, 0.5, -1, 1] / 2 = [0.5, 0.5, 0]
    var inb: [8192]f32 = [0.0; 8192];
    var outb: [4096]f32 = [0.0; 4096];
    inb[0] = 1.0;
    inb[1] = 0.0;
    inb[2] = 0.5;
    inb[3] = 0.5;
    inb[4] = -1.0;
    inb[5] = 1.0;
    assert au_downmix_interleaved(inb, 6, 2, outb) == 3;
    assert outb[0] == 0.5;
    assert outb[1] == 0.5;
    assert outb[2] == 0.0;
    // [1, 2, 3, 4, 5] / 2 = [1.5, 3.5]: the remainder is ignored.
    inb[0] = 1.0;
    inb[1] = 2.0;
    inb[2] = 3.0;
    inb[3] = 4.0;
    inb[4] = 5.0;
    assert au_downmix_interleaved(inb, 5, 2, outb) == 2;
    assert outb[0] == 1.5;
    assert outb[1] == 3.5;
    // Mono passes through; no channels gives nothing.
    inb[0] = 0.25;
    inb[1] = -0.5;
    assert au_downmix_interleaved(inb, 2, 1, outb) == 2;
    assert outb[0] == 0.25;
    assert outb[1] == -0.5;
    assert au_downmix_interleaved(inb, 2, 0, outb) == 0;
    // [4, 0, 0, 0, 1, 1, 1, 1] / 4 = [1, 1]
    inb[0] = 4.0;
    inb[1] = 0.0;
    inb[2] = 0.0;
    inb[3] = 0.0;
    inb[4] = 1.0;
    inb[5] = 1.0;
    inb[6] = 1.0;
    inb[7] = 1.0;
    assert au_downmix_interleaved(inb, 8, 4, outb) == 2;
    assert outb[0] == 1.0;
    assert outb[1] == 1.0;
    // The Float sum times the Float reciprocal 1/3, not a division by 3.
    inb[0] = 3.0;
    inb[1] = 3.0;
    inb[2] = 3.0;
    assert au_downmix_interleaved(inb, 3, 3, outb) == 1;
    var nine: f32 = 9.0;
    assert outb[0] == nine * au_average_factor(3);
    // averageFactor
    assert au_average_factor(0) == 1.0;
    assert au_average_factor(1) == 1.0;
    assert au_average_factor(2) == 0.5;
    assert au_average_factor(4) == 0.25;
    // downmixPlanar [[1, 1, 1], [0, -1, 1]] = [0.5, 0, 1]; the shortest channel wins.
    var planar: [8192]f32 = [0.0; 8192];
    var lengths: [64]i64 = [0; 64];
    planar[0] = 1.0;
    planar[1] = 1.0;
    planar[2] = 1.0;
    planar[3] = 0.0;
    planar[4] = -1.0;
    planar[5] = 1.0;
    lengths[0] = 3;
    lengths[1] = 3;
    assert au_downmix_planar(planar, lengths, 2, outb) == 3;
    assert outb[0] == 0.5;
    assert outb[1] == 0.0;
    assert outb[2] == 1.0;
    planar[3] = 1.0;
    lengths[1] = 1;
    assert au_downmix_planar(planar, lengths, 2, outb) == 1;
    assert outb[0] == 1.0;
    assert au_downmix_planar(planar, lengths, 0, outb) == 0;
    lengths[0] = 0;
    assert au_downmix_planar(planar, lengths, 2, outb) == 0;
    // accumulateFrames then scale, in place: (1 + 1+2)/2, (1 + 3+4)/2, (1 + 5+6)/2
    var src: [8192]f32 = [0.0; 8192];
    var dst: [4096]f32 = [0.0; 4096];
    var k: i64 = 0;
    while (k < 6) {
        var v: f32 = k + 1;
        src[k] = v;
        k = k + 1;
    }
    dst[0] = 1.0;
    dst[1] = 1.0;
    dst[2] = 1.0;
    assert au_accumulate_frames(src, 2, 3, dst) == 3;
    assert au_scale(dst, 3, 0.5) == 3;
    assert dst[0] == 2.0;
    assert dst[1] == 4.0;
    assert dst[2] == 6.0;
    assert au_scale(dst, 3, 1.0) == 0;
    assert au_accumulate_frames(src, 0, 3, dst) == 0;
    assert au_accumulate_frames(src, 2, 0, dst) == 0;
    // Block limits: 4096 frames, and 8192 samples over all channels.
    assert au_accumulate_frames(src, 1, 9000, dst) == 4096;
    assert au_accumulate_frames(src, 4, 4096, dst) == 2048;
    assert au_downmix_interleaved(src, 9000, 1, dst) == 4096;
    // Block sizes, interleaved and planar frame counts.
    assert au_block_frames_for(2, 10000) == 4096;
    assert au_block_frames_for(3, 10000) == 2730;
    assert au_block_frames_for(16, 100) == 100;
    assert au_block_frames_for(9000, 5) == 0;
    assert au_block_frames_for(0, 5) == 0;
    assert au_block_frames_for(2, 0) == 0;
    assert au_interleaved_frames(7, 2) == 3;
    assert au_interleaved_frames(7, 0) == 0;
    var lens: [64]i64 = [0; 64];
    lens[0] = 5;
    lens[1] = 3;
    lens[2] = 9;
    assert au_planar_frames(lens, 3) == 3;
    assert au_planar_frames(lens, 0) == 0;
    assert au_planar_frames(lens, 65) == 0;
    lens[1] = 0;
    assert au_planar_frames(lens, 3) == 0;
}

test au_gain_and_levels {
    // gainAndClip
    assert au_clamp(2.0, -1.0, 1.0) == 1.0;
    assert au_clamp(-2.0, -1.0, 1.0) == -1.0;
    var third: f32 = 0.3;
    assert au_clamp(third, -1.0, 1.0) == third;
    assert au_clamp_unit(-0.5) == 0.0;
    assert au_clamp_unit(1.5) == 1.0;
    var seven: f32 = 0.7;
    assert au_clamp_unit(seven) == seven;
    var p4: f32 = 0.4;
    var p8: f32 = 0.8;
    assert au_gain_clip(p4, 2.0) == p8;
    assert au_gain_clip(p8, 2.0) == 1.0;
    assert au_gain_clip(0.0 - p8, 2.0) == -1.0;
    var block: [4096]f32 = [0.0; 4096];
    var p1: f32 = 0.1;
    var p6: f32 = 0.6;
    var p2: f32 = 0.2;
    block[0] = p1;
    block[1] = 0.0 - p6;
    block[2] = p6;
    assert au_apply_gain(block, 3, 2.0) == 3;
    assert block[0] == p2;
    assert block[1] == -1.0;
    assert block[2] == 1.0;
    // levels
    assert au_rms_from_sum(4.0, 4) == 1.0;
    assert au_rms_from_sum(1.0, 0) == 0.0;
    block[0] = 3.0;
    block[1] = -4.0;
    block[2] = 0.0;
    block[3] = 0.0;
    assert au_rms(block, 4) == 2.5;
    assert au_rms(block, 0) == 0.0;
    block[0] = p1;
    block[1] = 0.0 - seven;
    block[2] = 0.3;
    assert au_peak(block, 3) == seven;
    assert au_peak(block, 0) == 0.0;
    assert au_peak_continue(block, 1, 0.5) == 0.5;
    assert au_sum_squares_continue(block, 0, 2.5) == 2.5;
    assert au_dbfs(1.0) == 0.0;
    assert au_dbfs(0.1) > -20.0001;
    assert au_dbfs(0.1) < -19.9999;
    assert au_dbfs(0.0) == -120.0;
    assert au_dbfs(-1.0) == -120.0;
    assert au_dbfs(0.000000001) == -120.0;
    // levelCodes
    assert au_level_code(0.0, 0.0) == AU_LEVEL_DIGITAL_SILENCE;
    assert au_level_code(0.0005, 0.0005) == AU_LEVEL_QUIET;
    assert au_level_code(0.002, 0.001) == AU_LEVEL_SIGNAL;
    assert au_level_code(0.5, 0.2) == AU_LEVEL_SIGNAL;
    assert au_tap_silence_suspect(1000, 0.0) == true;
    assert au_tap_silence_suspect(0, 0.0) == false;
    assert au_tap_silence_suspect(1000, 0.01) == false;
    // the extra meter
    assert au_meter_smooth(0.0, 1.0) == 0.5;
    assert au_meter_smooth(-60.0, -20.0) == -40.0;
    assert au_meter_smooth(-30.0, -30.0) == -30.0;
    // dBFS never falls below the floor and never decreases over a sweep of eight decades.
    var level: f32 = 0.00000001;
    var previous: f32 = -120.0;
    var bad: u32 = 0;
    var steps: u32 = 0;
    while (level < 2.0) {
        var db: f32 = au_dbfs(level);
        if (db < previous or db < -120.0) { bad = bad + 1; }
        previous = db;
        var grow: f32 = 1.01;
        level = level * grow;
        steps = steps + 1;
    }
    assert bad == 0;
    assert steps > 1800;
}

test au_rates_chunks_pacing {
    // ratesAndChunks
    assert au_rate_or_default(44100.0) == 44100.0;
    assert au_rate_or_default(0.0) == 48000.0;
    assert au_rate_or_default(-1.0) == 48000.0;
    assert au_frames_per_chunk(48000.0, AU_CHUNK_SECONDS) == 4800;
    assert au_frames_per_chunk(22050.0, AU_CHUNK_SECONDS) == 2205;
    assert au_frames_per_chunk(11025.0, AU_CHUNK_SECONDS) == 1103;
    assert au_frames_per_chunk(16000.0, 0.02) == 320;
    assert au_frames_per_chunk(0.0, AU_CHUNK_SECONDS) == 1;
    assert au_chunk_count(10, 4) == 3;
    assert au_chunk_length(10, 4, 0) == 4;
    assert au_chunk_length(10, 4, 1) == 4;
    assert au_chunk_length(10, 4, 2) == 2;
    assert au_chunk_length(10, 4, 3) == 0;
    assert au_chunk_count(8, 4) == 2;
    assert au_chunk_length(8, 4, 1) == 4;
    assert au_chunk_count(0, 4) == 0;
    assert au_chunk_count(3, 0) == 0;
    assert au_chunk_length(3, 0, 0) == 0;
    assert au_conversion_capacity(22050, 22050.0, 48000.0) == 48000 + 1024;
    assert au_conversion_capacity(1, 44100.0, 48000.0) == 2 + 1024;
    assert au_conversion_capacity(10, 0.0, 48000.0) == 10 + 1024;
    assert au_needs_resample(48000.0, 44100.0) == true;
    assert au_needs_resample(48000.0, 48000.0) == false;
    assert au_converter_should_downmix(2, 1) == true;
    assert au_converter_should_downmix(1, 2) == false;
    assert au_session_rate(0.0, 44100.0) == 44100.0;
    assert au_session_rate(48000.0, 44100.0) == 48000.0;
    // Every chunk split covers the total exactly once.
    var total: i64 = 0;
    var bad: u32 = 0;
    while (total < 50) {
        var chunk: i64 = 1;
        while (chunk < 12) {
            var sum: i64 = 0;
            var idx: i64 = 0;
            while (idx < au_chunk_count(total, chunk)) {
                var len: i64 = au_chunk_length(total, chunk, idx);
                if (len <= 0 or len > chunk) { bad = bad + 1; }
                sum = sum + len;
                idx = idx + 1;
            }
            if (sum != total) { bad = bad + 1; }
            chunk = chunk + 1;
        }
        total = total + 1;
    }
    assert bad == 0;
    // pacing
    assert au_pacing_sleep_nanos(1000, 1000, 4800, 48000.0) == 100000000;
    assert au_pacing_sleep_nanos(0, 40000000, 4800, 48000.0) == 60000000;
    assert au_pacing_sleep_nanos(0, 200000000, 4800, 48000.0) == 0;
    assert au_pacing_sleep_nanos(0, 0, 4800, 0.0) == 0;
    assert au_pacing_sleep_nanos(0, 0, 0, 48000.0) == 0;
    // conversionPathAndTapFormat
    assert au_conversion_path(true, true) == AU_CONVERT_NONE;
    assert au_conversion_path(false, true) == AU_CONVERT_DOWNMIX;
    assert au_conversion_path(false, false) == AU_CONVERT_RESAMPLE;
    assert au_is_usable_tap_format(true, true, 32, 48000.0) == true;
    assert au_is_usable_tap_format(true, false, 16, 48000.0) == false;
    assert au_is_usable_tap_format(false, true, 32, 48000.0) == false;
    assert au_is_usable_tap_format(true, true, 64, 48000.0) == false;
    assert au_is_usable_tap_format(true, true, 32, 0.0) == false;
}

test au_tap_and_mic {
    // tapActions
    assert au_tap_action(false, 2, false, false, true) == AU_TAP_REBUILD;
    assert au_tap_action(false, 0, false, false, true) == AU_TAP_WAIT;
    assert au_tap_action(false, 0, false, true, true) == AU_TAP_REBUILD;
    assert au_tap_action(true, 2, true, false, false) == AU_TAP_KEEP;
    assert au_tap_action(true, 3, false, false, false) == AU_TAP_UPDATE;
    assert au_tap_action(true, 0, false, false, false) == AU_TAP_WAIT;
    assert au_tap_action(true, 1, false, true, false) == AU_TAP_UPDATE;
    assert au_tap_action(false, 0, true, false, false) == AU_TAP_KEEP;
    assert au_tap_action(false, 1, false, false, false) == AU_TAP_REBUILD;
    assert au_tap_action(true, 2, true, false, true) == AU_TAP_REBUILD;
    assert au_tap_action(true, 0, false, false, true) == AU_TAP_WAIT;
    // Every input: forced never keeps or updates; a global tap is never left waiting.
    var bits: u32 = 0;
    var bad: u32 = 0;
    while (bits < 32) {
        var attached: bool = (bits & 1) == 1;
        var same: bool = (bits & 2) == 2;
        var global: bool = (bits & 4) == 4;
        var force: bool = (bits & 8) == 8;
        var desired: i64 = 0;
        if ((bits & 16) == 16) { desired = 3; }
        var a: i64 = au_tap_action(attached, desired, same, global, force);
        if (a < AU_TAP_KEEP or a > AU_TAP_REBUILD) { bad = bad + 1; }
        if (force and (a == AU_TAP_KEEP or a == AU_TAP_UPDATE)) { bad = bad + 1; }
        if (global and a == AU_TAP_WAIT) { bad = bad + 1; }
        bits = bits + 1;
    }
    assert bad == 0;
    // micPermission
    assert au_mic_start_decision(3) == AU_MIC_START;
    assert au_mic_start_decision(0) == AU_MIC_REQUEST_FIRST;
    assert au_mic_start_decision(1) == AU_MIC_DENIED;
    assert au_mic_start_decision(2) == AU_MIC_DENIED;
    assert au_mic_start_decision(99) == AU_MIC_DENIED;
}

test au_moved_rules {
    assert au_has_signal(0.0, 0.0) == false;
    assert au_has_signal(0.5, 0.0) == true;
    assert au_has_signal(0.0005, 0.0005) == true;
    assert au_tap_lists_processes(false) == true;
    assert au_tap_lists_processes(true) == false;
    assert au_flushes_converter(2, 3, false) == true;
    assert au_flushes_converter(1, 3, false) == false;
    assert au_flushes_converter(1, 3, true) == true;
    assert au_uses_buffer(true, 2) == true;
    assert au_uses_buffer(true, 0) == false;
    assert au_uses_buffer(false, 2) == false;
    var sizes: [64]i64 = [0; 64];
    var chans: [64]i64 = [0; 64];
    sizes[0] = 4096;
    chans[0] = 2;
    sizes[1] = 2048;
    chans[1] = 1;
    assert au_buffer_list_frames(sizes, chans, 2, 10000) == 512;
    assert au_buffer_list_frames(sizes, chans, 2, 100) == 100;
    assert au_buffer_list_frames(sizes, chans, 0, 100) == 0;
    assert au_buffer_list_channels(chans, 2) == 3;
    assert au_mono_blocks(true, 6) == 1;
    assert au_mono_blocks(false, 6) == 6;
    assert au_mono_per_block(true, 6) == 6;
    assert au_mono_per_block(false, 6) == 1;
    assert au_mono_supported(AU_FORMAT_FLOAT32) == true;
    assert au_mono_supported(AU_FORMAT_INT16) == true;
    assert au_mono_supported(AU_FORMAT_INT32) == true;
    assert au_mono_supported(AU_FORMAT_FLOAT64) == false;
    assert au_mono_supported(AU_FORMAT_OTHER) == false;
    assert au_is_plain_mono(AU_FORMAT_FLOAT32, 1, false) == true;
    assert au_is_plain_mono(AU_FORMAT_FLOAT32, 1, true) == false;
    assert au_is_plain_mono(AU_FORMAT_FLOAT32, 2, false) == false;
    assert au_is_plain_mono(AU_FORMAT_INT16, 1, false) == false;
    assert au_converter_input(false, true) == AU_INPUT_HAVE_DATA;
    assert au_converter_input(true, false) == AU_INPUT_NO_DATA_NOW;
    assert au_converter_input(true, true) == AU_INPUT_END_OF_STREAM;
    assert au_fourcc_printable(0x626C746E) == true;
    assert au_fourcc_printable(0x70636920) == true;
    assert au_fourcc_printable(0) == false;
    assert au_fourcc_printable(0x7F414141) == false;
    assert au_meter_fraction(1.0) == 1.0;
    assert au_meter_fraction(0.0) == 0.0;
    assert au_meter_fraction(0.001) == 0.0;
    assert au_meter_fraction(0.1) > 0.66;
    assert au_meter_fraction(0.1) < 0.67;
    assert au_meter_fraction(4.0) == 1.0;
    // The fill never leaves 0...1 and never falls as the level rises.
    var level: f32 = 0.0000001;
    var previous: f32 = 0.0;
    var bad: u32 = 0;
    while (level < 3.0) {
        var f: f32 = au_meter_fraction(level);
        if (f < 0.0 or f > 1.0 or f < previous) { bad = bad + 1; }
        previous = f;
        var grow: f32 = 1.05;
        level = level * grow;
    }
    assert bad == 0;
}

test au_restart_backoff {
    // Live crash 2026-10-13: the rebuild after a device change is delayed and backs off.
    assert au_restart_delay_ms(0) == 300;
    assert au_restart_delay_ms(-3) == 300;
    assert au_restart_delay_ms(1) == 600;
    assert au_restart_delay_ms(2) == 1200;
    assert au_restart_delay_ms(3) == 2400;
    assert au_restart_delay_ms(4) == 4800;
    assert au_restart_delay_ms(5) == 5000;
    assert au_restart_delay_ms(1000000) == 5000;
    assert au_restart_delay_ms(9223372036854775807) == 5000;
    assert au_restart_failed(0) == false;
    assert au_restart_failed(5) == false;
    assert au_restart_failed(6) == true;
    assert au_restart_failed(100) == true;
    // The wait never shrinks, never leaves RESTART_DELAY_MS...RESTART_MAX_DELAY_MS, and reaches the cap.
    var a: i64 = -5;
    var previous: i64 = 0;
    var bad: u32 = 0;
    while (a <= 200) {
        var d: i64 = au_restart_delay_ms(a);
        if (d < previous or d < AU_RESTART_DELAY_MS or d > AU_RESTART_MAX_DELAY_MS) { bad = bad + 1; }
        if (au_restart_failed(a) != (a >= AU_RESTART_ATTEMPTS)) { bad = bad + 1; }
        previous = d;
        a = a + 1;
    }
    assert bad == 0;
    assert previous == AU_RESTART_MAX_DELAY_MS;
    // The six waits before the source reports failed add up to 14.3 s.
    var total: i64 = 0;
    var f: i64 = 0;
    while (au_restart_failed(f) == false) {
        total = total + au_restart_delay_ms(f);
        f = f + 1;
    }
    assert total == 14300;
    assert au_mic_tap_ready(48000.0, 1, 48000.0, 1) == true;
    assert au_mic_tap_ready(48000.0, 1, 24000.0, 2) == true;
    assert au_mic_tap_ready(0.0, 1, 48000.0, 1) == false;
    assert au_mic_tap_ready(48000.0, 0, 48000.0, 1) == false;
    assert au_mic_tap_ready(48000.0, 1, 0.0, 1) == false;
    assert au_mic_tap_ready(48000.0, 1, 48000.0, 0) == false;
    assert au_mic_tap_ready(-48000.0, 1, 48000.0, 1) == false;
}

test au_player_rules {
    // Live 2026-10-13: the call output keeps running, rebuilds after a real stop and replays a cut phrase.
    assert au_player_step_state(au_player_step(AU_PL_IDLE, AU_PLE_STARTED, true, 0)) == AU_PL_RUNNING;
    assert au_player_step_action(au_player_step(AU_PL_IDLE, AU_PLE_STARTED, true, 0)) == AU_PLA_SCHEDULE_WAITING;
    assert au_player_step_state(au_player_step(AU_PL_REBUILDING, AU_PLE_STARTED, true, 0)) == AU_PL_RUNNING;
    assert au_player_step_state(au_player_step(AU_PL_FAILED, AU_PLE_STARTED, true, 0)) == AU_PL_RUNNING;
    // A configuration change while the engine runs is ignored; a real stop cuts and schedules a rebuild.
    assert au_player_step(AU_PL_RUNNING, AU_PLE_CHANGE, true, 0) == au_player_keep(AU_PL_RUNNING);
    assert au_player_step_state(au_player_step(AU_PL_RUNNING, AU_PLE_CHANGE, false, 0)) == AU_PL_REBUILDING;
    assert au_player_step_action(au_player_step(AU_PL_RUNNING, AU_PLE_CHANGE, false, 0)) == AU_PLA_CUT_RETRY;
    // The rest of a burst: a rebuild is already scheduled.
    assert au_player_step(AU_PL_REBUILDING, AU_PLE_CHANGE, false, 0) == au_player_keep(AU_PL_REBUILDING);
    assert au_player_step(AU_PL_FAILED, AU_PLE_CHANGE, false, 0) == au_player_keep(AU_PL_FAILED);
    assert au_player_step(AU_PL_IDLE, AU_PLE_CHANGE, false, 0) == au_player_keep(AU_PL_IDLE);
    // Failed starts retry; after RESTART_ATTEMPTS in a row the waiting phrases are completed unplayed.
    assert au_player_step_state(au_player_step(AU_PL_IDLE, AU_PLE_START_FAILED, false, 1)) == AU_PL_REBUILDING;
    assert au_player_step_action(au_player_step(AU_PL_REBUILDING, AU_PLE_START_FAILED, false, 5)) == AU_PLA_RETRY;
    assert au_player_step_state(au_player_step(AU_PL_REBUILDING, AU_PLE_START_FAILED, false, 6)) == AU_PL_FAILED;
    assert au_player_step_action(au_player_step(AU_PL_REBUILDING, AU_PLE_START_FAILED, false, 6)) == AU_PLA_RETRY_RELEASE;
    assert au_player_step_action(au_player_step(AU_PL_FAILED, AU_PLE_START_FAILED, false, 7)) == AU_PLA_RETRY_RELEASE;
    assert au_player_enqueue(AU_PL_IDLE) == AU_PLQ_START;
    assert au_player_enqueue(AU_PL_RUNNING) == AU_PLQ_SCHEDULE;
    assert au_player_enqueue(AU_PL_REBUILDING) == AU_PLQ_WAIT;
    assert au_player_enqueue(AU_PL_FAILED) == AU_PLQ_REFUSE;
    // Every state, event, running flag and failure count: the step stays in the four states, a failure
    // always retries, the engine runs after STARTED, and only a stop of a running engine cuts.
    var bad: u32 = 0;
    var state: i64 = AU_PL_IDLE;
    while (state <= AU_PL_FAILED) {
        var event: i64 = AU_PLE_STARTED;
        while (event <= AU_PLE_CHANGE) {
            var f: i64 = 0;
            while (f <= 20) {
                var r: i64 = 0;
                while (r <= 1) {
                    var running: bool = r == 1;
                    var step: i64 = au_player_step(state, event, running, f);
                    var next: i64 = au_player_step_state(step);
                    var action: i64 = au_player_step_action(step);
                    if (next < AU_PL_IDLE or next > AU_PL_FAILED) { bad = bad + 1; }
                    if (action < AU_PLA_NONE or action > AU_PLA_CUT_RETRY) { bad = bad + 1; }
                    if (event == AU_PLE_STARTED and next != AU_PL_RUNNING) { bad = bad + 1; }
                    if (event == AU_PLE_START_FAILED and action != AU_PLA_RETRY and action != AU_PLA_RETRY_RELEASE) { bad = bad + 1; }
                    if (event == AU_PLE_START_FAILED and (action == AU_PLA_RETRY_RELEASE) != au_restart_failed(f)) { bad = bad + 1; }
                    var cut: bool = action == AU_PLA_CUT_RETRY;
                    if (cut != (event == AU_PLE_CHANGE and running == false and state == AU_PL_RUNNING)) { bad = bad + 1; }
                    if (event == AU_PLE_CHANGE and cut == false and step != au_player_keep(state)) { bad = bad + 1; }
                    r = r + 1;
                }
                f = f + 1;
            }
            event = event + 1;
        }
        state = state + 1;
    }
    assert bad == 0;
    // Heard: only from the phrase's own engine, still running, rendered up to the end (less the tolerance).
    assert au_player_completion(true, true, true, 48000, 48000) == AU_PLC_DONE;
    assert au_player_completion(true, true, true, 43904, 48000) == AU_PLC_DONE;
    assert au_player_completion(true, true, true, 43903, 48000) == AU_PLC_REPLAY;
    assert au_player_completion(true, true, true, 0, 48000) == AU_PLC_REPLAY;
    assert au_player_completion(true, true, false, 0, 48000) == AU_PLC_DONE;
    assert au_player_completion(false, true, true, 96000, 48000) == AU_PLC_IGNORE;
    assert au_player_completion(true, false, true, 96000, 48000) == AU_PLC_IGNORE;
    assert au_player_completion(false, false, false, 0, 0) == AU_PLC_IGNORE;
    // A cut phrase is played again at most MAX_REPLAYS times.
    assert au_player_replays(1) == true;
    assert au_player_replays(3) == true;
    assert au_player_replays(4) == false;
}
