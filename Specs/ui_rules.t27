test ui_mic_light_gate {
    // Live test 2026-10-13: push-to-talk, key up, 10 s without a buffer. The microphone light was BAD.
    assert ui_audio_light(UI_RUN_RUNNING, true, 10000, -1) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 10000, -1, -1) == UI_LIGHT_OK;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 10000, -1, 8000) == UI_LIGHT_OK;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 10000, -1, 100) == UI_LIGHT_OK;
    // Key held: the warm-up counts from the press; nothing past the thresholds is BAD.
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 13999, 3999, 7999) == UI_LIGHT_BUSY;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 14000, 4000, 8000) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 15000, 5000, -1) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 15000, 5000, 1999) == UI_LIGHT_OK;
    // Mode auto: the gate opened at the start.
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 3999, 3000, -1) == UI_LIGHT_BUSY;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_CAPTURING, 9000, 8000, 2000) == UI_LIGHT_BAD;
    // Live crash 2026-10-13: a device change stops the microphone; rebuilding is BUSY, a failed rebuild BAD,
    // also with the key up.
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_RESTARTING, 10000, -1, -1) == UI_LIGHT_BUSY;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_RESTARTING, 10000, 9000, 100) == UI_LIGHT_BUSY;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_FAILED, 10000, -1, -1) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_FAILED, 10000, 9000, 100) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_RUNNING, true, UI_MIC_NONE, 10000, -1, -1) == UI_LIGHT_OK;
    assert ui_mic_light(UI_RUN_IDLE, true, UI_MIC_FAILED, 0, -1, -1) == UI_LIGHT_UNKNOWN;
    // A microphone that did not start, and the run states, as audioLight.
    assert ui_mic_light(UI_RUN_RUNNING, false, UI_MIC_CAPTURING, 9000, -1, -1) == UI_LIGHT_BAD;
    assert ui_mic_light(UI_RUN_STARTING, true, UI_MIC_CAPTURING, 0, -1, -1) == UI_LIGHT_BUSY;
    assert ui_mic_light(UI_RUN_IDLE, true, UI_MIC_CAPTURING, 0, -1, -1) == UI_LIGHT_UNKNOWN;
    assert ui_mic_light(UI_RUN_STOPPING, true, UI_MIC_CAPTURING, 9000, 5000, -1) == UI_LIGHT_UNKNOWN;
    assert ui_mic_shows_level(UI_LIGHT_OK, 1999) == true;
    assert ui_mic_shows_level(UI_LIGHT_OK, 2000) == false;
    assert ui_mic_shows_level(UI_LIGHT_OK, -1) == false;
    assert ui_mic_shows_level(UI_LIGHT_BUSY, 10) == false;
    // Every run state, both lane flags, every microphone status and the threshold edges of the three times.
    var ms: [8]i64 = [0; 8];
    ms[0] = -1;
    ms[1] = 0;
    ms[2] = 1999;
    ms[3] = 2000;
    ms[4] = 3999;
    ms[5] = 4000;
    ms[6] = 10000;
    ms[7] = 100000;
    var bad: u32 = 0;
    var run: i32 = -1;
    while (run <= 4) {
        var a: i32 = 0;
        while (a < 2) {
            var active: bool = a == 1;
            var i: i32 = 0;
            while (i < 8) {
                var j: i32 = 0;
                while (j < 8) {
                    var k: i32 = 0;
                    while (k < 8) {
                        var mic: i32 = -1;
                        while (mic <= 5) {
                            var light: i32 = ui_mic_light(run, active, mic, ms[i], ms[j], ms[k]);
                            var fresh: bool = ms[k] >= 0 and ms[k] < UI_AUDIO_FRESH_MS;
                            if (run != UI_RUN_RUNNING or active == false) {
                                if (light != ui_audio_light(run, active, ms[i], ms[k])) { bad = bad + 1; }
                            } else if (mic == UI_MIC_FAILED) {
                                if (light != UI_LIGHT_BAD) { bad = bad + 1; }
                            } else if (mic == UI_MIC_RESTARTING) {
                                if (light != UI_LIGHT_BUSY) { bad = bad + 1; }
                            } else if (ms[j] < 0) {
                                if (light != UI_LIGHT_OK) { bad = bad + 1; }
                            } else {
                                var warm: i64 = ms[i];
                                if (ms[j] < warm) { warm = ms[j]; }
                                if (light != ui_audio_light(run, active, warm, ms[k])) { bad = bad + 1; }
                                if (light == UI_LIGHT_BAD and (fresh or warm < UI_AUDIO_WARMUP_MS)) { bad = bad + 1; }
                            }
                            if (light == UI_LIGHT_BAD and run == UI_RUN_RUNNING and active and ms[j] < 0 and mic != UI_MIC_FAILED) { bad = bad + 1; }
                            if (ui_mic_shows_level(light, ms[k]) != (light == UI_LIGHT_OK and fresh)) { bad = bad + 1; }
                            mic = mic + 1;
                        }
                        k = k + 1;
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            a = a + 1;
        }
        run = run + 1;
    }
    assert bad == 0;
}

test ui_checklist {
    // Rows: the reminders never change; the listener row follows the listener status.
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_OK, false, UI_MICSRC_SYSTEM) == UI_CK_OK;
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_NOBODY, true, UI_MICSRC_AUTO) == UI_CK_BAD;
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_REAL_MIC, true, UI_MICSRC_AUTO) == UI_CK_BAD;
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_NO_BLACKHOLE, true, UI_MICSRC_AUTO) == UI_CK_BAD;
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_BOTH, true, UI_MICSRC_AUTO) == UI_CK_WARN;
    assert ui_checklist_mark(UI_CKI_LISTENER, UI_LISTEN_UNKNOWN, true, UI_MICSRC_AUTO) == UI_CK_UNKNOWN;
    assert ui_checklist_mark(UI_CKI_CALL_MIC, UI_LISTEN_NOBODY, false, UI_MICSRC_SYSTEM) == UI_CK_INFO;
    assert ui_checklist_mark(UI_CKI_EXTENSIONS, UI_LISTEN_OK, true, UI_MICSRC_AUTO) == UI_CK_INFO;
    assert ui_checklist_mark(UI_CKI_HOW_TO_TALK, UI_LISTEN_OK, true, UI_MICSRC_AUTO) == UI_CK_INFO;
    assert ui_checklist_mark(UI_CKI_HEADPHONES, UI_LISTEN_OK, true, UI_MICSRC_AUTO) == UI_CK_OK;
    assert ui_checklist_mark(UI_CKI_HEADPHONES, UI_LISTEN_OK, false, UI_MICSRC_AUTO) == UI_CK_WARN;
    assert ui_checklist_mark(UI_CKI_MY_MIC, UI_LISTEN_OK, false, UI_MICSRC_SAVED) == UI_CK_OK;
    assert ui_checklist_mark(UI_CKI_MY_MIC, UI_LISTEN_OK, false, UI_MICSRC_AUTO) == UI_CK_OK;
    assert ui_checklist_mark(UI_CKI_MY_MIC, UI_LISTEN_OK, false, UI_MICSRC_SYSTEM) == UI_CK_WARN;
    assert ui_checklist_mark(UI_CKI_COUNT, UI_LISTEN_OK, true, UI_MICSRC_AUTO) == UI_CK_UNKNOWN;
    // Every row, status, flag and source: a mark is one of the five, and only the listener row is ever red.
    var item: i32 = -1;
    var bad: u32 = 0;
    while (item <= UI_CKI_COUNT) {
        var st: i32 = -1;
        while (st <= 6) {
            var h: i32 = 0;
            while (h < 2) {
                var src: i32 = -1;
                while (src <= 3) {
                    var m: i32 = ui_checklist_mark(item, st, h == 1, src);
                    if (m < UI_CK_UNKNOWN or m > UI_CK_INFO) { bad = bad + 1; }
                    if (m == UI_CK_BAD and item != UI_CKI_LISTENER) { bad = bad + 1; }
                    if (m == UI_CK_INFO and (item == UI_CKI_LISTENER or item == UI_CKI_HEADPHONES or item == UI_CKI_MY_MIC)) { bad = bad + 1; }
                    src = src + 1;
                }
                h = h + 1;
            }
            st = st + 1;
        }
        item = item + 1;
    }
    assert bad == 0;
    assert ui_mic_source(true, true, true) == UI_MICSRC_SAVED;
    assert ui_mic_source(true, false, true) == UI_MICSRC_AUTO;
    assert ui_mic_source(false, true, true) == UI_MICSRC_AUTO;
    assert ui_mic_source(true, false, false) == UI_MICSRC_SYSTEM;
    assert ui_mic_source(false, false, false) == UI_MICSRC_SYSTEM;
    // Opening: never over the wizard; at launch unless turned off, in test mode or with autostart.
    assert ui_checklist_opens(UI_CKO_LAUNCH, true, false, false, false) == true;
    assert ui_checklist_opens(UI_CKO_LAUNCH, false, false, false, false) == false;
    assert ui_checklist_opens(UI_CKO_LAUNCH, true, true, false, false) == false;
    assert ui_checklist_opens(UI_CKO_LAUNCH, true, false, true, false) == false;
    assert ui_checklist_opens(UI_CKO_LAUNCH, true, false, false, true) == false;
    assert ui_checklist_opens(UI_CKO_ASKED, false, false, true, true) == true;
    assert ui_checklist_opens(UI_CKO_ASKED, true, true, false, false) == false;
    assert ui_checklist_opens(7, true, false, false, false) == false;
    assert UI_DEFAULT_CHECKLIST_ON_LAUNCH == 1;
    assert ui_checklist_can_start(UI_RUN_IDLE) == true;
    assert ui_checklist_can_start(UI_RUN_RUNNING) == false;
    assert ui_checklist_can_start(UI_RUN_STARTING) == false;
    assert ui_poll_reads_listeners(0, true, UI_RUN_IDLE) == true;
    assert ui_poll_reads_listeners(1, true, UI_RUN_IDLE) == false;
    assert ui_poll_reads_listeners(2, false, UI_RUN_RUNNING) == true;
    assert ui_poll_reads_listeners(4, false, UI_RUN_IDLE) == false;
    assert ui_poll_reads_listeners(4, false, UI_RUN_STARTING) == false;
    // The runtime banner.
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_BAD, 3000, false, false) == UI_LB_SHOW;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_BAD, 2999, false, false) == UI_LB_NONE;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_BAD, -1, false, false) == UI_LB_NONE;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_BAD, 9000, true, false) == UI_LB_SHOW;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_BAD, 9000, false, true) == UI_LB_NONE;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_OK, 9000, true, false) == UI_LB_CLEAR;
    assert ui_listener_banner(UI_RUN_RUNNING, UI_CK_WARN, 9000, false, false) == UI_LB_NONE;
    assert ui_listener_banner(UI_RUN_IDLE, UI_CK_BAD, 9000, true, false) == UI_LB_CLEAR;
    assert ui_listener_banner(UI_RUN_STOPPING, UI_CK_BAD, 9000, false, false) == UI_LB_NONE;
    assert ui_listener_streak(UI_CK_BAD) == true;
    assert ui_listener_streak(UI_CK_WARN) == false;
    // Every input: SHOW only during a call with a red row past the grace time, never after the owner closed it.
    var run: i32 = -1;
    while (run <= 4) {
        var mark: i32 = -1;
        while (mark <= 5) {
            var f: i32 = 0;
            while (f < 4) {
                var ms: i64 = -1;
                while (ms <= 4000) {
                    var shown: bool = f % 2 == 1;
                    var dismissed: bool = f >= 2;
                    var lb: i32 = ui_listener_banner(run, mark, ms, shown, dismissed);
                    var red: bool = run == UI_RUN_RUNNING and mark == UI_CK_BAD;
                    if (lb == UI_LB_SHOW and (red == false or dismissed or ms < UI_LISTENER_GRACE_MS)) { bad = bad + 1; }
                    if (lb == UI_LB_CLEAR and (red or shown == false)) { bad = bad + 1; }
                    if (red == false and shown and lb != UI_LB_CLEAR) { bad = bad + 1; }
                    ms = ms + 1000;
                }
                f = f + 1;
            }
            mark = mark + 1;
        }
        run = run + 1;
    }
    assert bad == 0;
    assert ui_mic_migration(false, true) == UI_MIGRATE_CLEAR;
    assert ui_mic_migration(false, false) == UI_MIGRATE_MARK;
    assert ui_mic_migration(true, true) == UI_MIGRATE_NONE;
    assert ui_mic_migration(true, false) == UI_MIGRATE_NONE;
}
