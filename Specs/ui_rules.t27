; modelsLight counting translators that could not be prepared as failures.
pub fn ui_models_light_all(run_state: i32, ever_started: bool, lanes_started: i32, lanes_failed: i32, translators_failed: i32) -> i32 {
    return ui_models_light(run_state, ever_started, lanes_started, lanes_failed + translators_failed);
}

; A level meter shows only next to a green light.
pub fn ui_shows_level(light: i32) -> bool {
    return light == UI_LIGHT_OK;
}

; micShowsLevel: the microphone meter shows the last buffer's level only next to a green light and while
; that buffer is fresh. With the gate closed the light is green without audio; the meter then stays empty
; instead of holding the level of the last buffer.
pub fn ui_mic_shows_level(light: i32, ms_since_buffer: i64) -> bool {
    return ui_shows_level(light) and ms_since_buffer >= 0 and ms_since_buffer < UI_AUDIO_FRESH_MS;
}

; The silence warning follows the source light. While the light is WARN the warning is given once per call;
; an error banner already shown stays, and the warning counts as given. As soon as the light is anything
; but WARN (a non-zero sample arrived, the tap waits or failed, the call stopped), a silence warning still
; on screen is taken down; it is not given again in the same call. silence_shown: the banner on screen is
; the silence warning.
pub fn ui_silence_banner(source_light: i32, already_warned: bool, error_shown: bool, silence_shown: bool) -> i32 {
    if (source_light == UI_LIGHT_WARN) {
        if (already_warned) { return UI_SB_NONE; }
        if (error_shown) { return UI_SB_MARK; }
        return UI_SB_SHOW;
    }
    if (silence_shown) { return UI_SB_CLEAR; }
    return UI_SB_NONE;
}

pub fn ui_poll_refreshes_catalogs(tick: i64) -> bool {
    return tick % UI_CATALOG_EVERY_TICKS == UI_CATALOG_TICK;
}

; The source light's tooltip: idle; else by the tap status; else silence; else audio flows.
pub fn ui_source_help(run_state: i32, tap_status: i32, source_light: i32) -> i32 {
    if (run_state != UI_RUN_RUNNING) { return UI_HELP_IDLE; }
    if (tap_status == UI_TAP_WAITING) { return UI_HELP_WAITING; }
    if (tap_status == UI_TAP_FAILED) { return UI_HELP_FAILED; }
    if (tap_status == UI_TAP_NONE) { return UI_HELP_FILE; }
    if (source_light == UI_LIGHT_WARN) { return UI_HELP_SILENCE; }
    return UI_HELP_FLOWING;
}

pub fn ui_source_title(is_system: bool, has_running_name: bool, has_label: bool) -> i32 {
    if (is_system) { return UI_TITLE_SYSTEM; }
    if (has_running_name) { return UI_TITLE_RUNNING; }
    if (has_label) { return UI_TITLE_LABEL; }
    return UI_TITLE_ID;
}

; The call has an output: BlackHole, or the test sink.
pub fn ui_has_call_output(has_blackhole: bool, has_sink: bool) -> bool {
    return has_blackhole or has_sink;
}

pub fn ui_banner_kind(banner: i32) -> i32 {
    if (banner == UI_BAN_FAILED_PACKS or banner == UI_BAN_FAILED_OTHER or banner == UI_BAN_NO_PACKS or banner == UI_BAN_NO_TRANSLATOR) {
        return UI_BK_ERROR;
    }
    if (banner == UI_BAN_NO_BLACKHOLE or banner == UI_BAN_SPEAKERS) { return UI_BK_WARNING; }
    return UI_BK_NONE;
}

; The wizard step a start banner opens.
pub fn ui_banner_step(banner: i32) -> i32 {
    if (banner == UI_BAN_FAILED_PACKS or banner == UI_BAN_NO_PACKS or banner == UI_BAN_NO_TRANSLATOR) { return UI_WZ_PACKS; }
    if (banner == UI_BAN_FAILED_OTHER) { return UI_WZ_PERMISSIONS; }
    if (banner == UI_BAN_NO_BLACKHOLE) { return UI_WZ_BLACKHOLE; }
    return UI_WZ_NONE;
}

; A translation failure: missing packs show the packs banner unless it is up; anything else a warning
; unless the same text is up.
pub fn ui_translation_error_banner(missing_packs: bool, packs_banner_shown: bool, same_text_shown: bool) -> i32 {
    if (missing_packs) {
        if (packs_banner_shown) { return UI_TEB_NONE; }
        return UI_TEB_PACKS;
    }
    if (same_text_shown) { return UI_TEB_NONE; }
    return UI_TEB_WARNING;
}

; A device setting names a device that is connected: use it; else the automatic choice.
pub fn ui_device_choice(has_setting: bool, found: bool) -> i32 {
    if (has_setting and found) { return UI_DEV_SAVED; }
    return UI_DEV_AUTO;
}

; The Claude key is looked up only when Claude is the preferred translator.
pub fn ui_probes_claude(preferred: i32) -> bool {
    return preferred == UI_TR_CLAUDE;
}

; A transcript saved during the call has no end time yet.
pub fn ui_transcript_has_end(run_state: i32) -> bool {
    return run_state != UI_RUN_RUNNING;
}

; The test phrase into the call needs BlackHole.
pub fn ui_test_phrase_possible(into_call: bool, has_blackhole: bool) -> bool {
    return into_call == false or has_blackhole;
}

pub fn ui_outgoing_status(paused: bool, speaking: bool, running: bool, has_blackhole: bool) -> i32 {
    if (paused) { return UI_OUT_PAUSED; }
    if (speaking) { return UI_OUT_SPEAKING; }
    if (running and has_blackhole == false) { return UI_OUT_NO_BLACKHOLE; }
    return UI_OUT_NONE;
}

pub fn ui_call_output_label(has_blackhole: bool, has_setting: bool) -> i32 {
    if (has_blackhole and has_setting == false) { return UI_COL_FOUND; }
    return UI_COL_SEARCH;
}

pub fn ui_translator_note(preferred: i32, claude_available: bool) -> i32 {
    if (claude_available) { return UI_TN_NONE; }
    if (preferred == UI_TR_CLAUDE) { return UI_TN_NO_KEY_FALLBACK; }
    return UI_TN_NO_KEY;
}

pub fn ui_permission_state(raw: i64) -> i32 {
    if (raw == UI_RAW_AUTHORIZED) { return UI_PERM_GRANTED; }
    if (raw == UI_RAW_DENIED_A or raw == UI_RAW_DENIED_B) { return UI_PERM_DENIED; }
    if (raw == UI_RAW_NOT_DETERMINED) { return UI_PERM_NOT_ASKED; }
    return UI_PERM_UNKNOWN;
}

pub fn ui_permission_action(state: i32) -> i32 {
    if (state == UI_PERM_DENIED) { return UI_PA_OPEN_SETTINGS; }
    if (state != UI_PERM_GRANTED) { return UI_PA_REQUEST; }
    return UI_PA_NONE;
}

pub fn ui_permission_light(state: i32) -> i32 {
    if (state == UI_PERM_GRANTED) { return UI_LIGHT_OK; }
    if (state == UI_PERM_DENIED) { return UI_LIGHT_BAD; }
    return UI_LIGHT_UNKNOWN;
}

; The capture check offers System Settings after a bad or silent result.
pub fn ui_capture_needs_settings(light: i32) -> bool {
    return light == UI_LIGHT_BAD or light == UI_LIGHT_WARN;
}

pub fn ui_accessibility_light(granted: bool) -> i32 {
    if (granted) { return UI_LIGHT_OK; }
    return UI_LIGHT_UNKNOWN;
}

pub fn ui_pack_light(status: i32) -> i32 {
    if (status == UI_AVAIL_INSTALLED) { return UI_LIGHT_OK; }
    if (status == UI_AVAIL_UNSUPPORTED) { return UI_LIGHT_BAD; }
    return UI_LIGHT_UNKNOWN;
}

; A pack being downloaded keeps its light until the download ends.
pub fn ui_pack_refreshable(light: i32) -> bool {
    return light != UI_LIGHT_BUSY;
}

pub fn ui_pack_download_enabled(light: i32) -> bool {
    return (light == UI_LIGHT_BUSY or light == UI_LIGHT_OK) == false;
}

pub fn ui_line_state(has_translation: bool, has_error: bool) -> i32 {
    if (has_translation) { return UI_LINE_TRANSLATED; }
    if (has_error) { return UI_LINE_FAILED; }
    return UI_LINE_PENDING;
}

; Files instead of devices: test mode.
pub fn ui_is_test_mode(has_incoming_file: bool, has_outgoing_file: bool, has_sink: bool, has_transcript_dir: bool) -> bool {
    return has_incoming_file or has_outgoing_file or has_sink or has_transcript_dir;
}

; Does the slice equal row `row` of the word table?
pub fn ui_equals_row(text: [64]u8, len: i64, row: i64) -> bool {
    var n: i64 = UI_ROW_LENGTHS[row];
    if (len != n) { return false; }
    var off: i64 = UI_ROW_OFFSETS[row];
    var i: i64 = 0;
    while (i < n) {
        if (text[i] != UI_ROW_TEXT[off + i]) { return false; }
        i = i + 1;
    }
    return true;
}

; A launch flag (lowercased by Swift) means yes: "yes", "true" or "1".
pub fn ui_is_yes(text: [64]u8, len: i64) -> bool {
    return ui_equals_row(text, len, UI_ROW_YES) or ui_equals_row(text, len, UI_ROW_TRUE) or ui_equals_row(text, len, UI_ROW_ONE);
}

; A stored source key "app:<bundleID>": the prefix length; -1 for anything else (all Mac audio).
pub fn ui_source_key_app_prefix(text: [4096]u8, len: i64) -> i64 {
    var off: i64 = UI_ROW_OFFSETS[UI_ROW_SOURCE_APP_PREFIX];
    var n: i64 = UI_ROW_LENGTHS[UI_ROW_SOURCE_APP_PREFIX];
    if (len < n) { return -1; }
    var i: i64 = 0;
    while (i < n) {
        if (text[i] != UI_ROW_TEXT[off + i]) { return -1; }
        i = i + 1;
    }
    return n;
}

; Row `row` of the word table, written to out (its length).
pub fn ui_row_bytes(row: i64, out: [64]u8) -> i64 {
    if (row < 0 or row >= UI_ROW_COUNT) { return 0; }
    var off: i64 = UI_ROW_OFFSETS[row];
    var n: i64 = UI_ROW_LENGTHS[row];
    var i: i64 = 0;
    while (i < n) {
        out[i] = UI_ROW_TEXT[off + i];
        i = i + 1;
    }
    return n;
}

; Quitting during a call stops it first (and saves the transcript).
pub fn ui_quit_waits(run_state: i32) -> bool {
    return run_state == UI_RUN_RUNNING;
}

; --- The checklist "before the call" (owner 2026-10-13) ----------------------------------------------------------
; A sheet with live marks that opens at launch (by default) and from the toolbar and the call menu. Its rows, in
; the order shown: who listens to BlackHole; the call app's microphone is on (cannot be detected: a reminder);
; headphones; Ponte's microphone; browser extensions that replace the microphone (a reminder); how to talk.
pub const UI_CKI_LISTENER : i32 = 0;
pub const UI_CKI_CALL_MIC : i32 = 1;
pub const UI_CKI_HEADPHONES : i32 = 2;
pub const UI_CKI_MY_MIC : i32 = 3;
pub const UI_CKI_EXTENSIONS : i32 = 4;
pub const UI_CKI_HOW_TO_TALK : i32 = 5;
pub const UI_CKI_COUNT : i32 = 6;
; Marks: unknown, done (green), check it (amber), broken (red), a reminder.
pub const UI_CK_UNKNOWN : i32 = 0;
pub const UI_CK_OK : i32 = 1;
pub const UI_CK_WARN : i32 = 2;
pub const UI_CK_BAD : i32 = 3;
pub const UI_CK_INFO : i32 = 4;
; Who listens to BlackHole (the same codes as DV_LISTEN_* in device_rules.t27).
pub const UI_LISTEN_UNKNOWN : i32 = 0;
pub const UI_LISTEN_OK : i32 = 1;
pub const UI_LISTEN_NOBODY : i32 = 2;
pub const UI_LISTEN_REAL_MIC : i32 = 3;
pub const UI_LISTEN_BOTH : i32 = 4;
pub const UI_LISTEN_NO_BLACKHOLE : i32 = 5;
; Ponte's microphone: the one chosen in the settings, the automatic pick (dv_pick_auto_mic_index), or none found
; (the system's default input).
pub const UI_MICSRC_SAVED : i32 = 0;
pub const UI_MICSRC_AUTO : i32 = 1;
pub const UI_MICSRC_SYSTEM : i32 = 2;
; Why the sheet would open: at launch, or asked for (toolbar, menu, banner).
pub const UI_CKO_LAUNCH : i32 = 0;
pub const UI_CKO_ASKED : i32 = 1;
; "Show at launch" is on until the owner turns it off.
pub const UI_DEFAULT_CHECKLIST_ON_LAUNCH : i32 = 1;
; The sheet and a running call re-read who listens to BlackHole every 2nd poll (1 s).
pub const UI_LISTENER_EVERY_TICKS : i64 = 2;
; The red banner during a call waits this long after the call app stopped listening (switching the microphone in
; Meet takes a moment).
pub const UI_LISTENER_GRACE_MS : i64 = 3000;
; The runtime listener banner: nothing, show (or keep) it, take it down.
pub const UI_LB_NONE : i32 = 0;
pub const UI_LB_SHOW : i32 = 1;
pub const UI_LB_CLEAR : i32 = 2;
; The one-time move of a stored microphone to "automatic": nothing, clear the setting and remember, only remember.
pub const UI_MIGRATE_NONE : i32 = 0;
pub const UI_MIGRATE_CLEAR : i32 = 1;
pub const UI_MIGRATE_MARK : i32 = 2;

; listenerMark: OK when a program other than Ponte reads BlackHole; amber when the call app reads BlackHole and a
; real microphone; red when nobody listens, the call app reads a real microphone, or BlackHole is missing.
pub fn ui_listener_mark(listen_status: i32) -> i32 {
    if (listen_status == UI_LISTEN_OK) { return UI_CK_OK; }
    if (listen_status == UI_LISTEN_BOTH) { return UI_CK_WARN; }
    if (listen_status == UI_LISTEN_NOBODY or listen_status == UI_LISTEN_REAL_MIC or listen_status == UI_LISTEN_NO_BLACKHOLE) {
        return UI_CK_BAD;
    }
    return UI_CK_UNKNOWN;
}

; checklistMark: the mark of one row. The call app's microphone, the extensions and how to talk are reminders;
; headphones-like output is done, anything else (speakers, none) amber; Ponte's microphone is done when chosen or
; picked, amber when only the system default is left.
pub fn ui_checklist_mark(item: i32, listen_status: i32, headphones_like: bool, mic_source: i32) -> i32 {
    if (item == UI_CKI_LISTENER) { return ui_listener_mark(listen_status); }
    if (item == UI_CKI_CALL_MIC or item == UI_CKI_EXTENSIONS or item == UI_CKI_HOW_TO_TALK) { return UI_CK_INFO; }
    if (item == UI_CKI_HEADPHONES) {
        if (headphones_like) { return UI_CK_OK; }
        return UI_CK_WARN;
    }
    if (item == UI_CKI_MY_MIC) {
        if (mic_source == UI_MICSRC_SAVED or mic_source == UI_MICSRC_AUTO) { return UI_CK_OK; }
        return UI_CK_WARN;
    }
    return UI_CK_UNKNOWN;
}

; micSource: a setting naming a connected device wins (ui_device_choice); else the automatic pick; else none.
pub fn ui_mic_source(has_setting: bool, found: bool, has_auto: bool) -> i32 {
    if (ui_device_choice(has_setting, found) == UI_DEV_SAVED) { return UI_MICSRC_SAVED; }
    if (has_auto) { return UI_MICSRC_AUTO; }
    return UI_MICSRC_SYSTEM;
}

; checklistOpens: never over the setup wizard; asked for, always; at launch when "show at launch" is on, outside
; test mode and without autostart.
pub fn ui_checklist_opens(reason: i32, show_on_launch: bool, wizard_shown: bool, test_mode: bool, autostart: bool) -> bool {
    if (wizard_shown) { return false; }
    if (reason == UI_CKO_ASKED) { return true; }
    if (reason == UI_CKO_LAUNCH) { return show_on_launch and test_mode == false and autostart == false; }
    return false;
}

; "Start" in the sheet starts translation only when Ponte is idle.
pub fn ui_checklist_can_start(run_state: i32) -> bool {
    return run_state == UI_RUN_IDLE;
}

; pollReadsListeners: while the sheet is open or a call runs, every UI_LISTENER_EVERY_TICKS-th poll.
pub fn ui_poll_reads_listeners(tick: i64, sheet_open: bool, run_state: i32) -> bool {
    return (sheet_open or run_state == UI_RUN_RUNNING) and tick % UI_LISTENER_EVERY_TICKS == 0;
}

; A red listener mark starts (or continues) the streak the banner waits on.
pub fn ui_listener_streak(mark: i32) -> bool {
    return mark == UI_CK_BAD;
}

; listenerBanner: during a call, the listener row's red text as a red banner, the most important runtime
; warning. Shown once the row has been red for UI_LISTENER_GRACE_MS (ms_bad < 0: not red); it replaces other
; banners. Closed by the owner, it stays down until the row stops being red. Taken down when the call stops or the
; row is not red. shown: the banner on screen is this one.
pub fn ui_listener_banner(run_state: i32, mark: i32, ms_bad: i64, shown: bool, dismissed: bool) -> i32 {
    if (run_state != UI_RUN_RUNNING or ui_listener_streak(mark) == false) {
        if (shown) { return UI_LB_CLEAR; }
        return UI_LB_NONE;
    }
    if (dismissed) { return UI_LB_NONE; }
    if (ms_bad < UI_LISTENER_GRACE_MS) { return UI_LB_NONE; }
    return UI_LB_SHOW;
}

; micMigration: before 2026-10-13 the microphone setting had no "automatic" (the stored built-in microphone was
; set by the lead, not the owner). Once: a stored microphone is cleared to automatic; either way it is remembered.
pub fn ui_mic_migration(migrated: bool, has_setting: bool) -> i32 {
    if (migrated) { return UI_MIGRATE_NONE; }
    if (has_setting) { return UI_MIGRATE_CLEAR; }
    return UI_MIGRATE_MARK;
}

test ui_run_and_buttons {
    // rulesRunStateBannersAndButtons
    assert ui_toggle_run(UI_RUN_IDLE) == UI_TOGGLE_START;
    assert ui_toggle_run(UI_RUN_RUNNING) == UI_TOGGLE_STOP;
    assert ui_toggle_run(UI_RUN_STARTING) == UI_TOGGLE_NONE;
    assert ui_toggle_run(UI_RUN_STOPPING) == UI_TOGGLE_NONE;
    assert ui_run_state_after_start(0) == UI_RUN_IDLE;
    assert ui_run_state_after_start(1) == UI_RUN_RUNNING;
    assert ui_start_banner(1, true, false, true) == UI_BAN_FAILED_PACKS;
    assert ui_start_banner(2, false, true, false) == UI_BAN_FAILED_OTHER;
    assert ui_start_banner(0, false, false, true) == UI_BAN_NO_BLACKHOLE;
    assert ui_start_banner(0, false, true, true) == UI_BAN_SPEAKERS;
    assert ui_start_banner(0, true, true, false) == UI_BAN_NONE;
    assert ui_start_banner_after_start(0, 1, true, true, false) == UI_BAN_NO_PACKS;
    assert ui_start_banner_after_start(0, 2, false, false, true) == UI_BAN_NO_TRANSLATOR;
    assert ui_start_banner_after_start(1, 1, true, true, false) == UI_BAN_FAILED_PACKS;
    assert ui_start_banner_after_start(0, 0, false, false, true) == UI_BAN_NO_BLACKHOLE;
    assert ui_start_banner_after_start(0, 0, false, true, false) == UI_BAN_NONE;
    assert ui_autosave_on_stop(1) == true;
    assert ui_autosave_on_stop(0) == false;
    assert ui_button_enabled(UI_BTN_START_STOP, UI_RUN_IDLE, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_START_STOP, UI_RUN_RUNNING, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_START_STOP, UI_RUN_STARTING, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_START_STOP, UI_RUN_STOPPING, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_SOURCE, UI_RUN_IDLE, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_SOURCE, UI_RUN_RUNNING, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_REPLAY_INCOMING, UI_RUN_RUNNING, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_REPLAY_INCOMING, UI_RUN_RUNNING, 1, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_REPLAY_INCOMING, UI_RUN_IDLE, 1, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_REPLAY_OUTGOING, UI_RUN_RUNNING, 0, 1, true, false) == true;
    assert ui_button_enabled(UI_BTN_REPLAY_OUTGOING, UI_RUN_RUNNING, 1, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_SAVE_TRANSCRIPT, UI_RUN_IDLE, 0, 1, true, false) == true;
    assert ui_button_enabled(UI_BTN_SAVE_TRANSCRIPT, UI_RUN_RUNNING, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_PAUSE_VOICE, UI_RUN_IDLE, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_MODE, UI_RUN_STOPPING, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_VOICE_TOGGLE, UI_RUN_STARTING, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_TALK_PAD, UI_RUN_RUNNING, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_TALK_PAD, UI_RUN_IDLE, 0, 0, true, false) == false;
    assert ui_button_enabled(UI_BTN_TEST_CALL, UI_RUN_IDLE, 0, 0, true, false) == true;
    assert ui_button_enabled(UI_BTN_TEST_CALL, UI_RUN_IDLE, 0, 0, false, false) == false;
    assert ui_button_enabled(UI_BTN_TEST_CALL, UI_RUN_IDLE, 0, 0, true, true) == false;
    assert ui_button_enabled(UI_BTN_TEST_HEADPHONES, UI_RUN_IDLE, 0, 0, false, false) == true;
    assert ui_button_enabled(UI_BTN_TEST_HEADPHONES, UI_RUN_IDLE, 0, 0, true, true) == false;
    assert ui_button_enabled(0, UI_RUN_RUNNING, 0, 0, true, false) == false;
    // Every button and run state: replay and the talk pad need a running Ponte.
    var b: i32 = 0;
    var bad: u32 = 0;
    while (b <= 12) {
        var r: i32 = 0;
        while (r < 4) {
            var on: bool = ui_button_enabled(b, r, 1, 1, true, false);
            if ((b == UI_BTN_REPLAY_INCOMING or b == UI_BTN_REPLAY_OUTGOING or b == UI_BTN_TALK_PAD) and on and r != UI_RUN_RUNNING) { bad = bad + 1; }
            if ((b < UI_BTN_START_STOP or b > UI_BTN_VOICE_TOGGLE) and on) { bad = bad + 1; }
            r = r + 1;
        }
        b = b + 1;
    }
    assert bad == 0;
}

test ui_lights_and_choices {
    // rulesLightsAndLatency
    assert ui_audio_light(UI_RUN_IDLE, true, 0, 0) == UI_LIGHT_UNKNOWN;
    assert ui_audio_light(UI_RUN_STARTING, false, 0, -1) == UI_LIGHT_BUSY;
    assert ui_audio_light(UI_RUN_RUNNING, false, 0, -1) == UI_LIGHT_BAD;
    assert ui_audio_light(UI_RUN_RUNNING, true, 9000, 1999) == UI_LIGHT_OK;
    assert ui_audio_light(UI_RUN_RUNNING, true, 3999, -1) == UI_LIGHT_BUSY;
    assert ui_audio_light(UI_RUN_RUNNING, true, 4000, 2000) == UI_LIGHT_BAD;
    assert ui_source_light(UI_RUN_IDLE, true, UI_TAP_FAILED, 0, 0, 0) == UI_LIGHT_UNKNOWN;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_FAILED, 9000, 10, 10) == UI_LIGHT_BAD;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_WAITING, 9000, 10, 10) == UI_LIGHT_BUSY;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_CAPTURING, 8000, 10, -1) == UI_LIGHT_WARN;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_CAPTURING, 7999, 10, -1) == UI_LIGHT_OK;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_CAPTURING, 9000, 10, 10) == UI_LIGHT_OK;
    assert ui_source_light(UI_RUN_RUNNING, true, UI_TAP_NONE, 9000, 10, -1) == UI_LIGHT_OK;
    assert ui_source_light(UI_RUN_RUNNING, false, UI_TAP_FAILED, 9000, 10, -1) == UI_LIGHT_BAD;
    assert ui_capture_check_light(UI_TAP_FAILED, true, true) == UI_LIGHT_BAD;
    assert ui_capture_check_light(UI_TAP_CAPTURING, false, false) == UI_LIGHT_BAD;
    assert ui_capture_check_light(UI_TAP_CAPTURING, true, false) == UI_LIGHT_WARN;
    assert ui_capture_check_light(UI_TAP_CAPTURING, true, true) == UI_LIGHT_OK;
    assert ui_blackhole_light(true) == UI_LIGHT_OK;
    assert ui_blackhole_light(false) == UI_LIGHT_BAD;
    assert ui_models_light(UI_RUN_IDLE, false, 0, 0) == UI_LIGHT_UNKNOWN;
    assert ui_models_light(UI_RUN_STARTING, true, 0, 0) == UI_LIGHT_BUSY;
    assert ui_models_light(UI_RUN_RUNNING, true, 2, 0) == UI_LIGHT_OK;
    assert ui_models_light(UI_RUN_RUNNING, true, 1, 1) == UI_LIGHT_BAD;
    assert ui_models_light(UI_RUN_IDLE, true, 2, 0) == UI_LIGHT_OK;
    assert ui_latency_color(-1) == UI_LAT_NONE;
    assert ui_latency_color(0) == UI_LAT_GOOD;
    assert ui_latency_color(2000) == UI_LAT_GOOD;
    assert ui_latency_color(2001) == UI_LAT_SLOW;
    assert ui_latency_color(4000) == UI_LAT_SLOW;
    assert ui_latency_color(4001) == UI_LAT_BAD;
    // rulesSourceTranslatorPushToTalk (source and translator part)
    assert ui_source_section(true, false) == UI_SRC_CALLS;
    assert ui_source_section(false, true) == UI_SRC_PLAYING;
    assert ui_source_section(false, false) == UI_SRC_OTHER;
    assert ui_translator_choice(UI_TR_CLAUDE, true) == UI_TR_CLAUDE;
    assert ui_translator_choice(UI_TR_CLAUDE, false) == UI_TR_APPLE;
    assert ui_translator_choice(UI_TR_APPLE, true) == UI_TR_APPLE;
    // The latency colour never improves as the latency grows.
    var ms: i64 = 0;
    var previous: i32 = UI_LAT_GOOD;
    var bad: u32 = 0;
    while (ms <= 10000) {
        var c: i32 = ui_latency_color(ms);
        if (c < previous) { bad = bad + 1; }
        previous = c;
        ms = ms + 7;
    }
    assert bad == 0;
}

test ui_wizard_and_overlay {
    // rulesWizardAndOverlay
    assert ui_wizard_next(0) == 1;
    assert ui_wizard_next(4) == 5;
    assert ui_wizard_next(5) == UI_WZ_NONE;
    assert ui_wizard_next(-1) == UI_WZ_NONE;
    assert ui_wizard_previous(0) == UI_WZ_NONE;
    assert ui_wizard_previous(1) == 0;
    assert ui_wizard_previous(5) == 4;
    assert ui_wizard_previous(6) == UI_WZ_NONE;
    assert ui_wizard_step_mark(UI_WZ_PERMISSIONS, true, true, 0, 0, false, false) == UI_MARK_DONE;
    assert ui_wizard_step_mark(UI_WZ_PERMISSIONS, true, false, 0, 0, false, false) == UI_MARK_NONE;
    assert ui_wizard_step_mark(UI_WZ_MODELS, false, false, 2, 0, false, false) == UI_MARK_DONE;
    assert ui_wizard_step_mark(UI_WZ_MODELS, false, false, 1, 0, false, false) == UI_MARK_NONE;
    assert ui_wizard_step_mark(UI_WZ_PACKS, false, false, 0, 2, false, false) == UI_MARK_DONE;
    assert ui_wizard_step_mark(UI_WZ_PACKS, false, false, 0, 1, false, false) == UI_MARK_NONE;
    assert ui_wizard_step_mark(UI_WZ_BLACKHOLE, false, false, 0, 0, true, false) == UI_MARK_DONE;
    assert ui_wizard_step_mark(UI_WZ_BLACKHOLE, false, false, 0, 0, false, false) == UI_MARK_WARN;
    assert ui_wizard_step_mark(UI_WZ_CALL_APPS, false, false, 0, 0, false, true) == UI_MARK_DONE;
    assert ui_wizard_step_mark(UI_WZ_CALL_APPS, false, false, 0, 0, false, false) == UI_MARK_NONE;
    assert ui_wizard_step_mark(UI_WZ_DONE, true, true, 2, 2, true, true) == UI_MARK_NONE;
    assert ui_wizard_show_on_launch(false, -1) == true;
    assert ui_wizard_show_on_launch(true, -1) == false;
    assert ui_wizard_show_on_launch(true, 3) == true;
    assert ui_wizard_show_on_launch_in_mode(false, -1, true) == false;
    assert ui_wizard_show_on_launch_in_mode(false, -1, false) == true;
    assert ui_wizard_show_on_launch_in_mode(true, 2, true) == true;
    assert ui_wizard_completed_after_close(false, true) == true;
    assert ui_wizard_completed_after_close(false, false) == false;
    assert ui_wizard_completed_after_close(true, false) == true;
    // next and previous walk the six steps both ways.
    var s: i32 = 0;
    var bad: u32 = 0;
    while (s < UI_WZ_DONE) {
        if (ui_wizard_previous(ui_wizard_next(s)) != s) { bad = bad + 1; }
        s = s + 1;
    }
    assert bad == 0;
    assert ui_translation_font_size(0) == 24;
    assert ui_translation_font_size(13) == 24;
    assert ui_translation_font_size(14) == 16;
    assert ui_translation_font_size(16) == 16;
    assert ui_translation_font_size(30) == 30;
    assert ui_translation_font_size(40) == 40;
    assert ui_translation_font_size(41) == 40;
    assert ui_translation_font_size(99) == 40;
    assert ui_overlay_line_count(0, 500, 24) == 0;
    assert ui_overlay_line_count(5, 130, 24) == 2;
    assert ui_overlay_line_count(1, 130, 24) == 1;
    assert ui_overlay_line_count(5, 90, 40) == 1;
    assert ui_overlay_line_count(5, 1000, 16) == 2;
}

