; Specs/voice_rules.t27 -- Ponte: which system voice speaks, and how long synthesis may take
; Mirrors the voice and synthesis parts of PonteSpeech/SpeechRules.swift one to one (same constants,
; codes and order of checks; each function names the Swift function it mirrors). A voice identifier is
; UTF-8 bytes in a buffer of VO_ID_MAX bytes with its length. Swift keeps the preferred-name lists
; (Luciana for pt-BR, Milena for ru) and passes the position of a voice's name in them. ASCII only.
; Generated C: Sources/PonteSpecs/voice_rules.h (Specs/generate.sh).

module PonteVoiceRules;

pub const VO_ID_MAX : i64 = 1024;

; --- Quality codes (qualityCompact, qualityEnhanced, qualityPremium) ---------------------------------
; Also the raw values of AVSpeechSynthesisVoiceQuality.
pub const VO_QUALITY_COMPACT : i64 = 1;
pub const VO_QUALITY_ENHANCED : i64 = 2;
pub const VO_QUALITY_PREMIUM : i64 = 3;

; --- Rank key -------------------------------------------------------------------------------------------
; quality x 10000, + 1000 for a regular (not novelty) voice, + 100 - min(preferredIndex, 99) for a
; preferred name. Larger is better; Swift breaks ties by name, then identifier.
pub const VO_QUALITY_WEIGHT : i64 = 10000;
pub const VO_REGULAR_BONUS : i64 = 1000;
pub const VO_PREFERRED_BASE : i64 = 100;
pub const VO_PREFERRED_MAX_INDEX : i64 = 99;

; --- Synthesis ------------------------------------------------------------------------------------------
; synthesisTimeoutMs = min(60000, max(5000, 5000 + 50 x bytes)).
pub const VO_SYNTHESIS_TIMEOUT_MIN_MS : i64 = 5000;
pub const VO_SYNTHESIS_TIMEOUT_MAX_MS : i64 = 60000;
pub const VO_SYNTHESIS_MS_PER_BYTE : i64 = 50;
; synthesisEndGraceMs: after didFinish, wait this long for a late buffer.
pub const VO_SYNTHESIS_END_GRACE_MS : i64 = 200;

; --- Speaking rate ----------------------------------------------------------------------------------------
; defaultUtteranceRateMilli: AVSpeechUtteranceDefaultSpeechRate (0.5) in thousandths.
pub const VO_DEFAULT_UTTERANCE_RATE_MILLI : i64 = 500;
; utteranceRateMilliPer10Percent: rate change, in thousandths of AVSpeechUtterance.rate, per 10 % of speed.
; Measured on this Mac 2026-10-11 (Luciana pt-BR, Milena ru): +0.01 of rate is about +5.8 % of speed.
pub const VO_UTTERANCE_RATE_MILLI_PER_10_PERCENT : i64 = 17;
pub const VO_PERCENT_NORMAL : i64 = 100;
pub const VO_RATE_MILLI_MAX : i64 = 1000;

; >>> generated by Specs/tables/ponte_tables.py -- edit the lists there, not here
; Identifier parts of novelty voices, then the preferred voice names
pub const VO_ROW_FIRST_PREFERRED_PT : i64 = 2;
pub const VO_ROW_FIRST_PREFERRED_RU : i64 = 5;
pub const VO_PREFERRED_PT_COUNT : i64 = 3;
pub const VO_PREFERRED_RU_COUNT : i64 = 3;
; .eloquence.
pub const VO_ROW_ELOQUENCE : i64 = 0;
; .speech.synthesis.voice.
pub const VO_ROW_LEGACY : i64 = 1;
; Luciana
pub const VO_ROW_PREFERRED_PT_0 : i64 = 2;
; Felipe
pub const VO_ROW_PREFERRED_PT_1 : i64 = 3;
; Fernanda
pub const VO_ROW_PREFERRED_PT_2 : i64 = 4;
; Milena
pub const VO_ROW_PREFERRED_RU_0 : i64 = 5;
; Yuri
pub const VO_ROW_PREFERRED_RU_1 : i64 = 6;
; Katya
pub const VO_ROW_PREFERRED_RU_2 : i64 = 7;
pub const VO_ROW_COUNT : i64 = 8;
pub const VO_ROW_TEXT : [71]u8 = [46, 101, 108, 111, 113, 117, 101, 110, 99, 101, 46, 46, 115, 112, 101, 101, 99, 104, 46, 115, 121, 110, 116, 104, 101, 115, 105, 115, 46, 118, 111, 105, 99, 101, 46, 76, 117, 99, 105, 97, 110, 97, 70, 101, 108, 105, 112, 101, 70, 101, 114, 110, 97, 110, 100, 97, 77, 105, 108, 101, 110, 97, 89, 117, 114, 105, 75, 97, 116, 121, 97];
pub const VO_ROW_OFFSETS : [8]u32 = [0, 11, 35, 42, 48, 56, 62, 66];
pub const VO_ROW_LENGTHS : [8]u32 = [11, 24, 7, 6, 8, 6, 4, 5];
; Texts for the tests
; com.apple.eloquence.pt-BR.Eddy
pub const VO_FX_EDDY : i64 = 0;
; com.apple.speech.synthesis.voice.Bells
pub const VO_FX_BELLS : i64 = 1;
; com.apple.voice.compact.pt-BR.Luciana
pub const VO_FX_LUCIANA : i64 = 2;
; (empty)
pub const VO_FX_EMPTY : i64 = 3;
pub const VO_FX_COUNT : i64 = 4;
pub const VO_FX_TEXT : [105]u8 = [99, 111, 109, 46, 97, 112, 112, 108, 101, 46, 101, 108, 111, 113, 117, 101, 110, 99, 101, 46, 112, 116, 45, 66, 82, 46, 69, 100, 100, 121, 99, 111, 109, 46, 97, 112, 112, 108, 101, 46, 115, 112, 101, 101, 99, 104, 46, 115, 121, 110, 116, 104, 101, 115, 105, 115, 46, 118, 111, 105, 99, 101, 46, 66, 101, 108, 108, 115, 99, 111, 109, 46, 97, 112, 112, 108, 101, 46, 118, 111, 105, 99, 101, 46, 99, 111, 109, 112, 97, 99, 116, 46, 112, 116, 45, 66, 82, 46, 76, 117, 99, 105, 97, 110, 97];
pub const VO_FX_OFFSETS : [4]u32 = [0, 30, 68, 105];
pub const VO_FX_LENGTHS : [4]u32 = [30, 38, 37, 0];
; <<< generated

pub fn vo_id_len(len: i64) -> i64 {
    if (len < 0) { return 0; }
    if (len > VO_ID_MAX) { return VO_ID_MAX; }
    return len;
}

; voiceQualityCode: an AVSpeechSynthesisVoiceQuality raw value 1...3 is its own code; anything else compact.
pub fn vo_voice_quality_code(av_quality_raw: i64) -> i64 {
    if (av_quality_raw >= VO_QUALITY_COMPACT and av_quality_raw <= VO_QUALITY_PREMIUM) { return av_quality_raw; }
    return VO_QUALITY_COMPACT;
}

; contains: the identifier holds row `row` of VO_ROW_TEXT as exact bytes (an empty part never matches).
pub fn vo_contains_row(id: [1024]u8, len: i64, row: i64) -> bool {
    var n: i64 = vo_id_len(len);
    var off: i64 = VO_ROW_OFFSETS[row];
    var m: i64 = VO_ROW_LENGTHS[row];
    if (m == 0 or n < m) { return false; }
    var start: i64 = 0;
    while (start <= n - m) {
        if (id[start] == VO_ROW_TEXT[off]) {
            var k: i64 = 1;
            var same: bool = true;
            while (same and k < m) {
                if (id[start + k] != VO_ROW_TEXT[off + k]) { same = false; }
                k = k + 1;
            }
            if (same) { return true; }
        }
        start = start + 1;
    }
    return false;
}

; isNoveltyVoice: "com.apple.eloquence.*" (Eddy, Flo, Reed...) and the old
; "com.apple.speech.synthesis.voice.*" voices rank below regular voices.
pub fn vo_is_novelty_voice(id: [1024]u8, len: i64) -> bool {
    return vo_contains_row(id, len, VO_ROW_ELOQUENCE) or vo_contains_row(id, len, VO_ROW_LEGACY);
}

; voiceRankKey: quality first, then regular before novelty, then the preferred-name position (-1: none).
pub fn vo_voice_rank_key(quality_code: i64, is_novelty: bool, preferred_index: i64) -> i64 {
    var preferred: i64 = 0;
    if (preferred_index >= 0) {
        var index: i64 = preferred_index;
        if (VO_PREFERRED_MAX_INDEX < index) { index = VO_PREFERRED_MAX_INDEX; }
        preferred = VO_PREFERRED_BASE - index;
    }
    var regular: i64 = VO_REGULAR_BONUS;
    if (is_novelty) { regular = 0; }
    return quality_code * VO_QUALITY_WEIGHT + regular + preferred;
}

; synthesisTimeoutMs: the rendering time limit for a phrase of text_bytes UTF-8 bytes.
pub fn vo_synthesis_timeout_ms(text_bytes: i64) -> i64 {
    var t: i64 = VO_SYNTHESIS_TIMEOUT_MIN_MS + VO_SYNTHESIS_MS_PER_BYTE * text_bytes;
    if (t < VO_SYNTHESIS_TIMEOUT_MIN_MS) { t = VO_SYNTHESIS_TIMEOUT_MIN_MS; }
    if (t > VO_SYNTHESIS_TIMEOUT_MAX_MS) { t = VO_SYNTHESIS_TIMEOUT_MAX_MS; }
    return t;
}

; utteranceRateMilli: base + (ratePercent - 100) * 17 / 10 (integer division truncating toward zero),
; clamped to 0...1000. 100 gives base; 110 base + 17; 130 base + 51.
pub fn vo_utterance_rate_milli(rate_percent: i64, base_rate_milli: i64) -> i64 {
    var rate: i64 = base_rate_milli + (rate_percent - VO_PERCENT_NORMAL) * VO_UTTERANCE_RATE_MILLI_PER_10_PERCENT / 10;
    if (rate < 0) { rate = 0; }
    if (rate > VO_RATE_MILLI_MAX) { rate = VO_RATE_MILLI_MAX; }
    return rate;
}

; --- Rules moved here from SystemSpeechSynth and VoiceRanking (2026-10-11) ---------------------------------------
; Languages (the same codes as SG_LANG_* in segment_rules.t27).
pub const VO_LANG_PT_BR : i64 = 0;
pub const VO_LANG_RU : i64 = 1;
; Which voice speaks: the one saved in the settings, the best installed one, or the language's default.
pub const VO_SOURCE_SAVED : i64 = 0;
pub const VO_SOURCE_BEST : i64 = 1;
pub const VO_SOURCE_LANGUAGE : i64 = 2;
pub const VO_MILLI : f32 = 1000.0;

; VoiceRanking.preferredNames: how many names, and name `index` written to out (its length; 0: none).
pub fn vo_preferred_count(language: i64) -> i64 {
    if (language == VO_LANG_PT_BR) { return VO_PREFERRED_PT_COUNT; }
    if (language == VO_LANG_RU) { return VO_PREFERRED_RU_COUNT; }
    return 0;
}

pub fn vo_preferred_name(language: i64, index: i64, out: [1024]u8) -> i64 {
    if (index < 0 or index >= vo_preferred_count(language)) { return 0; }
    var row: i64 = VO_ROW_FIRST_PREFERRED_PT + index;
    if (language == VO_LANG_RU) { row = VO_ROW_FIRST_PREFERRED_RU + index; }
    var off: i64 = VO_ROW_OFFSETS[row];
    var n: i64 = VO_ROW_LENGTHS[row];
    var i: i64 = 0;
    while (i < n) {
        out[i] = VO_ROW_TEXT[off + i];
        i = i + 1;
    }
    return n;
}

; VoiceRanking.rank order: the larger rank key first; then the name, then the identifier, ascending.
; name_order and id_order are Swift's comparison of a with b: -1 before, 0 equal, 1 after.
pub fn vo_voice_before(key_a: i64, key_b: i64, name_order: i64, id_order: i64) -> bool {
    if (key_a != key_b) { return key_a > key_b; }
    if (name_order != 0) { return name_order < 0; }
    return id_order < 0;
}

pub fn vo_voice_source(has_saved: bool, has_best: bool) -> i64 {
    if (has_saved) { return VO_SOURCE_SAVED; }
    if (has_best) { return VO_SOURCE_BEST; }
    return VO_SOURCE_LANGUAGE;
}

; The utterance rate is set when the settings give one or the speed is not 100 %.
pub fn vo_sets_rate(has_rate: bool, rate_percent: i64) -> bool {
    return has_rate or rate_percent != VO_PERCENT_NORMAL;
}

; The voice's normal rate in thousandths: the setting rounded (Float), else the default 500.
pub fn vo_base_rate_milli(has_rate: bool, rate: f32) -> i64 {
    if (has_rate) {
        var scaled: f32 = rate * VO_MILLI;
        return cast_i64(round(scaled));
    }
    return VO_DEFAULT_UTTERANCE_RATE_MILLI;
}

; AVSpeechUtterance.rate from thousandths: Float(milli) / 1000.
pub fn vo_utterance_rate(milli: i64) -> f32 {
    var m: f32 = milli;
    return m / VO_MILLI;
}

; Copies text fixture `index` to out at `at` and returns its length (0 for an unknown index).
pub fn vo_fixture(index: i64, out: [1024]u8, at: i64) -> i64 {
    if (index < 0 or index >= VO_FX_COUNT or at < 0) { return 0; }
    var off: i64 = VO_FX_OFFSETS[index];
    var len: i64 = VO_FX_LENGTHS[index];
    var k: i64 = 0;
    while (k < len and at + k < VO_ID_MAX) {
        out[at + k] = VO_FX_TEXT[off + k];
        k = k + 1;
    }
    return k;
}

test vo_rank_rules {
    // rankKey
    assert vo_voice_rank_key(VO_QUALITY_PREMIUM, true, -1) > vo_voice_rank_key(VO_QUALITY_ENHANCED, false, 0);
    assert vo_voice_rank_key(VO_QUALITY_COMPACT, false, -1) > vo_voice_rank_key(VO_QUALITY_COMPACT, true, 0);
    assert vo_voice_rank_key(VO_QUALITY_COMPACT, false, 0) > vo_voice_rank_key(VO_QUALITY_COMPACT, false, 1);
    assert vo_voice_rank_key(VO_QUALITY_ENHANCED, false, 0) == 21100;
    assert vo_voice_rank_key(VO_QUALITY_COMPACT, true, -1) == 10000;
    assert vo_voice_rank_key(VO_QUALITY_COMPACT, false, 150) == 11001;
    assert vo_voice_quality_code(0) == VO_QUALITY_COMPACT;
    assert vo_voice_quality_code(3) == VO_QUALITY_PREMIUM;
    assert vo_voice_quality_code(2) == VO_QUALITY_ENHANCED;
    assert vo_voice_quality_code(9) == VO_QUALITY_COMPACT;
    // A better quality always outranks any novelty and preference of a worse one.
    var q: i64 = 1;
    var bad: u32 = 0;
    while (q < 3) {
        var p: i64 = -1;
        while (p < 120) {
            if (vo_voice_rank_key(q, false, 0) >= vo_voice_rank_key(q + 1, true, p)) { bad = bad + 1; }
            if (vo_voice_rank_key(q, true, 0) >= vo_voice_rank_key(q, false, p)) { bad = bad + 1; }
            p = p + 1;
        }
        q = q + 1;
    }
    assert bad == 0;
}

test vo_novelty_and_synthesis {
    var id: [1024]u8 = [0; 1024];
    assert vo_is_novelty_voice(id, vo_fixture(VO_FX_EDDY, id, 0)) == true;
    assert vo_is_novelty_voice(id, vo_fixture(VO_FX_BELLS, id, 0)) == true;
    assert vo_is_novelty_voice(id, vo_fixture(VO_FX_LUCIANA, id, 0)) == false;
    assert vo_is_novelty_voice(id, vo_fixture(VO_FX_EMPTY, id, 0)) == false;
    // synthesisTimeout
    assert vo_synthesis_timeout_ms(0) == 5000;
    assert vo_synthesis_timeout_ms(100) == 10000;
    assert vo_synthesis_timeout_ms(10000) == 60000;
    assert vo_synthesis_timeout_ms(-1000) == 5000;
    // speaking rate
    assert vo_utterance_rate_milli(100, 500) == 500;
    assert vo_utterance_rate_milli(110, 500) == 517;
    assert vo_utterance_rate_milli(120, 500) == 534;
    assert vo_utterance_rate_milli(130, 500) == 551;
    assert vo_utterance_rate_milli(95, 500) == 492;
    assert vo_utterance_rate_milli(91, 500) == 485;
    assert vo_utterance_rate_milli(-1000, 500) == 0;
    assert vo_utterance_rate_milli(10000, 500) == 1000;
}

test vo_moved_rules {
    var out: [1024]u8 = [0; 1024];
    assert vo_preferred_count(VO_LANG_PT_BR) == 3;
    assert vo_preferred_count(VO_LANG_RU) == 3;
    assert vo_preferred_count(7) == 0;
    assert vo_preferred_name(VO_LANG_PT_BR, 0, out) == 7;
    assert out[0] == 76;
    assert vo_preferred_name(VO_LANG_RU, 0, out) == 6;
    assert out[0] == 77;
    assert vo_preferred_name(VO_LANG_RU, 3, out) == 0;
    assert vo_preferred_name(VO_LANG_PT_BR, -1, out) == 0;
    assert vo_voice_before(2, 1, 1, 1) == true;
    assert vo_voice_before(1, 2, -1, -1) == false;
    assert vo_voice_before(1, 1, -1, 1) == true;
    assert vo_voice_before(1, 1, 1, -1) == false;
    assert vo_voice_before(1, 1, 0, -1) == true;
    assert vo_voice_before(1, 1, 0, 0) == false;
    assert vo_voice_source(true, true) == VO_SOURCE_SAVED;
    assert vo_voice_source(false, true) == VO_SOURCE_BEST;
    assert vo_voice_source(false, false) == VO_SOURCE_LANGUAGE;
    assert vo_sets_rate(false, 100) == false;
    assert vo_sets_rate(true, 100) == true;
    assert vo_sets_rate(false, 110) == true;
    assert vo_base_rate_milli(false, 0.9) == 500;
    assert vo_base_rate_milli(true, 0.5) == 500;
    assert vo_base_rate_milli(true, 0.4) == 400;
    assert vo_base_rate_milli(true, 0.5555) == 556;
    assert vo_utterance_rate(500) == 0.5;
    assert vo_utterance_rate(1000) == 1.0;
}
