{
  "manifest_version": 3,
  "name": "Ponte Camera",
  "version": "0.1.14",
  "description": "Light, colour and framing of your camera in Google Meet, set from Ponte.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://meet.google.com/*"], "js": ["bridge.js"], "run_at": "document_start" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
